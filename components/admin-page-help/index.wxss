.help-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(88rpx + env(safe-area-inset-bottom));
  z-index: 55;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #006495;
  box-shadow: 0 6rpx 18rpx rgba(0, 58, 88, 0.24);
  touch-action: none;
}
.help-fab--moved { right: auto; bottom: auto; }

.help-panel { display: flex; height: 100%; flex-direction: column; background: #f8f9ff; }
.help-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; background: #ffffff; border-bottom: 1rpx solid #e3e8ed; }
.help-title { color: #163b4d; font-size: 32rpx; font-weight: 600; }
.help-content { flex: 1; min-height: 0; padding: 24rpx 28rpx; box-sizing: border-box; }
.help-answer, .chat-message { margin-bottom: 20rpx; padding: 24rpx; border-radius: 8rpx; background: #ffffff; color: #253640; font-size: 28rpx; line-height: 1.65; white-space: pre-wrap; }
.chat-message--user { margin-left: 100rpx; background: #dff1f8; }
.chat-message--assistant { margin-right: 32rpx; }
.citation-list { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #e3e8ed; color: #56717e; font-size: 22rpx; }
.citation { overflow: hidden; margin-top: 4rpx; text-overflow: ellipsis; white-space: nowrap; }
.help-state, .help-error { display: flex; min-height: 120rpx; align-items: center; justify-content: center; gap: 18rpx; color: #6b7d87; font-size: 27rpx; }
.help-error { flex-direction: column; color: #b54b43; }
.help-input-bar { display: flex; align-items: flex-end; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1rpx solid #e3e8ed; }
.help-input { flex: 1; min-height: 64rpx; max-height: 150rpx; padding: 14rpx 16rpx; border: 1rpx solid #cbd8df; border-radius: 8rpx; box-sizing: border-box; color: #253640; font-size: 28rpx; line-height: 1.4; }