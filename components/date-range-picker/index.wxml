<view class="dpr-root">
  <view class="dpr-display" bindtap="openCalendar">
    <text class="dpr-text {{mode == 'single' && !date ? 'dpr-text--placeholder' : ''}}">{{mode == 'single' ? (date || placeholder) : startDate + ' ~ ' + endDate}}</text>
  </view>
  <!-- 快捷键只对区间查询有意义，单选（如"截止日"）不出现 -->
  <view class="dpr-shortcuts" wx:if="{{mode != 'single'}}">
    <view class="dpr-btn {{activeShortcut == 'today' ? 'dpr-btn--active' : ''}}"
          data-key="today" bindtap="onShortcut">今天</view>
    <view class="dpr-btn {{activeShortcut == 'yesterday' ? 'dpr-btn--active' : ''}}"
          data-key="yesterday" bindtap="onShortcut">昨天</view>
    <view class="dpr-btn {{activeShortcut == 'thisweek' ? 'dpr-btn--active' : ''}}"
          data-key="thisweek" bindtap="onShortcut">本周</view>
    <view class="dpr-btn {{activeShortcut == 'lastweek' ? 'dpr-btn--active' : ''}}"
          data-key="lastweek" bindtap="onShortcut">上周</view>
  </view>
</view>

<van-calendar
  show="{{showCalendar}}"
  type="{{mode == 'single' ? 'single' : 'range'}}"
  allow-same-day
  min-date="{{minDate}}"
  max-date="{{maxDate}}"
  bind:confirm="onCalendarConfirm"
  bind:close="closeCalendar"
/>
