.lp-root {
  background: #f8f9ff;
}

.lp-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.lp-bar--second {
  gap: 12rpx;
  flex-wrap: wrap;
}

.lp-info {
  font-size: 24rpx;
  color: #666;
}

.lp-ctrl {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}

.lp-label {
  font-size: 24rpx;
  color: #666;
}

.lp-input {
  width: 80rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 10rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  background: #fff;
}

.lp-input[disabled] {
  background: #f2f3f5;
  color: #aaa;
}
