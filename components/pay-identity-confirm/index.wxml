<!-- pay-identity-confirm -->
<!-- 已迁出 phone_required 渲染分支:由 payment_entry 在「敬请支付」点击时弹软授权,
     允许用户跳过。本组件保留 direct_to_scanner / choose_identity / error 三个状态。 -->

<!-- 2) direct_to_scanner：订单未匹配会员，将归扫码方 -->
<view wx:if="{{status === 'direct_to_scanner'}}" class="card identity-card">
  <view class="section-title">确认订单归属</view>
  <view class="hint">
    支付完成后，订单将归您
    <text class="hl">{{result.scannerMaskedCell || ''}}</text>
    名下。
  </view>
  <view class="btn-row">
    <!-- 无 cell(散客 OR 已是会员但未绑手机号) → 统一弹软授权层(授权/跳过/取消)。
         前端行为一致,后端 _submitPhone 根据 scannerMember 是否存在自动分流:
           null → _createNewMember(新建会员); 非 null → BindMemberMainCellNum(给现有会员补 cell)。
         注: 之前曾因 MiniAppHelperController 的「孤儿清理」逻辑会把会员 openid MSA 失效,
         导致软授权死循环 → 已于 2026-05-29 修复(删 258-294 孤儿清理 + socialAccountForJob 改为兜底)。 -->
    <button wx:if="{{!result.scannerHasCell}}"
            class="btn btn-primary"
            bindtap="onConfirmTapNeedAuth"
            disabled="{{busy}}">
      确认并继续
    </button>
    <!-- 已是会员且有 cell → 直接走 confirm_direct -->
    <button wx:else
            class="btn btn-primary"
            bindtap="onConfirmDirect"
            disabled="{{busy}}">
      确认并继续
    </button>
  </view>
</view>

<!-- 软授权弹层: 散客 / 会员+无 cell 共用。允许跳过. -->
<view wx:if="{{softAuthShow}}" class="soft-auth-mask" bindtap="onCloseSoftAuth">
  <view class="soft-auth-card" catchtap="">
    <view class="soft-auth-title">建议授权手机号</view>
    <view class="soft-auth-desc">您还未绑定手机号，授权后可在「我的」查看订单记录。也可跳过，直接支付。</view>
    <view class="soft-auth-btn-row">
      <button class="btn btn-primary"
              open-type="getPhoneNumber"
              bindgetphonenumber="onGetPhoneNumberAndConfirmDirect"
              disabled="{{busy}}">
        授权手机号并继续
      </button>
      <button class="btn btn-secondary"
              bindtap="onSkipPhoneAndConfirm"
              disabled="{{busy}}">
        跳过，直接支付
      </button>
      <button class="btn btn-ghost"
              bindtap="onCloseSoftAuth"
              disabled="{{busy}}">
        取消
      </button>
    </view>
  </view>
</view>

<!-- 3) choose_identity：订单已匹配别人，二选一 -->
<view wx:elif="{{status === 'choose_identity'}}" class="card identity-card">
  <view class="section-title">选择支付身份</view>
  <view class="hint">
    本订单已记录会员
    <text wx:if="{{result.orderMemberName}}" class="hl">{{result.orderMemberName}} </text>
    <text class="hl">{{result.orderMemberMaskedCell || ''}}</text>
    。您与该会员
    <text wx:if="{{result.scannerMemberId}}">不一致</text>
    <text wx:else>未匹配</text>
    ，请选择支付身份：
  </view>
  <view class="btn-row btn-row--vertical">
    <button class="btn btn-primary" bindtap="onChooseSelf" disabled="{{busy}}">
      正常支付（订单转归我）
    </button>
    <button class="btn btn-secondary" bindtap="onChooseProxy" disabled="{{busy}}">
      替人代付（订单仍归原会员）
    </button>
  </view>
</view>

<!-- 4) error：展示错误信息 -->
<view wx:elif="{{status === 'error'}}" class="card identity-card">
  <view class="section-title section-title--error">无法支付</view>
  <view class="error-text">{{(result && result.errorMessage) || '未知错误'}}</view>
</view>
