<!-- pay-identity-confirm -->
<!-- 已迁出 phone_required 渲染分支:由 payment_entry 在「敬请支付」点击时弹软授权,
     允许用户跳过。本组件保留 direct_to_scanner / choose_identity / error 三个状态。 -->

<!-- 2) direct_to_scanner：订单未匹配会员，将归扫码方 -->
<view wx:if="{{status === 'direct_to_scanner'}}" class="card identity-card">
  <view class="section-title">确认订单归属</view>
  <view class="hint">
    支付完成后，订单将归您
    <text class="hl">{{result.scannerMaskedCell || ''}}</text>
    名下。
  </view>
  <view class="btn-row">
    <!-- 无 cell(散客 OR 已是会员但未绑手机号) → 直接 getPhoneNumber, 弹微信原生授权页。
         用户同意 → submit_phone + confirm_direct (后端按 scanner 是否存在自动分流: null→建新会员, 非null→给现有会员补cell)。
         用户拒绝 → 走 confirm_direct 兜底, 仍能支付。 -->
    <button wx:if="{{!result.scannerHasCell}}"
            class="btn btn-primary"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhoneNumberAndConfirmDirect"
            disabled="{{busy}}">
      确认并继续
    </button>
    <!-- 已是会员且有 cell → 直接走 confirm_direct -->
    <button wx:else
            class="btn btn-primary"
            bindtap="onConfirmDirect"
            disabled="{{busy}}">
      确认并继续
    </button>
  </view>
</view>

<!-- 3) choose_identity：订单已匹配别人，二选一。
     scanner 没绑手机号时按钮改用 open-type=getPhoneNumber 触发软授权，
     回调里 submit_phone 落库再做 choose 动作。文案/布局保持不变。 -->
<view wx:elif="{{status === 'choose_identity'}}" class="card identity-card">
  <view class="section-title">选择支付身份</view>
  <view class="hint">
    本订单已记录会员
    <text wx:if="{{result.orderMemberName}}" class="hl">{{result.orderMemberName}} </text>
    <text class="hl">{{result.orderMemberMaskedCell || ''}}</text>
    。您与该会员
    <text wx:if="{{result.scannerMemberId}}">不一致</text>
    <text wx:else>未匹配</text>
    ，请选择支付身份：
  </view>
  <view class="btn-row btn-row--vertical">
    <!-- 正常支付：无 cell → getPhoneNumber 触发软授权 -->
    <button wx:if="{{!result.scannerHasCell}}"
            class="btn btn-primary"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhoneNumberAndChooseSelf"
            disabled="{{busy}}">
      正常支付（订单转归我）
    </button>
    <button wx:else
            class="btn btn-primary"
            bindtap="onChooseSelf"
            disabled="{{busy}}">
      正常支付（订单转归我）
    </button>

    <!-- 替人代付：无 cell → getPhoneNumber 触发软授权（回调里弹代付确认 modal） -->
    <button wx:if="{{!result.scannerHasCell}}"
            class="btn btn-secondary"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhoneNumberAndChooseProxy"
            disabled="{{busy}}">
      替人代付（订单仍归原会员）
    </button>
    <button wx:else
            class="btn btn-secondary"
            bindtap="onChooseProxy"
            disabled="{{busy}}">
      替人代付（订单仍归原会员）
    </button>
  </view>
</view>

<!-- 4) error：展示错误信息 -->
<view wx:elif="{{status === 'error'}}" class="card identity-card">
  <view class="section-title section-title--error">无法支付</view>
  <view class="error-text">{{(result && result.errorMessage) || '未知错误'}}</view>
</view>
