/* pay-identity-confirm/index.wxss
 * 与 pages/order/payment_entry.wxss 共用同一套设计 token（#2EA6D0 主色、#E64340 警示红、
 * #F8F8F8 页面底、12rpx 圆角卡片）。组件自身仅设置文字 + 按钮样式，外层 .card 沿用父页面。
 */

.identity-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 4rpx 0 16rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #2EA6D0;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-title--error::before {
  background: #E64340;
}

.hint {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.hint .hl {
  color: #2EA6D0;
  font-weight: 600;
}

.error-text {
  font-size: 28rpx;
  color: #E64340;
  line-height: 1.6;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn-row--vertical {
  flex-direction: column;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 8rpx;
  padding: 0 24rpx;
  border: none;
}

.btn-primary {
  background: #2EA6D0;
  color: #FFFFFF;
}

.btn-primary[disabled] {
  background: #A8C7D8;
  color: #FFFFFF;
}

.btn-secondary {
  background: #FFFFFF;
  color: #2EA6D0;
  border: 1rpx solid #2EA6D0;
}

.btn-secondary[disabled] {
  border-color: #A8C7D8;
  color: #A8C7D8;
}

/* 抹掉微信小程序 button 默认的圆角 + 边框 */
button.btn::after {
  border: none;
}

/* ===== 软授权弹层(仅会员+无 cell) ===== */
.soft-auth-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.soft-auth-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.soft-auth-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.soft-auth-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.soft-auth-btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.soft-auth-btn-row .btn {
  width: 100%;
}
