<view class="order-card">
  <view class="order-card-head" bindtap="onToggle">
    <view class="order-card-head-left">
      <text class="order-card-title">订单详情</text>
      <text wx:if="{{order}}" class="order-card-sub">#{{order.code || order.id}} · {{payingAmountStr}}</text>
    </view>
    <van-icon name="{{expanded ? 'arrow-up' : 'arrow-down'}}" size="18px" color="#3f4850"/>
  </view>
  <view wx:if="{{expanded && order}}" class="order-card-body">
    <view class="kv-row" wx:if="{{order.shop}}">
      <text class="kv-label">店铺</text>
      <text class="kv-value">{{order.shop}}</text>
    </view>
    <view wx:if="{{isCare && !order.careCardSale}}" class="kv-row kv-row--multiline">
      <text class="kv-label">养护内容</text>
      <view class="kv-value-list">
        <text wx:for="{{cares}}" wx:key="id" class="kv-value-item">{{item.name}}</text>
        <text wx:if="{{cares.length === 0}}" class="kv-value-item">（无）</text>
      </view>
    </view>
    <block wx:elif="{{isRetail || order.careCardSale}}">
      <view class="kv-row">
        <text class="kv-label">七色米单号</text>
        <text class="kv-value">{{retailInfo ? retailInfo.mi7 : '（无）'}}</text>
      </view>
      <block wx:if="{{order.careCardSale}}">
        <view class="kv-row"><text class="kv-label">购买卡类</text><text class="kv-value">{{cardNames || '养护卡'}}</text></view>
        <view class="kv-row"><text class="kv-label">购卡金额</text><text class="kv-value">{{cardAmountStr}}</text></view>
        <view class="kv-row"><text class="kv-label">养护费用</text><text class="kv-value">{{careAmountStr}}</text></view>
      </block>
      <view class="kv-row" wx:if="{{retailInfo}}">
        <text class="kv-label">订单类型</text>
        <text class="kv-value">{{retailInfo.type}}{{retailInfo.entertain ? ' · 招待' : ''}}</text>
      </view>
    </block>
    <view wx:else class="kv-row kv-row--multiline">
      <text class="kv-label">租赁商品</text>
      <view class="kv-value-list">
        <text wx:for="{{rentals}}" wx:key="id" class="kv-value-item">{{item.name || '加载中…'}}</text>
        <text wx:if="{{rentals.length === 0}}" class="kv-value-item">（无）</text>
      </view>
    </view>
    <view class="kv-row">
      <text class="kv-label">应付金额</text>
      <text class="kv-value kv-value--strong">{{payingAmountStr}}</text>
    </view>
    <linked-care-summary wx:if="{{order.careCardSale.careOrderId}}" orderId="{{order.careCardSale.careOrderId}}" />
  </view>
</view>
