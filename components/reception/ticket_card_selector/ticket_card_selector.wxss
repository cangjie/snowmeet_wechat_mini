.tcs-wrap {
  padding: 32rpx 32rpx 48rpx;
  background: #ffffff;
}
.tcs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.tcs-tabs {
  display: flex;
  gap: 12rpx;
}
.tcs-tab {
  height: 60rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4b5563;
  background: #f3f4f6;
  border-radius: 30rpx;
  border: 1rpx solid transparent;
}
.tcs-tab--active {
  background: #e0f2fe;
  color: #006495;
  border-color: #006495;
  font-weight: 600;
}
.tcs-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tcs-list {
  height: 600rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
}
.tcs-tip {
  padding: 80rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

/* ---- 优惠券行 ---- */
.tcs-item {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.tcs-item:last-child {
  border-bottom: none;
}
.tcs-item--active {
  background: #f0f9ff;
}
.tcs-item--disabled {
  background: #f1f3f5;
}
.tcs-item-radio {
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.radio-dot {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
  box-sizing: border-box;
}
.radio-dot--active {
  border-color: #006495;
  background: #006495;
  box-shadow: inset 0 0 0 6rpx #ffffff;
}
.radio-dot--disabled {
  border-color: #c7ced8;
  background: #edf1f5;
}
.tcs-item-body {
  flex: 1;
  min-width: 0;
}
.tcs-item-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.tcs-item-name--none {
  font-weight: 400;
  color: #4b5563;
}
.tcs-item-code {
  font-size: 24rpx;
  color: #6b7280;
  font-family: monospace;
  margin-bottom: 4rpx;
}
.tcs-item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.tcs-item-memo {
  color: #006495;
  background: #f0f4f8;
  padding: 0 12rpx;
  border-radius: 6rpx;
}
.tcs-item-occupied {
  color: #b91c1c;
}
.tcs-item--disabled .tcs-item-name,
.tcs-item--disabled .tcs-item-code,
.tcs-item--disabled .tcs-item-meta {
  color: #9aa4b2;
}

/* ---- 会员卡行（行容器复用 .tcs-item） ---- */
.tcs-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.tcs-chip {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.tcs-chip--care {
  background: #dcfce7;
  color: #15803d;
}
.tcs-chip--rent {
  background: #e0f2fe;
  color: #006495;
}
.tcs-card-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}
.tcs-card-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.tcs-card-remaining {
  color: #006495;
  font-weight: 500;
}

/* ---- 底部按钮 ---- */
.tcs-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 32rpx;
}
.tcs-foot-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 8rpx;
}
.tcs-foot-btn--ghost {
  background: #f3f4f6;
  color: #4b5563;
}
.tcs-foot-btn--primary {
  background: #006495;
  color: #ffffff;
}
