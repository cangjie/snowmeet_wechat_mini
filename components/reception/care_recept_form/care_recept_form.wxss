/* components/reception/care_recept_form/care_recept_form.wxss
   基础卡片/chip/结算条样式复用租赁表单（Alpine Operational Minimalist），
   这里只放养护特有的增量样式 */
@import "../rent_recept_form/rent_recept_form.wxss";

/* 服务项按钮行：可换行版本的 rent-mode */
.svc-btn-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}
.svc-btn-row--wrap {
  flex-wrap: wrap;
}
.svc-btn-row .rent-mode-btn {
  flex: none;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

/* 修刃角度行 */
.edge-degree-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  gap: 12rpx;
}
.edge-degree-input {
  width: 120rpx;
  text-align: center;
  flex: none;
}
.edge-degree-unit {
  font-size: 26rpx;
  color: #6f7881;
}

/* 其它维修项追加输入 */
.others-memo-input {
  margin-top: 16rpx;
}

/* 本件小计 */
.care-item-summary {
  font-size: 30rpx;
  font-weight: 600;
  color: #006495;
}

/* 底部添加装备（单按钮加宽） */
.action-item--wide {
  flex: 1;
}

/* 新增品牌 modal 内容 */
.brand-modal-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 32rpx 8rpx;
}

/* 历史装备弹层 */
.history-modal {
  padding: 32rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}
.history-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1c30;
  text-align: center;
}
.history-modal-subtitle {
  font-size: 24rpx;
  color: #6f7881;
  text-align: center;
  margin-top: 8rpx;
}
.history-list {
  max-height: 480rpx;
  margin-top: 16rpx;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(191, 199, 209, 0.3);
}
.history-item:active {
  background: #eff4ff;
}
.history-item-main {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}
.history-item-brand {
  font-size: 30rpx;
  font-weight: 600;
  color: #0b1c30;
}
.history-item-scale {
  font-size: 26rpx;
  color: #3f4850;
}
.history-item-date {
  font-size: 22rpx;
  color: #6f7881;
  flex-shrink: 0;
}
.history-manual {
  padding: 16rpx 32rpx 0;
  border-top: 8rpx solid #f8f9ff;
}
.history-manual-label {
  font-size: 24rpx;
  color: #6f7881;
  margin-bottom: 8rpx;
}

/* 会员储值行（结算条上方） */
.deposit-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin: 0 16rpx 12rpx;
  background: #eff4ff;
  border-radius: 12rpx;
}
.deposit-info {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}
.deposit-label {
  font-size: 24rpx;
  color: #6f7881;
}
.deposit-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #006495;
}
.deposit-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.deposit-toggle-text {
  font-size: 26rpx;
  color: #6f7881;
}
.deposit-toggle-text--on {
  color: #006495;
  font-weight: 600;
}

/* 限装备季卡：装备信息锁定态 */
.equip-lock-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b45309;
}
.kv-text--locked {
  color: #9aa4b2;
}
.kv-input--locked {
  color: #9aa4b2;
  background: #f1f3f5;
}
