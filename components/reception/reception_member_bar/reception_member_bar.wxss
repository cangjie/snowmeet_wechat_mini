/* components/reception/reception_member_bar/reception_member_bar.wxss */

.member-bar {
  --primary: #006495;
  --primary-fixed: #cbe6ff;
  --on-primary-container: #003b5b;
  --secondary: #545f73;
  --secondary-container: #d5e0f8;
  --on-secondary-container: #586377;
  --on-surface: #0b1c30;
  --on-surface-variant: #3f4850;
  --outline-variant: #bfc7d1;
  --surface-container-lowest: #ffffff;
  --surface-container: #e5eeff;

  background: var(--surface-container-lowest);
  border: 1px solid var(--outline-variant);
  border-radius: 12px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 16px;
}

.member-avatar {
  width: 40px;
  height: 40px;
  border-radius: 999px;
  background: var(--secondary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-avatar-text {
  font-size: 12px;
  font-weight: 700;
  color: var(--on-secondary-container);
  letter-spacing: 0.6px;
}

.member-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.member-row--bottom { margin-top: 2px; }

.member-name {
  font-size: 18px;
  font-weight: 700;
  color: var(--on-surface);
  /* 长姓名截断，避免顶到右侧手机号 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}
.member-cell {
  font-size: 13px;
  color: var(--on-surface-variant);
  margin-left: 6px;
  flex-shrink: 0;
}
.member-name-wrap {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}
.member-gender {
  font-size: 13px;
  color: var(--secondary);
  margin-left: 6px;
  flex-shrink: 0;
}
.member-edit-link {
  display: flex;
  align-items: center;
  gap: 2px;
  color: var(--primary);
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
}

/* 编辑顾客信息弹层 */
.edit-panel {
  padding: 20px 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.edit-title { font-size: 16px; font-weight: 700; color: #0b1c30; }
.edit-sub { font-size: 12px; color: #3f4850; margin-top: -6px; }
.edit-group { display: flex; flex-direction: column; gap: 6px; }
.edit-label { font-size: 13px; font-weight: 600; color: #545f73; }
.edit-input {
  height: 44px;
  padding: 0 12px;
  border: 1px solid #bfc7d1;
  border-radius: 8px;
  background: #ffffff;
  font-size: 16px;
  color: #0b1c30;
}
.edit-input--readonly { background: #eff4ff; color: #6f7881; }
.edit-placeholder { color: #6f7881; }
.edit-seg {
  display: flex;
  border: 1px solid #bfc7d1;
  border-radius: 8px;
  overflow: hidden;
}
.edit-seg-item {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  font-size: 15px;
  color: #3f4850;
}
.edit-seg-item.active { background: #006495; color: #ffffff; font-weight: 600; }
.edit-actions { display: flex; gap: 12px; margin-top: 8px; }
.edit-btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 8px;
  border: 1px solid #bfc7d1;
  font-size: 15px;
  color: #3f4850;
}
.edit-btn--primary { background: #006495; border-color: #006495; color: #ffffff; font-weight: 600; }

.member-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}
.member-tag {
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.4px;
  white-space: nowrap;
}
.tag-biz  { background: var(--primary-fixed); color: var(--on-primary-container); }
/* 会员资产速览 chip（有则显示）：icon + 文字，icon 继承 chip 的 color */
.member-tag { display: inline-flex; align-items: center; gap: 3px; }
.member-tag-text { line-height: 1; }
.tag-deposit { background: #dff2e7; color: #15803d; }
.tag-ticket  { background: #e6f0fd; color: #1d4ed8; }
.tag-punch   { background: #fdf1dc; color: #b86e00; }
.tag-season  { background: #ede9fe; color: #6d28d9; }
.tag-points  { background: #fde4ee; color: #b03a6e; }

.member-detail-link {
  display: flex;
  align-items: center;
  gap: 2px;
  color: var(--primary);
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
}
