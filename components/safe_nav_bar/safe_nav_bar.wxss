/* components/safe_nav_bar/safe_nav_bar.wxss */
.snb {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  box-sizing: border-box;
}
.snb--border {
  border-bottom: 1px solid #e2e8f0;
}
.snb-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.snb-side {
  flex: none;
  height: 100%;
  display: flex;
  align-items: center;
}
/* 返回键热区 44×44，比图标大，好点 */
.snb-back {
  width: 44px;
  height: 44px;
  margin-left: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22px;
}
.snb-back--hover {
  background: rgba(0, 100, 149, 0.08);
}
.snb-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 17px;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
