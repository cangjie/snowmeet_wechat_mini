<view wx:if="{{!hidden}}" class="ose-card">
  <view class="ose-head" bindtap="onToggle">
    <text class="ose-title">介绍人分账</text>
    <view class="ose-head-right">
      <text class="ose-side">{{summary}}</text>
      <text class="ose-arrow {{expanded ? 'open' : ''}}">›</text>
    </view>
  </view>

  <block wx:if="{{expanded}}">
    <view class="ose-meta">店长以上可设置 · 关单后</view>

    <view wx:for="{{shares}}" wx:key="orderShareId" class="ose-row">
      <view class="ose-line">
        <view class="ose-name">
          <text class="ose-bold">{{item.name}}</text>
          <text class="ose-tag blue">{{item.type}}</text>
        </view>
        <text class="ose-bold">¥{{item.amount}}</text>
      </view>
      <view class="ose-line">
        <text class="ose-tag {{item.stateClass}}">{{item.state}}</text>
        <text wx:if="{{item.removable}}" class="ose-remove" data-id="{{item.orderShareId}}" bindtap="onRemove">删除</text>
      </view>
      <view wx:if="{{item.planDate}}" class="ose-meta">预计分账：{{item.planDate}}</view>
      <view wx:if="{{item.memo}}" class="ose-meta">备注：{{item.memo}}</view>
    </view>
    <view wx:if="{{!shares.length && !loading}}" class="ose-meta">还没有设置介绍人分账</view>

    <view wx:if="{{canEdit}}" class="ose-form">
      <view class="ose-label">选择介绍人（一单可以给不同的介绍人各设一条）</view>
      <block wx:if="{{choices.length}}">
        <picker range="{{choices}}" range-key="label" bindchange="onPick">
          <view class="ose-pick {{form.introducerId ? 'on' : ''}}">
            <text class="{{form.introducerLabel ? 'ose-bold' : 'ose-placeholder'}}">{{form.introducerLabel || '请选择介绍人'}}</text>
            <text class="ose-caret">▾</text>
          </view>
        </picker>
        <view class="ose-label">分账金额（元）</view>
        <input class="ose-input" type="digit" value="{{form.amount}}" bindinput="onAmount" />
        <view wx:if="{{suggested > 0}}" class="ose-meta">预填：租金（扣减免后）的 10% = ¥{{suggested}}，可以改</view>
        <block wx:if="{{supportsPlanDate}}">
          <view class="ose-label">预计分账日期</view>
          <date-range-picker mode="single" allow-future date="{{form.planDate}}" placeholder="选择预计分账日期" bind:change="onPlanDate" />
          <view class="ose-meta">预填的是最早能分的那天。自动分账的，到这一天夜间 23:00 才提交；要手动转账的，这是预计转账的日子。</view>
        </block>
        <view class="ose-label">备注（选填）</view>
        <input class="ose-input" value="{{form.memo}}" bindinput="onMemo" maxlength="40" />
        <view class="ose-save {{saving ? 'disabled' : ''}}" bindtap="onSave">保存介绍人分账</view>
        <view class="ose-meta">合计（万龙 + 介绍人）达到门槛时，这单所有分账都走手动转账；没达到的，夜间 23:00 自动分账。</view>
      </block>
      <block wx:else>
        <view class="ose-meta">还没有可选的介绍人</view>
        <view wx:if="{{canAddIntroducer}}" class="ose-add" bindtap="onGoAddIntroducer">去添加介绍人</view>
        <view wx:else class="ose-meta">请系统管理员先在「介绍人管理」里添加</view>
      </block>
    </view>
    <view wx:elif="{{reason}}" class="ose-reason">{{reason}}</view>
  </block>
</view>
