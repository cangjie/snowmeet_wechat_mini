.ose-card { margin: 20rpx 24rpx; padding: 24rpx; background: #fff; border: 2rpx solid #006495; border-radius: 16rpx; display: flex; flex-direction: column; gap: 18rpx; box-sizing: border-box; }
.ose-head { display: flex; justify-content: space-between; align-items: center; min-height: 64rpx; }
.ose-head-right { display: flex; align-items: center; gap: 12rpx; }
.ose-title { font-size: 30rpx; font-weight: 700; color: #181C20; }
.ose-side { font-size: 24rpx; color: #5D6A75; }
.ose-arrow { display: inline-block; font-size: 40rpx; line-height: 1; color: #5D6A75; transform: rotate(90deg); }
.ose-arrow.open { transform: rotate(-90deg); }
.ose-row { border: 2rpx solid #D9E2EC; border-radius: 12rpx; padding: 18rpx; display: flex; flex-direction: column; gap: 10rpx; }
.ose-line { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.ose-name { display: flex; align-items: center; gap: 12rpx; }
.ose-bold { font-size: 28rpx; font-weight: 600; color: #181C20; }
.ose-meta { font-size: 22rpx; color: #5D6A75; line-height: 1.5; }
.ose-tag { display: inline-flex; align-items: center; padding: 2rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; background: #F3F6FA; color: #5D6A75; white-space: nowrap; }
.ose-tag.blue { background: #E6F1F8; color: #00507A; }
.ose-tag.warn { background: #FFF1D6; color: #7A4B00; }
.ose-tag.ok { background: #E3F4E8; color: #14602F; }
.ose-tag.danger { background: #FDE7E5; color: #8C1D18; }
.ose-remove { min-height: 88rpx; min-width: 88rpx; display: inline-flex; align-items: center; justify-content: center; color: #B3261E; font-size: 26rpx; }
.ose-save { min-height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #006495; color: #fff; font-size: 30rpx; font-weight: 600; }
.ose-reason { background: #FFF1D6; color: #5C3800; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 24rpx; line-height: 1.5; }
