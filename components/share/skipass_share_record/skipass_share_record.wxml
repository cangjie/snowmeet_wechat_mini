<view wx:if="{{!hidden}}" class="ssr-card">
  <view class="ssr-head" bindtap="onToggle">
    <text class="ssr-title">雪票分账记录</text>
    <view class="ssr-head-right">
      <text class="ssr-side">{{summary}}</text>
      <text class="ssr-arrow {{expanded ? 'open' : ''}}">›</text>
    </view>
  </view>

  <block wx:if="{{expanded}}">
    <view wx:if="{{ticketText}}" class="ssr-meta">{{ticketText}}；每张票分 ¥1，取票后自动分给推荐员工</view>
    <view wx:for="{{records}}" wx:key="orderShareId" class="ssr-row">
      <view class="ssr-line">
        <text class="ssr-bold">分给：{{item.receiver}}</text>
        <text class="ssr-bold">¥{{item.amount}}</text>
      </view>
      <view class="ssr-line">
        <text class="ssr-tag {{item.stateClass}}">{{item.state}}</text>
      </view>
      <view class="ssr-meta">计划：{{item.plan}}</view>
      <view wx:if="{{item.submitTime}}" class="ssr-meta">提交：{{item.submitTime}}</view>
      <view wx:if="{{item.successTime}}" class="ssr-meta ok">成功：{{item.successTime}}</view>
      <view wx:if="{{item.memo}}" class="ssr-meta">备注：{{item.memo}}</view>
    </view>
    <view wx:if="{{!records.length && !loading}}" class="ssr-reason">{{summary}}</view>
  </block>
</view>
