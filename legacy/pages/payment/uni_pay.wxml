<!-- legacy-demo：旧版演示的返回条（build_legacy.py 注入） -->
<view style="background:#fff3cd;color:#8a6d3b;padding:20rpx 24rpx;font-size:28rpx;text-align:center;" bindtap="__legacyExit">【演示】当前为旧版，点此返回新版</view>
<view>
  <view class="view-row" style="justify-content: center;margin-top: 100rpx;" >
    <input class="input" style="width: 300rpx;height: 100rpx;text-align: center;" placeholder="请输入支付金额" type="digit" bindinput="setAmount" disabled="{{!loaded}}" />
  </view>
  <view class="view-row" style="margin-top: 100rpx;justify-content: center;" >
    <van-button type="primary" bind:click="pay" disabled="{{!wellForm}}" > 确 认 支 付 </van-button>
  </view>
</view>