<!-- legacy-demo：旧版演示的返回条（build_legacy.py 注入） -->
<view style="background:#fff3cd;color:#8a6d3b;padding:20rpx 24rpx;font-size:28rpx;text-align:center;" bindtap="__legacyExit">【演示】当前为旧版，点此返回新版</view>
<mp-cells title="确认姓名电话">
  <mp-cell>
    <view class="view-row" >
      <view class="left-column">姓名：</view>
      <view class="right-column">{{realName}}</view>
    </view>
  </mp-cell>
  <mp-cell>
    <view class="view-row" >
      <view class="left-column">电话：</view>
      <view class="right-column">
        <input class="input" bindinput="setCell" type="digit" />
      </view>
    </view>
  </mp-cell>
  <mp-cell>
    <button class="input" disabled="{{disabled}}" bindtap="confirm"  > 成 为 管 理 员 </button>
  </mp-cell>
</mp-cells>