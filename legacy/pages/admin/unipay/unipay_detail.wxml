<!-- legacy-demo：旧版演示的返回条（build_legacy.py 注入） -->
<view style="background:#fff3cd;color:#8a6d3b;padding:20rpx 24rpx;font-size:28rpx;text-align:center;" bindtap="__legacyExit">【演示】当前为旧版，点此返回新版</view>
<view>
  <view class="view-row">
    <view class="left-column">【订单号】</view>
    <view class="right-column">{{order.code}}</view>
  </view>
  <van-divider></van-divider>
  <view class="view-row">
    <view class="left-column">【支付方式】</view>
    <view class="right-column">{{order.payMethod}}</view>
  </view>
  <van-divider></van-divider>
  <view class="view-row">
    <view class="left-column">【日期】</view>
    <view class="right-column">{{order.biz_dateFullStr}}</view>
    <view class="left-column">【时间】</view>
    <view class="right-column">{{order.biz_timeStr}}</view>
  </view>
  <van-divider></van-divider>
  <view class="view-row">
    <view class="left-column">【支付金额】</view>
    <view class="right-column">
      <view style="margin-right:80rpx; text-align: right;">{{order.paidAmountStr}}</view>
    </view>
    <view class="left-column"></view>
    <view class="right-column"></view>
  </view>
  <van-divider></van-divider>
  <view class="view-row">
    <view class="left-column">【退款金额】</view>
    <view class="right-column">
      <view style="margin-right:80rpx; text-align: right;">{{order.refundAmountStr}}</view>
    </view>
    <view class="left-column">【申请退款】</view>
    <view class="right-column view-row">
      <input type="digit" class="input" style="width: 75rpx;text-align: center;" bindinput="setRefundAmount" />
      <van-button size="mini" type="danger" style="margin-left: 10rpx;" bind:click="refund" >退款</van-button>
    </view>
  </view>
  <van-divider></van-divider>
  <view class="view-row">
    <view class="left-column">【结余金额】</view>
    <view class="right-column" style="text-align: right;">
      <view style="margin-right:80rpx; text-align: right;">{{order.remainAmountStr}}</view>
    </view>
    <view class="left-column"></view>
    <view class="right-column"></view>
  </view>
  <van-divider></van-divider>
  <view class="view-row">
    <view class="left-column">【备注】</view>
    <view class="right-column">
      <textarea style="width:500rpx;height:200rpx" class="input" disabled="{{modding==false}}" bindinput="setMemo"
        value="{{order.memo}}">
      </textarea>
    </view>
  </view>
  <van-divider></van-divider>
  <view class="view-row" style="justify-content: center;">
    <block wx:if="{{modding==true}}">
      <van-button type="warning" style="margin-right: 50rpx;" bind:click="cancel"> 取 消 </van-button>
      <van-button type="danger" style="margin-right: 50rpx;" bind:click="confirm"> 确 认 </van-button>
    </block>
    <van-button wx:else type="primary" bind:click="mod"> 修 改 备 注 </van-button>
  </view>
  <van-divider></van-divider>
  <view  class="view-row" style="justify-content: center;margin-top: 30rpx;" >
    <image style="width: 300rpx;height: 300rpx;"  src="{{qrcodeUrl}}" ></image>
  </view>
</view>