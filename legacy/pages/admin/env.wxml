  <radio checked="{{domain=='snowmeet.wanlonghuaxue.com'}}" value='snowmeet.wanlonghuaxue.com' >snowmeet.wanlonghuaxue.com</radio>
  <radio checked="{{domain=='localhost'}}" value='localhost' >localhost<input class="input" bind:tap="input"  value="{{port}}" /></radio>
</radio-group>