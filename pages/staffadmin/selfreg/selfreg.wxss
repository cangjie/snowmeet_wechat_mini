@import "../common/sa.wxss";
.done-mark { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--ok-bg); color: var(--ok); font-size: 60rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.done-mark.off { background: var(--warn-bg); color: var(--warn); }
