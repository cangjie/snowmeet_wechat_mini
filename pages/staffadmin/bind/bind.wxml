<view class="sa-page">
  <view class="card"><view class="card-pad" style="align-items: center; gap: 28rpx;">
    <block wx:if="{{state === 'confirm'}}">
      <block wx:if="{{code.purpose === 'job_phone'}}">
        <view class="card-meta">把本机微信绑定为</view>
        <view class="card-title">工作手机 {{code.phone.tail}}</view>
        <view class="sa-note" style="text-align: center;">绑定后，谁分到这部手机，谁就用这个微信进后台。请授权本机号码 {{code.phone.tail}}。</view>
      </block>
      <block wx:else>
        <view class="card-meta">你将绑定为员工账号</view>
        <view class="card-title">{{code.staff.name}}</view>
        <view class="card-meta">{{code.staff.title_label}}<text wx:if="{{code.staff.shop_name}}"> · {{code.staff.shop_name}}</text></view>
        <view class="sa-note" style="text-align: center;">一个账号只关联一套手机号 + 微信。绑定后，这个微信就能进员工后台。</view>
      </block>
      <button class="btn primary btn-block {{submitting ? 'disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="onPhone">授权手机号并绑定</button>
    </block>
    <block wx:elif="{{state === 'done'}}">
      <view class="done-mark">✓</view>
      <view class="card-title small">绑定成功</view>
      <view class="sa-note" style="text-align: center;">{{code.purpose === 'job_phone' ? '这部手机分给员工后，本机微信就能进后台。' : '退出并重新进入小程序后，「我的」页会出现「我是管理员」入口。'}}</view>
    </block>
    <block wx:elif="{{state === 'not_member'}}">
      <view class="done-mark off">!</view>
      <view class="card-title small">这个微信还不是会员</view>
      <view class="sa-note" style="text-align: center;">员工必须先是会员。请先在小程序里注册会员，再重新扫码。</view>
    </block>
    <block wx:elif="{{state === 'used'}}">
      <view class="done-mark off">!</view>
      <view class="card-title small">这个码已经用过了</view>
      <view class="sa-note" style="text-align: center;">如需重新绑定，请联系系统管理员重新生成。</view>
    </block>
    <block wx:elif="{{state}}">
      <view class="done-mark off">!</view>
      <view class="card-title small">这个码已失效</view>
      <view class="sa-note" style="text-align: center;">请联系系统管理员重新生成绑定码。</view>
    </block>
  </view></view>
</view>
