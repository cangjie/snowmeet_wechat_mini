<view wx:if="{{!verified}}" style="margin-top: 50rpx;" >
  <!-- member==null(未注册) 或 cell 未绑 → 走授权流程; 已有 cell 才显示"已合并" -->
  <member-auth wx:if="{{!member || !member.cell}}" bindVerified="verified" ></member-auth>
  <view wx:else >找到旧的会员信息，现已和当前账户合并，请告知店员顾客需要重新扫码开单。</view>
</view>
<view wx:else >
欢迎新会员
</view>