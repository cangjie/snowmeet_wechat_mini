<view class="trial-page">
  <view class="trial-header">
    <view class="trial-title">武士团试滑预约</view>
    <view class="trial-note">查看预约记录，为会员扫码签到或办理归还。</view>
  </view>

  <picker mode="date" value="{{date}}" bindchange="dateChange">
    <view class="trial-date">
      <text class="trial-date-label">预约日期</text>
      <view class="trial-date-value">{{date}} <text class="trial-date-arrow">›</text></view>
    </view>
  </picker>
  <view wx:if="{{error}}" class="trial-alert trial-alert--error">{{error}}</view>

  <view class="trial-section-title">预约列表</view>
  <view wx:if="{{loading && !rows.length}}" class="trial-empty">加载中…</view>
  <view wx:elif="{{!loading && !error && !rows.length}}" class="trial-empty">当天暂无预约记录</view>
  <view wx:for="{{rows}}" wx:key="id" class="trial-card">
    <view class="trial-card-top">
      <view class="trial-card-title">{{item.memberName}}</view>
      <text class="trial-status trial-status--{{item.label === '已过期' ? 'expired' : item.status}}">{{item.label}}</text>
    </view>
    <view class="trial-card-sub">单板：{{item.barcode}} · {{item.name}}</view>
    <view class="trial-card-sub">预约日期：{{item.date}}</view>
    <view wx:if="{{(item.status === 'pending' && item.date >= today) || item.status === 'in_use'}}" class="trial-actions">
      <button wx:if="{{item.status === 'pending' && item.date === today}}" class="trial-btn trial-btn--primary" size="mini" data-id="{{item.id}}" bindtap="showQr">扫码签到</button>
      <button wx:if="{{item.status === 'pending' && item.date >= today}}" class="trial-btn trial-btn--secondary" size="mini" data-id="{{item.id}}" bindtap="cancel">取消预约</button>
      <button wx:if="{{item.status === 'in_use'}}" class="trial-btn trial-btn--primary" size="mini" data-id="{{item.id}}" bindtap="returnBoard">确认归还</button>
    </view>
  </view>

  <view wx:if="{{qr}}" class="trial-overlay">
    <view class="trial-popup">
      <view class="trial-popup-title">扫码签到</view>
      <view class="trial-popup-note">{{qr.message}}</view>
      <view class="trial-qr-box">
        <image wx:if="{{qr.url}}" class="trial-qr" src="{{qr.url}}" mode="aspectFit" binderror="qrError" />
      </view>
      <button class="trial-popup-close" bindtap="closeQr">关闭</button>
    </view>
  </view>
</view>
