<view class="trial-page">
  <view class="trial-header">
    <view class="trial-title">武士团单板试滑</view>
    <view class="trial-note">武士团会籍会员可免费试滑，不收租金和押金。每天只能预约一块，取消未开始的预约后可重新选择。</view>
  </view>

  <picker mode="date" value="{{date}}" start="{{today}}" end="{{seasonEnd}}" bindchange="onDate">
    <view class="trial-date">
      <text class="trial-date-label">预约日期</text>
      <view class="trial-date-value">{{date}} <text class="trial-date-arrow">›</text></view>
    </view>
  </picker>

  <view wx:if="{{error}}" class="trial-alert trial-alert--error">{{error}}</view>
  <view wx:if="{{!eligible && !loading && !error}}" class="trial-alert trial-alert--error">当前没有有效的武士团会籍</view>
  <view wx:if="{{already}}" class="trial-alert">当天已有预约</view>

  <view class="trial-section-title">可预约单板</view>
  <view wx:if="{{loading && !boards.length}}" class="trial-empty">加载中…</view>
  <view wx:elif="{{!loading && !error && !boards.length}}" class="trial-empty">暂无可预约单板</view>
  <view wx:for="{{boards}}" wx:key="id" class="trial-card trial-card--row">
    <view class="trial-card-main">
      <view class="trial-card-title">{{item.barcode}} · {{item.name}}</view>
      <view class="trial-card-sub">{{item.available ? '可预约' : '暂不可用'}}</view>
    </view>
    <button class="trial-btn trial-btn--primary" size="mini" disabled="{{!item.available || !eligible || already || loading}}" data-id="{{item.id}}" bindtap="reserve">{{item.available ? '预约' : '暂不可用'}}</button>
  </view>

  <view class="trial-section-title">我的预约</view>
  <view wx:if="{{!loading && !error && !reservations.length}}" class="trial-empty">暂无预约记录</view>
  <view wx:for="{{reservations}}" wx:key="id" class="trial-card">
    <view class="trial-card-top">
      <view class="trial-card-title">{{item.barcode}} · {{item.name}}</view>
      <text class="trial-status trial-status--{{item.label === '已过期' ? 'expired' : item.status}}">{{item.label}}</text>
    </view>
    <view class="trial-card-sub">预约日期：{{item.date}}</view>
    <view wx:if="{{item.status === 'pending' && item.date >= today}}" class="trial-actions">
      <button class="trial-btn trial-btn--secondary" size="mini" data-id="{{item.id}}" bindtap="cancel">取消预约</button>
    </view>
  </view>
</view>
