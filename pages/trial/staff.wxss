@import "./index.wxss";

.trial-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(0, 0, 0, 0.5);
}
.trial-popup {
  width: 100%;
  max-width: 320px;
  box-sizing: border-box;
  padding: 24px;
  border-radius: 12px;
  background: #fff;
  text-align: center;
}
.trial-popup-title { font-size: 18px; font-weight: 700; color: #0b1c30; }
.trial-popup-note { margin-top: 8px; font-size: 13px; line-height: 1.5; color: #3f4850; }
.trial-qr-box {
  width: 100%;
  max-width: 220px;
  height: 220px;
  margin: 16px auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #bfc7d1;
  border-radius: 8px;
}
.trial-qr { width: 100%; height: 100%; }
.trial-popup-close {
  height: 44px;
  line-height: 44px;
  padding: 0;
  border-radius: 8px;
  background: #006495;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}
.trial-popup-close::after { border: 0; }
