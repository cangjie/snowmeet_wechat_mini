page {
  background: #f8f9ff;
  color: #0b1c30;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}
.trial-page { min-height: 100vh; box-sizing: border-box; padding: 16px 16px 32px; }
.trial-header { margin-bottom: 16px; }
.trial-title { font-size: 24px; font-weight: 700; line-height: 1.3; }
.trial-note { margin-top: 8px; font-size: 13px; line-height: 1.6; color: #3f4850; }
.trial-date {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 12px;
  border: 1px solid #bfc7d1;
  border-radius: 8px;
  background: #fff;
  font-size: 14px;
}
.trial-date-label { color: #545f73; }
.trial-date-value { color: #006495; font-weight: 600; }
.trial-date-arrow { margin-left: 4px; font-size: 20px; }
.trial-alert { margin-top: 12px; padding: 10px 12px; border-radius: 8px; background: #eff4ff; color: #006495; font-size: 13px; line-height: 1.5; }
.trial-alert--error { background: #ffdad6; color: #93000a; }
.trial-section-title { margin: 24px 0 10px; font-size: 16px; font-weight: 700; }
.trial-card {
  margin-bottom: 10px;
  padding: 16px;
  border: 1px solid #bfc7d1;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 1px 2px rgba(11, 28, 48, 0.04);
}
.trial-card--row, .trial-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.trial-card-main { flex: 1; min-width: 0; }
.trial-card-title { min-width: 0; font-size: 15px; font-weight: 700; overflow-wrap: break-word; }
.trial-card-sub { margin-top: 6px; font-size: 13px; line-height: 1.5; color: #545f73; overflow-wrap: break-word; }
.trial-status { flex-shrink: 0; padding: 3px 8px; border-radius: 999px; background: #eff4ff; color: #006495; font-size: 12px; }
.trial-status--in_use { background: #ecfdf3; color: #15803d; }
.trial-status--returned, .trial-status--cancelled, .trial-status--expired { background: #f1f3f5; color: #6f7881; }
.trial-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.trial-btn {
  flex-shrink: 0;
  height: 36px;
  line-height: 36px;
  margin: 0;
  padding: 0 14px;
  border: 0;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
}
.trial-btn::after { border: 0; }
.trial-btn--primary { background: #006495; color: #fff; }
.trial-btn--secondary { background: #eff4ff; color: #006495; }
.trial-btn[disabled] { background: #e9edf1; color: #8b949e; }
.trial-empty { padding: 24px 16px; color: #6f7881; font-size: 13px; text-align: center; }
