<view class="page">
  <view class="tip" wx:if="{{loading}}">加载中…</view>
  <block wx:else>
    <view class="card" wx:if="{{needMember}}">
      <view class="tip">授权手机号后即可领取优惠券</view>
      <view class="tip tip--err" wx:if="{{errMsg}}">{{errMsg}}</view>
      <button class="btn" loading="{{authBusy}}" disabled="{{authBusy}}"
        open-type="getPhoneNumber" bindgetphonenumber="onGetCell">授权手机号</button>
    </view>
    <view class="card" wx:if="{{!needMember && errMsg}}">
      <view class="tip tip--err">{{errMsg}}</view>
      <button class="btn" bindtap="onRetry">{{loginError ? '重新登录' : '重新加载'}}</button>
    </view>
    <block wx:if="{{!needMember && info && !loginError}}">
      <view class="card">
        <view class="tname">{{info.templateName}}</view>
        <view class="tmemo" wx:if="{{info.templateMemo}}">{{info.templateMemo}}</view>
      </view>
      <view class="card" wx:if="{{doneCode || info.claimed}}">
        <view class="ok">已领取</view>
        <view class="ok-sub" wx:if="{{doneCode}}">券码 {{doneCode}}</view>
        <button class="btn" bindtap="onGoMyTickets">去我的优惠券</button>
      </view>
      <view class="card" wx:elif="{{info.soldOut}}">
        <view class="tip tip--err">{{info.shareType == 'personal' ? '这张券已经被别人领走了' : '这次分享的券已经领完了'}}</view>
      </view>
      <view class="card" wx:else>
        <button class="btn" loading="{{claiming}}" disabled="{{claiming}}" bindtap="onClaim">领取优惠券</button>
      </view>
    </block>
  </block>
</view>
