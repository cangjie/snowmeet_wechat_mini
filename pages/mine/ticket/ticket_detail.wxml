<!--pages/mine/ticket/ticket_detail.wxml-->
<view class="ticket-page">

  <view class="ticket-card">
    <!-- 券种 banner 作页头，与列表页同一套配色；失效统一降灰 -->
    <view class="tk-banner tk-banner--{{ticket.bannerCls}} {{ticket.muted ? 'tk-banner--muted' : ''}}">
      <text class="tk-banner-kind">{{ticket.bannerLabel}}</text>
      <text class="tk-banner-name">{{ticket.name}}</text>
    </view>
    <view class="detail-body {{ticket.muted ? 'stub-row--muted' : ''}}">
      <view class="card-header">
        <view class="status-tag {{ticket.statusClass}}">{{ticket.statusText}}</view>
      </view>
      <text class="meta-line {{ticket.expireUrgent ? 'meta-line--urgent' : ''}}">{{ticket.metaLine}}</text>
      <text class="code-time-line">{{ticket.codeTimeLine}}</text>
      <rich-text class="usage-rich" wx:if="{{ticket.rich}}" nodes="{{ticket.memo}}"></rich-text>
      <view class="usage-block" wx:elif="{{ticket.usage.length > 0}}">
        <view class="usage-item" wx:for="{{ticket.usage}}" wx:for-item="u" wx:key="*this">· {{u}}</view>
      </view>
    </view>
  </view>

  <view class="card-actions" wx:if="{{ticket.canCancelShare}}">
    <button class="btn btn-cancel-share" bindtap="onCancelShare">撤回分享</button>
  </view>
  <view class="card-actions" wx:elif="{{ticket.canTransfer}}">
    <button class="btn btn-use" bindtap="onTransferTap">转赠好友</button>
  </view>

  <view class="qr-card" wx:if="{{ticket.used == 0 && ticket.actionable}}">
    <text class="qr-card-title">核销二维码</text>
    <image class="qr-card-image" src="{{qrCodeUrl}}" mode="widthFix"></image>
    <text class="qr-card-code">{{ticket.code}}</text>
  </view>

</view>

<!-- 转赠确认弹层：订阅授权走完之后才弹，里面这个才是真正拉起微信转发面板的按钮 -->
<view class="tr-mask" wx:if="{{transferShow}}" bindtap="onTransferPanelClose" catchtouchmove="onNoop">
  <view class="tr-panel" catchtap="onNoop">
    <view class="tr-title">转赠优惠券</view>
    <view class="tr-desc">选择好友后，对方需关注公众号才能领取。领取成功会通知你，并回赠你一张同款券。</view>
    <view class="tr-warn" wx:if="{{subscribeBlocked}}">
      你之前选择了不再接收提醒，对方领取后将收不到通知。<text class="tr-warn-link" catchtap="onOpenSubscribeSetting">去开启</text>
    </view>
    <button class="tr-share-btn" open-type="share" bindtap="onTransferPanelShareTap">选择好友</button>
    <view class="tr-cancel" bindtap="onTransferPanelClose">取消</view>
  </view>
</view>
<!-- 未验证手机号：整页盖死，只留「授权」和「返回」两条路。
     catchtap + catchtouchmove 吃掉所有穿透，遮罩本身点不掉 -->
<view class="auth-mask" wx:if="{{needAuth}}" catchtap="onNoop" catchtouchmove="onNoop">
  <view class="auth-panel">
    <view class="auth-title">需要验证手机号</view>
    <view class="auth-desc">优惠券绑定在你的手机号上。验证后才能查看券面和核销二维码，也方便你换设备后仍能找到它。</view>
    <button class="auth-btn" loading="{{authBusy}}"
      open-type="getPhoneNumber" bindgetphonenumber="onGetCell">授权手机号</button>
    <view class="auth-cancel" catchtap="onAuthBack">返回</view>
  </view>
</view>
