<!--pages/mine/ticket/ticket_detail.wxml-->
<view class="container">

  <view class="ticket-card {{ticket.used == 1 ? 'ticket-card--used' : ''}}">
    <view class="card-header">
      <text class="ticket-title">{{ticket.name}}</text>
      <view class="status-tag {{ticket.statusClass}}">{{ticket.statusText}}</view>
    </view>
    <rich-text class="usage-rich" wx:if="{{ticket.rich}}" nodes="{{ticket.memo}}"></rich-text>
    <view class="usage-block" wx:else>
      <view class="usage-item" wx:for="{{ticket.usage}}" wx:for-item="u" wx:key="*this">· {{u}}</view>
    </view>
  </view>

  <view class="card-actions" wx:if="{{ticket.canTransfer}}">
    <button open-type="share" class="btn btn-use">转赠好友</button>
  </view>

  <view class="qr-card" wx:if="{{ticket.used == 0}}">
    <text class="qr-card-title">核销二维码</text>
    <image class="qr-card-image" src="{{qrCodeUrl}}" mode="widthFix"></image>
    <text class="qr-card-code">{{ticket.code}}</text>
  </view>

</view>
<!--auth wx:if="{{needAuth}}" validType="cell" bindUpdateSuccess="AuthFinish" ></auth-->
