<view class="ticket-page">

  <!-- 顶部 Tab 导航 -->
  <view class="tab-nav">
    <navigator class="tab-item {{activeTab == 'pending' ? 'tab-active' : 'tab-inactive'}}" url="ticket_list?tab=pending" open-type="redirect" hover-class="none">
      未使用<text class="tab-badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</text>
    </navigator>
    <navigator class="tab-item {{activeTab == 'used' ? 'tab-active' : 'tab-inactive'}}" url="ticket_list?tab=used" open-type="redirect" hover-class="none">已使用</navigator>
    <navigator class="tab-item {{activeTab == 'shared' ? 'tab-active' : 'tab-inactive'}}" url="ticket_list?tab=shared" open-type="redirect" hover-class="none">已分享</navigator>
  </view>

  <!-- 汇总行：仅未使用 tab -->
  <view class="list-summary" wx:if="{{summaryText}}">
    <text class="summary-text">{{summaryText}}</text>
    <text class="summary-sort" bindtap="onToggleSort">{{sortLabel}} ⌄</text>
  </view>

  <!-- 优惠券列表 -->
  <view wx:for="{{ticketArr}}" wx:key="code" class="ticket-card">

    <!-- 券种通栏 banner：底色 + 几何图案按券种区分，失效统一降灰。
         券名放这里（原设计稿这里右侧还有个 ¥ 金额，已按业务要求全站去掉） -->
    <view class="tk-banner tk-banner--{{item.bannerCls}} {{item.muted ? 'tk-banner--muted' : ''}}"
          id="{{item.code}}" bindtap="showDetail">
      <text class="tk-banner-kind">{{item.bannerLabel}}</text>
      <text class="tk-banner-name">{{item.name}}</text>
    </view>

    <view class="stub-row {{item.muted ? 'stub-row--muted' : ''}}" id="{{item.code}}" bindtap="showDetail">
      <view class="stub-main">
        <view class="card-header">
          <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
        </view>
        <text class="meta-line {{item.expireUrgent ? 'meta-line--urgent' : ''}}">{{item.metaLine}}</text>
        <text class="code-time-line">{{item.codeTimeLine}}</text>
      </view>
    </view>

    <!-- 使用说明：默认收起，没有说明的券整行不显示 -->
    <block wx:if="{{item.hasUsage}}">
      <view class="usage-toggle" data-code="{{item.code}}" bindtap="onToggleUsage">
        <text class="usage-toggle-label">使用说明<text wx:if="{{item.usageCount > 0}}"> · {{item.usageCount}} 条</text></text>
        <text class="usage-toggle-arrow">{{expandedCode == item.code ? '收起 ⌃' : '展开 ⌄'}}</text>
      </view>
      <view class="usage-panel" wx:if="{{expandedCode == item.code}}">
        <rich-text class="usage-rich" wx:if="{{item.rich}}" nodes="{{item.memo}}"></rich-text>
        <block wx:else>
          <view class="usage-item" wx:for="{{item.usage}}" wx:for-item="u" wx:key="*this">· {{u}}</view>
        </block>
      </view>
    </block>

    <view class="card-actions" wx:if="{{item.canCancelShare}}">
      <button size="mini" class="btn btn-cancel-share" bindtap="onCancelShare" data-code="{{item.code}}">撤回分享</button>
    </view>
    <view class="card-actions" wx:elif="{{item.canTransfer}}">
      <button size="mini" class="btn btn-use" bindtap="onTransferTap" data-code="{{item.code}}">转赠好友</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{ticketArr.length == 0}}">
    <view class="empty-icon-box"><view class="empty-icon-inner"></view></view>
    <text class="empty-title">这里还没有券</text>
    <text class="empty-text">到店养护或参与活动可获得体验券</text>
  </view>

</view>

<!-- 转赠确认弹层：订阅授权走完之后才弹，里面这个才是真正拉起微信转发面板的按钮 -->
<view class="tr-mask" wx:if="{{transferShow}}" bindtap="onTransferPanelClose" catchtouchmove="onNoop">
  <view class="tr-panel" catchtap="onNoop">
    <view class="tr-title">转赠优惠券</view>
    <view class="tr-desc">选择好友后，对方需关注公众号才能领取。领取成功会通知你，并回赠你一张同款券。</view>
    <view class="tr-warn" wx:if="{{subscribeBlocked}}">
      你之前选择了不再接收提醒，对方领取后将收不到通知。<text class="tr-warn-link" catchtap="onOpenSubscribeSetting">去开启</text>
    </view>
    <button class="tr-share-btn" open-type="share" data-code="{{transferCode}}" bindtap="onTransferPanelShareTap">选择好友</button>
    <view class="tr-cancel" bindtap="onTransferPanelClose">取消</view>
  </view>
</view>
<!--auth wx:if="{{needAuth}}" validType="cell" bindUpdateSuccess="AuthFinish" ></auth-->
