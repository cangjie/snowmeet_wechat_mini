<view class="ticket-page">

  <!-- 顶部 Tab 导航 -->
  <view class="tab-nav">
    <navigator class="tab-item {{activeTab == 'pending' ? 'tab-active' : 'tab-inactive'}}" url="ticket_list?tab=pending" open-type="redirect" hover-class="none">未使用</navigator>
    <navigator class="tab-item {{activeTab == 'used' ? 'tab-active' : 'tab-inactive'}}" url="ticket_list?tab=used" open-type="redirect" hover-class="none">已使用</navigator>
    <navigator class="tab-item {{activeTab == 'shared' ? 'tab-active' : 'tab-inactive'}}" url="ticket_list?tab=shared" open-type="redirect" hover-class="none">已分享</navigator>
  </view>

  <!-- 优惠券列表 -->
  <view wx:for="{{ticketArr}}" wx:key="code" class="ticket-card {{item.used == 1 ? 'ticket-card--used' : ''}}">
    <view id="{{item.code}}" bindtap="showDetail">
      <view class="card-header">
        <text class="ticket-title">{{item.name}}</text>
        <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <text class="ticket-code">{{item.codeDisplay}}</text>
      <rich-text class="usage-rich" wx:if="{{item.rich}}" nodes="{{item.memo}}"></rich-text>
      <view class="usage-block" wx:else>
        <view class="usage-item" wx:for="{{item.usage}}" wx:for-item="u" wx:key="*this">· {{u}}</view>
      </view>
    </view>
    <view class="card-actions" wx:if="{{item.canCancelShare}}">
      <button size="mini" class="btn btn-cancel-share" bindtap="onCancelShare" data-code="{{item.code}}">撤回分享</button>
    </view>
    <view class="card-actions" wx:elif="{{item.canTransfer}}">
      <button size="mini" class="btn btn-use" open-type="share" data-code="{{item.code}}">转赠好友</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{ticketArr.length == 0}}">
    <text class="empty-icon">🎟️</text>
    <text class="empty-text">暂无优惠券</text>
  </view>

</view>
<!--auth wx:if="{{needAuth}}" validType="cell" bindUpdateSuccess="AuthFinish" ></auth-->
