/* pages/mine/ticket/ticket_detail.wxss */
@import "./ticket_card.wxss";

/* ===== 核销二维码卡片 ===== */
.qr-card {
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 44rpx 40rpx;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

.qr-card-image {
  width: 360rpx;
  margin-bottom: 20rpx;
}

.qr-card-code {
  font-size: 24rpx;
  color: var(--color-text-muted);
  letter-spacing: 2rpx;
}

/* 转赠确认弹层：订阅授权走完之后才弹（与 ticket_list 同款） */
.tr-mask{
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45); z-index: 100;
  display: flex; align-items: flex-end;
}
.tr-panel{
  width: 100%; background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.tr-title{ font-size: 34rpx; font-weight: 600; color: #333; text-align: center; }
.tr-desc{
  font-size: 26rpx; color: #888; line-height: 1.6;
  margin: 20rpx 0 36rpx; text-align: center;
}
.tr-share-btn{
  background: #2EA6D0; color: #fff; border-radius: 12rpx;
  font-size: 30rpx; line-height: 84rpx; height: 84rpx;
}
.tr-share-btn::after{ border: none; }
.tr-cancel{
  margin-top: 20rpx; text-align: center;
  font-size: 30rpx; color: #888; line-height: 72rpx;
}
