/* pages/mine/ticket/ticket_claim/ticket_claim.wxss */
page { background: #F5F6FA; }
.page { padding: 24rpx; box-sizing: border-box; }

.card {
  background: #fff; border-radius: 16rpx;
  padding: 32rpx 24rpx; margin-bottom: 20rpx;
}
.tname { font-size: 34rpx; color: #333; font-weight: 600; }
.tmemo { font-size: 26rpx; color: #6B7280; line-height: 1.6; margin-top: 12rpx; }

.tip { text-align: center; color: #9AA0AC; font-size: 28rpx; padding: 60rpx 0; }
.tip--err { color: #D9534F; }

.qr-title { text-align: center; font-size: 28rpx; color: #333; padding-bottom: 20rpx; }
.qr { width: 420rpx; display: block; margin: 0 auto; }
.qr-hint {
  text-align: center; font-size: 22rpx; color: #9AA0AC;
  line-height: 1.6; padding-top: 20rpx;
}

.ok { text-align: center; font-size: 32rpx; color: #2EA6D0; font-weight: 600; }
.ok-sub { text-align: center; font-size: 26rpx; color: #6B7280; padding: 12rpx 0 24rpx; }

.btn {
  background: #2EA6D0; color: #fff;
  font-size: 30rpx; border-radius: 12rpx;
}
