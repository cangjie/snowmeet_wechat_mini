/* pages/mine/ticket/ticket_list.wxss */
@import "./ticket_card.wxss";

/* ===== Tab 导航 ===== */
.tab-nav {
  display: flex;
  background: #E4E7EF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tab-active {
  background: var(--color-white);
  color: var(--color-blue);
  box-shadow: 0 4rpx 20rpx rgba(37, 99, 235, 0.12);
}

.tab-inactive {
  color: var(--color-text-secondary);
}

/* 转赠确认弹层：订阅授权走完之后才弹 */
.tr-mask{
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45); z-index: 100;
  display: flex; align-items: flex-end;
}
.tr-panel{
  width: 100%; background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.tr-title{ font-size: 34rpx; font-weight: 600; color: #333; text-align: center; }
.tr-desc{
  font-size: 26rpx; color: #888; line-height: 1.6;
  margin: 20rpx 0 36rpx; text-align: center;
}
.tr-share-btn{
  background: #2EA6D0; color: #fff; border-radius: 12rpx;
  font-size: 30rpx; line-height: 84rpx; height: 84rpx;
}
.tr-share-btn::after{ border: none; }
.tr-cancel{
  margin-top: 20rpx; text-align: center;
  font-size: 30rpx; color: #888; line-height: 72rpx;
}
