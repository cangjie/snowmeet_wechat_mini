/* pages/mine/ticket/ticket_list.wxss */
@import "./ticket_card.wxss";

/* ===== Tab 导航 ===== */
.tab-nav {
  display: flex;
  background: #E4E7EF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  /* 四个 tab（未使用 / 已使用 / 已分享 / 已接受）并排，字号和间距比三个 tab 时小一点，未使用的数量角标才放得下 */
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

/* 未使用 tab 的数量角标。三个 tab 是 redirect 各自重新加载页面，
   站在别的 tab 上拿不到未使用张数，所以只在未使用 tab 上显示 */
.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-blue);
  color: var(--color-white);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

/* 汇总行：仅未使用 tab */
.list-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.summary-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-sort {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-blue);
}

.tab-active {
  background: var(--color-white);
  color: var(--color-blue);
  box-shadow: 0 4rpx 20rpx rgba(37, 99, 235, 0.12);
}

.tab-inactive {
  color: var(--color-text-secondary);
}

/* 转赠确认弹层：订阅授权走完之后才弹 */
.tr-mask{
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45); z-index: 100;
  display: flex; align-items: flex-end;
}
.tr-panel{
  width: 100%; background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.tr-title{ font-size: 34rpx; font-weight: 600; color: #333; text-align: center; }
.tr-desc{
  font-size: 26rpx; color: #888; line-height: 1.6;
  margin: 20rpx 0 36rpx; text-align: center;
}
.tr-share-btn{
  background: #2EA6D0; color: #fff; border-radius: 12rpx;
}
.tr-share-btn::after{ border: none; }
.tr-cancel{
  margin-top: 20rpx; text-align: center;
  font-size: 30rpx; color: #888; line-height: 72rpx;
}
.tr-warn{
  background: #FFF7E6; color: #A15C00;
  font-size: 24rpx; line-height: 1.6;
  padding: 16rpx 20rpx; border-radius: 8rpx;
  margin-bottom: 24rpx;
}
.tr-warn-link{ color: #2EA6D0; text-decoration: underline; margin-left: 6rpx; }

/* ===== 同一券种合并的汇总卡（「免费打蜡券 × N」，点开看每一张） ===== */
.group-card {
  background: var(--color-white);
  border-radius: var(--radius-card);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}
.group-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.group-count {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-blue);
  white-space: nowrap;
}
.tk-banner--muted .group-count { color: #6B7280; }
.group-summary {
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.group-summary-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.group-summary-line {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.group-arrow {
  font-size: 24rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
}
/* 展开后组里的每一张：缩进一点，和组头区分开 */
.ticket-card--in-group {
  margin-left: 28rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}
