<!--pages/mine/ticket/ticket_share.wxml-->
<view class="ticket-page">

  <view class="ticket-card">
    <view class="card-header">
      <text class="ticket-title">{{ticket.name}}</text>
    </view>
    <view class="usage-block">
      <view class="usage-item" wx:for="{{ticket.usage}}" wx:for-item="u" wx:key="*this">· {{u}}</view>
    </view>
  </view>

  <view wx:if="{{checking}}" class="share-panel share-loading">
    <text class="loading-text">正在查询关注状态...</text>
  </view>

  <view wx:elif="{{!followed}}" class="share-panel qr-panel">
    <text class="qr-tip">长按识别下方二维码关注公众号</text>
    <text class="qr-tip qr-tip-sub">关注后将自动为您接受这张优惠券</text>
    <image class="qr-image" show-menu-by-longpress src="{{qrCodeUrl}}"></image>
    <text class="qr-status">{{accepting ? '已关注，正在为您接受...' : '还未关注，请扫码关注后自动接收'}}</text>
  </view>

  <view wx:else class="share-panel accept-panel">
    <text class="followed-tip">已关注公众号 ✓</text>
    <button class="btn btn-use" bindtap="accept" disabled="{{accepting}}" loading="{{accepting}}">{{accepting ? '正在接受...' : '接 受'}}</button>
  </view>

</view>
