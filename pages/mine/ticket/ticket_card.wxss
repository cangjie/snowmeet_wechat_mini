/* pages/mine/ticket/ticket_card.wxss
   与 pages/mine/skipass/my_skipasses.wxss 同一套新版样式规范（客户端"我的X"系列页面），
   转赠/优惠券列表与详情页共用，通过 @import 引入。 */

page {
  --color-bg: #F0F2F7;
  --color-white: #ffffff;
  --color-blue: #2563EB;
  --color-blue-light: #EFF4FF;
  --color-danger: #EF4444;
  --color-text-primary: #111827;
  --color-text-secondary: #6B7280;
  --color-text-muted: #9CA3AF;
  --color-border: #E5E7EB;
  --color-gray-light: #F3F4F6;
  --radius-card: 36rpx;
  --radius-btn: 999rpx;
  --shadow-card: 0 4rpx 40rpx rgba(0, 0, 0, 0.06);
  background-color: var(--color-bg);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.ticket-page {
  min-height: 100vh;
  padding: 40rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 票券卡片 ===== */
.ticket-card {
  background: var(--color-white);
  border-radius: var(--radius-card);
  /* 内边距下放到各分区（票根行 / 说明 / 按钮），让「使用说明」的分隔线能通栏 */
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* ===== 券主体 =====
   原设计稿这里有个左侧 ¥ 面额票根 + 虚线打孔，因为优惠券绝大多数是 0 元、
   打折券的力度又随商品而变，金额表达不了信息，已整列移除 */
.stub-row {
  padding: 36rpx 36rpx 0;
  display: flex;
}

.stub-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 28rpx;
}

.meta-line {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.meta-line--urgent {
  color: var(--color-danger);
  font-weight: 600;
}

.code-time-line {
  font-size: 22rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.8rpx;
  line-height: 1.4;
}

/* ===== 使用说明折叠 ===== */
.usage-toggle {
  border-top: 1rpx solid var(--color-gray-light);
  padding: 24rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.usage-toggle-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.usage-toggle-arrow {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.usage-panel {
  padding: 0 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ticket-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-blue) 0%, #7CB9F4 100%);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  opacity: 0.6;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.ticket-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  flex: 1;
}

.ticket-code {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.status-tag {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.status-pending {
  background: var(--color-blue-light);
  color: var(--color-blue);
}

.status-shared {
  background: #FEF3C7;
  color: #B45309;
}

.status-used {
  background: var(--color-gray-light);
  color: var(--color-text-muted);
}

.status-accepted {
  background: #DCFCE7;
  color: #15803D;
}

/* ===== 使用说明 ===== */
.usage-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 券卡片上那行时间：未使用=领取/获得时间，已使用=核销时间，
   已分享=分享时间或对方领取时间。文案和数值都由后端按所在 tab 算好下发。 */
.ticket-time {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.ticket-time-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-right: 12rpx;
}

.ticket-time-value {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.usage-item {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.usage-rich {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ===== 操作按钮 ===== */
.card-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 36rpx 36rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.85;
}

.btn-use {
  background: var(--color-blue);
  color: var(--color-white);
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.3);
}

.btn-cancel-share {
  background: #FEF3C7;
  color: #B45309;
}

/* ===== 空状态 ===== */
.empty-state {
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 104rpx 48rpx;
  gap: 24rpx;
}

.empty-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--color-blue-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 4rpx dashed var(--color-blue);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* ═══ 券种 banner ═══
   每个券种一套「底色 + 几何图案」。全部是 repeating-linear-gradient / radial-gradient，
   不出图，新增券种只要加一条 class。
   图案透明度 ≤20%，保证正文压在上面仍有足够对比度。
   券种由后端 TicketTransferRules.ResolveBanner 按券名判定，四个页面共用同一口径。 */
.tk-banner {
  padding: 28rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tk-banner-kind {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.tk-banner-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

/* 机打蜡 · 主蓝 · 45° 细斜纹 */
.tk-banner--wax {
  background-color: #EFF4FF;
  background-image: repeating-linear-gradient(45deg, rgba(37,99,235,.13) 0 14rpx, transparent 14rpx 30rpx);
}
.tk-banner--wax .tk-banner-kind { color: #1D4FD7; }

/* 热打蜡 · 暖橙 · 热扩散同心弧 */
.tk-banner--hotwax {
  background-color: #FFF1E7;
  background-image:
    radial-gradient(circle at 92% 128%, transparent 80rpx, rgba(234,88,12,.15) 80rpx 84rpx, transparent 84rpx),
    radial-gradient(circle at 92% 128%, transparent 128rpx, rgba(234,88,12,.13) 128rpx 132rpx, transparent 132rpx),
    radial-gradient(circle at 92% 128%, transparent 176rpx, rgba(234,88,12,.11) 176rpx 180rpx, transparent 180rpx);
}
.tk-banner--hotwax .tk-banner-kind { color: #C2410C; }

/* 修刃 · 钢青 · 刻度竖线 */
.tk-banner--edge {
  background-color: #E6F5F3;
  background-image: repeating-linear-gradient(90deg, rgba(15,118,110,.16) 0 4rpx, transparent 4rpx 26rpx);
}
.tk-banner--edge .tk-banner-kind { color: #0F766E; }

/* 双项 · 蓝紫 · 交叉网格 */
.tk-banner--dual {
  background-color: #EEF0FF;
  background-image:
    repeating-linear-gradient(45deg, rgba(67,56,202,.12) 0 4rpx, transparent 4rpx 24rpx),
    repeating-linear-gradient(-45deg, rgba(67,56,202,.12) 0 4rpx, transparent 4rpx 24rpx);
}
.tk-banner--dual .tk-banner-kind { color: #4338CA; }

/* 雪票 / 体验 · 天蓝 · 雪粒点阵 */
.tk-banner--pass {
  background-color: #E8F5FE;
  background-image: radial-gradient(circle, rgba(2,132,199,.20) 3rpx, transparent 3.2rpx);
  background-size: 28rpx 28rpx;
}
.tk-banner--pass .tk-banner-kind { color: #0369A1; }

/* 课程 · 石墨 · 宽斜条 */
.tk-banner--course {
  background-color: #F1F5F9;
  background-image: repeating-linear-gradient(-45deg, rgba(51,65,85,.10) 0 20rpx, transparent 20rpx 44rpx);
}
.tk-banner--course .tk-banner-kind { color: #334155; }

/* 代金 · 琥珀 · 横向细纹 */
.tk-banner--cash {
  background-color: #FEF3C7;
  background-image: repeating-linear-gradient(180deg, rgba(180,83,9,.13) 0 4rpx, transparent 4rpx 32rpx);
}
.tk-banner--cash .tk-banner-kind { color: #B45309; }

/* 失效态：任何券种失效后统一降灰。
   注意用的是"换灰底 + 文字降色"，不是整卡 opacity——后者会把小字压到读不清。 */
.tk-banner--muted {
  background-color: #F3F4F6 !important;
  background-image: repeating-linear-gradient(45deg, rgba(107,114,128,.20) 0 14rpx, transparent 14rpx 30rpx) !important;
}
.tk-banner--muted .tk-banner-kind { color: #6B7280 !important; }
.tk-banner--muted .tk-banner-name { color: #6B7280; }

/* 失效卡片正文降色（配合 .tk-banner--muted，取代原来的整卡 opacity） */
.stub-row--muted .ticket-title,
.stub-row--muted .meta-line,
.stub-row--muted .code-time-line { color: var(--color-text-secondary); }

/* 券详情页正文（banner 下方） */
.detail-body {
  padding: 32rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
