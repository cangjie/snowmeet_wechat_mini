/* pages/mine/ticket/ticket_card.wxss
   与 pages/mine/skipass/my_skipasses.wxss 同一套新版样式规范（客户端"我的X"系列页面），
   转赠/优惠券列表与详情页共用，通过 @import 引入。 */

page {
  --color-bg: #F0F2F7;
  --color-white: #ffffff;
  --color-blue: #2563EB;
  --color-blue-light: #EFF4FF;
  --color-danger: #EF4444;
  --color-text-primary: #111827;
  --color-text-secondary: #6B7280;
  --color-text-muted: #9CA3AF;
  --color-border: #E5E7EB;
  --color-gray-light: #F3F4F6;
  --radius-card: 36rpx;
  --radius-btn: 999rpx;
  --shadow-card: 0 4rpx 40rpx rgba(0, 0, 0, 0.06);
  background-color: var(--color-bg);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.ticket-page {
  min-height: 100vh;
  padding: 40rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 票券卡片 ===== */
.ticket-card {
  background: var(--color-white);
  border-radius: var(--radius-card);
  /* 内边距下放到各分区（票根行 / 说明 / 按钮），让「使用说明」的分隔线能通栏 */
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

/* ===== 票根布局：左侧面额 · 虚线打孔 · 右侧信息 ===== */
.stub-row {
  padding: 36rpx 36rpx 0;
  display: flex;
  gap: 32rpx;
  align-items: stretch;
}

.stub {
  width: 148rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0 16rpx;
}

.stub-value {
  display: flex;
  align-items: baseline;
}

.stub-yuan {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-blue);
}

.stub-num {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--color-blue);
  letter-spacing: -1rpx;
  line-height: 1;
}

/* 已使用/已被领取的券整卡降透明度，这里不再单独变灰，避免叠加后过淡 */

.stub-divider {
  width: 0;
  position: relative;
  flex-shrink: 0;
}

/* 打孔：卡片 overflow:hidden 会把圆孔切掉一半，正好是纸质票根被撕开的样子 */
.punch {
  position: absolute;
  left: -10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
}

.punch--top { top: -40rpx; }
.punch--bottom { bottom: -10rpx; }

.punch-line {
  position: absolute;
  top: 4rpx;
  bottom: 12rpx;
  left: 0;
  border-left: 1rpx dashed var(--color-border);
}

.stub-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 28rpx;
}

.meta-line {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.meta-line--urgent {
  color: var(--color-danger);
  font-weight: 600;
}

.code-time-line {
  font-size: 22rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.8rpx;
  line-height: 1.4;
}

/* ===== 使用说明折叠 ===== */
.usage-toggle {
  border-top: 1rpx solid var(--color-gray-light);
  padding: 24rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.usage-toggle-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.usage-toggle-arrow {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.usage-panel {
  padding: 0 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ticket-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-blue) 0%, #7CB9F4 100%);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  opacity: 0.6;
}

.ticket-card--used {
  opacity: 0.6;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.ticket-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  flex: 1;
}

.ticket-code {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.status-tag {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.status-pending {
  background: var(--color-blue-light);
  color: var(--color-blue);
}

.status-shared {
  background: #FEF3C7;
  color: #B45309;
}

.status-used {
  background: var(--color-gray-light);
  color: var(--color-text-muted);
}

.status-accepted {
  background: #DCFCE7;
  color: #15803D;
}

/* ===== 使用说明 ===== */
.usage-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 券卡片上那行时间：未使用=领取/获得时间，已使用=核销时间，
   已分享=分享时间或对方领取时间。文案和数值都由后端按所在 tab 算好下发。 */
.ticket-time {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.ticket-time-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-right: 12rpx;
}

.ticket-time-value {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.usage-item {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.usage-rich {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ===== 操作按钮 ===== */
.card-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 36rpx 36rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.85;
}

.btn-use {
  background: var(--color-blue);
  color: var(--color-white);
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.3);
}

.btn-cancel-share {
  background: #FEF3C7;
  color: #B45309;
}

/* ===== 空状态 ===== */
.empty-state {
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 104rpx 48rpx;
  gap: 24rpx;
}

.empty-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--color-blue-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 4rpx dashed var(--color-blue);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
  text-align: center;
}
