<view class="page">
  <view class="card">
    <view class="section-title">我的次卡</view>
    <view wx:if="{{!loading && cards.length == 0}}" class="empty-tip">暂无次卡</view>
    <view class="pcard-row" wx:for="{{cards}}" wx:key="id">
      <view class="pcard-name">{{item.card_name}}</view>
      <view class="pcard-remain">{{item.remainingStr}}</view>
    </view>
  </view>
  <view class="buy-btn" bindtap="onBuyCard">购买次卡</view>
</view>
