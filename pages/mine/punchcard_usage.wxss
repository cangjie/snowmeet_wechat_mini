/* 视觉与 my_punchcards 保持一致（同一套白卡 + 竖条标题 + #2EA6D0 主色） */
@import '/app.wxss';

.page {
  background: #F8F8F8;
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 12rpx 0;
  margin-bottom: 4rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #2EA6D0;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

/* 卡片摘要 */
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
  font-size: 30rpx;
}

.head-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.head-remain {
  color: #2EA6D0;
  font-weight: 600;
}

.biz {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.biz--rent { background: #e3f2fb; color: #006495; }
.biz--care { background: #e3f6ee; color: #047857; }

.head-sub {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  padding-bottom: 12rpx;
}

.head-sub-date { color: #bbb; }

/* 已退款：整卡灰化（底色、卡名、业务角标、副行一起降下去），配合右上角「已退款」标记，
   不用读文字也能看出这张卡已经不可用 */
.card--refunded { background: #f5f5f5; }
.card--refunded .head-name { color: #9ca3af; }
.card--refunded .biz { background: #e5e7eb; color: #9ca3af; }
.card--refunded .head-sub { color: #b8bcc2; }
.card--refunded .head-sub-date { color: #c8ccd2; }

.head-refunded {
  font-size: 24rpx;
  font-weight: 600;
  color: #9ca3af;
  background: #e5e7eb;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 退款入口：描边红按钮（危险动作但不是本页主操作，实心红太抢） */
.refund-tip {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  padding: 12rpx 0;
}

.refund-tip--staff { color: #999; }

.refund-btn {
  margin: 8rpx 0 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #FFFFFF;
  color: #E64340;
  border: 1rpx solid #E64340;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.refund-btn--disabled {
  color: #d9a5a3;
  border-color: #e8c4c3;
}

/* 顾客信息 / 绑定装备（仅店员模式） */
.kv {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
}
.kv:last-child { border-bottom: none; }
.kv-k { color: #666; }
.kv-v { color: #1a1a1a; font-weight: 600; }

.fgroup { display: flex; align-items: center; gap: 20rpx; padding: 14rpx 0; }
.fl { font-size: 28rpx; color: #666; width: 160rpx; flex-shrink: 0; }
.fi {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  font-size: 28rpx;
}
/* 装备类型双选：与养护开单的类型按钮同款（选中实心主色） */
.etype { flex: 1; display: flex; gap: 16rpx; }
.etype-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #FFFFFF;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
}
.etype-btn--active {
  background: #2EA6D0;
  border-color: #2EA6D0;
  color: #fff;
  font-weight: 600;
}

/* 品牌 picker：外观与相邻的输入框一致，点开是系统选择器 */
.fi-wrap { flex: 1; }
.fi--picker { line-height: 70rpx; }
.fi--placeholder { color: #b0b4ba; }

.equip-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  padding: 8rpx 0 0;
}

/* 新增品牌弹窗 */
.bmodal { padding: 32rpx 32rpx 24rpx; }
.bmodal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}
.bmodal-input { display: block; width: 100%; margin-bottom: 20rpx; }
.bmodal-btns { display: flex; gap: 20rpx; margin-top: 12rpx; }
.bmodal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
}
.bmodal-btn--primary {
  background: #2EA6D0;
  border-color: #2EA6D0;
  color: #fff;
  font-weight: 600;
}

.save-btn {
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #2EA6D0;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.save-btn--disabled { background: #cfd4d9; }

/* 核销记录行 */
.urow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.urow:last-child { border-bottom: none; }

.ucol { flex: 1; min-width: 0; }

.ucode {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  word-break: break-all;
}

.udate {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.ucount {
  font-size: 28rpx;
  color: #2EA6D0;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}
