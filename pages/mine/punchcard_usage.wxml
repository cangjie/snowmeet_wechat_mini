<view class="page">

  <!-- 卡片摘要：卡名 + 业务角标 + 剩余，和「我的次卡」列表口径一致。
       已退款的卡整卡置灰、右上角换成「已退款」标记，一眼看出这张卡不能用了 -->
  <view wx:if="{{card}}" class="card {{card.isRefund ? 'card--refunded' : ''}}">
    <view class="head">
      <view class="head-name">
        <text class="biz biz--{{card.biz_type == '养护' ? 'care' : 'rent'}}">{{card.biz_type}}</text>
        <text>{{card.card_name}}</text>
      </view>
      <view wx:if="{{card.isRefund}}" class="head-refunded">已退款</view>
      <view wx:else class="head-remain">{{card.remainingStr}}</view>
    </view>
    <view class="head-sub">
      <text wx:if="{{!card.isSeason}}">总 {{card.total}} 次 · 已核销 {{usedTotal}} 次</text>
      <text wx:else>不限次数 · 已核销 {{usedTotal}} 次</text>
      <text class="head-sub-date">开卡 {{card.createDateStr}}</text>
    </view>
  </view>

  <!-- 退款入口只在服务端判定「可自助退款」时出现（一次未核销 + 微信/支付宝支付）。
       不能自助退时一律把原因写出来：一张没用过的卡却没有退款按钮，不解释顾客必然来问
       （赠送发放的卡没有支付记录、现金支付要走人工，都属于这类）。
       唯一不写的是卡本身已退款——卡片已经整块灰掉并标了「已退款」，再补一句是重复。 -->
  <view wx:if="{{!loading && refund.canRefund}}" class="card">
    <view class="refund-tip">这张卡还没有使用过，可以申请退款，款项按原路退回支付账户。</view>
    <view class="refund-btn {{refunding ? 'refund-btn--disabled' : ''}}" bindtap="onRefundTap">
      {{refunding ? '退款中…' : '申请退款 ' + refundAmountStr}}
    </view>
  </view>
  <view wx:elif="{{!loading && refund.blockReason && !refund.isRefund}}" class="card">
    <view class="refund-tip refund-tip--staff">{{refund.blockReason}}</view>
  </view>

  <view class="card">
    <view class="section-title">核销记录</view>

    <view wx:if="{{loading}}" class="tip">加载中…</view>
    <view wx:elif="{{usages.length == 0}}" class="tip">这张卡还没有核销记录</view>

    <block wx:else>
      <view class="urow" wx:for="{{usages}}" wx:key="orderId">
        <view class="ucol">
          <view class="ucode">{{item.orderCode}}</view>
          <view class="udate">{{item.bizDateStr}}</view>
        </view>
        <view class="ucount">核销 {{item.punchCount}} 次</view>
      </view>
    </block>
  </view>

</view>
