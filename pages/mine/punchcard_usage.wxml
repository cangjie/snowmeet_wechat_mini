<view class="page">

  <!-- 卡片摘要：卡名 + 业务角标 + 剩余，和「我的次卡」列表口径一致。
       已退款的卡整卡置灰、右上角换成「已退款」标记，一眼看出这张卡不能用了 -->
  <view wx:if="{{card}}" class="card {{card.isRefund ? 'card--refunded' : ''}}">
    <view class="head">
      <view class="head-name">
        <text class="biz biz--{{card.biz_type == '养护' ? 'care' : 'rent'}}">{{card.biz_type}}</text>
        <text>{{card.card_name}}</text>
      </view>
      <view wx:if="{{card.isRefund}}" class="head-refunded">已退款</view>
      <view wx:else class="head-remain">{{card.remainingStr}}</view>
    </view>
    <view class="head-sub">
      <text wx:if="{{!card.isSeason}}">总 {{card.total}} 次 · 已核销 {{usedTotal}} 次</text>
      <text wx:else>不限次数 · 已核销 {{usedTotal}} 次</text>
      <text class="head-sub-date">开卡 {{card.createDateStr}}</text>
    </view>
  </view>

  <!-- 退款入口只在服务端判定「可自助退款」时出现（一次未核销 + 微信/支付宝支付）。
       不能自助退时一律把原因写出来：一张没用过的卡却没有退款按钮，不解释顾客必然来问
       （赠送发放的卡没有支付记录、现金支付要走人工，都属于这类）。
       唯一不写的是卡本身已退款——卡片已经整块灰掉并标了「已退款」，再补一句是重复。 -->
  <view wx:if="{{!loading && refund.canRefund}}" class="card">
    <view class="refund-tip">这张卡还没有使用过，可以申请退款，款项按原路退回支付账户。</view>
    <view class="refund-btn {{refunding ? 'refund-btn--disabled' : ''}}" bindtap="onRefundTap">
      {{refunding ? '退款中…' : '申请退款 ' + refundAmountStr}}
    </view>
  </view>
  <view wx:elif="{{!loading && refund.blockReason && !refund.isRefund}}" class="card">
    <view class="refund-tip refund-tip--staff">{{refund.blockReason}}</view>
  </view>

  <!-- 顾客信息 + 购买时间：仅店员模式（管理后台按卡找人）。顾客自己看自己的卡不需要这块 -->
  <view wx:if="{{isStaff && member}}" class="card">
    <view class="section-title">顾客信息</view>
    <view class="kv"><text class="kv-k">顾客</text><text class="kv-v">{{member.displayName}}</text></view>
    <view class="kv"><text class="kv-k">手机号</text><text class="kv-v">{{member.cell || '（无手机号）'}}</text></view>
    <view class="kv"><text class="kv-k">购买/开卡时间</text><text class="kv-v">{{card.createTimeStr || card.createDateStr}}</text></view>
  </view>

  <!-- 季卡绑定装备：仅店员模式可改。开卡时按第一次养护的装备自动绑，绑错了在这里改。
       录入方式与养护开单的装备信息一致：类型双选 + 品牌 picker（可新增）+ 长度。
       三项要么全填要么全空——缺一项是残缺绑定，这张卡以后再也匹配不上装备（服务端同样拒绝） -->
  <view wx:if="{{isStaff && card && card.isSeason}}" class="card">
    <view class="section-title">绑定装备</view>
    <view class="fgroup">
      <text class="fl">装备类型</text>
      <view class="etype">
        <view class="etype-btn {{equipType == '双板' ? 'etype-btn--active' : ''}}"
              data-equip="双板" bindtap="onEquipTypeTap">双板</view>
        <view class="etype-btn {{equipType == '单板' ? 'etype-btn--active' : ''}}"
              data-equip="单板" bindtap="onEquipTypeTap">单板</view>
      </view>
    </view>
    <view class="fgroup">
      <text class="fl">品牌</text>
      <picker class="fi-wrap" range="{{brandListView}}" value="{{brandIndex}}"
              disabled="{{!equipType}}" bindchange="onBrandChange">
        <view class="fi fi--picker {{equipBrand ? '' : 'fi--placeholder'}}">
          {{equipBrand || (equipType ? '点此选择品牌' : '先选装备类型')}}
        </view>
      </picker>
    </view>
    <view class="fgroup">
      <text class="fl">长度 (cm)</text>
      <input class="fi" type="digit" value="{{equipScale}}" placeholder="如 170" bindinput="onEquipScaleInput" />
    </view>
    <view class="equip-hint">三项全部留空可让这张卡退回「未开卡」，下次养护时按当次装备重新绑定。</view>
    <view class="save-btn {{savingEquip ? 'save-btn--disabled' : ''}}" bindtap="onSaveEquip">
      {{savingEquip ? '保存中…' : '保存装备信息'}}
    </view>
  </view>

  <!-- 新增品牌：品牌库里没有的牌子当场加，加完直接选中（与养护开单同一接口同一行为） -->
  <van-popup show="{{addBrand.show}}" position="center" round custom-style="width: 560rpx;" bind:close="onAddBrandCancel">
    <view class="bmodal">
      <view class="bmodal-title">新增品牌</view>
      <input class="fi bmodal-input" placeholder="英文名称（必填）" value="{{addBrand.name}}"
             data-field="name" bindinput="onAddBrandInput" />
      <input class="fi bmodal-input" placeholder="中文名称" value="{{addBrand.chineseName}}"
             data-field="chineseName" bindinput="onAddBrandInput" />
      <view class="bmodal-btns">
        <view class="bmodal-btn" bindtap="onAddBrandCancel">取消</view>
        <view class="bmodal-btn bmodal-btn--primary" bindtap="onAddBrandConfirm">确定</view>
      </view>
    </view>
  </van-popup>

  <view class="card">
    <view class="section-title">核销记录</view>

    <view wx:if="{{loading}}" class="tip">加载中…</view>
    <view wx:elif="{{usages.length == 0}}" class="tip">这张卡还没有核销记录</view>

    <block wx:else>
      <view class="urow" wx:for="{{usages}}" wx:key="orderId">
        <view class="ucol">
          <view class="ucode">{{item.orderCode}}</view>
          <view class="udate">{{item.bizDateStr}}</view>
        </view>
        <view class="ucount">核销 {{item.punchCount}} 次</view>
      </view>
    </block>
  </view>

</view>
