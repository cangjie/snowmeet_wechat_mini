@import "/pages/payment/settle/tokens.wxss";

.page {
  min-height: 100vh;
  padding: 16px 14px 32px;
  box-sizing: border-box;
}

.info-strip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  border-radius: 12px;
  margin-bottom: 14px;
  background: linear-gradient(120deg, var(--primary), var(--tertiary));
}

.info-strip-text {
  font-size: 12.5px;
  font-weight: 600;
  color: #ffffff;
}

.card {
  background: var(--surface-container-lowest);
  border: 1px solid var(--outline-variant);
  border-radius: 14px;
  padding: 12px 14px;
  margin-bottom: 4px;
}

.section-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--on-surface);
  padding: 4px 0;
}

.section-title--pkg {
  margin: 14px 2px 10px;
}

.loading-state,
.empty-state {
  text-align: center;
  color: var(--on-surface-variant);
  font-size: 13px;
  padding: 60px 0;
}

.pkg-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pkg-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--surface-container-lowest);
  border: 1px solid var(--outline-variant);
  border-radius: 14px;
  padding: 12px;
}

.pkg-card:active {
  background: var(--surface-container-low);
}

.pkg-hero {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 12px;
  background: linear-gradient(145deg, var(--primary), var(--tertiary-container));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pkg-hero-count {
  font-family: 'Lexend', sans-serif;
  font-size: 22px;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
}

.pkg-hero-unit {
  font-size: 11px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

.pkg-body {
  flex: 1;
  min-width: 0;
}

.pkg-name {
  font-size: 15.5px;
  font-weight: 700;
  color: var(--on-surface);
  margin-bottom: 5px;
}

.pkg-shop-chip {
  display: inline-flex;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--surface-container-low);
  color: var(--on-surface-variant);
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 6px;
}

.pkg-price-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.pkg-price {
  font-family: 'Lexend', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: var(--primary);
}

.pkg-unit-price {
  font-size: 11px;
  color: var(--on-surface-variant);
}
