<!-- pages/tickets/tickets.wxml -->
<view class="container">

<!-- 顶部 Tab 导航 -->
<view class="tab-nav">
  <view
    class="tab-item {{activeTab === 'unused' ? 'tab-active' : 'tab-inactive'}}"
    bindtap="switchTab"
    data-tab="unused"
  >
    未使用 ({{unusedList.length}})
  </view>
  <view
    class="tab-item {{activeTab === 'used' ? 'tab-active' : 'tab-inactive'}}"
    bindtap="switchTab"
    data-tab="used"
  >
    已使用 ({{usedList.length}})
  </view>
</view>

<!-- 票券列表：票种、日期、手机号相同的合并成一条 × n -->
<scroll-view scroll-y class="ticket-list">
  <view
    wx:for="{{currentList}}"
    wx:key="key"
    class="ticket-card"
    style="animation-delay: {{index * 80}}ms"
  >
    <!-- 卡片头部 -->
    <view class="card-header">
      <view class="card-header-left">
        <text class="ticket-title" style="font-size: 10pt;">{{item.title}}</text>
        <text class="ticket-times" wx:if="{{item.count > 1}}">× {{item.count}}</text>
      </view>
      <view class="status-tag status-picked">{{item.statusText}}</view>
    </view>

    <view class="status-hint" wx:if="{{item.statusHint}}">{{item.statusHint}}</view>

    <!-- 只有一张时显示供应商订单号 -->
    <view class="serial-block" wx:if="{{item.serial}}">
      <text class="serial-label">Serial Number</text>
      <text class="serial-value">{{item.serial}}</text>
    </view>

    <!-- 详情信息 -->
    <view class="details-grid">
      <view class="detail-item">
        <text class="detail-label">VALID DATE</text>
        <text class="detail-value">{{item.validDate}}</text>
      </view>
      <view class="detail-item align-right">
        <text class="detail-label">PHONE</text>
        <text class="detail-value">{{item.cell}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">AMOUNT</text>
        <text class="detail-value amount">{{item.amount}}</text>
      </view>
    </view>

    <!-- 操作按钮：退票在弹层里，每张票各有一个 -->
    <view class="card-actions" wx:if="{{activeTab === 'unused'}}">
      <view
        class="btn btn-use"
        bindtap="onUseTicket"
        data-key="{{item.key}}"
      >
        立即使用{{item.count > 1 ? '（' + item.usableCount + ' 张可用）' : ''}}
      </view>
    </view>

    <!-- 已使用 / 已退票 状态遮盖 -->
    <view class="used-overlay" wx:if="{{activeTab === 'used'}}">
      <view class="used-stamp">{{item.stampText}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{currentListEmpty}}">
    <text class="empty-icon">🎫</text>
    <text class="empty-text">暂无票券</text>
  </view>
</scroll-view>

<!-- ===== 弹窗：申请取消确认 ===== -->
<view class="modal-mask {{showCancelModal ? 'modal-visible' : ''}}" bindtap="closeCancelModal">
  <view class="modal-box" catchtap="">
    <view class="modal-icon-wrap cancel-icon-wrap">
      <text class="modal-icon">⚠️</text>
    </view>
    <text class="modal-title">确认退票？</text>
    <text class="modal-desc">您即将申请取消以下票券：</text>
    <text class="modal-ticket-name">{{cancelTarget.title}}</text>
    <text class="modal-tip">退款将在 3-5 个工作日内原路返回，手续费可能不予退还。</text>
    <view class="modal-actions">
      <view class="modal-btn modal-btn-secondary" bindtap="closeCancelModal">再想想</view>
      <view class="modal-btn modal-btn-danger" bindtap="confirmCancel">确认退票</view>
    </view>
  </view>
</view>

<!-- ===== 弹窗：立即使用 - 二维码；一组多张票用标签切换，每张票有自己的二维码、状态和退票按钮 ===== -->
<view class="modal-mask {{showUseModal ? 'modal-visible' : ''}}" bindtap="closeUseModal">
  <view class="modal-box qr-modal" catchtap="">
    <!-- 关闭按钮 -->
    <view class="close-btn" bindtap="closeUseModal">
      <text class="close-icon">✕</text>
    </view>

    <text class="qr-modal-title">扫码取票</text>
    <text class="qr-modal-subtitle">{{useTarget.title}}</text>
    <text class="qr-modal-meta">{{useTarget.validDate}} · {{useTarget.cell}}</text>

    <!-- 多张票的标签 -->
    <scroll-view scroll-x class="ticket-tabs" wx:if="{{useTickets.length > 1}}">
      <view
        wx:for="{{useTickets}}"
        wx:key="id"
        class="ticket-tab {{index === useIndex ? 'ticket-tab--active' : ''}}"
        bindtap="onSelectTicket"
        data-index="{{index}}"
      >
        <text class="ticket-tab-name">{{item.tag}}</text>
        <text class="ticket-tab-state ticket-tab-state--{{item.kind}}">{{item.stateText}}</text>
      </view>
    </scroll-view>

    <!-- 二维码区域 -->
    <view class="qr-wrapper">
      <image
        class="qr-image"
        wx:if="{{useTicket.pickupCode && useTicket.usable}}"
        src="{{useTicket.pickupCode}}"
        mode="aspectFit"
      />
      <view class="qr-placeholder" wx:elif="{{useTicket.usable}}">取票码正在生成，请稍后下拉刷新</view>
      <view class="qr-placeholder" wx:else>{{useTicket.stateText}}</view>
      <view class="qr-scan-line" wx:if="{{useTicket.pickupCode && useTicket.usable}}"></view>
    </view>

    <!-- 数字取票码 -->
    <view class="pickup-code-section" wx:if="{{useTicket.cardNo && useTicket.usable}}">
      <text class="pickup-label">取票码</text>
      <view class="pickup-code-row">
        <text class="pickup-code">{{useTicket.cardNo}}</text>
      </view>
    </view>

    <!-- 这张票的状态和退票 -->
    <view class="ticket-state-row">
      <text class="ticket-state-text ticket-state-text--{{useTicket.kind}}">{{useTicket.stateText}}</text>
      <text class="ticket-state-hint" wx:if="{{useTicket.stateHint}}">{{useTicket.stateHint}}</text>
    </view>
    <view
      class="btn btn-cancel qr-cancel-btn"
      wx:if="{{useTicket.canCancel}}"
      bindtap="onCancelTicket"
      data-id="{{useTicket.id}}"
    >
      退这张票
    </view>

    <text class="qr-tip">请将此码出示给工作人员，或在自助取票机扫描</text>
  </view>
</view>
</view>
