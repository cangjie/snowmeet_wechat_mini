@import '/app.wxss';

.page {
  background: #F8F8F8;
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 12rpx 0;
  margin-bottom: 4rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #2EA6D0;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.pcard-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.pcard-row:last-child { border-bottom: none; }

.pcard-name { color: #1a1a1a; display: flex; align-items: center; gap: 10rpx; }
/* 租赁卡/养护卡混在一个列表里，靠角标区分（顾客自助两种卡都能买） */
.pcard-biz {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.pcard-biz--rent { background: #e3f2fb; color: #006495; }
.pcard-biz--care { background: #e3f6ee; color: #047857; }
.pcard-right { display: flex; align-items: center; gap: 8rpx; }
.pcard-remain { color: #2EA6D0; font-weight: 600; }
.pcard-arrow { color: #c8c9cc; font-size: 32rpx; line-height: 1; }
.pcard-row:active { background: #f7f8fa; }

/* 已退款的卡：整行灰化 + 右侧「已退款」标记（仍可点进去看核销记录/退款状态） */
.pcard-row--refunded .pcard-name { color: #9ca3af; }
.pcard-row--refunded .pcard-biz { background: #e5e7eb; color: #9ca3af; }
.pcard-refunded {
  font-size: 22rpx;
  font-weight: 600;
  color: #9ca3af;
  background: #e5e7eb;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.buy-btn {
  background: #2EA6D0;
  color: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
}

.buy-btn:active { opacity: 0.85; }
