@import "./tokens.wxss";

.page-root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--surface);
}
.topbar {
  height: 56px;
  background: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  position: sticky;
  top: 0;
  z-index: 50;
}
.topbar-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.topbar-title {
  flex: 1;
  text-align: center;
  color: var(--on-surface);
  font-weight: 600;
  font-size: 18px;
}
.main {
  flex: 1;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 480px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}
.card-sale-summary { background: #fff; padding: 16px; border-radius: 12px; border: 1px solid #dce4ed; }
.card-sale-summary-title { font-size: 16px; font-weight: 600; color: #003b5b; }
.card-sale-summary-item { margin-top: 12px; font-size: 14px; line-height: 1.6; }
.card-sale-summary-use { font-size: 12px; line-height: 1.6; color: #6f7881; margin-top: 4px; }
.card-sale-processing-error { color: #a52a25; line-height: 1.6; font-size: 13px; margin: 12px 0; }
