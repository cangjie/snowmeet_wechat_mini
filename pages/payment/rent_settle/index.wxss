@import "/pages/template/stitch/tokens.wxss";

.page-root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--surface);
}
.topbar {
  height: 56px;
  background: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  position: sticky;
  top: 0;
  z-index: 50;
}
.topbar-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.topbar-title {
  flex: 1;
  text-align: center;
  color: var(--on-surface);
  font-weight: 600;
  font-size: 18px;
}
.main {
  flex: 1;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 480px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}
