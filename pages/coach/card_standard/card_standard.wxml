<view class="co-page">
  <view wx:if="{{blocked}}" class="co-blocked">{{blocked}}</view>
  <block wx:elif="{{!loading}}">
    <view class="note blue">{{name}}的会员卡标准。有优惠的项目就是会员卡指定的商品和服务；顾客领卡当天起到 {{validUntil}} 按这里的价格消费。</view>
    <view wx:if="{{!canEdit}}" class="note">{{reason}}</view>

    <view class="card card-pad">
      <view class="card-row"><text class="card-title small">养护</text><text class="card-meta">按门店、单项/双项分别设置</text></view>
      <block wx:for="{{cells}}" wx:key="key" wx:for-index="i">
        <view wx:if="{{i % 2 === 0}}" class="shop-title" style="{{i === 0 ? 'border-top: none; padding-top: 0;' : ''}}">{{item.shop}}</view>
        <view class="price-row">
          <text class="lab">{{item.tier}}</text>
          <view class="seg">
            <view wx:for="{{modes}}" wx:for-item="m" wx:key="key" class="chip-sq {{item.mode === m.key ? 'on' : ''}}" data-i="{{i}}" data-mode="{{m.key}}" bindtap="onMode">{{m.label}}</view>
          </view>
          <view class="val {{item.mode === 'none' ? 'off' : ''}}">
            <input type="digit" value="{{item.text}}" disabled="{{item.mode === 'none' || !canEdit}}" data-i="{{i}}" bindinput="onCellText" />
            <text class="unit">{{item.mode === 'rate' ? '折' : (item.mode === 'fixed' ? '元' : '')}}</text>
          </view>
        </view>
        <view class="floor-hint {{item.open ? '' : 'closed'}}">底价：{{item.hint}}</view>
        <view wx:if="{{item.belowFloor}}" class="below-floor">当前设置低于底价，保存前请调整。</view>
      </block>
      <view class="card-meta">一口价 = 养护服务费封顶价，维修费不打折；加急单只对单/双项的基础价生效，加急加价照收。折扣填「8」表示 8 折。</view>
    </view>

    <view class="card card-pad">
      <view class="card-row"><text class="card-title small">租赁</text><text class="card-meta">各店、各项目通用</text></view>
      <view class="price-row">
        <text class="lab" style="width: 96rpx;">折扣</text>
        <view class="val" style="width: 220rpx;"><input type="digit" placeholder="不优惠留空" value="{{rentalText}}" disabled="{{!canEdit}}" bindinput="onRentalText" /><text class="unit">折</text></view>
      </view>
      <view class="floor-hint {{rental.open ? '' : 'closed'}}" style="margin-left: 0;">底价：{{rental.hint}}</view>
      <view wx:if="{{rental.belowFloor}}" class="below-floor" style="margin-left: 0;">当前设置低于底价，保存前请调整。</view>
    </view>

    <view class="note">保存即生效，只影响<text style="font-weight: 700;">之后</text>领取的新卡；已领的卡保持领取时的价格。设置完成后，到「发卡与领取情况」生成会员卡发给顾客。</view>
  </block>
</view>
<view wx:if="{{!blocked && !loading && canEdit}}" class="bottom-bar">
  <view class="btn primary {{dirty && !saving ? '' : 'disabled'}}" bindtap="onSave">保存</view>
</view>
