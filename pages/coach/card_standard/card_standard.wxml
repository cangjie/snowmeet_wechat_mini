<view class="co-page">
  <view wx:if="{{blocked}}" class="co-blocked">{{blocked}}</view>
  <block wx:elif="{{!loading && !editing}}">
    <view class="note blue">创建不同卡种；每个卡种可以「分享二维码」或「分享小程序卡片」。每次分享都会记一条，记录在各卡种下面的「分享记录」里（默认折叠）；一次分享只能一位顾客领取，顾客领取时需要授权头像和昵称。</view>
    <view class="btn primary btn-block" bindtap="onNew">＋ 创建卡种</view>
    <view wx:if="{{sharesError}}" class="note">分享记录加载失败，请下拉刷新重试。</view>
    <view wx:for="{{templates}}" wx:key="id" class="card card-pad">
      <view class="card-row">
        <view class="card-title grow">{{item.name}}</view>
        <view wx:if="{{item.canDelete}}" class="btn danger" data-id="{{item.id}}" data-name="{{item.name}}" data-pending="{{item.pendingCount}}" bindtap="onDeleteTemplate">删除</view>
        <view class="btn" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
      </view>
      <view wx:for="{{item.benefit.lines}}" wx:for-item="line" wx:key="label" class="card-meta">{{line.label}}：单项 {{line.one}} · 双项 {{line.two}}</view>
      <view class="card-meta">租赁：{{item.benefit.rental}}</view>
      <view wx:if="{{item.claimedCount > 0}}" class="card-meta">已有 {{item.claimedCount}} 位顾客领取过，不能删除</view>
      <view class="btn-row">
        <view class="btn primary {{sharingQr ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="onShareQr">分享二维码</view>
        <button wx:if="{{item.coverPath}}" class="btn primary" open-type="share" data-id="{{item.id}}" data-name="{{item.name}}" data-cover="{{item.coverPath}}">分享小程序卡片</button>
        <view wx:elif="{{item.coverError}}" class="card-meta" data-name="{{item.name}}" bindtap="onRetryCover">封面生成失败，点此重试</view>
        <view wx:else class="btn disabled">分享小程序卡片（封面生成中…）</view>
      </view>

      <!-- 分享记录：默认折叠；每次分享一条，已领取的显示领取人头像昵称，没领取的可再看二维码、再分享、直接删除 -->
      <view class="share-toggle" data-id="{{item.id}}" bindtap="onToggleShares">
        <text class="card-title small">分享记录（{{shareStats[item.id].total || 0}}）</text>
        <text class="card-meta grow" style="text-align: right;">待领取 {{shareStats[item.id].pending || 0}} · 已领取 {{shareStats[item.id].claimed || 0}}</text>
        <text class="share-arrow">{{expanded[item.id] ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
      <block wx:if="{{expanded[item.id]}}">
        <view wx:if="{{!shareRows[item.id].length}}" class="card-meta">这个卡种还没有分享记录</view>
        <view wx:for="{{shareRows[item.id]}}" wx:for-item="rec" wx:key="id" class="share-rec">
          <view class="card-row">
            <image wx:if="{{rec.avatarUrl}}" class="share-avatar" src="{{rec.avatarUrl}}" mode="aspectFill" />
            <view wx:elif="{{rec.status === 'claimed'}}" class="share-avatar">{{rec.initial || '客'}}</view>
            <view wx:else class="share-avatar empty">?</view>
            <view class="grow">
              <view class="card-title small">{{rec.status === 'claimed' ? (rec.nickName || '顾客') : '等待顾客领取'}}</view>
              <view class="card-meta">{{rec.channelText ? rec.channelText + ' · ' : ''}}分享于 {{rec.created}}</view>
            </view>
            <text class="tag {{rec.tone}}">{{rec.statusText}}</text>
          </view>
          <view wx:if="{{rec.status === 'claimed'}}" class="card-meta">卡号 {{rec.cardNo}} · {{rec.claimed}} 领取</view>
          <view wx:if="{{rec.canDelete}}" class="btn-row">
            <view class="btn" data-card-id="{{rec.id}}" data-name="{{rec.name}}" bindtap="onViewQr">查看二维码</view>
            <button class="btn" open-type="share" data-path="{{rec.sharePath}}" data-name="{{rec.name}}" data-cover="{{item.coverPath || fallbackCover}}">分享小程序卡片</button>
            <view class="btn danger" data-id="{{rec.id}}" bindtap="onDeleteShare">删除</view>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{!templates.length}}" class="co-empty">还没有卡种，先创建一张</view>

    <!-- 卡种已不在列表里的分享记录（旧卡、卡种被停用）：有才显示，同样默认折叠 -->
    <view wx:if="{{otherShares.length}}" class="card card-pad">
      <view class="share-toggle" data-id="other" bindtap="onToggleShares">
        <text class="card-title small">其他分享记录（{{otherStats.total}}）</text>
        <text class="card-meta grow" style="text-align: right;">待领取 {{otherStats.pending}} · 已领取 {{otherStats.claimed}}</text>
        <text class="share-arrow">{{expanded.other ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
      <block wx:if="{{expanded.other}}">
        <view wx:for="{{otherShares}}" wx:for-item="rec" wx:key="id" class="share-rec">
          <view class="card-row">
            <image wx:if="{{rec.avatarUrl}}" class="share-avatar" src="{{rec.avatarUrl}}" mode="aspectFill" />
            <view wx:elif="{{rec.status === 'claimed'}}" class="share-avatar">{{rec.initial || '客'}}</view>
            <view wx:else class="share-avatar empty">?</view>
            <view class="grow">
              <view class="card-title small">{{rec.status === 'claimed' ? (rec.nickName || '顾客') : '等待顾客领取'}}</view>
              <view class="card-meta">{{rec.name}}{{rec.channelText ? ' · ' + rec.channelText : ''}} · 分享于 {{rec.created}}</view>
            </view>
            <text class="tag {{rec.tone}}">{{rec.statusText}}</text>
          </view>
          <view wx:if="{{rec.status === 'claimed'}}" class="card-meta">卡号 {{rec.cardNo}} · {{rec.claimed}} 领取</view>
          <view wx:if="{{rec.canDelete}}" class="btn-row">
            <view class="btn" data-card-id="{{rec.id}}" data-name="{{rec.name}}" bindtap="onViewQr">查看二维码</view>
            <button class="btn" open-type="share" data-path="{{rec.sharePath}}" data-name="{{rec.name}}" data-cover="{{fallbackCover}}">分享小程序卡片</button>
            <view class="btn danger" data-id="{{rec.id}}" bindtap="onDeleteShare">删除</view>
          </view>
        </view>
      </block>
    </view>
  </block>
  <block wx:elif="{{!loading && editing}}">
    <view class="note blue">设置卡种的名称和权益，价格不能低于管理员设定的底价。</view>
    <view class="card card-pad"><view class="card-title small">卡种名称</view><input class="input" placeholder="例如学员卡、教练卡" value="{{name}}" maxlength="50" bindinput="onName" /></view>
    <view wx:if="{{!canEdit}}" class="note">{{reason}}</view>

    <view wx:if="{{nothingOpen}}" class="note">管理员还没有给你开放会籍卡的项目，请联系管理员设置会籍卡底价。</view>

    <view wx:if="{{cells.length && !nothingOpen}}" class="card card-pad">
      <view class="card-row"><text class="card-title small">养护</text><text class="card-meta">按门店、单项/双项分别设置</text></view>
      <block wx:for="{{cells}}" wx:key="key" wx:for-index="i">
        <block wx:if="{{item.visible}}">
          <view wx:if="{{item.showShop}}" class="shop-title" style="{{i === 0 ? 'border-top: none; padding-top: 0;' : ''}}">{{item.shop}}</view>
          <view class="price-row">
            <text class="lab">{{item.tier}}</text>
            <!-- 只有设置了不止一种方式时才有方式按钮；没设置的方式不显示 -->
            <view wx:if="{{item.modes.length > 1}}" class="seg">
              <view wx:for="{{item.modes}}" wx:for-item="m" wx:key="key" class="chip-sq {{item.mode === m.key ? 'on' : ''}}" data-i="{{i}}" data-mode="{{m.key}}" bindtap="onMode">{{m.label}}</view>
            </view>
            <view class="val" style="flex: 1;">
              <input type="digit" placeholder="{{item.placeholder}}" value="{{item.text}}" disabled="{{!canEdit}}" data-i="{{i}}" bindinput="onCellText" />
              <text class="unit">{{item.unit}}</text>
            </view>
          </view>
          <view class="floor-hint">底价：{{item.hint}}</view>
          <view wx:if="{{item.belowFloor}}" class="below-floor">当前设置低于底价或方式已不开放，保存前请调整。</view>
        </block>
      </block>
      <view class="card-meta">一口价 = 养护服务费封顶价，维修费不打折；加急单只对单/双项的基础价生效，加急加价照收。留空 = 这一项不优惠。</view>
    </view>

    <view wx:if="{{showRental}}" class="card card-pad">
      <view class="card-row"><text class="card-title small">租赁</text><text class="card-meta">各店、各项目通用</text></view>
      <view class="price-row">
        <text class="lab" style="width: 96rpx;">折扣</text>
        <view class="val" style="width: 220rpx;"><input type="digit" placeholder="不优惠留空" value="{{rentalText}}" disabled="{{!canEdit}}" bindinput="onRentalText" /><text class="unit">折</text></view>
      </view>
      <view class="floor-hint" style="margin-left: 0;">底价：{{rental.hint}}</view>
      <view wx:if="{{rental.belowFloor}}" class="below-floor" style="margin-left: 0;">当前设置低于底价，保存前请调整。</view>
    </view>

    <view class="note">保存后，已领取和之后领取的卡都会使用卡种的最新优惠；已开单的订单金额不变。</view>
  </block>
  <view wx:if="{{qr.show}}" class="qr-mask">
    <view class="qr-pop">
      <view class="card-title">{{qr.name}}</view>
      <view class="card-meta">让顾客用微信「扫一扫」或长按识别二维码，授权头像昵称后即可领取。一个二维码只能一位顾客领取。</view>
      <image wx:if="{{qr.url}}" class="qr-img" src="{{qr.url}}" mode="aspectFit" show-menu-by-longpress bindload="onQrLoad" binderror="onQrError" />
      <view wx:if="{{qr.loading}}" class="card-meta">正在生成二维码…</view>
      <view wx:if="{{qr.error}}" class="danger-line">{{qr.error}}</view>
      <view class="btn-row">
        <view wx:if="{{qr.error}}" class="btn" bindtap="onQrRetry">重试</view>
        <view wx:else class="btn" bindtap="onQrSave">保存到相册</view>
        <view class="btn primary" bindtap="onQrClose">完成</view>
      </view>
    </view>
  </view>
</view>
<canvas canvas-id="membershipShareCover" style="position: fixed; left: -10000px; top: 0; width: 500px; height: 400px; pointer-events: none;"></canvas>
<view wx:if="{{!blocked && !loading && editing && canEdit}}" class="bottom-bar">
  <view class="btn" bindtap="onBackToList">返回</view>
  <view class="btn primary {{dirty && !saving ? '' : 'disabled'}}" bindtap="onSave">保存</view>
</view>
