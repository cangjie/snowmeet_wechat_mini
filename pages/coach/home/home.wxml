<view class="co-page">
  <view wx:if="{{blocked}}" class="co-blocked">{{blocked}}</view>
  <block wx:elif="{{coach}}">
    <view wx:if="{{!coach.valid}}" class="note">你的分销商身份已停用或需要管理员处理，不能再发新卡和新优惠券，已领的卡继续有效。</view>

    <view class="tabs">
      <!-- 只有机构能发整个雪季有效的会籍卡；教练和 KOL 只能发单张优惠券（2026-11-17） -->
      <view wx:if="{{coach.introducerType === '机构'}}" class="tab {{tab === 'share' ? 'on' : ''}}" data-tab="share" bindtap="onTab">发卡/分享</view>
      <view wx:if="{{coach.introducerType === '机构'}}" class="tab {{tab === 'status' ? 'on' : ''}}" data-tab="status" bindtap="onTab">领取情况</view>
      <view class="tab {{tab === 'students' ? 'on' : ''}}" data-tab="students" bindtap="onTab">顾客消费</view>
      <view class="tab {{tab === 'coupons' ? 'on' : ''}}" data-tab="coupons" bindtap="onTab">我的券</view>
    </view>

    <!-- 发卡 / 分享：分享二维码、分享小程序卡片都在「制作会员卡」页，这里只是入口 -->
    <block wx:if="{{tab === 'share'}}">
      <view class="card card-pad">
        <view class="card-title">分享会籍卡</view>
        <view class="card-meta" style="line-height: 1.7;">在「制作会员卡」里选好卡种，点「分享二维码」或「分享小程序卡片」发给顾客。每次分享都会记一条，一次分享只能一位顾客领取；顾客领取时需要授权头像和昵称，领取后在「领取情况」里能看到他的头像、昵称和卡号，没领取的可以取消。</view>
        <view class="btn primary btn-block" bindtap="onGoShare">去分享会籍卡</view>
      </view>
    </block>

    <!-- 领取情况：每次分享一条 -->
    <block wx:if="{{tab === 'status'}}">
      <view wx:if="{{counts}}" class="stats">
        <view class="stat"><text class="stat-num">{{counts.total}}</text><text class="stat-label">已分享</text></view>
        <view class="stat"><text class="stat-num">{{counts.claimed}}</text><text class="stat-label">已领取</text></view>
        <view class="stat"><text class="stat-num">{{counts.issued}}</text><text class="stat-label">待领取</text></view>
        <view class="stat"><text class="stat-num">{{counts.revoked}}</text><text class="stat-label">已取消</text></view>
      </view>
      <view wx:for="{{statusRows}}" wx:key="id" class="card card-pad" style="{{item.status === 'revoked' ? 'opacity: 0.6;' : ''}}">
        <view class="card-row">
          <image wx:if="{{item.avatarUrl}}" class="share-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:elif="{{item.status === 'claimed'}}" class="share-avatar">{{item.initial || '客'}}</view>
          <view wx:else class="share-avatar empty">?</view>
          <view class="grow">
            <view class="card-title small">{{item.status === 'claimed' ? (item.nickName || '顾客') : '等待顾客领取'}}</view>
            <view class="card-meta">{{item.name}}{{item.channelText ? ' · ' + item.channelText : ''}}</view>
          </view>
          <text class="tag {{item.tone}}">{{item.statusText}}</text>
        </view>
        <view class="card-meta">分享于 {{item.created}}</view>
        <view wx:if="{{item.status === 'claimed'}}" class="card-meta">卡号 {{item.cardNo}} · {{item.claimed}} 领取</view>
        <view wx:if="{{item.canCancel}}" class="btn-row"><view class="btn danger" data-id="{{item.id}}" bindtap="onCancelShare">取消分享</view></view>
      </view>
      <view wx:if="{{!statusRows.length}}" class="co-empty">还没有分享过会籍卡</view>
    </block>

    <!-- 顾客消费 -->
    <block wx:if="{{tab === 'students'}}">
      <view wx:if="{{studentSummary}}" class="stats">
        <view class="stat"><text class="stat-num">{{studentSummary.students}}</text><text class="stat-label">顾客</text></view>
        <view class="stat"><text class="stat-num">¥{{studentSummary.amount}}</text><text class="stat-label">累计消费</text></view>
        <view class="stat"><text class="stat-num">¥{{studentSummary.cardDiscount}}</text><text class="stat-label">用卡优惠</text></view>
      </view>
      <view wx:for="{{students}}" wx:key="memberId" class="card card-pad" data-id="{{item.memberId}}" bindtap="onStudent">
        <view class="card-row"><view class="grow card-row"><text class="card-title small">{{item.name}}</text><text class="tag {{item.sourceTone}}">{{item.sourceText}}</text></view><text class="card-title small">¥{{item.amount}}</text></view>
        <view class="card-meta">尾号 {{item.phoneTail}} · {{item.orderCount}} 单{{item.last ? ' · 最近 ' + item.last : ''}}</view>
      </view>
      <view wx:if="{{!students.length}}" class="co-empty">还没有顾客</view>
      <view class="note blue">只统计顾客<text style="font-weight: 700;">领卡/接券当天起</text>的消费，不含更早的订单。只做展示，不涉及分成。</view>
    </block>

    <!-- 我的优惠券 -->
    <block wx:if="{{tab === 'coupons'}}">
      <view wx:if="{{couponSummary}}" class="stats">
        <view class="stat"><text class="stat-num">{{couponSummary.granted}}</text><text class="stat-label">发放（含自制）</text></view>
        <view class="stat"><text class="stat-num">{{couponSummary.held}}</text><text class="stat-label">在手</text></view>
        <view class="stat"><text class="stat-num">{{couponSummary.accepted}}</text><text class="stat-label">已被接受</text></view>
        <view class="stat"><text class="stat-num">{{couponSummary.used}}</text><text class="stat-label">已使用</text></view>
      </view>
      <view class="btn primary btn-block" bindtap="onGoTickets">去券包转发给顾客</view>
      <view wx:for="{{coupons}}" wx:key="code" class="card card-pad">
        <view class="card-row"><text class="card-title small grow">{{item.name}}</text><text class="tag {{item.tag.tone}}">{{item.tag.text}}</text></view>
        <view wx:if="{{item.acceptedName}}" class="card-meta">{{item.acceptedName}} · 尾号 {{item.acceptedPhoneTail}} · {{item.accepted}} 接受</view>
        <view wx:elif="{{item.state === 'pending'}}" class="card-meta">已转出 · 还没有人接受</view>
        <view wx:else class="card-meta">有效期至 {{item.expire}}</view>
      </view>
      <view wx:if="{{!coupons.length}}" class="co-empty">还没有券：管理员发给你的、或你自己生成的券都会出现在这里</view>
    </block>
  </block>
</view>
<canvas canvas-id="membershipShareCover" style="position: fixed; left: -10000px; top: 0; width: 500px; height: 400px; pointer-events: none;"></canvas>
