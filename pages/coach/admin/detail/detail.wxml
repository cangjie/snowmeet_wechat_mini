<view class="co-page">
  <view wx:if="{{blocked}}" class="co-blocked">{{blocked}}</view>
  <block wx:elif="{{coach}}">
    <view class="tabs detail-tabs">
      <view class="tab {{tab === 'coupon' ? 'on' : ''}}" data-tab="coupon" bindtap="onTab">优惠券底价</view>
      <view wx:if="{{coach.introducerType === '机构'}}" class="tab {{tab === 'floor' ? 'on' : ''}}" data-tab="floor" bindtap="onTab">会籍卡底价</view>
      <view class="tab {{tab === 'cards' ? 'on' : ''}}" data-tab="cards" bindtap="onTab">他的卡</view>
      <view class="tab {{tab === 'cardReport' ? 'on' : ''}}" data-tab="cardReport" bindtap="onTab">会籍卡领取</view>
      <view class="tab {{tab === 'couponReport' ? 'on' : ''}}" data-tab="couponReport" bindtap="onTab">优惠券领取</view>
      <view class="tab {{tab === 'manage' ? 'on' : ''}}" data-tab="manage" bindtap="onTab">停用</view>
    </view>

    <!-- 优惠券底价（原来的「价格设置」） -->
    <block wx:if="{{tab === 'coupon'}}">
      <view class="card card-pad">
        <view class="card-row"><text class="card-title small">养护优惠券底价</text><text class="card-meta">限制他自己生成的单张优惠券</text></view>
        <block wx:for="{{couponCells}}" wx:key="key" wx:for-index="i">
          <view wx:if="{{i % 2 === 0}}" class="shop-title" style="{{i === 0 ? 'border-top: none; padding-top: 0;' : ''}}">{{item.shop}}</view>
          <view class="price-row">
            <text class="lab">{{item.tier}}</text>
            <view class="val" style="flex: 1;"><input type="digit" placeholder="最低价" value="{{item.fixedText}}" data-i="{{i}}" bindinput="onCouponFixed" /><text class="unit">元</text></view>
            <view class="val" style="flex: 1;"><input type="digit" placeholder="最低折" value="{{item.rateText}}" data-i="{{i}}" bindinput="onCouponRate" /><text class="unit">折</text></view>
            <view class="val" style="flex: 1;"><input type="digit" placeholder="最高减" value="{{item.offText}}" data-i="{{i}}" bindinput="onCouponOff" /><text class="unit">元</text></view>
          </view>
        </block>
        <view class="card-meta">每格三个框依次是：<text style="font-weight: 700;">一口价不能低于</text>多少元、<text style="font-weight: 700;">折扣不能低于</text>几折（7 = 7 折）、<text style="font-weight: 700;">减免不能超过</text>多少元。某一种留空 = 没开放，他生成优惠券时看不到这种方式；三个都留空 = 这一项整格不开放。</view>
      </view>
      <view class="note">这是限制他生成<text style="font-weight: 700;">单张优惠券</text>（单次核销）的底价，教练、KOL、机构都一样。只有机构能发整个雪季有效的会籍卡，会籍卡的底价在「会籍卡底价」里。修改只影响他之后生成的券，已生成的券不变。</view>
    </block>

    <!-- 会籍卡底价（机构自己制作会籍卡的下限） -->
    <block wx:if="{{tab === 'floor'}}">
      <view class="card card-pad">
        <view class="card-row"><text class="card-title small">会籍卡养护底价</text><text class="card-meta">机构自己的会籍卡能设的最低折扣 / 最低一口价</text></view>
        <block wx:for="{{floorCells}}" wx:key="key" wx:for-index="i">
          <view wx:if="{{i % 2 === 0}}" class="shop-title" style="{{i === 0 ? 'border-top: none; padding-top: 0;' : ''}}">{{item.shop}}</view>
          <view class="price-row">
            <text class="lab">{{item.tier}}</text>
            <view class="val" style="flex: 1;"><input type="digit" placeholder="最低折扣" value="{{item.rateText}}" data-i="{{i}}" bindinput="onFloorRate" /><text class="unit">折</text></view>
            <view class="val" style="flex: 1;"><input type="digit" placeholder="最低一口价" value="{{item.fixedText}}" data-i="{{i}}" bindinput="onFloorFixed" /><text class="unit">元</text></view>
          </view>
        </block>
        <view class="card-meta">两个都留空 = 这一项不开放，机构不能给这一项设优惠。只填最低折扣 = 机构只能设折扣；只填最低一口价 = 只能设一口价。折扣填「7」表示不能比 7 折更低。</view>
      </view>
      <view class="card card-pad">
        <view class="card-row"><text class="card-title small">租赁底价</text><text class="card-meta">各店、各项目通用</text></view>
        <view class="price-row">
          <text class="lab" style="width: 96rpx;">最低折扣</text>
          <view class="val" style="width: 220rpx;"><input type="digit" placeholder="留空不开放" value="{{floorRentalText}}" bindinput="onFloorRental" /><text class="unit">折</text></view>
        </view>
      </view>
      <view class="note">会籍卡底价只限制机构自己制作会籍卡时的价格；优惠券的底价在「优惠券底价」里，两份互不影响。已经设好的价格不会被底价追溯修改，机构下次保存时才会被要求调整。</view>
    </block>

    <!-- 他的卡 -->
    <block wx:if="{{tab === 'cards'}}">
      <view wx:if="{{cardCounts}}" class="chips" style="flex-wrap: wrap;">
        <view class="chip {{cardFilter === '' ? 'on' : ''}}" data-s="" bindtap="onCardFilter">全部 {{cardCounts.total}}</view>
        <view class="chip {{cardFilter === 'issued' ? 'on' : ''}}" data-s="issued" bindtap="onCardFilter">待领取 {{cardCounts.issued}}</view>
        <view class="chip {{cardFilter === 'claimed' ? 'on' : ''}}" data-s="claimed" bindtap="onCardFilter">已领取 {{cardCounts.claimed}}</view>
        <view class="chip {{cardFilter === 'revoked' ? 'on' : ''}}" data-s="revoked" bindtap="onCardFilter">已撤销 {{cardCounts.revoked}}</view>
      </view>
      <view wx:for="{{cards}}" wx:key="id" class="card card-pad" style="{{item.status === 'revoked' ? 'opacity: 0.65;' : ''}}">
        <view class="card-row"><text class="card-title small grow">卡 …{{item.tokenTail}}</text><text class="tag {{item.tag.tone}}">{{item.tag.text}}</text></view>
        <block wx:if="{{item.status === 'claimed' || item.memberId}}">
          <view class="kv"><text class="k">领取人</text><text class="v">{{item.studentName}} · 尾号 {{item.phoneTail}}</text></view>
          <view class="kv"><text class="k">领取时间</text><text class="v">{{item.claimed}}</text></view>
          <view class="kv"><text class="k">锁定价 · 万龙养护</text><text class="v">单 / 双 {{item.care1}}</text></view>
          <view class="kv"><text class="k">锁定价 · 崇礼养护</text><text class="v">单 / 双 {{item.care2}}</text></view>
          <view class="kv"><text class="k">锁定价 · 租赁</text><text class="v">{{item.rental}}</text></view>
          <view class="kv"><text class="k">有效期至</text><text class="v">{{item.until}}</text></view>
          <view class="kv"><text class="k">已用卡</text><text class="v">{{item.useCount}} 次</text></view>
        </block>
        <view wx:else class="kv"><text class="k">创建时间</text><text class="v">{{item.created}}</text></view>
        <view wx:if="{{item.status === 'issued' || item.status === 'claimed'}}" class="btn-row" style="justify-content: flex-end;">
          <view class="btn danger" data-id="{{item.id}}" bindtap="onRevoke">撤销</view>
        </view>
      </view>
      <view wx:if="{{!cards.length}}" class="co-empty">没有学员卡</view>
    </block>

    <!-- 管理员按卡种查看领取人 -->
    <block wx:if="{{tab === 'cardReport'}}">
      <view class="co-note">按会籍卡种查看领取情况，包含领取后被撤销的卡。</view>
      <view wx:if="{{reportLoading}}" class="co-empty">正在加载…</view>
      <view wx:elif="{{reportError}}" class="co-blocked" bindtap="loadDistribution">{{reportError}}，点击重试</view>
      <block wx:else>
        <view wx:for="{{cardKinds}}" wx:key="id" class="card card-pad">
          <view class="card-row report-toggle" data-kind="card" data-id="{{item.id}}" bindtap="onReportToggle">
            <view class="grow"><view class="card-title small">{{item.name}}</view><view class="card-meta">已领取 {{item.claimed}} 张</view></view>
            <text class="caret">{{reportOpen === 'card:' + item.id ? '收起 ⌃' : '查看领取人 ⌄'}}</text>
          </view>
          <block wx:if="{{reportOpen === 'card:' + item.id}}"><template is="recipients" data="{{recipients: recipients, recipientLoading: recipientLoading, recipientError: recipientError, recipientTotal: recipientTotal}}" /></block>
        </view>
        <view wx:if="{{!cardKinds.length}}" class="co-empty">暂无会籍卡种</view>
      </block>
    </block>

    <!-- 管理员按券种查看领取及使用情况 -->
    <block wx:if="{{tab === 'couponReport'}}">
      <view class="co-note">未使用包含已过期的券；领取人按首次领券记录统计。管理员发放后由分销商转赠的券也列在这里。</view>
      <view wx:if="{{reportLoading}}" class="co-empty">正在加载…</view>
      <view wx:elif="{{reportError}}" class="co-blocked" bindtap="loadDistribution">{{reportError}}，点击重试</view>
      <block wx:else>
        <view wx:for="{{couponKinds}}" wx:key="id" class="card card-pad">
          <view class="card-row report-toggle" data-kind="coupon" data-id="{{item.id}}" bindtap="onReportToggle">
            <view class="grow"><view class="card-title small">{{item.name}}</view><view class="card-meta">{{item.source}}</view></view>
            <text class="caret">{{reportOpen === 'coupon:' + item.id ? '收起 ⌃' : '查看领取人 ⌄'}}</text>
          </view>
          <view wx:if="{{item.memo}}" class="card-meta">{{item.memo}}</view>
          <view class="report-counts">已领取 {{item.claimed}} 张 · 已使用 {{item.used}} 张 · 未使用 {{item.unused}} 张</view>
          <view class="card-meta">未使用中已过期 {{item.expired}} 张<text wx:if="{{item.invalid}}"> · 其他失效 {{item.invalid}} 张</text><text wx:if="{{item.unknown}}"> · 券记录缺失 {{item.unknown}} 张</text></view>
          <block wx:if="{{reportOpen === 'coupon:' + item.id}}"><template is="recipients" data="{{recipients: recipients, recipientLoading: recipientLoading, recipientError: recipientError, recipientTotal: recipientTotal}}" /></block>
        </view>
        <view wx:if="{{!couponKinds.length}}" class="co-empty">暂无优惠券</view>
      </block>
    </block>

    <!-- 停用 / 改名 -->
    <block wx:if="{{tab === 'manage'}}">
      <view class="card card-pad">
        <view class="field">
          <view class="field-label"><text>分销商显示名</text></view>
          <view class="card-row"><input class="input grow" value="{{name}}" bindinput="onName" maxlength="20" /><view class="btn" bindtap="onRename">保存</view></view>
        </view>
      </view>
      <view class="card card-pad">
        <view class="card-row"><text class="card-title small grow">{{coach.valid ? '启用中' : '已停用'}}</text><text class="tag {{coach.valid ? 'ok' : 'muted'}}">{{coach.valid ? '启用' : '已停用'}}</text></view>
        <view class="card-meta">停用后，已领的学员卡继续有效，但这位分销商不能再发新卡，没领的卡也不能再领。恢复后价格保留。</view>
        <view class="btn {{coach.valid ? 'danger' : 'primary'}} btn-block" bindtap="onToggleValid">{{coach.valid ? '停用这位分销商' : '恢复这位分销商'}}</view>
      </view>
    </block>
  </block>
</view>

<template name="recipients">
  <view class="report-recipients">
    <view wx:for="{{recipients}}" wx:key="code" class="report-recipient">
      <view class="card-row"><text class="grow report-person">{{item.name}}<text wx:if="{{item.phone}}"> · {{item.phone}}</text></text><text class="tag {{item.status === '已使用' || item.status === '已领取' ? 'ok' : 'muted'}}">{{item.status}}</text></view>
      <view class="card-meta">领取时间 {{item.claimed}}<text wx:if="{{item.code}}"> · {{item.code}}</text></view>
    </view>
    <view wx:if="{{recipientLoading}}" class="card-meta">正在加载领取人…</view>
    <view wx:elif="{{recipientError}}" class="report-more" bindtap="onReportMore">{{recipientError}}，点击重试</view>
    <view wx:elif="{{recipients.length < recipientTotal}}" class="report-more" bindtap="onReportMore">加载更多（{{recipients.length}} / {{recipientTotal}}）</view>
    <view wx:elif="{{!recipients.length}}" class="card-meta">暂无领取人</view>
  </view>
</template>
<view wx:if="{{!blocked && coach && tab === 'coupon'}}" class="bottom-bar">
  <view class="btn primary {{couponDirty ? '' : 'disabled'}}" bindtap="onCouponSave">保存优惠券底价</view>
</view>
<view wx:if="{{!blocked && coach && tab === 'floor'}}" class="bottom-bar">
  <view class="btn primary {{floorDirty ? '' : 'disabled'}}" bindtap="onFloorSave">保存会籍卡底价</view>
</view>
