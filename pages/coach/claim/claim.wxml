<view class="co-page">
  <view wx:if="{{loginError}}" class="center">
    <view class="state-icon warn">!</view>
    <view class="big-title">微信登录未完成</view>
    <view class="card-meta" style="margin: 12rpx 0 28rpx;">{{errMsg}}</view>
    <view class="btn primary" bindtap="onRetry">重新登录</view>
  </view>
  <view wx:elif="{{errMsg && !state}}" class="center">
    <view class="state-icon gray">!</view>
    <view class="big-title">{{errMsg}}</view>
    <view wx:if="{{token}}" class="btn primary" style="margin-top: 28rpx;" bindtap="onRetry">重试</view>
  </view>
  <view wx:elif="{{loading && !state}}" class="co-empty">加载中…</view>

  <!-- 可领取 -->
  <block wx:elif="{{state === 'claimable'}}">
    <view class="vip">
      <view class="vip-small">送你一张</view>
      <view class="vip-title">{{coachName}}的学员卡</view>
      <view wx:for="{{benefit.lines}}" wx:key="label" class="vip-line"><text>{{item.label}}</text><text>单项 <text class="em">{{item.one}}</text> · 双项 <text class="em">{{item.two}}</text></text></view>
      <view class="vip-line"><text>租赁 · 各店通用</text><text class="em">{{benefit.rental}}</text></view>
      <view class="vip-foot">领取当天起，有效期至 {{validUntil}}</view>
    </view>
    <view class="card card-pad"><view class="card-meta" style="line-height: 1.7;">到店养护、租赁时，由店员在开单页选择使用这张卡，和优惠券、次卡二选一。维修费、加急加价不打折。</view></view>
    <view wx:if="{{errMsg}}" class="danger-line center">{{errMsg}}</view>
    <button wx:if="{{needMember}}" class="btn primary btn-block {{claiming ? 'disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="onPhone">授权手机号并领取</button>
    <view wx:else class="btn primary btn-block {{claiming ? 'disabled' : ''}}" bindtap="onClaim">领取学员卡</view>
    <view wx:if="{{needMember}}" class="note blue">需要先授权手机号，这样到店报手机号，店员就能在开单时选到这张卡。</view>
  </block>

  <!-- 已领取（本人） -->
  <view wx:elif="{{state === 'claimed_by_me'}}" class="center">
    <view class="state-icon ok">✓</view>
    <view class="big-title">已领取</view>
    <view class="card-meta" style="margin: 12rpx 0 28rpx;">{{coachName}}的学员卡 · 有效期至 {{validUntil}}</view>
    <view class="card card-pad" style="text-align: left;"><view class="card-meta" style="line-height: 1.7;">到店养护、租赁时，说手机号或扫码接待，店员开单时选择这张卡即可享受优惠。</view></view>
    <view class="btn primary btn-block" style="margin-top: 24rpx;" bindtap="onGoMine">查看我的学员卡</view>
  </view>

  <!-- 已被别人领走 -->
  <view wx:elif="{{state === 'taken'}}" class="center">
    <view class="state-icon gray">!</view>
    <view class="big-title">这张学员卡已被领取</view>
    <view class="card-meta" style="margin-top: 12rpx;">每张卡只能一位学员领取，请向教练再要一张。</view>
  </view>

  <!-- 已失效 -->
  <view wx:elif="{{state === 'invalid'}}" class="center">
    <view class="state-icon warn">×</view>
    <view class="big-title">这张学员卡已失效</view>
    <view class="card-meta" style="margin-top: 12rpx;">可能已被教练撤销或已过期，请联系教练重新发送。</view>
  </view>

  <!-- 教练本人 -->
  <view wx:elif="{{state === 'self'}}" class="center">
    <view class="state-icon info">i</view>
    <view class="big-title">这是你发出的学员卡</view>
    <view class="card-meta" style="margin: 12rpx 0 28rpx;">转发给你的学员即可，教练本人不能领取。</view>
    <view class="btn primary" bindtap="onGoCoach">回到教练中心</view>
  </view>

  <!-- 已有该教练的卡 -->
  <view wx:elif="{{state === 'already_has'}}" class="center">
    <view class="state-icon info">i</view>
    <view class="big-title">你已有{{coachName}}的学员卡</view>
    <view class="card-meta" style="margin: 12rpx 0 28rpx;">本雪季每位教练的卡只能领取一张，有效期至 {{validUntil}}。</view>
    <view class="btn primary" bindtap="onGoMine">查看我的学员卡</view>
  </view>
</view>
