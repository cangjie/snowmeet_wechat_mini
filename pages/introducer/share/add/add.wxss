@import "../../common/introducer.wxss";

.type-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.pick { min-height: 88rpx; padding: 0 20rpx; border: 2rpx solid var(--line); border-radius: 12rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pick.on { border-color: var(--blue); background: var(--blue-soft); }
.pick-name { font-size: 28rpx; font-weight: 600; margin-right: 12rpx; }
.switch-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; }
