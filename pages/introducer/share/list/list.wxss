@import "../../common/introducer.wxss";

.filters { display: flex; flex-direction: column; gap: 14rpx; }
.filter-row { display: flex; gap: 12rpx; flex-wrap: wrap; align-items: center; }
.filter-label { font-size: 24rpx; color: var(--muted); width: 88rpx; }
.summary { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: var(--muted); }
.link { color: var(--blue); font-weight: 600; padding: 12rpx 8rpx; }
.row { background: var(--card); border: 2rpx solid var(--line); border-radius: 16rpx; padding: 20rpx 24rpx; display: flex; gap: 20rpx; align-items: flex-start; }
.row.done { opacity: 0.85; }
.row-main { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.line { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.code { font-size: 26rpx; font-weight: 600; word-break: break-all; }
.amount { font-size: 30rpx; font-weight: 700; }
.meta { font-size: 22rpx; color: var(--muted); line-height: 1.5; }
.tags { display: flex; gap: 10rpx; flex-wrap: wrap; align-items: center; }
.box { width: 44rpx; height: 44rpx; flex: none; margin-top: 4rpx; border: 2rpx solid #9FB3C4; border-radius: 10rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; }
.box.on { background: var(--blue); border-color: var(--blue); }
.box.off { visibility: hidden; }
.bar { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; width: 100%; }
.bar-text { font-size: 26rpx; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; }
.dialog { width: 100%; background: var(--card); border-radius: 20rpx; padding: 36rpx 32rpx; display: flex; flex-direction: column; gap: 20rpx; box-sizing: border-box; }
.dialog-title { font-size: 32rpx; font-weight: 700; }
.dialog-sum { font-size: 28rpx; }
.dialog-warn { font-size: 24rpx; color: var(--warn); background: var(--warn-bg); border-radius: 12rpx; padding: 14rpx 18rpx; line-height: 1.5; }
.dialog-actions { display: flex; gap: 20rpx; }
.dialog-actions .btn { flex: 1; }
