@import "../../common/introducer.wxss";
.distributor-heading { gap: 8rpx; min-width: 0; }
.distributor-heading checkbox-group, .distributor-heading .tag, .distributor-phone { flex: none; }
.distributor-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.distributor-phone { margin-left: auto; white-space: nowrap; }
.edit-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 30; background: rgba(0, 0, 0, .45); display: flex; align-items: center; justify-content: center; padding: 30rpx; box-sizing: border-box; }
.edit-dialog { width: 100%; max-height: 80vh; }
.bottom-bar .btn { min-width: 0; padding-left: 8rpx; padding-right: 8rpx; font-size: 23rpx; }
