.page { height: 100vh; background: #f8f9ff; display: flex; flex-direction: column; }

.top-bar { background: #ffffff; padding: 20rpx 28rpx 18rpx; border-bottom: 1rpx solid rgba(191,199,209,.3); }
.member-line { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; }
.member-name { font-size: 30rpx; font-weight: 700; color: #0b1c30; }
.member-count { font-size: 24rpx; color: #6f7881; }
.tabs { display: flex; gap: 14rpx; }
.tab { padding: 10rpx 26rpx; border-radius: 999rpx; font-size: 25rpx; color: #3f4850; background: #eff4ff; border: 1rpx solid transparent; }
.tab--on { background: #e1edf7; color: #006495; font-weight: 700; border-color: #006495; }

.list-scroll { flex: 1; overflow: hidden; }
.empty-tip { padding: 120rpx 40rpx; display: flex; flex-direction: column; align-items: center; gap: 14rpx; color: #6f7881; font-size: 27rpx; text-align: center; }
.empty-txt { font-size: 29rpx; font-weight: 600; color: #3f4850; }
.empty-sub { font-size: 24rpx; color: #6f7881; }

.equip-card { margin: 20rpx 24rpx 0; background: #ffffff; border-radius: 22rpx; border: 1rpx solid rgba(191,199,209,.32); padding: 24rpx; }
.equip-main { display: flex; gap: 22rpx; align-items: center; }
.equip-photo { width: 124rpx; height: 124rpx; border-radius: 14rpx; background: #f1f4f9; flex-shrink: 0; }
.equip-photo--empty { display: flex; align-items: center; justify-content: center; }
.equip-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.equip-title-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.type-badge { padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 700; }
.type-badge--ski { background: #e1edf7; color: #006495; }
.type-badge--board { background: #e1f3ea; color: #1f7a4d; }
.equip-brand { font-size: 29rpx; font-weight: 700; color: #0b1c30; }
.equip-scale { font-size: 26rpx; font-weight: 600; color: #3f4850; }
.equip-meta { font-size: 23rpx; color: #6f7881; word-break: break-all; }

.equip-actions { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(191,199,209,.22); display: flex; justify-content: flex-end; gap: 16rpx; }
.act-btn { height: 56rpx; padding: 0 20rpx; border-radius: 12rpx; border: 1rpx solid rgba(191,199,209,.55); background: #ffffff;
  display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; font-weight: 600; color: #3f4850; }
.act-btn--primary { border-color: #006495; background: #e1edf7; color: #006495; }
.act-btn--danger { border-color: rgba(186,26,26,.35); background: #fdecec; color: #ba1a1a; }

.bottom-pad { height: 36rpx; }
.footer-bar { flex-shrink: 0; background: #ffffff; border-top: 1rpx solid rgba(191,199,209,.4); padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); }
.add-btn { height: 88rpx; border-radius: 18rpx; background: #006495; color: #ffffff; font-size: 29rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; gap: 10rpx; }

/* 遮罩与底部弹层 */
.mask { position: fixed; inset: 0; background: rgba(11,28,48,.45); z-index: 100; display: flex; align-items: flex-end; justify-content: center; }
.mask--center { align-items: center; z-index: 120; }
.sheet { width: 100%; background: #f8f9ff; border-radius: 28rpx 28rpx 0 0; max-height: 86vh; display: flex; flex-direction: column; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx 16rpx; background: #ffffff; border-radius: 28rpx 28rpx 0 0; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: #0b1c30; }
.sheet-close { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: #eff4ff; display: flex; align-items: center; justify-content: center; }
.sheet-body { flex: 1; max-height: 64vh; padding: 20rpx 28rpx; box-sizing: border-box; }
.sheet-foot { display: flex; gap: 18rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1rpx solid rgba(191,199,209,.3); }
.sheet-foot--dialog { padding: 24rpx 0 0; border-top: none; background: transparent; }
.foot-btn { flex: 1; height: 84rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; }
.foot-btn--ghost { border: 1rpx solid rgba(191,199,209,.55); background: #ffffff; color: #3f4850; }
.foot-btn--primary { flex: 1.6; background: #006495; color: #ffffff; }

.dialog { width: 580rpx; background: #ffffff; border-radius: 24rpx; padding: 32rpx 28rpx; box-sizing: border-box; }
.dialog-title { font-size: 30rpx; font-weight: 700; color: #0b1c30; text-align: center; margin-bottom: 24rpx; }

.field-group { margin-bottom: 24rpx; }
.field-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.field-label { display: block; font-size: 25rpx; font-weight: 600; color: #3f4850; margin-bottom: 10rpx; }
.field-label-row .field-label { margin-bottom: 0; }
.field-input { width: 100%; height: 82rpx; border-radius: 14rpx; border: 1rpx solid rgba(191,199,209,.55); background: #ffffff;
  padding: 0 22rpx; font-size: 28rpx; color: #0b1c30; box-sizing: border-box; }
.field-input--gap { margin-bottom: 14rpx; }
.field-picker { display: flex; align-items: center; justify-content: space-between; }
.field-val { color: #0b1c30; }
.field-ph { color: #9ca3af; }

.seg { display: flex; background: #e8effa; border-radius: 14rpx; padding: 6rpx; gap: 6rpx; }
.seg-item { flex: 1; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 11rpx; font-size: 27rpx; color: #3f4850; }
.seg-item--on { background: #ffffff; color: #006495; font-weight: 700; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }

.diff-toggle { padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 23rpx; color: #3f4850; background: #e8effa; font-weight: 600; }
.diff-toggle--on { background: #006495; color: #ffffff; }

.photo-editor { display: flex; align-items: center; gap: 20rpx; }
.photo-preview-wrap { position: relative; width: 140rpx; height: 140rpx; }
.photo-preview { width: 140rpx; height: 140rpx; border-radius: 14rpx; background: #f1f4f9; }
.photo-remove { position: absolute; top: -10rpx; right: -10rpx; width: 38rpx; height: 38rpx; border-radius: 999rpx;
  background: rgba(11,28,48,.75); display: flex; align-items: center; justify-content: center; }
.photo-upload-btn { height: 140rpx; padding: 0 32rpx; border-radius: 14rpx; border: 2rpx dashed #8cb6d2; background: #f0f7fc;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; font-size: 24rpx; color: #006495; font-weight: 600; }

/* 历史时间线 */
.hist-subtitle { padding: 12rpx 28rpx; background: #eff4ff; font-size: 25rpx; font-weight: 600; color: #006495; }
.hist-row { background: #ffffff; border-radius: 16rpx; border: 1rpx solid rgba(191,199,209,.3); padding: 20rpx 22rpx; margin-bottom: 16rpx; }
.hist-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.hist-badge { padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 700; background: #e1edf7; color: #006495; }
.hist-badge--create { background: #e1f3ea; color: #1f7a4d; }
.hist-badge--delete { background: #fdecec; color: #ba1a1a; }
.hist-badge--merge { background: #eee6fa; color: #6d3fb5; }
.hist-time { font-size: 23rpx; color: #6f7881; }
.hist-val { font-size: 27rpx; font-weight: 600; color: #0b1c30; margin-bottom: 8rpx; word-break: break-all; }
.hist-val-muted { font-size: 24rpx; color: #6f7881; }
.hist-meta { font-size: 22rpx; color: #6f7881; }
.hist-photo-diff { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.hist-photo-side { display: flex; align-items: center; }
.hist-thumb { width: 96rpx; height: 96rpx; border-radius: 10rpx; background: #f1f4f9; }
.hist-arrow { font-size: 28rpx; color: #6f7881; font-weight: 700; }
