<view class="page" wx:if="{{order}}">

  <view class="card">
    <view class="section-title">订单信息</view>
    <view class="row"><text class="label">店铺</text><text class="value">{{order.shop}}</text></view>
    <view class="row"><text class="label">订单号</text><text class="value">{{order.code}}</text></view>
    <view class="row"><text class="label">日期</text><text class="value">{{order.dataStr}}</text></view>
    <view class="row"><text class="label">时间</text><text class="value">{{order.timeStr}}</text></view>
  </view>

  <view class="card" wx:if="{{order.type=='租赁' && order.rentals && order.rentals.length}}">
    <view class="section-title">租赁内容</view>

    <block wx:for="{{order.rentals}}" wx:for-item="rental" wx:key="id">
      <view wx:if="{{index > 0}}" class="rental-divider"></view>

      <view class="rental-head {{rental.expanded ? 'rental-head--open' : ''}}"
            bindtap="toggleRental" data-index="{{index}}">
        <view class="row">
          <text class="label">{{rental.displayName}}</text>
          <text class="value">{{rental.rentItems.length}} 件<text class="arrow">▾</text></text>
        </view>
        <view class="row fee-row">
          <view class="fee-group fee-group--deposit"><text class="label">押金</text><text class="value">{{rental.guarantyStr}}</text></view>
          <view class="fee-group fee-group--rent"><text class="label">日租金</text><text class="value">{{rental.totalRentalAmountStr}}</text></view>
        </view>
      </view>

      <view class="rental-items" wx:if="{{rental.expanded}}">
        <view class="item-row" wx:for="{{rental.rentItems}}" wx:for-item="item" wx:key="id">
          <view class="row"><text class="label">编码</text><text class="value">{{item.code || '-'}}</text></view>
          <view class="row"><text class="label">名称</text><text class="value">{{item.name || '-'}}</text></view>
          <view class="row"><text class="label">品类</text><text class="value">{{item.categoryName}}</text></view>
        </view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">金额</view>
    <view class="row"><text class="label">总计</text><text class="value value--amount">{{order.total_amountStr}}</text></view>
    <view class="row" wx:if="{{order.orderStatus != '支付成功'}}">
      <text class="label">需要支付</text><text class="value value--pay">{{order.paying_amountStr}}</text>
    </view>
    <view class="row" wx:else>
      <text class="label">已支付</text><text class="value value--amount">{{order.paidAmountStr}}</text>
    </view>
  </view>

  <!-- 订单已支付成功 → 直接显示「支付成功」,屏蔽其它支付相关 UI -->
  <view wx:if="{{order.orderStatus=='支付成功'}}" class="pay-success"> 支 付 成 功 </view>

  <!-- 支付前身份验证：仅在订单未支付时显示;identity 非 direct 状态用组件渲染,direct 状态显示支付按钮 -->
  <pay-identity-confirm
    wx:if="{{order.orderStatus != '支付成功' && identity && identity.status && identity.status !== 'direct'}}"
    payment-id="{{paymentId}}"
    payer-type="wechat"
    scanner-id="{{scannerId}}"
    status="{{identity.status}}"
    result="{{identity}}"
    bind:refreshed="onIdentityRefreshed">
  </pay-identity-confirm>

  <view wx:if="{{order.orderStatus != '支付成功' && payment && payment.status=='待支付' && identity && identity.status === 'direct'}}" class="pay-btn-wrap">
    <van-button type="primary" color="#2EA6D0" bind:click="pay" disabled="{{paying}}"> 敬 请 支 付 </van-button>
  </view>

</view>

<view wx:if="{{!order}}" class="loading">请稍候……</view>

<!-- 软授权手机号弹窗:点「敬请支付」时若 scannerHasCell=false 显示。授权或跳过都可继续支付 -->
<view wx:if="{{showPhonePrompt}}" class="phone-prompt-overlay" bindtap="onSkipPhone">
  <view class="phone-prompt-card" catchtap="">
    <view class="phone-prompt-title">建议授权手机号</view>
    <view class="phone-prompt-hint">便于查询订单与售后服务,您也可以跳过直接支付</view>
    <view class="phone-prompt-btn-row">
      <button class="phone-prompt-btn-primary" open-type="getPhoneNumber" bindgetphonenumber="onAuthorizePhone">授权手机号</button>
      <button class="phone-prompt-btn-secondary" bindtap="onSkipPhone">跳过,直接支付</button>
    </view>
  </view>
</view>
