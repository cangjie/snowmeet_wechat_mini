.verify-page {
  min-height: 100vh;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.verify-box {
  width: 100%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.verify-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  line-height: 1;
  color: #ffffff;
  margin-bottom: 28rpx;
}
.verify-icon--ok { background: #07c160; }
.verify-icon--no { background: #fa9d3b; }
.verify-icon--err { background: #e64340; }
.verify-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #e3e6ea;
  border-top-color: #006495;
  border-radius: 50%;
  margin-bottom: 28rpx;
  animation: verify-spin 0.8s linear infinite;
}
@keyframes verify-spin { to { transform: rotate(360deg); } }
.verify-title { font-size: 34rpx; font-weight: 600; color: #1a1a1a; }
.verify-sub { margin-top: 16rpx; font-size: 26rpx; color: #888; line-height: 1.5; }
.verify-btn {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #006495;
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
}
