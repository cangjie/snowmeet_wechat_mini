@import '/app.wxss';

.page {
  background: #F8F8F8;
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 12rpx 0;
  margin-bottom: 4rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #2EA6D0;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  font-size: 28rpx;
}

.row .label {
  color: #666;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.row .value {
  color: #333;
  text-align: right;
  word-break: break-all;
}

.value--amount {
  font-weight: 600;
}

.value--pay {
  color: #E64340;
  font-weight: 600;
  font-size: 32rpx;
}

.rental-head {
  padding: 4rpx 0;
}

.rental-head .row:first-child .label {
  color: #333;
  font-weight: 600;
}

.rental-head .row:first-child .value {
  color: #2EA6D0;
}

.rental-head .arrow {
  display: inline-block;
  margin-left: 8rpx;
  transition: transform 0.2s ease;
}

.rental-head--open .arrow {
  transform: rotate(180deg);
}

.fee-row {
  justify-content: flex-start;
  gap: 40rpx;
}

.fee-group {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.fee-group .label {
  margin-right: 16rpx;
}

.fee-group .value {
  text-align: right;
}

.fee-group--deposit {
  min-width: 300rpx;
}

.fee-group--rent {
  min-width: 300rpx;
}

.rental-items {
  background: #FAFAFA;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  margin: 8rpx 0 16rpx;
}

.item-row {
  padding: 8rpx 0;
  border-bottom: 1rpx solid #EEE;
}

.item-row:last-child {
  border-bottom: none;
}

.rental-divider {
  height: 1rpx;
  background: #EEE;
  margin: 12rpx 0;
}

.pay-btn-wrap {
  display: flex;
  justify-content: center;
  margin-top: 60rpx;
}

.pay-success {
  text-align: center;
  font-size: 36rpx;
  color: #E64340;
  font-weight: 600;
  margin-top: 60rpx;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 200rpx;
}

/* 软授权手机号弹窗 — 全屏遮罩 + 底部滑入卡片 */
.phone-prompt-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: phone-prompt-fade-in 0.2s ease-out;
}

@keyframes phone-prompt-fade-in {
  from { background: rgba(0, 0, 0, 0); }
  to { background: rgba(0, 0, 0, 0.5); }
}

.phone-prompt-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  animation: phone-prompt-slide-up 0.25s ease-out;
}

@keyframes phone-prompt-slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.phone-prompt-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.phone-prompt-hint {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.phone-prompt-btn-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.phone-prompt-btn-primary {
  background: #2EA6D0;
  color: #FFFFFF;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: none;
}

.phone-prompt-btn-primary::after {
  border: none;
}

.phone-prompt-btn-secondary {
  background: #FFFFFF;
  color: #666;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: 1rpx solid #DDD;
}

.phone-prompt-btn-secondary::after {
  border: none;
}
