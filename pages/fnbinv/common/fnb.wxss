/* 食材管理共享样式：沿用「我的X」系列 token（pages/mine/ticket/ticket_card.wxss），尺寸取自 Claude Design 原型（1px = 2rpx） */
page {
  --bg: #F0F2F7; --card: #FFFFFF; --ink: #111827; --muted: #6B7280; --faint: #9CA3AF; --line: #E5E7EB; --gray: #F3F4F6;
  --blue: #2563EB; --blue-soft: #EFF4FF; --warn: #B45309; --warn-bg: #FEF3C7; --danger: #EF4444; --danger-bg: #FEF2F2;
  --ok: #15803D; --ok-bg: #DCFCE7; --shadow: 0 4rpx 40rpx rgba(0, 0, 0, 0.06);
  background: var(--bg); color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}
.fnb-page { padding: 28rpx 32rpx calc(200rpx + env(safe-area-inset-bottom)); box-sizing: border-box; display: flex; flex-direction: column; gap: 24rpx; }
.fnb-head { display: flex; align-items: center; justify-content: space-between; }
.fnb-sub { font-size: 22rpx; color: var(--faint); }
.fnb-date { padding: 12rpx 22rpx; border-radius: 12rpx; background: var(--card); font-size: 22rpx; font-weight: 600; color: var(--muted); }
.fnb-blocked { margin-top: 80rpx; padding: 48rpx 40rpx; background: var(--card); border-radius: 32rpx; text-align: center; font-size: 26rpx; color: var(--muted); line-height: 1.6; }
.fnb-note { font-size: 24rpx; color: var(--muted); line-height: 1.6; padding: 4rpx 8rpx; }
.fnb-note .em { color: var(--ink); font-weight: 600; }
.fnb-empty { padding: 60rpx 0; text-align: center; font-size: 26rpx; color: var(--faint); }
.fnb-section-title { font-size: 26rpx; font-weight: 700; padding: 8rpx 4rpx 0; display: flex; justify-content: space-between; align-items: center; }
.fnb-section-title .side { font-size: 22rpx; font-weight: 600; color: var(--faint); }

/* 卡片 */
.card { background: var(--card); border-radius: 32rpx; box-shadow: var(--shadow); overflow: hidden; }
.card-pad { padding: 30rpx 32rpx; }
.card-row { display: flex; align-items: center; gap: 22rpx; }
.card-title { font-size: 30rpx; font-weight: 700; }
.card-meta { font-size: 22rpx; color: var(--faint); line-height: 1.5; }
.card-sep { border-top: 2rpx solid var(--gray); }
.sub-list { background: #FAFBFC; border-top: 2rpx solid var(--gray); }
.sub-row { padding: 24rpx 32rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 2rpx solid var(--gray); }
.sub-row:last-child { border-bottom: none; }
.grow { flex: 1; min-width: 0; }
.col { display: flex; flex-direction: column; gap: 8rpx; }
.right { text-align: right; align-items: flex-end; }
.qty { font-size: 34rpx; font-weight: 700; letter-spacing: -0.6rpx; }
.caret { font-size: 30rpx; color: var(--faint); }
.batch-no { font-size: 22rpx; font-weight: 700; color: var(--blue); letter-spacing: 0.6rpx; }

/* 统计块 */
.stats { display: flex; gap: 16rpx; }
.stat { flex: 1; background: var(--card); border-radius: 24rpx; padding: 24rpx 26rpx; display: flex; flex-direction: column; gap: 8rpx; }
.stat-num { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.stat-label { font-size: 22rpx; color: var(--faint); }

/* 标签 */
.tag { display: inline-flex; align-items: center; padding: 6rpx 14rpx; border-radius: 10rpx; font-size: 20rpx; font-weight: 600; background: var(--gray); color: var(--muted); white-space: nowrap; }
.tag.danger { background: var(--danger-bg); color: var(--danger); }
.tag.warn { background: var(--warn-bg); color: var(--warn); }
.tag.ok { background: var(--ok-bg); color: var(--ok); }
.tag.blue { background: var(--blue-soft); color: var(--blue); }
.tag.muted { background: var(--gray); color: var(--muted); }
.tone-danger { color: var(--danger); } .tone-warn { color: var(--warn); } .tone-ok { color: var(--ok); } .tone-blue { color: var(--blue); }

/* 筛选 chip */
.chips { display: flex; gap: 12rpx; white-space: nowrap; }
.chip { flex: none; display: inline-block; padding: 16rpx 26rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; background: var(--card); color: var(--muted); }
.chip.on { background: var(--blue); color: #fff; }
.chip-sq { flex: none; display: inline-block; padding: 14rpx 24rpx; border-radius: 16rpx; font-size: 22rpx; font-weight: 600; background: var(--card); color: var(--muted); border: 2rpx solid var(--line); }
.chip-sq.on { background: var(--blue); color: #fff; border-color: var(--blue); }
.seg { display: flex; gap: 12rpx; }
.seg .chip-sq { flex: 1; text-align: center; }
.chip-scroll { width: 100%; white-space: nowrap; }

/* 按钮：全圆角胶囊 */
.btn { display: inline-flex; align-items: center; justify-content: center; padding: 14rpx 26rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; background: var(--blue-soft); color: var(--blue); white-space: nowrap; }
.btn.primary { background: var(--blue); color: #fff; box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.3); }
.btn.danger { background: var(--danger-bg); color: var(--danger); }
.btn.ghost { background: var(--gray); color: var(--muted); }
.btn.disabled { background: var(--gray); color: var(--faint); box-shadow: none; }
.btn-block { display: flex; width: 100%; box-sizing: border-box; padding: 26rpx 0; font-size: 28rpx; }

/* 表单 */
.search { display: flex; align-items: center; gap: 16rpx; background: var(--card); border-radius: 20rpx; padding: 0 24rpx; height: 80rpx; }
.search input { flex: 1; font-size: 26rpx; }
.field { display: flex; flex-direction: column; gap: 12rpx; }
.field-label { font-size: 24rpx; font-weight: 600; color: var(--muted); display: flex; justify-content: space-between; }
.field-label .hint { font-weight: 400; color: var(--faint); font-size: 22rpx; }
.input { background: #F8F9FB; border: 2rpx solid var(--line); border-radius: 16rpx; height: 80rpx; padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box; display: flex; align-items: center; }
.input.warn { border-color: var(--warn); background: var(--warn-bg); }
.input-row { display: flex; gap: 16rpx; align-items: center; }
.input-row .input { flex: 1; min-width: 0; }
.unit-suffix { font-size: 24rpx; color: var(--muted); flex: none; }
.step { display: flex; gap: 20rpx; }
.step-no { flex: none; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--blue); color: #fff; font-size: 22rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.step-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16rpx; }
.step-title { font-size: 28rpx; font-weight: 700; line-height: 44rpx; }
.warn-line { font-size: 22rpx; color: var(--warn); line-height: 1.5; }
.danger-line { font-size: 22rpx; color: var(--danger); line-height: 1.5; }

/* 弹层 */
.sheet { padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 24rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.pick-list { max-height: 60vh; }
.pick-row { padding: 24rpx 8rpx; border-bottom: 2rpx solid var(--gray); display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; }
.bar-track { height: 16rpx; border-radius: 999rpx; background: var(--gray); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; }
