@import "../common/fnb.wxss";
.order-no { font-size: 28rpx; font-weight: 700; letter-spacing: 0.6rpx; }
.dish-line { font-size: 26rpx; font-weight: 600; color: #374151; }
.remark { font-size: 22rpx; color: var(--warn); background: var(--warn-bg); border-radius: 10rpx; padding: 8rpx 14rpx; align-self: flex-start; }
.batch-qty { font-size: 26rpx; font-weight: 700; }
.need-head { background: var(--gray); font-size: 22rpx; font-weight: 600; color: var(--muted); }
.actions { gap: 16rpx; flex-wrap: wrap; }
.editor { max-height: 88vh; }
.chips.wrap { flex-wrap: wrap; white-space: normal; }
.picked { align-self: flex-start; }
.used-line { font-size: 22rpx; color: var(--muted); line-height: 1.5; }
/* 将扣减：按配方带出，可微调用量 */
.date-row { display: flex; align-items: center; gap: 14rpx; }
.line-name { flex: none; width: 220rpx; font-size: 26rpx; font-weight: 600; }
.deduct-row { display: flex; flex-direction: column; gap: 6rpx; }
.recipe-hint { padding-left: 234rpx; }
/* 库存提示：可用量、欠多少、有整包没开封时可直接开封 */
.stock-hint { display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx 14rpx; padding-left: 234rpx; }
.filter-seg { margin-top: 20rpx; }
