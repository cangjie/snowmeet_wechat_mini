@import "../common/fnb.wxss";
.chips.wrap { flex-wrap: wrap; white-space: normal; }
.batch-qty { font-size: 24rpx; font-weight: 700; color: #374151; }
.actions { gap: 16rpx; }
.fnb-empty.small { padding: 24rpx 0; font-size: 24rpx; }
.editor { max-height: 88vh; }
.date-row { display: flex; align-items: center; gap: 14rpx; }
.date-label { flex: none; width: 150rpx; font-size: 24rpx; color: var(--muted); }
.line-name { flex: none; width: 200rpx; font-size: 26rpx; font-weight: 600; }
.remove { flex: none; width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--gray); color: var(--muted); display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.picker { background: #F8F9FB; border-radius: 20rpx; padding: 20rpx; display: flex; flex-direction: column; gap: 12rpx; }
.pick-list { max-height: 40vh; }
.link { font-size: 22rpx; color: var(--faint); text-align: center; }
.grow-btn { flex: 1; padding: 24rpx 0; font-size: 26rpx; }
.go-cats { margin: 24rpx auto 0; display: flex; width: 320rpx; }
