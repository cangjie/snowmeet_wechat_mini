@import "../common/fnb.wxss";
.form { gap: 40rpx; }
.chip.gray { background: var(--gray); }
.chips.wrap { flex-wrap: wrap; white-space: normal; }
.hint-inline { font-size: 22rpx; font-weight: 400; color: var(--faint); margin-left: 12rpx; }
.picked { align-self: flex-start; }
.date-row { display: flex; align-items: center; gap: 14rpx; }
.date-label { flex: none; width: 150rpx; font-size: 24rpx; color: var(--muted); }
.date-row .grow { flex: 1; min-width: 0; }
.seg.mini { flex: none; gap: 8rpx; }
.seg.mini .chip-sq { flex: none; padding: 12rpx 18rpx; }
.rule-line { font-size: 22rpx; color: var(--blue); line-height: 1.5; }
.link { font-size: 22rpx; color: var(--faint); align-self: flex-start; }
.link.blue { color: var(--blue); }
/* 封装含量单位：与所选食材计量方式不同的置灰 */
.content-units { flex-wrap: wrap; }
.content-units .chip-sq.off { opacity: .35; }
/* 已手填到期日期：生产日期、保质期置灰不可改 */
.date-row.locked .date-label { color: var(--faint); }
.date-row.locked .input { background: var(--gray); color: var(--faint); }
.date-row.locked .chip-sq { opacity: .45; }
.days { flex: none !important; width: 120rpx; }
.card-title.small { font-size: 28rpx; }
.remove { flex: none; width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--gray); color: var(--muted); display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.fnb-empty.small { padding: 24rpx 0; font-size: 24rpx; }
/* 新食材的数量单位会列出全部单位，放不下时换行 */
.qty-units { flex: 1 !important; min-width: 0; flex-wrap: wrap; }
/* 开封后保质期不变：天数框换成说明文字 */
.keep-box { color: var(--muted); }
.chip-sq.keep { flex: none; padding: 0 20rpx; height: 80rpx; display: flex; align-items: center; }
