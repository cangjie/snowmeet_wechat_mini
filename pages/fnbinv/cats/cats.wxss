@import "../common/fnb.wxss";
.card-title.small { font-size: 28rpx; }
.l2 { padding: 28rpx 32rpx; border-bottom: 2rpx solid var(--gray); display: flex; flex-direction: column; gap: 18rpx; }
.warn-row { gap: 16rpx; }
.mini-step { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--blue-soft); color: var(--blue); font-weight: 700; display: flex; align-items: center; justify-content: center; }
.warn-val { font-size: 26rpx; font-weight: 700; min-width: 70rpx; text-align: center; }
.mats { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mat { padding: 10rpx 18rpx; font-size: 22rpx; }
.chips.wrap { flex-wrap: wrap; white-space: normal; }
.editor { max-height: 88vh; }
.rule-box { background: #F8F9FB; border-radius: 20rpx; padding: 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.rule-name { width: 72rpx; font-size: 26rpx; font-weight: 700; flex: none; }
.days { flex: none !important; width: 140rpx; }
.unit-seg { width: 50%; }
