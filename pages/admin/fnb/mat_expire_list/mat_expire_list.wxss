/* 食材过期提醒 · 列表页样式，配色/尺寸对标网页版 mat.css（px 按 ×2 换算 rpx） */

page { background: #f8f9ff; }

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  padding: 24rpx 32rpx 8rpx;
}
.htitle { font-size: 34rpx; font-weight: 700; color: #006495; }
.hsub { font-size: 23rpx; color: #6f7881; margin-top: 4rpx; }

.search-row {
  display: flex;
  align-items: center;
  margin: 0 32rpx 20rpx;
  padding: 0 24rpx;
  height: 84rpx;
  background: #fff;
  border: 1px solid rgba(191, 199, 209, 0.4);
  border-radius: 24rpx;
}
.search-ic { margin-right: 16rpx; color: #6f7881; }
.search-input { flex: 1; font-size: 28rpx; color: #0b1c30; }

.chips {
  white-space: nowrap;
  padding: 4rpx 32rpx 20rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 999px;
  font-size: 25rpx;
  font-weight: 500;
  color: #3f4850;
  background: #fff;
  border: 1px solid rgba(191, 199, 209, 0.4);
}
.chip-cnt { font-size: 22rpx; color: #6f7881; margin-left: 8rpx; }
.chip.on { background: #006495; border-color: #006495; color: #fff; font-weight: 700; }
.chip.on .chip-cnt { color: rgba(255, 255, 255, 0.8); }

.list { padding: 0 32rpx 180rpx; }
.bcard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1px solid rgba(191, 199, 209, 0.4);
  border-radius: 28rpx;
  padding: 26rpx 16rpx 26rpx 28rpx;
  margin-bottom: 20rpx;
}
.bcard:active { background: #eef1f5; }
.bcard .bl { min-width: 0; flex: 1; margin-right: 12rpx; }
.bcard .bname {
  font-size: 29rpx;
  font-weight: 700;
  color: #0b1c30;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bcard .bmeta {
  display: flex;
  font-size: 23rpx;
  color: #3f4850;
  margin-top: 8rpx;
}
.bcard .bmeta text { margin-right: 20rpx; }
.bcard.disposed .bname, .bcard.disposed .bmeta { color: #6f7881; }
.bcard .br { display: flex; align-items: center; flex-shrink: 0; }

.badge {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999px;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}
.badge-ic { margin-right: 6rpx; }
.badge.expired { color: #ba1a1a; background: #fee2e2; }
.badge.today   { color: #c2410c; background: #ffedd5; }
.badge.warning { color: #a8720a; background: #fef3c7; }
.badge.normal  { color: #1f8a5b; background: #dcfce7; }
.badge.done    { color: #6f7881; background: #eef1f5; font-weight: 500; }

.more-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f7881;
  font-size: 32rpx;
}

.empty { text-align: center; color: #6f7881; padding: 120rpx 0 40rpx; font-size: 26rpx; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 56rpx;
  z-index: 20;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #006495;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 100, 149, 0.4);
}
.fab:active { background: #00527a; }

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 30;
  background: rgba(11, 28, 48, 0.45);
  display: none;
}
.mask.show { display: block; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 31;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.18s ease-out;
}
.sheet.show { transform: translateY(0); }
.sheet .stitle {
  text-align: center;
  font-size: 24rpx;
  color: #6f7881;
  padding: 16rpx 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet .sopt {
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #0b1c30;
  border-top: 1px solid rgba(191, 199, 209, 0.4);
}
.sheet .sopt.warn { color: #ba1a1a; }
.sheet .scancel { margin-top: 12rpx; border-top: 12rpx solid #f8f9ff; color: #6f7881; }
