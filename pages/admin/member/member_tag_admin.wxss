.page { min-height: 100vh; background: #f8f9ff; padding-bottom: 40rpx; }

.appbar { height: 88rpx; background: #fff; display: flex; align-items: center; justify-content: space-between;
  padding: 0 24rpx; border-bottom: 1rpx solid rgba(191,199,209,.3); position: sticky; top: 0; z-index: 30; }
.appbar-title { font-size: 34rpx; font-weight: 700; color: #006495; }
.appbar-add { display: flex; align-items: center; gap: 6rpx; }
.appbar-add-txt { font-size: 26rpx; color: #006495; font-weight: 600; }

.hint { padding: 18rpx 24rpx; font-size: 23rpx; color: #6f7881; line-height: 1.5; background: #eff4ff; }

.list { padding: 18rpx 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.trow { background: #fff; border-radius: 18rpx; border: 1rpx solid rgba(191,199,209,.3); padding: 22rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between; }
.trow-l { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.trow-tag { font-size: 29rpx; font-weight: 700; color: #0b1c30; }
.trow-group { font-size: 21rpx; color: #6f7881; background: #eff4ff; padding: 2rpx 12rpx; border-radius: 8rpx; }
.trow-count { font-size: 23rpx; color: #6f7881; }
.trow-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.tbtn { height: 56rpx; line-height: 56rpx; padding: 0 22rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; }
.tbtn-merge { border: 1rpx solid #006495; color: #006495; background: #e1edf7; }
.tbtn-del { border: 1rpx solid #ba1a1a; color: #ba1a1a; background: #ffe9e7; }
.tbtn-del--off { border: 1rpx solid rgba(191,199,209,.5); color: #bfc7d1; background: #f4f6fa; }

.empty { padding: 100rpx 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-txt { font-size: 26rpx; color: #6f7881; }

/* 遮罩 / 弹窗 / 弹层 */
.mask { position: fixed; inset: 0; background: rgba(11,28,48,.45); z-index: 100; display: flex; align-items: flex-end; justify-content: center; }
.modal { width: 84%; background: #fff; border-radius: 24rpx; padding: 32rpx 30rpx; margin-bottom: 32vh; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #0b1c30; text-align: center; margin-bottom: 22rpx; }
.modal-input { width: 100%; height: 88rpx; border-radius: 16rpx; border: 1rpx solid rgba(191,199,209,.5); padding: 0 22rpx;
  font-size: 28rpx; background: #fff; box-sizing: border-box; }
.modal-foot { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn { flex: 1; height: 84rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.btn-ghost { border: 1rpx solid rgba(191,199,209,.5); background: #fff; color: #3f4850; }
.btn-primary { flex: 2; background: #006495; color: #fff; font-weight: 700; }

.sheet { width: 100%; background: #f8f9ff; border-radius: 28rpx 28rpx 0 0; max-height: 76vh; display: flex; flex-direction: column;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx 16rpx; }
.sheet-title { font-size: 30rpx; font-weight: 700; color: #0b1c30; }
.sheet-x { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: #e5eeff; display: flex; align-items: center; justify-content: center; }
.sheet-body { flex: 1; overflow: hidden; padding: 0 28rpx; }
.mtarget { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(191,199,209,.2); }
.mtarget-tag { font-size: 28rpx; font-weight: 600; color: #0b1c30; }
.mtarget-count { font-size: 23rpx; color: #6f7881; }
