.page { height: 100vh; background: #f8f9ff; display: flex; flex-direction: column; }
.scroll { flex: 1; overflow: hidden; }

.banner { margin: 20rpx 24rpx 0; border-radius: 16rpx; background: #e1edf7; border: 1rpx solid rgba(0,100,149,.25);
  padding: 20rpx 22rpx; display: flex; gap: 14rpx; align-items: flex-start; }
.banner-txt { font-size: 24rpx; color: #006495; line-height: 1.5; flex: 1; }

.card { margin: 20rpx 24rpx 0; background: #fff; border-radius: 20rpx; border: 1rpx solid rgba(191,199,209,.3); padding: 26rpx 28rpx; }
.card-title { font-size: 27rpx; font-weight: 700; color: #0b1c30; display: block; margin-bottom: 18rpx; }

.phone-row { display: flex; gap: 16rpx; }
.phone-input { flex: 1; height: 84rpx; border-radius: 16rpx; border: 1rpx solid rgba(191,199,209,.5); padding: 0 24rpx;
  font-size: 30rpx; font-family: monospace; letter-spacing: 1rpx; background: #fff; box-sizing: border-box; }
.detect-btn { width: 150rpx; height: 84rpx; border-radius: 16rpx; background: #006495; color: #fff; font-size: 30rpx;
  font-weight: 700; display: flex; align-items: center; justify-content: center; }
.detect-btn--off { background: #e5eeff; color: #6f7881; }

.tip { display: flex; align-items: center; gap: 10rpx; font-size: 26rpx; font-weight: 600; margin-bottom: 20rpx; }
.tip-warn { color: #b86e00; }
.tip-ok { color: #1f8a5b; }

.found { display: flex; align-items: center; gap: 20rpx; padding: 6rpx 0 20rpx; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 999rpx; background: #d9e7f5; color: #006495; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 38rpx; }
.avatar--f { background: #fde4ee; color: #b03a6e; }
.found-mid { display: flex; flex-direction: column; gap: 6rpx; }
.found-name { font-size: 32rpx; font-weight: 700; color: #0b1c30; }
.found-id { font-size: 24rpx; color: #6f7881; }

.form-item { margin-bottom: 22rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label { font-size: 26rpx; font-weight: 600; color: #3f4850; display: block; margin-bottom: 12rpx; }
.form-opt { font-size: 23rpx; font-weight: 400; color: #6f7881; }
.form-input { width: 100%; height: 84rpx; border-radius: 16rpx; border: 1rpx solid rgba(191,199,209,.5); padding: 0 22rpx;
  font-size: 28rpx; background: #fff; box-sizing: border-box; }
.seg { display: flex; background: #eff4ff; border-radius: 14rpx; padding: 5rpx; gap: 5rpx; }
.seg--narrow { width: 300rpx; }
.seg-item { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 11rpx; font-size: 27rpx; color: #3f4850; }
.seg-item--on { background: #fff; color: #006495; font-weight: 700; box-shadow: 0 1rpx 4rpx rgba(0,0,0,.06); }

.modal-field { display: flex; align-items: center; height: 92rpx; border-radius: 16rpx; border: 1rpx solid rgba(191,199,209,.5);
  padding: 0 24rpx; background: #fff; }
.modal-yen { font-size: 30rpx; color: #6f7881; margin-right: 8rpx; }
.modal-input { flex: 1; font-size: 36rpx; font-weight: 700; color: #0b1c30; text-align: right; }

/* 完成 */
.done-head { text-align: center; padding: 10rpx 0 6rpx; }
.done-circle { width: 116rpx; height: 116rpx; border-radius: 999rpx; background: #dff2e7; margin: 0 auto;
  display: flex; align-items: center; justify-content: center; }
.done-title { font-size: 36rpx; font-weight: 700; color: #0b1c30; display: block; margin-top: 18rpx; }
.done-box { background: #eff4ff; border-radius: 16rpx; padding: 22rpx; margin: 24rpx 0; }
.done-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 27rpx; }
.done-k { color: #6f7881; }
.done-v { font-weight: 600; color: #0b1c30; }
.mono { font-family: monospace; }
.done-actions { display: flex; gap: 18rpx; }

/* 开卡礼包 */
.gift-btns { display: flex; gap: 14rpx; }
.gift-btn { flex: 1; height: 72rpx; border-radius: 14rpx; border: 1rpx dashed rgba(0,100,149,.45); background: #f3f8fc;
  color: #006495; font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.gift-list { margin-top: 20rpx; }
.gift-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 4rpx; border-bottom: 1rpx solid rgba(191,199,209,.25); }
.gift-item:last-child { border-bottom: none; }
.gift-mid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.gift-name { font-size: 27rpx; font-weight: 600; color: #0b1c30; }
.gift-sub { font-size: 23rpx; color: #6f7881; }
.gift-del { width: 52rpx; height: 52rpx; border-radius: 999rpx; background: #eff4ff; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; }

/* 选择弹窗（样式对齐 member_detail） */
.mask { position: fixed; inset: 0; background: rgba(11,28,48,.45); z-index: 100; display: flex; align-items: flex-end; justify-content: center; }
.modal { width: 84%; background: #fff; border-radius: 24rpx; padding: 32rpx 30rpx; margin-bottom: 30vh; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #0b1c30; text-align: center; margin-bottom: 24rpx; }
.modal-field--inline { margin-top: 18rpx; justify-content: space-between; height: 80rpx; }
.modal-count-label { font-size: 27rpx; color: #3f4850; }
.modal-count-input { width: 160rpx; text-align: right; font-size: 30rpx; font-weight: 700; color: #0b1c30; }
.modal-list { max-height: 46vh; margin-bottom: 8rpx; }
.opt { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 8rpx; border-bottom: 1rpx solid rgba(191,199,209,.2); }
.opt--on { background: #f3f8fc; }
.opt-radio { width: 38rpx; height: 38rpx; border-radius: 999rpx; border: 2rpx solid rgba(191,199,209,.7); flex-shrink: 0; }
.opt-radio--on { border-color: #006495; background: radial-gradient(circle, #006495 42%, transparent 46%); }
.opt-mid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.opt-name { font-size: 28rpx; font-weight: 600; color: #0b1c30; }
.opt-sub { font-size: 23rpx; color: #6f7881; }
.opt-empty { padding: 40rpx 0; text-align: center; color: #6f7881; font-size: 26rpx; }
.modal-foot { display: flex; gap: 16rpx; margin-top: 24rpx; }

/* 完成页发放结果 */
.grant-results { background: #fff; border: 1rpx solid rgba(191,199,209,.3); border-radius: 16rpx; padding: 8rpx 22rpx; margin-bottom: 24rpx; }
.grant-row { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid rgba(191,199,209,.2); }
.grant-row:last-of-type { border-bottom: none; }
.grant-label { font-size: 26rpx; color: #0b1c30; }
.grant-label--fail { color: #b91c1c; }
.grant-fail-tip { font-size: 23rpx; color: #b86e00; padding: 12rpx 0 10rpx; }

.bottom-pad { height: 30rpx; }
.footer { flex-shrink: 0; background: #fff; border-top: 1rpx solid rgba(191,199,209,.4); padding: 16rpx 24rpx; display: flex; gap: 18rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }

.btn { flex: 1; height: 88rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 600; }
.btn-ghost { border: 1rpx solid rgba(191,199,209,.5); background: #fff; color: #3f4850; }
.btn-primary { flex: 2; background: #006495; color: #fff; font-weight: 700; }
.btn-full { width: 100%; flex: none; }
