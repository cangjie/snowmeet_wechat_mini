<view class="page" wx:if="{{member}}">
  <scroll-view class="scroll" scroll-y>
    <!-- 资料卡 -->
    <view class="card head">
      <view class="head-top">
        <view class="avatar {{member.female ? 'avatar--f' : ''}}">{{member.avatar}}</view>
        <view class="head-mid">
          <view class="head-line1">
            <text class="head-name">{{member.name}}</text>
            <text wx:if="{{member.gender}}" class="gchip {{member.female ? 'gchip--f' : ''}}">{{member.gender}}</text>
          </view>
          <view class="head-phone" bindtap="callPhone">
            <van-icon name="phone-o" size="15px" color="#006495" /><text class="head-phone-txt">{{member.phone || '未绑定手机号'}}</text>
          </view>
        </view>
        <view class="head-edit" catchtap="onEditProfile"><van-icon name="edit" size="13px" color="#006495" /><text class="head-edit-txt">编辑</text></view>
        <view wx:if="{{isAdmin}}" class="head-edit head-edit--merge" catchtap="onMergeOpen"><van-icon name="exchange" size="13px" color="#ba1a1a" /><text class="head-edit-txt head-edit-txt--merge">合并</text></view>
      </view>
      <view class="head-grid">
        <view class="kv"><text class="kv-k">会员 ID</text><text class="kv-v mono">{{member.id}}</text></view>
        <view class="kv"><text class="kv-k">来源</text><text class="kv-v">{{member.source || '—'}}</text></view>
      </view>
    </view>

    <!-- 储值 & 龙珠 -->
    <view class="card">
      <view class="card-title"><van-icon name="balance-o" size="16px" color="#006495" /><text class="card-title-txt">储值与龙珠</text></view>
      <view class="asset-row">
        <view class="asset-cell">
          <text class="asset-label">储值合计（C 类）</text>
          <text class="asset-big">{{member.depositTotalStr}}</text>
        </view>
        <view class="asset-cell asset-cell--r">
          <text class="asset-label">可用龙珠</text>
          <text class="asset-points">{{member.points}}</text>
        </view>
      </view>
    </view>

    <!-- 标签 -->
    <view class="card">
      <view class="card-title">
        <van-icon name="label-o" size="16px" color="#006495" /><text class="card-title-txt">标签</text>
        <view class="card-edit" bindtap="onEditTags"><van-icon name="edit" size="13px" color="#006495" /><text class="card-edit-txt">编辑</text></view>
      </view>
      <view class="tag-sub">系统标签 · 按参与业务自动生成</view>
      <view class="tag-wrap">
        <text wx:for="{{member.sys}}" wx:key="*this" class="chip chip--sys">{{item}}</text>
        <text wx:if="{{member.sys.length === 0}}" class="tag-none">暂无</text>
      </view>
      <view class="tag-sub tag-sub--mt">自定义标签</view>
      <view class="tag-wrap">
        <text wx:for="{{member.custom}}" wx:key="*this" class="chip chip--custom">{{item}}</text>
        <text wx:if="{{member.custom.length === 0}}" class="tag-none">暂无</text>
      </view>
    </view>

    <!-- 绑定账户 -->
    <view class="card">
      <view class="card-title"><van-icon name="link-o" size="16px" color="#006495" /><text class="card-title-txt">绑定账户</text></view>
      <view class="acc-row"><text class="acc-k">微信</text><text class="acc-v">{{member.accounts.wechatOpenId ? '已绑定' : '未绑定'}}</text></view>
      <view class="acc-row"><text class="acc-k">支付宝</text><text class="acc-v">{{member.accounts.alipayPayerId ? '已绑定' : '未绑定'}}</text></view>
      <view class="acc-row"><text class="acc-k">手机号</text><text class="acc-v mono">{{member.accounts.cell || '未绑定'}}</text></view>
      <view wx:if="{{member.contactCellsStr}}" class="acc-row"><text class="acc-k">联系手机号</text><text class="acc-v mono">{{member.contactCellsStr}}</text></view>
    </view>

    <!-- 名下次卡 -->
    <view class="card" wx:if="{{member.punchCards.length > 0}}">
      <view class="card-title"><van-icon name="coupon-o" size="16px" color="#006495" /><text class="card-title-txt">名下次卡</text></view>
      <!-- 整行可点，进这张卡的核销记录（与顾客侧「我的次卡」同一个页面、同一套展示口径） -->
      <view wx:for="{{member.punchCards}}" wx:key="id" class="punch-row {{item.isRefund ? 'punch-row--refunded' : ''}}"
            data-id="{{item.id}}" bindtap="onPunchCardTap">
        <view class="punch-l"><text class="punch-name">{{item.card_name}}</text><text class="punch-biz">{{item.biz_type}}</text></view>
        <view class="punch-r">
          <text wx:if="{{item.isRefund}}" class="punch-remain punch-remain--refunded">已退款</text>
          <text wx:elif="{{item.isSeason}}" class="punch-remain">季卡 · 不限次数</text>
          <text wx:else class="punch-remain">剩余 {{item.remaining}} / {{item.total}} 次</text>
          <text class="punch-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 最近订单 -->
    <view class="card" wx:if="{{member.recentOrders.length > 0}}">
      <view class="card-title"><van-icon name="orders-o" size="16px" color="#006495" /><text class="card-title-txt">最近订单</text></view>
      <scroll-view class="otab" scroll-x wx:if="{{orderTabs.length > 1}}">
        <view wx:for="{{orderTabs}}" wx:key="*this" class="otab-item {{orderTab === item ? 'otab-item--on' : ''}}"
              data-t="{{item}}" bindtap="onOrderTab">{{item}}</view>
      </scroll-view>
      <view wx:for="{{filteredOrders}}" wx:key="id" class="order-row order-row--tap" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="gotoOrder">
        <view class="order-l"><text class="order-code mono">{{item.code}}</text><text class="order-meta">{{item.type}} · {{item.dateStr}}</text></view>
        <van-icon name="arrow" size="15px" color="#bfc7d1" />
      </view>
      <view wx:if="{{filteredOrders.length === 0}}" class="order-empty">该分类暂无订单</view>
    </view>

    <!-- 名下优惠券（可折叠，与最近订单平行） -->
    <view class="card">
      <view class="card-title card-title--tap" bindtap="onCouponToggle">
        <van-icon name="coupon-o" size="16px" color="#006495" />
        <text class="card-title-txt">名下优惠券<text wx:if="{{couponLoaded}}" class="cp-total"> · {{couponCounts.total}} 张</text></text>
        <van-icon name="{{couponOpen ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#bfc7d1" />
      </view>

      <block wx:if="{{couponOpen}}">
        <view wx:if="{{couponLoading}}" class="order-empty">加载中…</view>
        <block wx:else>
          <scroll-view class="otab" scroll-x>
            <view wx:for="{{couponTabs}}" wx:key="key" class="otab-item {{couponTab === item.key ? 'otab-item--on' : ''}}"
                  data-k="{{item.key}}" bindtap="onCouponTab">{{item.name}} {{couponCounts[item.key]}}</view>
          </scroll-view>

          <view wx:for="{{filteredCoupons}}" wx:key="code" class="cp-row" data-code="{{item.code}}" bindtap="gotoCoupon">
            <view class="cp-main">
              <view class="cp-head">
                <text class="cp-name">{{item.templateName || item.name}}</text>
                <view class="cp-state cp-state--{{item.stateCls}}">{{item.stateLabel}}</view>
                <view class="cp-state cp-state--invalid" wx:if="{{item.showInvalid}}">无效</view>
                <view class="cp-state cp-state--inactive" wx:if="{{item.showInactive}}">未激活</view>
              </view>
              <text class="cp-meta mono">{{item.code}}</text>
              <text class="cp-meta">{{item.metaLine}}</text>
              <text class="cp-transfer" wx:if="{{item.transferText}}">{{item.transferText}}</text>
            </view>
            <van-icon name="arrow" size="15px" color="#bfc7d1" />
          </view>

          <view wx:if="{{filteredCoupons.length === 0}}" class="order-empty">该分类暂无优惠券</view>
        </block>
      </block>
    </view>

    <view class="bottom-pad"></view>
  </scroll-view>

  <!-- 底部操作条 -->
  <view class="actionbar">
    <view class="act act-ghost" bindtap="onCouponOpen"><van-icon name="gift-o" size="17px" color="#0b1c30" /><text>发券</text></view>
    <view class="act act-ghost" bindtap="onPunchOpen"><van-icon name="card" size="17px" color="#0b1c30" /><text>加次卡</text></view>
    <view class="act act-primary" bindtap="onChargeOpen"><van-icon name="gold-coin-o" size="17px" color="#fff" /><text class="act-primary-txt">充值储值</text></view>
  </view>
</view>

<view wx:else class="loading-tip">加载中…</view>

<!-- ───── 标签编辑弹层 ───── -->
<view wx:if="{{tagSheetShow}}" class="mask" bindtap="onTagSheetClose" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head"><text class="sheet-title">编辑自定义标签</text>
      <view class="sheet-x" bindtap="onTagSheetClose"><van-icon name="cross" size="18px" color="#3f4850" /></view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view class="sheet-sub">当前标签 <text class="sheet-sub-n">{{tagSel.length}}</text></view>
      <view class="tag-wrap">
        <view wx:for="{{tagSel}}" wx:key="*this" class="sel-chip">{{item}}
          <text class="sel-chip-x" data-v="{{item}}" catchtap="onTagRemove">×</text>
        </view>
        <text wx:if="{{tagSel.length === 0}}" class="tag-none">暂无，点下方标签或手动添加</text>
      </view>
      <view class="sheet-add">
        <input class="sheet-input" value="{{tagInput}}" bindinput="onTagInput" placeholder="输入新标签" confirm-type="done" bindconfirm="onTagAdd" />
        <view class="sheet-add-btn" bindtap="onTagAdd">添加</view>
      </view>
      <view class="sheet-sub sheet-sub--mt">从标签库选择</view>
      <view class="tag-wrap">
        <view wx:for="{{presetTagsView}}" wx:key="name" class="tag-pick {{item.on ? 'tag-pick--on' : ''}}"
              data-v="{{item.name}}" bindtap="onTagToggle">{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="sheet-foot">
      <view class="btn btn-ghost" bindtap="onTagSheetClose">取消</view>
      <view class="btn btn-primary" bindtap="onTagSave">保存（{{tagSel.length}}）</view>
    </view>
  </view>
</view>

<!-- ───── 充值储值（类型/七色米订单号/备注/金额 四项） ───── -->
<view wx:if="{{chargeShow}}" class="mask" bindtap="onChargeClose" catchtouchmove="noop">
  <view class="modal" catchtap="noop">
    <view class="modal-title">充值储值（C 类）</view>
    <view class="charge-row">
      <text class="charge-label">充值类型</text>
      <view class="charge-types">
        <view wx:for="{{chargeTypes}}" wx:key="*this" class="ct-chip {{chargeType === item ? 'ct-chip--on' : ''}}" data-v="{{item}}" bindtap="onChargeTypeTap">{{item}}</view>
      </view>
    </view>
    <view class="charge-row">
      <text class="charge-label">七色米订单号<text class="charge-opt">（选填）</text></text>
      <input class="charge-input" value="{{chargeMi7}}" bindinput="onChargeMi7Input" placeholder="如：XSD20260701001I" />
    </view>
    <view class="charge-row">
      <text class="charge-label">备注<text class="charge-opt">（选填）</text></text>
      <input class="charge-input" value="{{chargeMemo}}" bindinput="onChargeMemoInput" placeholder="备注" />
    </view>
    <view class="charge-row">
      <text class="charge-label">金额</text>
      <view class="modal-field">
        <text class="modal-yen">¥</text>
        <input class="modal-input" type="digit" value="{{chargeAmount}}" bindinput="onChargeInput" placeholder="0.00" />
      </view>
    </view>
    <view class="modal-foot">
      <view class="btn btn-ghost" bindtap="onChargeClose">取消</view>
      <view class="btn btn-primary" bindtap="onChargeConfirm">确认充值</view>
    </view>
  </view>
</view>

<!-- ───── 加次卡 ───── -->
<view wx:if="{{punchShow}}" class="mask" bindtap="onPunchClose" catchtouchmove="noop">
  <view class="modal" catchtap="noop">
    <view class="modal-title">发放次卡</view>
    <scroll-view class="modal-list" scroll-y>
      <!-- 卡种来自次卡/季卡商品目录，key 用 productId（卡名可能重名） -->
      <view wx:for="{{punchPresets}}" wx:key="productId" class="opt {{punchSelIdx === index ? 'opt--on' : ''}}"
            data-idx="{{index}}" bindtap="onPunchSelect">
        <view class="opt-radio {{punchSelIdx === index ? 'opt-radio--on' : ''}}"></view>
        <view class="opt-mid">
          <text class="opt-name">{{item.card_name}}</text>
          <text class="opt-sub">
            {{item.biz_type}}{{item.card_type}} · {{item.isSeason ? '不限次数' : item.total + ' 次'}}{{item.onShelves ? '' : ' · 已下架'}}
          </text>
        </view>
      </view>
      <view wx:if="{{punchPresets.length === 0}}" class="opt-empty">暂无可发放卡种</view>
    </scroll-view>
    <view class="modal-foot">
      <view class="btn btn-ghost" bindtap="onPunchClose">取消</view>
      <view class="btn btn-primary" bindtap="onPunchConfirm">确认发卡</view>
    </view>
  </view>
</view>

<!-- ───── 发券 ───── -->
<view wx:if="{{couponShow}}" class="mask" bindtap="onCouponClose" catchtouchmove="noop">
  <view class="modal" catchtap="noop">
    <view class="modal-title">发放优惠券</view>
    <scroll-view class="modal-list" scroll-y>
      <view wx:for="{{couponTemplates}}" wx:key="id" class="opt {{couponSelId === item.id ? 'opt--on' : ''}}"
            data-id="{{item.id}}" bindtap="onCouponSelect">
        <view class="opt-radio {{couponSelId === item.id ? 'opt-radio--on' : ''}}"></view>
        <view class="opt-mid"><text class="opt-name">{{item.name}}</text><text class="opt-sub">{{item.type}}</text></view>
      </view>
      <view wx:if="{{couponTemplates.length === 0}}" class="opt-empty">暂无可发放券模板</view>
    </scroll-view>
    <view class="modal-field modal-field--inline">
      <text class="modal-count-label">数量</text>
      <input class="modal-count-input" type="number" value="{{couponCount}}" bindinput="onCouponCountInput" placeholder="1" />
    </view>
    <view class="modal-foot">
      <view class="btn btn-ghost" bindtap="onCouponClose">取消</view>
      <view class="btn btn-primary" bindtap="onCouponConfirm">确认发券</view>
    </view>
  </view>
</view>

<!-- ───── 会员合并：搜索目标会员弹层 ───── -->
<view wx:if="{{mergeShow}}" class="mask" bindtap="onMergeClose" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head"><text class="sheet-title">合并到其他会员</text>
      <view class="sheet-x" bindtap="onMergeClose"><van-icon name="cross" size="18px" color="#3f4850" /></view>
    </view>
    <view class="merge-warn">当前会员（{{member.name}} · ID {{member.id}}）的订单、储值、龙珠、次卡、优惠券将全部转移到所选会员名下，当前会员随即失效。此操作不可撤销。</view>
    <view class="sheet-add merge-search">
      <input class="sheet-input" value="{{mergeKeyword}}" bindinput="onMergeInput" placeholder="输入手机号 / 姓名搜索" confirm-type="search" bindconfirm="onMergeSearch" />
      <view class="sheet-add-btn" bindtap="onMergeSearch">搜索</view>
    </view>
    <scroll-view class="sheet-body merge-body" scroll-y>
      <view wx:for="{{mergeResults}}" wx:key="id" class="opt" data-idx="{{index}}" bindtap="onMergeSelect">
        <view class="opt-mid">
          <text class="opt-name">{{item.name}}{{item.gender ? '（' + item.gender + '）' : ''}}</text>
          <text class="opt-sub mono">ID {{item.id}} · {{item.phone || '无手机号'}}</text>
        </view>
        <van-icon name="arrow" size="15px" color="#bfc7d1" />
      </view>
      <view wx:if="{{mergeSearched && mergeResults.length === 0}}" class="opt-empty">未找到匹配会员</view>
      <view wx:if="{{!mergeSearched}}" class="opt-empty">输入手机号或姓名后点搜索</view>
    </scroll-view>
  </view>
</view>

<!-- ───── 编辑会员资料（姓名/性别/手机号）───── -->
<view wx:if="{{profileShow}}" class="mask" bindtap="onProfileClose" catchtouchmove="noop">
  <view class="modal" catchtap="noop">
    <view class="modal-title">编辑资料</view>
    <view class="pf-item">
      <text class="pf-label">姓名</text>
      <input class="pf-input" value="{{pf.name}}" bindinput="onPfNameInput" placeholder="姓名 / 称呼" />
    </view>
    <view class="pf-item">
      <text class="pf-label">性别</text>
      <view class="seg">
        <view class="seg-item {{pf.gender === '男' ? 'seg-item--on' : ''}}" data-v="男" bindtap="onPfGenderTap">男</view>
        <view class="seg-item {{pf.gender === '女' ? 'seg-item--on' : ''}}" data-v="女" bindtap="onPfGenderTap">女</view>
      </view>
    </view>
    <view class="pf-item">
      <text class="pf-label">手机号</text>
      <input class="pf-input mono" value="{{pf.cell}}" bindinput="onPfCellInput" type="number" placeholder="11 位手机号" />
    </view>
    <view class="modal-foot">
      <view class="btn btn-ghost" bindtap="onProfileClose">取消</view>
      <view class="btn btn-primary" bindtap="onProfileSave">保存</view>
    </view>
  </view>
</view>
