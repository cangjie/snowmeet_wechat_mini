<view class="page">
  <scroll-view class="scroll" scroll-y>
    <view class="banner">
      <van-icon name="info-o" size="18px" color="#006495" />
      <text class="banner-txt">远程注册：顾客不在店时，仅凭手机号即可创建会员并办理业务。一个手机号只能认证一个会员。</text>
    </view>

    <!-- 手机号检测 -->
    <view class="card">
      <text class="card-title">会员手机号</text>
      <view class="phone-row">
        <input class="phone-input" value="{{phone}}" bindinput="onPhoneInput" type="number" placeholder="输入 11 位手机号" />
        <view class="detect-btn {{phone.length === 11 ? '' : 'detect-btn--off'}}" bindtap="onDetect">检测</view>
      </view>
    </view>

    <!-- 已存在 -->
    <view wx:if="{{phase === 'existing'}}" class="card">
      <view class="tip tip-warn"><van-icon name="info-o" size="17px" color="#b86e00" /><text>该手机号已是会员，可直接办理业务</text></view>
      <view class="found">
        <view class="avatar {{found.gender === '女' ? 'avatar--f' : ''}}">{{found.real_name ? found.real_name[0] : (found.name ? found.name[0] : '?')}}</view>
        <view class="found-mid">
          <text class="found-name">{{found.real_name || found.name || '会员'}}</text>
          <text class="found-id">会员 ID {{found.id}}</text>
        </view>
      </view>
      <view class="btn btn-primary btn-full" bindtap="gotoExisting">进入会员详情</view>
    </view>

    <!-- 新建表单 -->
    <block wx:if="{{phase === 'new'}}">
      <view class="card">
        <view class="tip tip-ok"><van-icon name="checked" size="17px" color="#1f8a5b" /><text>手机号未注册，将创建新会员</text></view>
        <view class="form-item">
          <text class="form-label">姓名 / 称呼<text class="form-opt">（选填）</text></text>
          <input class="form-input" value="{{form.name}}" bindinput="onNameInput" placeholder="如：王女士" />
        </view>
        <view class="form-item">
          <text class="form-label">性别</text>
          <view class="seg seg--narrow">
            <view class="seg-item {{form.gender === '男' ? 'seg-item--on' : ''}}" data-v="男" bindtap="onGenderTap">男</view>
            <view class="seg-item {{form.gender === '女' ? 'seg-item--on' : ''}}" data-v="女" bindtap="onGenderTap">女</view>
          </view>
        </view>
      </view>
      <view class="card">
        <text class="card-title">初始储值<text class="form-opt">（选填 · C 类）</text></text>
        <view wx:if="{{!depositCfg}}" class="gift-btns">
          <view class="gift-btn" bindtap="onDepositOpen">＋ 添加储值</view>
        </view>
        <view wx:else class="gift-list gift-list--flat">
          <view class="gift-item">
            <view class="gift-mid" bindtap="onDepositOpen">
              <text class="gift-name">{{depositCfg.chargeType}} · {{depositCfg.amountStr}}</text>
              <text class="gift-sub">{{depositCfg.subStr || '点击修改'}}</text>
            </view>
            <view class="gift-del" bindtap="onDepositRemove"><van-icon name="cross" size="14px" color="#6f7881" /></view>
          </view>
        </view>
      </view>
      <view class="card">
        <text class="card-title">开卡礼包<text class="form-opt">（选填）</text></text>
        <view class="gift-btns">
          <view class="gift-btn" bindtap="onAddCoupon">＋ 优惠券</view>
          <view class="gift-btn" bindtap="onAddRentPunch">＋ 租赁次卡</view>
          <view class="gift-btn" bindtap="onAddCarePunch">＋ 养护次卡</view>
        </view>
        <view wx:if="{{grants.length > 0}}" class="gift-list">
          <view wx:for="{{grants}}" wx:key="index" class="gift-item">
            <view class="gift-mid">
              <text class="gift-name">{{item.name}}</text>
              <text class="gift-sub">{{item.subStr}}</text>
            </view>
            <view class="gift-del" data-idx="{{index}}" bindtap="onGrantRemove"><van-icon name="cross" size="14px" color="#6f7881" /></view>
          </view>
        </view>
      </view>
    </block>

    <!-- 完成 -->
    <view wx:if="{{phase === 'done'}}" class="card">
      <view class="done-head">
        <view class="done-circle"><van-icon name="success" size="34px" color="#1f8a5b" /></view>
        <text class="done-title">注册成功</text>
      </view>
      <view class="done-box">
        <view class="done-row"><text class="done-k">会员 ID</text><text class="done-v mono">{{newMember.id}}</text></view>
        <view class="done-row"><text class="done-k">手机号</text><text class="done-v mono">{{newMember.phone}}</text></view>
        <view class="done-row"><text class="done-k">姓名</text><text class="done-v">{{newMember.name}}</text></view>
        <view class="done-row"><text class="done-k">初始储值</text><text class="done-v">{{newMember.depositStr}}</text></view>
      </view>
      <view wx:if="{{grantResults.length > 0}}" class="grant-results">
        <view wx:for="{{grantResults}}" wx:key="index" class="grant-row">
          <van-icon wx:if="{{item.ok}}" name="success" size="15px" color="#15803d" />
          <van-icon wx:else name="cross" size="15px" color="#b91c1c" />
          <text class="grant-label {{item.ok ? '' : 'grant-label--fail'}}">{{item.label}}</text>
        </view>
        <view wx:if="{{grantFailed}}" class="grant-fail-tip">部分发放失败，可到会员详情页补发</view>
      </view>
      <view class="done-actions">
        <view class="btn btn-ghost" bindtap="onReset">再注册一个</view>
        <view class="btn btn-primary" bindtap="gotoNew">查看会员详情</view>
      </view>
    </view>

    <view class="bottom-pad"></view>
  </scroll-view>

  <!-- 底部提交（新建表单时） -->
  <view wx:if="{{phase === 'new'}}" class="footer">
    <view class="btn btn-ghost" bindtap="onReset">重置</view>
    <view class="btn btn-primary" bindtap="onSubmit">注册会员</view>
  </view>

  <!-- 优惠券选择弹窗 -->
  <view wx:if="{{couponPickShow}}" class="mask" bindtap="onCouponPickClose" catchtouchmove="noop">
    <view class="modal" catchtap="noop">
      <view class="modal-title">选择优惠券</view>
      <scroll-view class="modal-list" scroll-y>
        <view wx:for="{{couponTemplates}}" wx:key="id" class="opt {{couponSelId === item.id ? 'opt--on' : ''}}" data-id="{{item.id}}" bindtap="onCouponPickSelect">
          <view class="opt-radio {{couponSelId === item.id ? 'opt-radio--on' : ''}}"></view>
          <view class="opt-mid">
            <text class="opt-name">{{item.name}}</text>
            <text class="opt-sub">{{item.type}}</text>
          </view>
        </view>
        <view wx:if="{{couponTemplates.length === 0}}" class="opt-empty">加载中…</view>
      </scroll-view>
      <view class="modal-field modal-field--inline">
        <text class="modal-count-label">数量</text>
        <input class="modal-count-input" type="number" value="{{couponCount}}" bindinput="onCouponCountInput" placeholder="1" />
      </view>
      <view class="modal-foot">
        <view class="btn btn-ghost" bindtap="onCouponPickClose">取消</view>
        <view class="btn btn-primary" bindtap="onCouponPickConfirm">加入礼包</view>
      </view>
    </view>
  </view>

  <!-- 初始储值弹窗（类型/七色米订单号/备注/金额 四项） -->
  <view wx:if="{{depositShow}}" class="mask" bindtap="onDepositModalClose" catchtouchmove="noop">
    <view class="modal" catchtap="noop">
      <view class="modal-title">初始储值（C 类）</view>
      <view class="charge-row">
        <text class="charge-label">充值类型</text>
        <view class="charge-types">
          <view wx:for="{{chargeTypes}}" wx:key="*this" class="ct-chip {{depositType === item ? 'ct-chip--on' : ''}}" data-v="{{item}}" bindtap="onDepositTypeTap">{{item}}</view>
        </view>
      </view>
      <view class="charge-row">
        <text class="charge-label">七色米订单号<text class="charge-opt">（选填）</text></text>
        <input class="charge-input" value="{{depositMi7}}" bindinput="onDepositMi7Input" placeholder="如：XSD20260701001I" />
      </view>
      <view class="charge-row">
        <text class="charge-label">备注<text class="charge-opt">（选填）</text></text>
        <input class="charge-input" value="{{depositMemo}}" bindinput="onDepositMemoInput" placeholder="备注" />
      </view>
      <view class="charge-row">
        <text class="charge-label">金额</text>
        <view class="modal-field">
          <text class="modal-yen">¥</text>
          <input class="modal-input" type="digit" value="{{depositAmount}}" bindinput="onDepositAmountInput" placeholder="0.00" />
        </view>
      </view>
      <view class="modal-foot">
        <view class="btn btn-ghost" bindtap="onDepositModalClose">取消</view>
        <view class="btn btn-primary" bindtap="onDepositModalConfirm">确定</view>
      </view>
    </view>
  </view>

  <!-- 次卡选择弹窗（租赁/养护共用，标题随 punchPickBiz） -->
  <view wx:if="{{punchPickShow}}" class="mask" bindtap="onPunchPickClose" catchtouchmove="noop">
    <view class="modal" catchtap="noop">
      <view class="modal-title">选择{{punchPickBiz}}次卡</view>
      <scroll-view class="modal-list" scroll-y>
        <view wx:for="{{punchPickList}}" wx:key="index" class="opt {{punchSelIdx === index ? 'opt--on' : ''}}" data-idx="{{index}}" bindtap="onPunchPickSelect">
          <view class="opt-radio {{punchSelIdx === index ? 'opt-radio--on' : ''}}"></view>
          <view class="opt-mid">
            <text class="opt-name">{{item.card_name}}</text>
            <text class="opt-sub">{{item.biz_type}} · {{item.total}} 次</text>
          </view>
        </view>
        <view wx:if="{{punchPickList.length === 0}}" class="opt-empty">加载中…</view>
      </scroll-view>
      <view class="modal-foot">
        <view class="btn btn-ghost" bindtap="onPunchPickClose">取消</view>
        <view class="btn btn-primary" bindtap="onPunchPickConfirm">加入礼包</view>
      </view>
    </view>
  </view>
</view>
