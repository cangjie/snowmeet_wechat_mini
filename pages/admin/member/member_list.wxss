.page { min-height: 100vh; background: #f8f9ff; padding-bottom: 24rpx; }

/* 顶部条 */
.appbar { height: 88rpx; background: #fff; display: flex; align-items: center; justify-content: space-between;
  padding: 0 24rpx; border-bottom: 1rpx solid rgba(191,199,209,.3); position: sticky; top: 0; z-index: 30; }
.appbar-title { font-size: 34rpx; font-weight: 700; color: #006495; }
.appbar-add { display: flex; align-items: center; gap: 6rpx; }
.appbar-add-txt { font-size: 26rpx; color: #006495; font-weight: 600; }

/* 筛选 */
.filter { background: #fff; border-bottom: 1rpx solid rgba(191,199,209,.25); }
.filter-head { display: flex; align-items: center; gap: 12rpx; padding: 24rpx; }
.filter-title { font-size: 28rpx; font-weight: 700; color: #0b1c30; }
.filter-badge { min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; background: #006495; color: #fff;
  font-size: 20rpx; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
.filter-arrow { margin-left: auto; }
.filter-body { padding: 0 24rpx 24rpx; }

.field { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.field-label { font-size: 26rpx; font-weight: 600; color: #3f4850; width: 110rpx; flex-shrink: 0; }
.field-input { flex: 1; height: 72rpx; border-radius: 14rpx; border: 1rpx solid rgba(191,199,209,.5);
  padding: 0 20rpx; font-size: 27rpx; color: #0b1c30; background: #fff; box-sizing: border-box; }

.seg { flex: 1; display: flex; background: #eff4ff; border-radius: 14rpx; padding: 5rpx; gap: 5rpx; }
.seg-item { flex: 1; height: 60rpx; line-height: 60rpx; text-align: center; border-radius: 11rpx; font-size: 26rpx; color: #3f4850; }
.seg-item--on { background: #fff; color: #006495; font-weight: 700; box-shadow: 0 1rpx 4rpx rgba(0,0,0,.06); }

.tag-group { padding: 14rpx 0; }
.tag-group-label { font-size: 26rpx; font-weight: 600; color: #3f4850; display: block; margin-bottom: 14rpx; }
.tag-group-hint { font-size: 22rpx; font-weight: 400; color: #6f7881; }
.tag-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag-pick { height: 58rpx; line-height: 58rpx; padding: 0 22rpx; border-radius: 999rpx; font-size: 25rpx;
  border: 1rpx solid rgba(191,199,209,.5); background: #fff; color: #3f4850; }
.tag-pick--on { border-color: #006495; background: #e1edf7; color: #006495; font-weight: 700; }

.filter-actions { display: flex; gap: 18rpx; margin-top: 22rpx; }
.btn { flex: 1; height: 84rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx;
  font-size: 28rpx; font-weight: 600; }
.btn-ghost { border: 1rpx solid rgba(191,199,209,.5); background: #fff; color: #3f4850; }
.btn-primary { flex: 2; background: #006495; color: #fff; font-weight: 700; }
.btn-txt { color: #fff; }

/* 统计 */
.stats { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 24rpx; background: #eff4ff;
  border-bottom: 1rpx solid rgba(191,199,209,.2); }
.stats-item { font-size: 25rpx; color: #3f4850; }
.stats-num { font-size: 30rpx; font-weight: 700; color: #006495; }
.stats-num--ink { color: #0b1c30; }
.stats-sep { color: rgba(191,199,209,.6); }

/* 列表 */
.list { padding: 18rpx 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
.mcard { background: #fff; border-radius: 22rpx; border: 1rpx solid rgba(191,199,209,.3); overflow: hidden; }
.mcard-main { display: flex; align-items: flex-start; gap: 20rpx; padding: 22rpx 24rpx 16rpx; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 999rpx; background: #d9e7f5; color: #006495; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 32rpx; }
.avatar--f { background: #fde4ee; color: #b03a6e; }
.mcard-mid { flex: 1; min-width: 0; }
.mcard-line1 { display: flex; align-items: center; gap: 12rpx; }
.mcard-name { font-size: 30rpx; font-weight: 700; color: #0b1c30; }
.gchip { font-size: 21rpx; font-weight: 600; padding: 1rpx 12rpx; border-radius: 999rpx; background: #dceaff; color: #0a5d8c; }
.gchip--f { background: #fde4ee; color: #b03a6e; }
.mcard-phone { font-size: 26rpx; color: #3f4850; margin-top: 6rpx; display: block; font-family: monospace; }
.mcard-right { flex-shrink: 0; text-align: right; }
.mcard-dep-label { font-size: 21rpx; color: #6f7881; }
.mcard-dep { font-size: 30rpx; font-weight: 700; color: #006495; }
.mcard-points { font-size: 22rpx; color: #6f7881; margin-top: 8rpx; }
.mcard-tags { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 0 24rpx 18rpx; }
.chip { font-size: 22rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 8rpx; }
.chip--sys { background: #cbe6ff; color: #0a5d8c; }
.chip--custom { background: #e5eeff; color: #3f4850; }

.empty { padding: 100rpx 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-txt { font-size: 27rpx; color: #6f7881; }
