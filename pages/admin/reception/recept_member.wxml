<!--pages/admin/reception/recept_member.wxml
  接待·顾客信息（对应旧版 recept_member_info）：直接显示并可修改顾客信息 → 选店铺 → 选业务进入开单
  修改只用于本次订单；会员点「更新顾客信息」才改会员资料
  样式沿用 recept_entry.wxss（Alpine Operational Minimalist stitch _1）
-->
<view class="page-root">

  <safe-nav-bar title="顾客信息" homeUrl="/pages/admin/reception/recept_scan" />

  <view class="main">

    <!-- 新顾客：等顾客在手机上授权手机号 -->
    <view wx:if="{{waitingPhone}}" class="card member-waiting">
      <van-loading size="24px" color="#006495"/>
      <view class="member-waiting-title">顾客已扫码，正在手机上授权手机号…</view>
      <view class="member-waiting-sub">顾客授权后这里会弹出提示，再选择店铺和业务开单</view>
      <view class="member-waiting-link" bindtap="onWalkInInstead">顾客不方便授权，按散客开单</view>
    </view>

    <!-- 顾客基本信息 -->
    <view wx:else class="card customer-card">
      <view class="card-header">
        <van-icon name="manager-o" size="18px" color="#006495"/>
        <text class="card-title">顾客基本信息</text>
        <view class="member-type {{member ? 'member-type--member' : ''}}">{{member ? '会员' : '散客'}}</view>
        <view wx:if="{{member}}" class="member-detail-link" bindtap="onMemberDetail">
          <text>查看详情</text>
          <van-icon name="arrow" size="14px" color="#006495"/>
        </view>
      </view>

      <view wx:if="{{member}}" class="info-row">
        <text class="info-label">绑定手机号</text>
        <text class="info-value">{{member.cell || '未绑定手机'}}</text>
      </view>

      <view class="form-group">
        <view class="form-label">联系电话</view>
        <input
          class="form-input"
          type="number"
          maxlength="20"
          placeholder="{{member ? '输入联系电话' : '输入联系电话（选填，国际区号用 00）'}}"
          placeholder-class="form-input-placeholder"
          value="{{form.cell}}"
          bindinput="onCellInput"/>
        <view wx:if="{{otherNums.length > 0}}" class="num-chips">
          <text class="num-chips-label">其他号码</text>
          <view wx:for="{{otherNums}}" wx:key="*this" class="num-chip" data-num="{{item}}" bindtap="onPickNum">{{item}}</view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">顾客称呼</view>
        <view class="name-row">
          <input
            class="form-input name-input"
            placeholder="您贵姓？"
            placeholder-class="form-input-placeholder"
            value="{{form.name}}"
            maxlength="20"
            bindinput="onNameInput"/>
          <view class="seg-control name-gender">
            <view class="seg-item {{form.gender === '男' ? 'active' : ''}}" data-value="男" bindtap="onGenderTap">先生</view>
            <view class="seg-item {{form.gender === '女' ? 'active' : ''}}" data-value="女" bindtap="onGenderTap">女士</view>
          </view>
        </view>
      </view>

      <view wx:if="{{member}}" class="info-row">
        <text class="info-label">可用储值</text>
        <text class="info-value">{{member.availableDepositStr}}</text>
        <text class="info-label info-label--gap">可用龙珠</text>
        <text class="info-value">{{member.availablePoints}}</text>
      </view>

      <view wx:if="{{member}}"
        class="update-btn {{needUpdate ? '' : 'update-btn--disabled'}}"
        bindtap="onUpdateMemberTap">更新顾客信息</view>
      <view class="form-tip">{{member ? '修改的电话和称呼只用于本次订单；点「更新顾客信息」才会改会员资料。' : '散客的电话和称呼都可以不填。'}}</view>
    </view>

    <!-- 选择店铺：shop-selector 内部调 Order/GetShops + beacon 自动选店 -->
    <view class="shop-card">
      <view class="shop-card-icon">
        <van-icon name="location-o" size="16px" color="#545f73"/>
      </view>
      <text class="shop-card-label">当前店铺</text>
      <view class="shop-card-picker">
        <shop-selector
          scene="recept"
          bindShopSelected="shopSelected" />
      </view>
      <van-icon name="arrow-down" size="16px" color="#6f7881"/>
    </view>

    <!-- 测试订单：勾选后本次开的单记为测试单（order.is_test=1） -->
    <view class="test-row {{isTest ? 'test-row--on' : ''}}" bindtap="onTestToggle">
      <view class="test-box">
        <van-icon wx:if="{{isTest}}" name="success" size="13px" color="#ffffff"/>
      </view>
      <text class="test-label">这是测试订单</text>
      <text wx:if="{{isTest}}" class="test-note">本次开的单记为测试单</text>
    </view>

    <!-- 选择业务 -->
    <view class="section">
      <view class="card-header card-header--standalone">
        <van-icon name="apps-o" size="18px" color="#006495"/>
        <text class="card-title">业务类型</text>
      </view>
      <view class="biz-grid">
        <view
          class="biz-card {{shop && sale === 1 && !waitingPhone ? '' : 'biz-card--disabled'}}"
          data-type="retail"
          bindtap="onBizTap">
          <view class="biz-icon-wrap">
            <van-icon name="shopping-cart-o" size="22px" color="#545f73"/>
          </view>
          <text class="biz-label">零售</text>
          <view class="biz-arrow"><van-icon name="arrow" size="14px"/></view>
        </view>

        <view
          class="biz-card {{shop && care === 1 && !waitingPhone ? '' : 'biz-card--disabled'}}"
          data-type="maintain"
          bindtap="onBizTap">
          <view class="biz-icon-wrap">
            <van-icon name="setting-o" size="22px" color="#545f73"/>
          </view>
          <text class="biz-label">养护</text>
          <view class="biz-arrow"><van-icon name="arrow" size="14px"/></view>
        </view>

        <view
          class="biz-card {{shop && rent === 1 && !waitingPhone ? '' : 'biz-card--disabled'}}"
          data-type="rent"
          bindtap="onBizTap">
          <view class="biz-icon-wrap">
            <van-icon name="gift-o" size="22px" color="#545f73"/>
          </view>
          <text class="biz-label">租赁</text>
          <view class="biz-arrow"><van-icon name="arrow" size="14px"/></view>
        </view>
      </view>
      <view wx:if="{{waitingPhone}}" class="biz-hint">顾客授权手机号后才能开单</view>
      <view wx:elif="{{!shop}}" class="biz-hint">请先选择店铺</view>
    </view>

  </view>
</view>

<admin-page-help />
