/* pages/admin/reception/recept_scan.wxss
   与手动录入入口共用 Alpine Operational Minimalist 样式，这里只补扫码卡片和散客按钮 */
@import "./recept_entry.wxss";

.scan-qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.scan-qr-box {
  width: 220px;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--outline-variant);
  border-radius: 8px;
  background: var(--surface-container-lowest);
}
.scan-qr { width: 204px; height: 204px; }
.scan-stage {
  font-size: 15px;
  font-weight: 600;
  color: var(--on-surface);
}
.scan-hint {
  font-size: 12px;
  color: var(--on-surface-variant);
  text-align: center;
}
.scan-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin-top: 12px;
  font-size: 13px;
  color: var(--primary);
}

.scan-stage--active { color: var(--primary); text-align: center; }

.cell-row { display: flex; align-items: center; gap: 8px; }
.cell-input { flex: 1; min-width: 0; }
.cell-submit {
  flex-shrink: 0;
  height: 44px;
  line-height: 44px;
  padding: 0 20px;
  border-radius: 8px;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 15px;
  font-weight: 600;
}
.cell-submit--disabled { background: var(--outline-variant); }
.cell-hint { margin-top: 8px; text-align: left; }

.walkin-btn {
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 8px;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 16px;
  font-weight: 600;
}
.walkin-btn:active { opacity: 0.85; }
