/* pages/admin/reception/recept_scan.wxss
   与手动录入入口共用 Alpine Operational Minimalist 样式，这里只补扫码卡片 */
@import "./recept_entry.wxss";

.scan-qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.scan-qr-box {
  width: 220px;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--outline-variant);
  border-radius: 8px;
  background: var(--surface-container-lowest);
}
.scan-qr { width: 204px; height: 204px; }
.scan-stage {
  font-size: 15px;
  font-weight: 600;
  color: var(--on-surface);
}
.scan-stage--active { color: var(--primary); }
.scan-hint {
  font-size: 12px;
  color: var(--on-surface-variant);
  text-align: center;
}

.scan-customer {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;
  border-radius: 8px;
  background: #dcfce7;
}
.scan-customer-main { display: flex; align-items: center; gap: 8px; }
.scan-customer-name { font-size: 18px; font-weight: 700; color: var(--on-surface); }
.scan-customer-gender { font-size: 14px; color: var(--secondary); }
.scan-customer-cell { font-size: 14px; color: var(--on-surface-variant); padding-left: 28px; }
.scan-customer .scan-hint { text-align: left; padding-left: 28px; color: #15803d; }

.scan-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin-top: 12px;
  font-size: 13px;
  color: var(--primary);
}
