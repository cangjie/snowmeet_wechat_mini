/* pages/admin/reception/recept_auth_list.wxss
   与开单入口共用 Alpine Operational Minimalist 样式，这里只补授权列表 */
@import "./recept_entry.wxss";

.auth-toolbar { display: flex; align-items: center; justify-content: space-between; }
.auth-toolbar-title { font-size: 16px; font-weight: 700; color: var(--on-surface); }
.auth-refresh { display: flex; align-items: center; gap: 4px; font-size: 13px; color: var(--primary); }

.auth-empty { text-align: center; font-size: 14px; color: var(--on-surface-variant); }

.auth-item { display: flex; flex-direction: column; gap: 6px; }
.auth-row { display: flex; align-items: baseline; gap: 8px; }
.auth-name { font-size: 17px; font-weight: 700; color: var(--on-surface); }
.auth-gender { font-size: 13px; color: var(--secondary); }
.auth-cell { font-size: 14px; color: var(--on-surface-variant); }
.auth-status {
  margin-left: auto;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  background: #fee2e2;
  color: #b91c1c;
}
.auth-status--ok { background: #dcfce7; color: #15803d; }
.auth-meta { font-size: 12px; color: var(--on-surface-variant); }
.auth-btn {
  margin-top: 4px;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 8px;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 15px;
  font-weight: 600;
}
