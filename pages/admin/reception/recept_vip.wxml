<!--pages/admin/reception/recept_vip.wxml
  VIP 开单：列出所有 VIP 会员，点一位直接开单（不用扫码、不用授权，视同身份已验证）
  样式沿用 recept_entry.wxss（Alpine Operational Minimalist）
-->
<view class="page-root">

  <!-- 顶栏：必须用 safe-nav-bar，自己画的顶栏会和手机状态栏重叠、返回键点不动 -->
  <safe-nav-bar title="VIP开单" homeUrl="/pages/admin/reception/recept_scan" />

  <view class="main">

    <!-- 搜索：姓名或手机号 -->
    <view class="vip-search">
      <van-icon name="search" size="18px" color="#6f7881"/>
      <input
        class="vip-search-input"
        placeholder="搜索 VIP 的姓名或手机号"
        placeholder-class="form-input-placeholder"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"/>
    </view>

    <view class="vip-hint">点一位 VIP 直接开单，无需顾客扫码或店长授权。</view>

    <!-- 列表 -->
    <view class="vip-list">
      <block wx:if="{{members.length > 0}}">
        <view wx:for="{{members}}" wx:key="id" class="vip-item" data-id="{{item.id}}" bindtap="onVipTap">
          <view class="vip-avatar {{item.female ? 'vip-avatar--f' : ''}}">{{item.avatar}}</view>
          <view class="vip-mid">
            <view class="vip-line1">
              <text class="vip-name">{{item.name}}</text>
              <text wx:if="{{item.gender}}" class="vip-gender {{item.female ? 'vip-gender--f' : ''}}">{{item.gender}}</text>
              <van-icon name="star" size="14px" color="#c98a00"/>
            </view>
            <view class="vip-phone-row">
              <text class="vip-phone">{{item.phone || '未登记手机号'}}</text><phone-copy phone="{{item.phone}}" />
            </view>
          </view>
          <view class="vip-go">开单<van-icon name="arrow" size="14px" color="#006495"/></view>
        </view>
      </block>
      <view wx:elif="{{querying}}" class="vip-empty">
        <van-loading size="24px">查询中…</van-loading>
      </view>
      <view wx:elif="{{loaded}}" class="vip-empty">
        <van-icon name="star-o" size="40px" color="#bfc7d1"/>
        <text class="vip-empty-txt">{{keyword ? '没有匹配的 VIP 会员' : '还没有 VIP 会员，可在会员详情页把会员设为 VIP'}}</text>
      </view>
    </view>

    <list-pager wx:if="{{total > 0}}" page="{{page}}" total-pages="{{totalPages}}" page-size="{{pageSize}}"
                disabled="{{querying}}" bind:change="onPagerChange" />

  </view>
</view>
