<!--pages/admin/reception/recept_scan.wxml
  扫码接待（管理员菜单默认进入的开单入口，对应旧版 recept_entry）
    顾客扫码 → 自动跳到顾客信息页（recept_member）选店铺和业务；顾客不扫码点「散客进入」
    手动录入顾客信息的入口在页面底部
  样式沿用 recept_entry.wxss（Alpine Operational Minimalist stitch _1）
-->
<view class="page-root">

  <!-- 顶栏：开单入口没有上一页。必须用 safe-nav-bar，否则标题会和手机状态栏重叠 -->
  <safe-nav-bar title="业务开单" showBack="{{false}}" />

  <view class="main">

    <view class="page-header">
      <view class="page-title">扫码接待</view>
    </view>

    <!-- 顾客扫码验证身份 -->
    <view class="card">
      <view class="card-header">
        <van-icon name="scan" size="18px" color="#006495"/>
        <text class="card-title">顾客扫码验证身份</text>
      </view>
      <!-- 已提交手机号、等店长授权：收起二维码，免得有人再扫 -->
      <view wx:if="{{waitingAuth}}" class="scan-qr-wrap">
        <van-loading size="24px" color="#006495"/>
        <view class="scan-stage scan-stage--active">{{authText}}</view>
        <view class="scan-hint">店长授权后自动进入顾客信息页</view>
        <view class="scan-refresh" bindtap="onCancelAuthTap">
          <van-icon name="close" size="14px" color="#006495"/>
          <text>不等了，重新出码</text>
        </view>
      </view>
      <block wx:else>
        <view class="scan-qr-wrap">
          <view class="scan-qr-box">
            <image wx:if="{{qrCodeUrl}}" class="scan-qr" src="{{qrCodeUrl}}" mode="aspectFit"/>
            <van-loading wx:elif="{{loadingQr}}" size="24px"/>
          </view>
          <view class="scan-stage">{{stageText}}</view>
          <view class="scan-hint">顾客扫码后自动进入顾客信息页。二维码每 2 分钟自动更新。</view>
        </view>
        <view class="scan-refresh" bindtap="onRefreshTap">
          <van-icon name="replay" size="14px" color="#006495"/>
          <text>换一个码</text>
        </view>
      </block>
    </view>

    <!-- 通过手机号（同旧版）：普通店员要店长授权 -->
    <view wx:if="{{!waitingAuth}}" class="card">
      <view class="card-header">
        <van-icon name="phone-o" size="18px" color="#006495"/>
        <text class="card-title">通过手机号</text>
      </view>
      <view class="cell-row">
        <input
          class="form-input cell-input"
          type="number"
          maxlength="20"
          placeholder="输入会员手机号"
          placeholder-class="form-input-placeholder"
          value="{{cell}}"
          bindinput="onCellInput"/>
        <view class="cell-submit {{cell ? '' : 'cell-submit--disabled'}}" bindtap="onSubmitCell">确认</view>
      </view>
      <view class="scan-hint cell-hint">只能查已登记手机号的会员；普通店员需要店长授权。不是会员请点「散客进入」。</view>
    </view>

    <!-- 散客 -->
    <view class="card">
      <view class="card-header">
        <van-icon name="friends-o" size="18px" color="#006495"/>
        <text class="card-title">散客</text>
      </view>
      <view class="walkin-btn" bindtap="onWalkInTap">散客进入</view>
    </view>

    <!-- 找回中断订单（PRD §1.4.6） -->
    <view class="recover-link" bindtap="onRecoverOrder">
      <van-icon name="search" size="14px" color="#006495"/>
      <text>找回中断的订单</text>
    </view>

    <!-- 手动录入顾客信息的入口（recept_entry） -->
    <view class="recover-link" bindtap="onManualEntryTap">
      <van-icon name="edit" size="14px" color="#006495"/>
      <text>手动录入顾客信息开单</text>
    </view>

  </view>

  <!-- 底部接待导航 -->
  <reception-tabbar active="open" bind:tabchange="onTabChange" />

  <!-- 找回中断订单面板 -->
  <van-popup
    show="{{ showRecoverPanel }}"
    position="bottom"
    custom-style="height: 70%; border-radius: 16px 16px 0 0; padding: 0;"
    bind:close="onCloseRecoverPanel">
    <view class="recover-panel">
      <view class="recover-panel-header">
        <text class="recover-panel-title">今日中断的订单</text>
      </view>
      <view wx:if="{{ recoverLoading }}" class="recover-empty">
        <van-loading size="24px">查询中…</van-loading>
      </view>
      <view wx:elif="{{ recoverOrders.length === 0 }}" class="recover-empty">
        <text>暂无中断订单</text>
      </view>
      <scroll-view wx:else scroll-y class="recover-list">
        <view
          wx:for="{{ recoverOrders }}" wx:key="id"
          class="recover-item"
          data-id="{{ item.id }}"
          bindtap="onRecoverOrderTap">
          <view class="recover-item-name">{{ item.calledName || '（未填姓名）' }}</view>
          <view class="recover-item-cell">{{ item.contact_num || '未留手机' }}</view>
          <view class="recover-item-time">{{ item.timeStr }}</view>
        </view>
      </scroll-view>
    </view>
  </van-popup>
</view>

<admin-page-help />
