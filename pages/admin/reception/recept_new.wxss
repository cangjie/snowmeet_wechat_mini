/* pages/admin/reception/recept_new.wxss
   Alpine Operational Minimalist 主题 */

page {
  --primary: #006495;
  --on-primary: #ffffff;
  --primary-fixed: #cbe6ff;
  --on-primary-container: #003b5b;
  --secondary: #545f73;
  --secondary-container: #d5e0f8;
  --on-secondary-container: #586377;
  --tertiary-container: #21abef;
  --on-tertiary-container: #003c58;
  --on-surface: #0b1c30;
  --on-surface-variant: #3f4850;
  --outline: #6f7881;
  --outline-variant: #bfc7d1;
  --surface: #f8f9ff;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #eff4ff;
  --surface-container: #e5eeff;
  --error-container: #ffdad6;
  --on-error-container: #93000a;

  background-color: var(--surface);
  color: var(--on-surface);
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px;
}

.page-root {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 业务表单插槽 */
.form-slot { flex: 1; display: flex; flex-direction: column; }

/* 占位（其他业务待迁移） */
.placeholder {
  margin: 32px 16px;
  padding: 64px 16px;
  border: 1px dashed var(--outline-variant);
  border-radius: 12px;
  text-align: center;
}
.placeholder-title { font-size: 16px; font-weight: 600; color: var(--on-surface); margin-bottom: 4px; }
.placeholder-desc { font-size: 13px; color: var(--on-surface-variant); }

.card-sale-popup { background: #f8f9ff; padding-bottom: env(safe-area-inset-bottom); }
.card-sale-heading { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px 4px; font-size: 19px; font-weight: 600; }
.card-sale-close { padding: 8px 0 8px 20px; font-size: 14px; color: #006495; }
.card-sale-caption { padding: 0 20px 12px; font-size: 12px; line-height: 1.5; color: #6f7881; }
.card-sale-scroll { height: 54vh; }
.card-sale-product { margin: 0 16px 10px; padding: 14px; display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #dbe2ed; border-radius: 12px; }
.card-sale-product--selected { border-color: #006495; background: #edf6fc; }
.card-sale-product--disabled { background: #f0f2f5; color: #6f7881; }
.card-sale-product--disabled .card-sale-price { color: #6f7881; }
.card-sale-product-main { flex: 1; min-width: 0; }
.card-sale-name { font-size: 15px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.card-sale-rule { color: #6f7881; font-size: 12px; line-height: 1.6; margin-top: 4px; }
.card-sale-price { color: #006495; margin-top: 6px; font-size: 16px; font-weight: 600; }
.card-sale-checkbox { width: 24px; height: 24px; box-sizing: border-box; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 2px solid #bfc7d1; border-radius: 5px; background: #fff; }
.card-sale-checkbox--checked { border-color: #006495; background: #006495; }
.card-sale-product--disabled .card-sale-checkbox { background: #e5e9ee; border-color: #d2d8df; }
.card-sale-unavailable { margin-top: 4px; color: #a52a25; font-size: 12px; line-height: 1.5; }
.card-sale-trial { margin: 14px 16px; padding: 14px; border-radius: 12px; background: #e9f3fc; }
.card-sale-trial-title { font-weight: 600; color: #003b5b; }
.card-sale-trial-item { margin: 12px 0; font-size: 14px; }
.card-sale-use { color: #006495; line-height: 1.6; font-size: 13px; }
.card-sale-empty, .card-sale-error { padding: 14px 20px; font-size: 14px; line-height: 1.6; }
.card-sale-error { color: #a52a25; }
.card-sale-retry { color: #006495; padding: 0 20px 16px; font-size: 14px; }
.card-sale-footer { padding: 12px 16px 16px; background: #fff; border-top: 1px solid #dbe2ed; }
.card-sale-total { font-size: 14px; margin-bottom: 12px; }
.card-sale-total text { color: #006495; font-weight: 600; font-size: 20px; margin-left: 8px; }
button.card-sale-confirm { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 48px; min-height: 48px; margin: 0; padding: 0; border: 0; background: #006495; color: #fff; border-radius: 10px; font-size: 16px; font-weight: 600; line-height: 22px; }
button.card-sale-confirm::after { border: 0; }
button.card-sale-confirm[disabled] { background: #dce4ed; color: #788797; }
