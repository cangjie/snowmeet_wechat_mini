<!--pages/admin/reception/recept_new.wxml
  业务开单（共享页）
  对应 PRD §1.4.5 第二步：店员选业务后进入对应业务开单
  设计：参考 pages/admin/recept/recept_new 的结构（顶级页持有数据 + 调接口，
        子组件只负责渲染表单与回传事件）
  目前实现：租赁（rent-recept-form）/ 养护（care-recept-form）/ 零售（retail-recept-form）
-->
<view class="page-root">

  <!-- 顶栏：标题 = 业务名 + 开单。必须用 safe-nav-bar，自己画的顶栏会和手机状态栏重叠、返回键点不动 -->
  <safe-nav-bar title="{{bizLabel}}开单" homeUrl="/pages/admin/reception/recept_scan" />

  <!-- 顾客信息条（所有 bizType 共用，组件化） -->
  <reception-member-bar
    customer="{{customer}}"
    shop="{{shop}}"
    bizLabel="{{bizLabel}}"
    bind:memberInfoFound="onMemberInfoFound"
    bind:memberDetail="onMemberDetail"
    bind:customerChange="onCustomerChange" />

  <!-- 业务表单：根据 bizType 渲染不同自定义组件 -->
  <view class="form-slot">
    <rent-recept-form
      wx:if="{{bizType === 'rent'}}"
      shop="{{shop}}"
      memberId="{{customer.memberId}}"
      rentals="{{order.rentals}}"
      bind:syncRent="onSyncRent"
      bind:addAction="onAddAction"
      bind:addSingleProduct="onAddSingleProduct"
      bind:editRental="onEditRental"
      bind:checkout="onCheckout"
      bind:sortChange="onSortChange" />

    <care-recept-form
      wx:if="{{bizType === 'maintain'}}"
      shop="{{shop}}"
      memberId="{{customer.memberId}}"
      cares="{{order.cares}}"
      newCardMode="{{careCardMode}}"
      cardPreview="{{careCardPreview}}"
      cardError="{{careCardError}}"
      cardBusy="{{cardSaleBusy}}"
      cardSubmitted="{{careCardSubmitted}}"
      hasCardSelection="{{careCardSelections.length > 0}}"
      bind:addCard="onAddCareCard"
      bind:removeCards="onRemoveCareCards"
      bind:syncCare="onSyncCare"
      bind:memberSwitch="onMemberSwitchByTicket"
      bind:checkout="onCheckout" />

    <retail-recept-form
      wx:if="{{bizType === 'retail'}}"
      id="retailForm"
      shop="{{shop}}"
      memberId="{{customer.memberId}}"
      bind:checkout="onRetailCheckout" />
  </view>

  <!-- 接待 tabbar -->
  <reception-tabbar active="open" />
</view>

<van-popup show="{{cardSaleShow}}" position="bottom" round bind:close="onCareCardClose" close-on-click-overlay="{{!cardSaleBusy}}">
  <view class="card-sale-popup">
    <view class="card-sale-heading"><text>添加养护卡类</text><text class="card-sale-close" bindtap="onCareCardClose">关闭</text></view>
    <view class="card-sale-caption">每单勾选一种卡，全部装备使用新购卡；确认后回开单页，点击去结算付款</view>
    <scroll-view scroll-y class="card-sale-scroll">
      <view wx:for="{{cardSaleProducts}}" wx:key="id"
            class="card-sale-product {{item.quantity > 0 ? 'card-sale-product--selected' : ''}} {{item.unavailable ? 'card-sale-product--disabled' : ''}}"
            data-id="{{item.id}}" bindtap="onCareCardToggle">
        <view class="card-sale-product-main">
          <view class="card-sale-name">{{item.name}}</view>
          <view class="card-sale-rule">{{item.ruleLabel}} · {{item.bindingLabel}}</view>
          <view wx:if="{{item.unavailable}}" class="card-sale-unavailable">仅一套装备时可选</view>
          <view class="card-sale-price">¥{{item.priceLabel}}</view>
        </view>
        <view class="card-sale-checkbox {{item.quantity > 0 ? 'card-sale-checkbox--checked' : ''}}">
          <van-icon wx:if="{{item.quantity > 0}}" name="success" size="16px" color="#ffffff" />
        </view>
      </view>
      <view wx:if="{{!cardSaleProducts.length && !cardSaleLoading && !cardSaleError}}" class="card-sale-empty">暂无在售养护卡</view>
      <view wx:if="{{cardSalePreview}}" class="card-sale-trial">
        <view class="card-sale-trial-title">本次试算</view>
        <view wx:for="{{cardSalePreview.items}}" wx:key="lineNo" class="card-sale-trial-item">
          <view>{{item.name}}</view>
          <view class="card-sale-rule">卡内抵扣：{{item.serviceLabel}}</view>
          <view class="card-sale-use">{{item.usageLabel}}</view>
          <view class="card-sale-rule">{{item.equipmentLabel}}</view>
        </view>
        <view class="card-sale-rule">卡款 {{cardSalePreview.cardAmountLabel}} ＋ 养护费用 {{cardSalePreview.careAmountLabel}}；付款成功后发卡扣次</view>
      </view>
      <view wx:if="{{cardSalePreview.errors.length}}" class="card-sale-error">确认选卡后，请补全每件装备的养护项目</view>
      <view wx:if="{{cardSaleLoading}}" class="card-sale-empty">正在加载或试算…</view>
      <view wx:if="{{cardSaleError}}" class="card-sale-error">{{cardSaleError}}</view>
      <view wx:if="{{cardSaleError}}" class="card-sale-retry" bindtap="onCardRecalculate">重新试算</view>
    </scroll-view>
    <view class="card-sale-footer">
      <view class="card-sale-total">应付合计 <text>{{cardSalePreview ? cardSalePreview.amountLabel : '--'}}</text></view>
      <button class="card-sale-confirm" bindtap="onCareCardConfirm" loading="{{cardSaleBusy}}" disabled="{{cardSaleBusy || cardSaleLoading || !cardSalePreview || !!cardSaleError}}">确认选卡</button>
    </view>
  </view>
</van-popup>

<admin-page-help />
