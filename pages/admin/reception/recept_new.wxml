<!--pages/admin/reception/recept_new.wxml
  业务开单（共享页）
  对应 PRD §1.4.5 第二步：店员选业务后进入对应业务开单
  设计：参考 pages/admin/recept/recept_new 的结构（顶级页持有数据 + 调接口，
        子组件只负责渲染表单与回传事件）
  目前实现：租赁（rent-recept-form）/ 养护（care-recept-form）/ 零售（retail-recept-form）
-->
<view class="page-root">

  <!-- 顶栏：标题 = 业务名 + 开单。必须用 safe-nav-bar，自己画的顶栏会和手机状态栏重叠、返回键点不动 -->
  <safe-nav-bar title="{{bizLabel}}开单" homeUrl="/pages/admin/reception/recept_entry" />

  <!-- 顾客信息条（所有 bizType 共用，组件化） -->
  <reception-member-bar
    customer="{{customer}}"
    shop="{{shop}}"
    bizLabel="{{bizLabel}}"
    bind:memberInfoFound="onMemberInfoFound"
    bind:memberDetail="onMemberDetail" />

  <!-- 业务表单：根据 bizType 渲染不同自定义组件 -->
  <view class="form-slot">
    <rent-recept-form
      wx:if="{{bizType === 'rent'}}"
      shop="{{shop}}"
      memberId="{{customer.memberId}}"
      rentals="{{order.rentals}}"
      bind:syncRent="onSyncRent"
      bind:addAction="onAddAction"
      bind:addSingleProduct="onAddSingleProduct"
      bind:editRental="onEditRental"
      bind:checkout="onCheckout"
      bind:sortChange="onSortChange" />

    <care-recept-form
      wx:if="{{bizType === 'maintain'}}"
      shop="{{shop}}"
      memberId="{{customer.memberId}}"
      cares="{{order.cares}}"
      bind:syncCare="onSyncCare"
      bind:memberSwitch="onMemberSwitchByTicket"
      bind:checkout="onCheckout" />

    <retail-recept-form
      wx:if="{{bizType === 'retail'}}"
      id="retailForm"
      shop="{{shop}}"
      memberId="{{customer.memberId}}"
      bind:checkout="onRetailCheckout" />
  </view>

  <!-- 接待 tabbar -->
  <reception-tabbar active="open" />
</view>

<admin-page-help />