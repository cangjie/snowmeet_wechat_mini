<!--pages/admin/retail/retail_order_detail.wxml
  新版零售订单详情（Alpine Operational Minimalist，对标 care_order_detail）
  A 订单信息 / B 顾客信息（可编辑） / C 零售内容（可编辑） / D 支付信息（四格摘要 + 可折叠明细 + 去收款）
-->
<view class="page-root" wx:if="{{order}}">

  <!-- A 订单信息 -->
  <view class="card">
    <view class="section-title-row">
      <view class="section-title">订单信息</view>
      <view class="chip {{view.statusChip}}">{{view.status}}</view>
    </view>
    <view class="info-grid">
      <view class="info-cell">
        <text class="info-label">订单号</text>
        <text class="info-value">{{view.code}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">店铺</text>
        <text class="info-value">{{order.shop}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">开单时间</text>
        <text class="info-value">{{view.bizDateStr}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">开单店员</text>
        <text class="info-value">{{view.staffName || '--'}}</text>
      </view>
    </view>
  </view>

  <!-- B 顾客信息 -->
  <view class="card">
    <view class="sub-title-row">
      <view class="section-title">顾客信息</view>
      <view wx:if="{{!contactEditing && !order.careCardSale}}" class="edit-link" catchtap="onContactEditTap">
        <van-icon name="edit" size="14px" color="#006495"/>
        <text>编辑</text>
      </view>
    </view>
    <view wx:if="{{!contactEditing}}" class="info-grid">
      <view class="info-cell">
        <text class="info-label">姓名</text>
        <view class="info-value-row">
          <text class="info-value">{{view.customerName ? view.customerName + ' ' + view.customerTitle : '散客'}}</text>
          <view class="chip {{view.memberChip}}">{{view.memberShip}}</view>
        </view>
      </view>
      <view class="info-cell" bindtap="onCall">
        <text class="info-label">电话</text>
        <text class="info-value {{view.cell ? 'info-value--link' : ''}}">{{view.cell || '--'}}</text>
      </view>
    </view>
    <view wx:else class="edit-panel">
      <view class="edit-block edit-block--first">
        <text class="info-label">姓名</text>
        <input class="panel-input" value="{{contactDraft.name}}" placeholder="选填"
               data-field="name" bindinput="onContactInput"/>
      </view>
      <view class="edit-block">
        <text class="info-label">性别</text>
        <view class="seg-row">
          <view class="btn btn--sm {{contactDraft.gender === '男' ? 'btn--primary' : 'btn--plain'}}"
                data-gender="男" catchtap="onContactGenderTap">男</view>
          <view class="btn btn--sm {{contactDraft.gender === '女' ? 'btn--primary' : 'btn--plain'}}"
                data-gender="女" catchtap="onContactGenderTap">女</view>
        </view>
      </view>
      <view class="edit-block">
        <text class="info-label">手机号</text>
        <input class="panel-input" type="number" value="{{contactDraft.cell}}" placeholder="选填"
               data-field="cell" bindinput="onContactInput"/>
      </view>
      <view class="panel-btn-row">
        <view class="btn btn--plain btn--half" catchtap="onContactCancel">取消</view>
        <view class="btn btn--primary btn--half" catchtap="onContactSave">{{savingContact ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- C 零售内容 -->
  <view class="card">
    <view class="sub-title-row">
      <view class="section-title">零售内容</view>
      <view wx:if="{{!retailEditing && retail && !order.careCardSale}}" class="edit-link" catchtap="onRetailEditTap">
        <van-icon name="edit" size="14px" color="#006495"/>
        <text>编辑</text>
      </view>
    </view>

    <view wx:if="{{!retail}}" class="pay-empty">没有零售明细</view>

    <block wx:elif="{{!retailEditing}}">
      <view class="kv-list">
        <view class="kv-line">
          <text class="kv-line-label">七色米单号</text>
          <text wx:if="{{view.mi7}}" class="kv-line-value">{{view.mi7}}</text>
          <view wx:else class="chip chip-warn">紧急开单 · 待补单号</view>
        </view>
        <view class="kv-line">
          <text class="kv-line-label">订单类型</text>
          <text class="kv-line-value">{{view.retailType}}</text>
        </view>
        <view class="kv-line">
          <text class="kv-line-label">金额</text>
          <view class="kv-line-value-row">
            <text class="kv-line-value kv-line-value--amount">{{view.amountStr}}</text>
            <view wx:if="{{view.entertain}}" class="chip chip-warn">招待 · 不收款</view>
          </view>
        </view>
        <view class="kv-line">
          <text class="kv-line-label">放弃龙珠</text>
          <text class="kv-line-value">{{view.giveupScore ? '是' : '否'}}</text>
        </view>
        <view class="kv-line kv-line--top">
          <text class="kv-line-label">备注</text>
          <text class="kv-line-value kv-line-value--memo {{view.memo ? '' : 'kv-line-value--empty'}}">{{view.memo || '暂无备注'}}</text>
        </view>
      </view>
      <view wx:if="{{view.photos.length > 0}}" class="photo-row">
        <image wx:for="{{view.photos}}" wx:key="id" class="photo-thumb" mode="aspectFill"
               src="{{item.thumb}}" data-idx="{{index}}" bindtap="onPhotoTap"/>
      </view>
    </block>

    <view wx:else class="edit-panel">
      <view class="edit-block edit-block--first">
        <text class="info-label">七色米单号</text>
        <input class="panel-input" value="{{retailDraft.mi7Code}}" placeholder="留空表示紧急开单"
               bindinput="onDraftMi7Input" bindblur="onDraftMi7Blur"/>
        <text wx:if="{{mi7Hint}}" class="mi7-hint mi7-hint--{{retailDraft.mi7Status}}">{{mi7Hint}}</text>
      </view>
      <view class="edit-block">
        <text class="info-label">订单类型</text>
        <view class="type-grid">
          <block wx:for="{{typeOptions}}" wx:key="value">
            <view class="type-btn {{item.on ? 'type-btn--active' : ''}} {{item.disabled ? 'type-btn--disabled' : ''}}"
                  data-value="{{item.value}}" catchtap="onDraftTypeTap">{{item.label}}</view>
          </block>
        </view>
      </view>
      <view class="edit-block">
        <text class="info-label">金额</text>
        <input wx:if="{{view.canEditAmount}}" class="panel-input" type="digit"
               value="{{retailDraft.amountInput}}" placeholder="原 {{view.amountStr}}，不改留空"
               bindinput="onDraftAmountInput"/>
        <text wx:else class="edit-readonly">{{view.amountStr}}（{{view.entertain ? '招待单' : '已收款'}}，不能改）</text>
      </view>
      <view class="edit-block">
        <text class="info-label">备注</text>
        <textarea class="panel-input panel-textarea" maxlength="200" value="{{retailDraft.memo}}"
                  placeholder="选填" bindinput="onDraftMemoInput"/>
      </view>
      <view class="edit-block">
        <text class="info-label">照片（最多 {{maxImages}} 张）</text>
        <van-uploader file-list="{{retailDraft.images}}" max-count="{{maxImages}}"
                      capture="{{['album', 'camera']}}"
                      bind:after-read="onDraftPhotoRead" bind:delete="onDraftPhotoDelete"/>
      </view>
      <view class="panel-btn-row">
        <view class="btn btn--plain btn--half" catchtap="onRetailCancel">取消</view>
        <view class="btn btn--primary btn--half" catchtap="onRetailSave">{{savingRetail ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- D 支付信息 -->
  <view wx:if="{{order.careCardSale}}" class="card">
    <view class="kv-line"><text class="kv-line-label">购卡数量</text><text class="kv-line-value">{{view.cardCount}} 张</text></view>
    <view class="kv-line"><text class="kv-line-label">购卡金额</text><text class="kv-line-value">{{view.cardAmountStr}}</text></view>
    <view class="kv-line"><text class="kv-line-label">养护费用（已合并收款）</text><text class="kv-line-value">{{view.careAmountStr}}</text></view>
    <linked-care-summary orderId="{{order.careCardSale.careOrderId}}" />
    <view class="pay-empty">含卡订单不退款；取消养护只返还实际扣减次数</view>
    <view class="btn btn--plain btn--block" catchtap="onViewLinkedCare">查看关联养护单</view>
  </view>
  <view class="card">
    <view class="section-title">支付信息</view>
    <view class="pay-summary-grid">
      <view class="pay-summary-cell">
        <view class="pay-summary-label">支付总金额</view>
        <view class="pay-summary-value pay-summary-value--blue">{{payment.paidStr}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">退款总金额</view>
        <view class="pay-summary-value pay-summary-value--red">{{payment.refundStr}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">支付笔数</view>
        <view class="pay-summary-value">{{payment.payRows.length}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">退款笔数</view>
        <view class="pay-summary-value">{{payment.refundRows.length}}</view>
      </view>
    </view>

    <view wx:if="{{view.showGoPay}}" class="btn btn--primary btn--block" catchtap="onGoPay">{{view.goPayLabel}}</view>

    <view class="divider"></view>

    <view class="payment-detail-toggle" bindtap="onTogglePayment">
      <text class="payment-detail-toggle__title">支付明细</text>
      <van-icon name="{{payment.expanded ? 'arrow-up' : 'arrow-down'}}" size="18px" color="#999"/>
    </view>

    <block wx:if="{{payment.expanded}}">
      <view class="pay-table" wx:if="{{payment.payRows.length > 0 || payment.refundRows.length > 0}}">
        <view class="pay-table-row" style="font-size:22rpx;color:#999;">
          <text class="pay-col-date">日期</text>
          <text class="pay-col-time">时间</text>
          <text class="pay-col-method">支付方式</text>
          <text class="pay-col-cell">手机号</text>
          <text class="pay-col-amount">金额</text>
        </view>
        <view class="pay-table-row {{item._isProxy ? 'pay-table-row--proxy' : ''}}" wx:for="{{payment.payRows}}" wx:key="id">
          <text class="pay-col-date">{{item.paid_dateDateStr}}</text>
          <text class="pay-col-time">{{item.paid_dateTimeStr}}</text>
          <text class="pay-col-method">{{item.pay_method}}</text>
          <text class="pay-col-cell">{{item._proxyCellMasked}}</text>
          <text class="pay-col-amount pay-col-amount--pay">{{item.amountStr}}</text>
        </view>
        <view class="pay-table-row" wx:for="{{payment.refundRows}}" wx:key="id">
          <text class="pay-col-date">{{item.paid_dateDateStr || '—'}}</text>
          <text class="pay-col-time">{{item.paid_dateTimeStr || ''}}</text>
          <text class="pay-col-method">{{item.pay_method || '—'}}</text>
          <text class="pay-col-cell"></text>
          <text class="pay-col-amount pay-col-amount--refund">-{{item.amountStr}}</text>
        </view>
      </view>
      <view wx:else class="pay-empty">暂无支付记录</view>
    </block>
  </view>

</view>
<view wx:else class="page-loading">加载中…</view>
<admin-page-help />
