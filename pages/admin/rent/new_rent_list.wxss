/* ── 页面背景 ─────────────────────────────── */
.page-root {
  min-height: 100vh;
  background: #f8f9ff;
  padding: 16rpx 0 48rpx;
  box-sizing: border-box;
}

/* ── 筛选卡片 ─────────────────────────────── */
.filter-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 16rpx 24rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-row:last-of-type {
  border-bottom: none;
}

.filter-row--date {
  align-items: flex-start;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.filter-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}

.filter-value {
  flex: 1;
  font-size: 26rpx;
}

.filter-row-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.date-btn {
  background: #f8f9ff;
  border-radius: 6rpx;
  padding: 6rpx 16rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

.date-sep {
  margin: 0 12rpx;
  color: #999;
}

/* radio group */
.radio-group {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  flex: 1;
}

.radio-group--wrap {
  flex-wrap: wrap;
}

.radio-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

/* inputs */
.filter-input {
  flex: 1;
  height: 56rpx;
  background: #f8f9ff;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #333;
  box-sizing: border-box;
}

.filter-input--sm {
  flex: none;
  width: 180rpx;
}

.filter-actions {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

/* ── 统计 & 分页 ─────────────────────────── */
.summary-section {
  margin: 0 16rpx 12rpx;
}

.summary-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #555;
  padding: 8rpx 0 4rpx;
}

.summary-sep {
  margin: 0 10rpx;
  color: #ccc;
}

/* 翻页栏已抽成 list-pager 组件，样式在 components/list-pager/index.wxss */
.summary-section--bottom {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

/* ── 订单卡片 ─────────────────────────────── */
.order-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

/* 卡头 */
.order-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  font-family: 'Lexend', sans-serif;
}

/* 状态 chip */
.status-chip {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #e8f4fd;
  color: #006495;
}

.status-chip--renting      { background: #dbeafe; color: #1d4ed8; }
.status-chip--returned     { background: #dcfce7; color: #15803d; }
.status-chip--closed       { background: #f3f4f6; color: #6b7280; }
.status-chip--full-refund  { background: #dcfce7; color: #15803d; }
.status-chip--part-refund  { background: #fef9c3; color: #92400e; }
.status-chip--part-return  { background: #fef3c7; color: #b45309; }
.status-chip--not-started  { background: #f0f9ff; color: #0369a1; }
.status-chip--unpaid       { background: #ffedd5; color: #c2410c; }
.status-chip--temp         { background: #fee2e2; color: #b91c1c; }

/* 内容区：左侧标签 + 右侧详情 */
.order-body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* 左侧标签列 */
.tag-col {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 48rpx;
  flex-shrink: 0;
  gap: 6rpx;
  padding-top: 2rpx;
  margin-right: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 0;
  border-radius: 4rpx;
  background: #f3f4f6;
  color: #374151;
  text-align: center;
}

.tag--test    { background: #fee2e2; color: #b91c1c; }
.tag--entertain { background: #fef3c7; color: #92400e; }
.tag--credit  { background: #fce7f3; color: #9d174d; }
.tag--discount { background: #d1fae5; color: #065f46; }
.tag--card    { background: #dbeafe; color: #1e40af; }
.tag--deposit { background: #ffedd5; color: #c2410c; }
.tag--retail  { background: #cffafe; color: #0e7490; }
.tag--member  { background: #f0fdf4; color: #166534; }

/* 详情行 */
.order-rows {
  margin-bottom: 12rpx;
}

.order-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 6rpx;
  font-size: 24rpx;
}

.row-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #888;
  font-size: 22rpx;
}

.row-label--mid {
  width: 100rpx;
  margin-left: 8rpx;
}

.row-value {
  width: 160rpx;
  color: #333;
  font-size: 24rpx;
}

.row-value--wide {
  flex: 1;
  width: auto;
}

/* 支付方式：独占一行 + 整行宽度，多通道拼接也不折行 */
.row-value--nowrap {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 60rpx 0;
}
