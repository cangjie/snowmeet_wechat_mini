<view class="page {{_compactScreen ? 'page--compact' : ''}}" wx:if="{{order}}">

  <!-- ── Card 1: 订单信息 ─────────────────── -->
  <view class="card">
    <view class="section-title" bindtap="onToggleOrderInfo">
      订单信息
      <view class="section-title-right">
        <van-icon name="{{_orderInfoExpanded ? 'arrow-up' : 'arrow-down'}}" size="18px" color="#999" />
      </view>
    </view>

    <block wx:if="{{_orderInfoExpanded}}">
      <!-- 姓名 + 订单号（双列紧凑布局） -->
      <view class="kv-row kv-row--dual">
        <view class="kv-cell">
          <text class="kv-label">姓名</text>
          <view class="kv-inline-value">
            <text class="kv-value kv-value--inline kv-value--nowrap">{{order.member.title || '—'}}</text>
            <view class="chip {{order._memberTypeClass}}">{{order._memberTypeLabel}}</view>
          </view>
        </view>
        <view class="kv-cell kv-cell--right kv-cell--code">
          <text class="kv-label kv-label--wide">订单号</text>
          <text class="kv-value kv-value--inline kv-value--nowrap">{{order._displayCode}}</text>
        </view>
      </view>

      <!-- 手机号 + 所属门店（双列紧凑布局） -->
      <view class="kv-row kv-row--dual">
        <view class="kv-cell">
          <text class="kv-label">手机</text>
          <text
            class="kv-value kv-value--inline kv-value--nowrap {{order.member.cell ? 'kv-value--link' : ''}}"
            bindtap="onCall"
          >{{order.member.cell || '—'}}</text>
        </view>
        <view class="kv-cell kv-cell--right kv-cell--shop">
          <text class="kv-label">门店</text>
          <text class="kv-value kv-value--inline kv-value--nowrap">{{order.shop || '—'}}</text>
        </view>
      </view>

      <!-- 开单店员（staffName 字段，若无则隐藏整行） -->
      <view class="kv-row" wx:if="{{order.staffName}}">
        <text class="kv-label">开单店员</text>
        <text class="kv-value">{{order.staffName}}</text>
      </view>

      <!-- 订单状态 -->
      <view class="kv-row" wx:if="{{order.closed == 1}}">
        <text class="kv-label">关单时间</text>
        <text class="kv-value">{{order.close_dateDateStr}} {{order.close_dateTimeStr}}</text>
      </view>
    </block>
  </view>

  <!-- ── Card 2: 支付信息 ─────────────────── -->
  <view class="card">
    <view class="section-title">
      支付信息
    </view>

    <!-- 2×2 摘要格 -->
    <view class="pay-summary-grid">
      <view class="pay-summary-cell">
        <view class="pay-summary-label">支付总金额</view>
        <view class="pay-summary-value pay-summary-value--blue">{{order.paidAmountStr}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">退款总金额</view>
        <view class="pay-summary-value pay-summary-value--red">{{order.refundAmountStr}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">支付笔数</view>
        <view class="pay-summary-value">{{order.availablePayments.length}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">退款笔数</view>
        <view class="pay-summary-value">{{order.availableRefunds.length || 0}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="payment-detail-toggle" bindtap="onTogglePaymentDetail">
      <text class="payment-detail-toggle__title">支付明细</text>
      <van-icon name="{{_paymentDetailExpanded ? 'arrow-up' : 'arrow-down'}}" size="18px" color="#999" />
    </view>

    <block wx:if="{{_paymentDetailExpanded}}">
      <view class="pay-table" wx:if="{{order.availablePayments.length > 0 || (order.availableRefunds.length || 0) > 0}}">
        <view class="pay-table-row" style="font-size:22rpx;color:#999;">
          <text class="pay-col-date">日期</text>
          <text class="pay-col-method">方式</text>
          <text class="pay-col-type">类型</text>
          <text class="pay-col-amount">金额</text>
        </view>
        <view class="pay-table-row" wx:for="{{order.availablePayments}}" wx:key="id">
          <view class="pay-col-date">
            <text style="display:block;">{{item.paid_dateDateStr}}</text>
            <text style="display:block;font-size:20rpx;color:#999;">{{item.paid_dateTimeStr}}</text>
          </view>
          <text class="pay-col-method">{{item.pay_method}}</text>
          <view class="pay-col-type">
            <view class="chip chip--member" style="font-size:20rpx;padding:2rpx 8rpx;">支付</view>
          </view>
          <text class="pay-col-amount pay-col-amount--pay">{{item.amountStr}}</text>
        </view>
        <view class="pay-table-row" wx:for="{{order.availableRefunds}}" wx:key="id">
          <view class="pay-col-date">
            <text style="display:block;">{{item.paid_dateDateStr || '—'}}</text>
          </view>
          <text class="pay-col-method">{{item.pay_method || '—'}}</text>
          <view class="pay-col-type">
            <view class="chip chip--guest" style="font-size:20rpx;padding:2rpx 8rpx;">退款</view>
          </view>
          <text class="pay-col-amount pay-col-amount--refund">-{{item.amountStr}}</text>
        </view>
      </view>
      <view wx:else style="color:#999;font-size:26rpx;text-align:center;padding:20rpx 0;">
        暂无支付记录
      </view>
    </block>
  </view>
  <!-- ── Card 3: 租赁信息 ─────────────────── -->
  <view class="card">
    <view class="section-title">
      租赁信息 共{{order.rentals.length}}项
      <view class="section-title-right">
        <!-- Tab pill -->
        <view class="tab-pill">
          <view class="tab-pill__item {{_rentalTab == 0 ? 'tab-pill__item--active' : ''}}"
            bindtap="onRentalTabChange" data-tab="0">按商品</view>
          <view class="tab-pill__item {{_rentalTab == 1 ? 'tab-pill__item--active' : ''}}"
            bindtap="onRentalTabChange" data-tab="1">按物品</view>
        </view>
      </view>
    </view>

    <!-- Tab 0: 按租赁商品 -->
    <block wx:if="{{_rentalTab == 0}}">
      <view class="rental-card" wx:for="{{order.rentals}}" wx:key="id" wx:for-index="ridx">
        <!-- 折叠态 -->
        <view class="rental-head" bindtap="onToggleRental" data-ridx="{{ridx}}">
          <view class="chip {{item._isPackage ? 'chip--package' : 'chip--item'}}">
            {{item._isPackage ? '套餐' : '单品'}}
          </view>
          <text class="rental-head-name">{{item.name}}</text>
          <view class="rental-head-meta">
            <view class="rental-head-fee">押金<text>{{item.guarantyAmountStr}}</text></view>
            <van-icon name="{{_expandedRentals[ridx] ? 'arrow-up' : 'arrow-down'}}" size="16px" color="#999" />
          </view>
        </view>

        <!-- 展开态 -->
        <block wx:if="{{_expandedRentals[ridx]}}">
          <view class="divider"></view>

          <view class="rental-showcase">
            <view class="rental-showcase-summary">
              <text>押金 <text class="rental-showcase-summary-value">{{item.guarantyAmountStr}}</text></text>
              <text>租金 <text class="rental-showcase-summary-value rental-showcase-summary-value--accent">¥{{item.totalRentSummaryAmount || 0}}</text></text>
            </view>

            <view class="rental-showcase-time-row">
              <view class="rental-showcase-time-card rental-showcase-time-card--start">
                <text class="rental-showcase-time-tag">起租</text>
                <text class="rental-showcase-time-date">{{item.start_dateDateStr}}</text>
                <text class="rental-showcase-time-time">{{item.start_dateTimeStr}}</text>
              </view>
              <text class="rental-showcase-time-arrow">→</text>
              <view class="rental-showcase-time-card rental-showcase-time-card--end">
                <text class="rental-showcase-time-tag">退租</text>
                <text class="rental-showcase-time-date">{{item.end_dateDateStr}}</text>
                <text class="rental-showcase-time-time">{{item.end_dateTimeStr}}</text>
              </view>
            </view>

            <view class="rental-showcase-fee-grid">
              <view class="rental-showcase-fee-cell">
                <text class="rental-showcase-fee-label">租金</text>
                <text class="rental-showcase-fee-value">¥{{item.totalRentSummaryAmount || 0}}</text>
              </view>
              <view class="rental-showcase-fee-cell">
                <text class="rental-showcase-fee-label">减免</text>
                <text class="rental-showcase-fee-value">¥{{item.totalDiscountAmount || 0}}</text>
              </view>
              <view class="rental-showcase-fee-cell">
                <text class="rental-showcase-fee-label">赔偿</text>
                <text class="rental-showcase-fee-value">¥{{item.totalRepairationAmount || 0}}</text>
              </view>
              <view class="rental-showcase-fee-cell">
                <text class="rental-showcase-fee-label">超时</text>
                <text class="rental-showcase-fee-value">¥{{item.totalOverTimeAmount || 0}}</text>
              </view>
              <view class="rental-showcase-fee-cell">
                <text class="rental-showcase-fee-label">招待</text>
                <text class="rental-showcase-fee-value">{{item.entertain ? '是' : '否'}}</text>
              </view>
            </view>

            <view class="rental-showcase-subtotal">
              <text class="rental-showcase-subtotal-label">小计</text>
              <text class="rental-showcase-subtotal-value">¥{{item.totalSummaryAmount || 0}}</text>
            </view>

            <view class="rental-showcase-memo-row">
              <view class="rental-showcase-memo-box" bindtap="onModMemo" data-ridx="{{ridx}}">
                <text wx:if="{{item.memo}}">{{item.memo}}</text>
                <text wx:else class="rental-memo-placeholder">输入商品备注</text>
              </view>
            </view>
          </view>

          <view class="divider"></view>

          <view class="rental-subsection-head">
            <text class="rental-subsection-title">租金明细</text>
          </view>

          <!-- 租金明细 toggle -->
          <view class="toggle-row" bindtap="onToggleDetails" data-ridx="{{ridx}}">
            <van-icon name="{{_expandedDetails[ridx] ? 'arrow-up' : 'arrow-down'}}" size="14px" />
            <text>租金明细 ({{item.feeRows.length}}天)</text>
          </view>
          <block wx:if="{{_expandedDetails[ridx]}}">
            <view class="detail-table">
              <view class="detail-table-row detail-table-head">
                <text class="detail-col-date">日期</text>
                <text class="detail-col-amount">租金</text>
                <text class="detail-col-overtime">超时费</text>
                <text class="detail-col-discount">减免</text>
                <text class="detail-col-subtotal">小计</text>
              </view>
              <view class="detail-table-row detail-table-row--tappable {{row.waived ? 'detail-table-row--waived' : ''}}" wx:for="{{item.feeRows}}" wx:key="dateStr" wx:for-item="row" wx:for-index="fidx" bindtap="onEditDayCharge" data-ridx="{{ridx}}" data-fidx="{{fidx}}">
                <text class="detail-col-date">{{row.dateStr}}</text>
                <text class="detail-col-amount">{{row.rentStr}}</text>
                <text class="detail-col-overtime">{{row.overtimeStr}}</text>
                <text class="detail-col-discount">{{row.discountStr}}</text>
                <text class="detail-col-subtotal">{{row.subtotalStr}}</text>
              </view>
            </view>
          </block>

          <view class="divider"></view>

          <view class="rental-subsection-head rental-subsection-head--between">
            <text class="rental-subsection-title">租赁物明细</text>
            <van-button size="mini" type="warning" plain bindtap="onReturnAllRental" data-ridx="{{ridx}}">全部归还</van-button>
          </view>

          <!-- 租赁物明细 toggle -->
          <view class="toggle-row toggle-row--between">
            <view class="toggle-row-left" bindtap="onToggleItems" data-ridx="{{ridx}}">
              <van-icon name="{{_expandedItems[ridx] ? 'arrow-up' : 'arrow-down'}}" size="14px" />
              <text>租赁物明细 ({{item._activeItemCount}}件)</text>
            </view>
          </view>
          <block wx:if="{{_expandedItems[ridx]}}">
            <view class="item-detail-card {{rentItem.noNeed ? 'item-detail-card--noneed' : ''}} {{rentItem._replaced ? 'item-detail-card--replaced' : ''}}" wx:for="{{item.rentItems}}" wx:key="id" wx:for-item="rentItem" wx:for-index="iidx">
              <view class="rid-head">
                <view class="rid-head-icon">
                  <van-icon name="goods-collect-o" size="18px" color="#006495" />
                </view>
                <view class="rid-head-main">
                  <view class="rid-head-title">
                    <text class="rid-name">{{rentItem.name || '—'}}</text>
                    <view class="chip {{rentItem._statusClass}} rid-badge">{{rentItem._statusLabel}}</view>
                  </view>
                  <view class="rid-head-sub">
                    <text class="rid-sub-label">编码</text>
                    <text class="rid-sub-value">{{rentItem.noNeed ? '--' : (rentItem.noCode ? '无编码' : (rentItem.code || '--'))}}</text>
                    <text class="rid-sub-dot" wx:if="{{!rentItem.noNeed}}">·</text>
                    <text class="rid-sub-label" wx:if="{{!rentItem.noNeed}}">分类</text>
                    <text class="rid-sub-value" wx:if="{{!rentItem.noNeed}}">{{rentItem.class_name || '—'}}</text>
                  </view>
                </view>
              </view>

              <view class="rid-timeline" wx:if="{{!rentItem.noNeed}}">
                <view class="rid-tl-col">
                  <view class="rid-tl-head">
                    <view class="rid-dot {{rentItem._picked ? 'rid-dot--on' : ''}}"></view>
                    <text class="rid-tl-label">发放</text>
                  </view>
                  <view class="rid-tl-date">{{rentItem.pickDateStr}}</view>
                  <view class="rid-tl-time">{{rentItem.pickTimeStr}}</view>
                  <view class="rid-tl-staff">{{rentItem.pickStaff ? rentItem.pickStaff.name : '--'}}</view>
                </view>
                <view class="rid-tl-col">
                  <view class="rid-tl-head">
                    <view class="rid-dot {{rentItem._returned ? 'rid-dot--on' : ''}}"></view>
                    <text class="rid-tl-label">归还</text>
                  </view>
                  <view class="rid-tl-date">{{rentItem.returnDateStr}}</view>
                  <view class="rid-tl-time">{{rentItem.returnTimeStr}}</view>
                  <view class="rid-tl-staff">{{rentItem.returnStaff ? rentItem.returnStaff.name : '--'}}</view>
                </view>
              </view>

              <view class="rid-kv" wx:if="{{!rentItem.noNeed}}">
                <text class="rid-kv-label">赔偿金额</text>
                <view class="rid-kv-right">
                  <text class="rid-kv-value">{{rentItem.totalRepairationAmountStr || '¥0.00'}}</text>
                  <view class="rid-kv-repair-btn" wx:if="{{!rentItem._replaced}}" bindtap="onItemRepairEdit" data-ridx="{{ridx}}" data-iidx="{{iidx}}">
                    <van-icon name="balance-o" size="13px" /><text>赔偿</text>
                  </view>
                </view>
              </view>

              <view class="rental-showcase-memo-row" style="margin-top:8rpx;">
                <view class="rental-showcase-memo-box" bindtap="onItemMemoTap" data-ridx="{{ridx}}" data-iidx="{{iidx}}">
                  <text wx:if="{{rentItem.memo}}">{{rentItem.memo}}</text>
                  <text wx:else class="rental-memo-placeholder">添加备注</text>
                </view>
              </view>

              <view class="rid-actions" wx:if="{{!rentItem.noNeed && !rentItem._replaced}}">
                <view class="rid-act rid-act--primary" wx:if="{{rentItem.status == '已发放'}}" bindtap="onItemReturn" data-id="{{rentItem.id}}" data-ridx="{{ridx}}" data-iidx="{{iidx}}">
                  <van-icon name="replay" size="15px" /><text>归还</text>
                </view>
                <view class="rid-act" wx:if="{{rentItem.status == '已发放'}}" bindtap="onItemStore" data-id="{{rentItem.id}}">
                  <van-icon name="goods-collect-o" size="15px" /><text>暂存</text>
                </view>
                <view class="rid-act" wx:if="{{rentItem.status == '已发放'}}" bindtap="onItemChange" data-id="{{rentItem.id}}">
                  <van-icon name="exchange" size="15px" /><text>更换</text>
                </view>
                <view class="rid-act rid-act--primary" wx:if="{{rentItem.status == '已暂存' || rentItem.status == '未发放'}}" bindtap="onItemPick" data-id="{{rentItem.id}}">
                  <van-icon name="sign" size="15px" /><text>发放</text>
                </view>
                <block wx:if="{{rentItem.status == '已归还'}}">
                  <view class="rid-act rid-act--primary" wx:if="{{!(order.refundAmount > 0)}}" bindtap="onItemUnReturn" data-id="{{rentItem.id}}" data-ridx="{{ridx}}" data-iidx="{{iidx}}">
                    <van-icon name="revoke" size="15px" /><text>设未归还</text>
                  </view>
                  <view class="rid-act rid-act--disabled" wx:else>
                    <van-icon name="revoke" size="15px" /><text>设未归还</text>
                  </view>
                </block>
              </view>

              <!-- 发放记录：已更换的租赁物暂不显示 -->
              <block wx:if="{{!rentItem._replaced}}">
                <view class="rid-record-toggle" bindtap="onToggleItemLog" data-ridx="{{ridx}}" data-iidx="{{iidx}}">
                  <van-icon name="clock-o" size="14px" color="#6f7881" />
                  <text class="rid-record-label">发放记录</text>
                  <text class="rid-record-count" wx:if="{{rentItem.availableLog && rentItem.availableLog.length}}">{{rentItem.availableLog.length}}</text>
                  <view class="rid-record-spacer"></view>
                  <van-icon name="{{_expandedItemLogs[ridx + '_' + iidx] ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#6f7881" />
                </view>
                <view class="item-log-table" wx:if="{{_expandedItemLogs[ridx + '_' + iidx]}}">
                  <view class="item-log-row item-log-row--head">
                    <text class="item-log-col-date">日期</text>
                    <text class="item-log-col-time">时间</text>
                    <text class="item-log-col-status">操作</text>
                    <text class="item-log-col-staff">操作人</text>
                  </view>
                  <view class="item-log-row" wx:for="{{rentItem.availableLog}}" wx:key="id" wx:for-item="log">
                    <text class="item-log-col-date">{{log.dateStr}}</text>
                    <text class="item-log-col-time">{{log.timeStr}}</text>
                    <text class="item-log-col-status">{{log.status}}</text>
                    <text class="item-log-col-staff">{{log.staff ? log.staff.name : '--'}}</text>
                  </view>
                  <view class="item-log-empty" wx:if="{{!rentItem.availableLog || rentItem.availableLog.length == 0}}">暂无发放记录</view>
                </view>
              </block>

              <view class="rid-record-toggle" wx:if="{{rentItem.prev_id != null}}" bindtap="onToggleItemChange" data-ridx="{{ridx}}" data-iidx="{{iidx}}">
                <van-icon name="exchange" size="14px" color="#6f7881" />
                <text class="rid-record-label">更换记录</text>
                <view class="rid-record-spacer"></view>
                <van-icon name="{{_expandedItemChanges[ridx + '_' + iidx] ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#6f7881" />
              </view>
              <view class="item-log-table" wx:if="{{rentItem.prev_id != null && _expandedItemChanges[ridx + '_' + iidx]}}">
                <view class="item-log-row item-log-row--head">
                  <text class="item-log-col-date">编码</text>
                  <text class="item-log-col-time">名称</text>
                  <text class="item-log-col-status">日期</text>
                  <text class="item-log-col-staff">时间</text>
                </view>
                <view class="item-log-row" wx:for="{{rentItem.changesLog}}" wx:key="id" wx:for-item="chg">
                  <text class="item-log-col-date">{{chg.code || '--'}}</text>
                  <text class="item-log-col-time">{{chg.name || '--'}}</text>
                  <text class="item-log-col-status">{{chg.changeDateStr || '--'}}</text>
                  <text class="item-log-col-staff">{{chg.changeTimeStr || '--'}}</text>
                </view>
                <view class="item-log-empty" wx:if="{{!rentItem.changesLog || rentItem.changesLog.length == 0}}">暂无更换记录</view>
              </view>
            </view>
            <view wx:if="{{!item.rentItems || item.rentItems.length == 0}}" class="item-log-empty">暂无租赁物</view>
          </block>
        </block>
      </view>

      <!-- 追加中的租赁 -->
      <view class="appending-section" wx:if="{{order.appendingRentals && order.appendingRentals.length > 0}}">
        <view class="appending-title">追加中 ({{order.appendingRentals.length}})</view>
        <view class="appending-card" wx:for="{{order.appendingRentals}}" wx:key="id">
          <view class="appending-card-head">
            <text class="appending-card-name">{{item.name}} · {{item.startDate}}</text>
            <text class="appending-del-btn" bindtap="onDelAppendingRental" data-id="{{item.id}}">删除</text>
          </view>
        </view>
      </view>
    </block>

    <!-- Tab 1: 按租赁物 -->
    <block wx:if="{{_rentalTab == 1}}">
      <view wx:if="{{order._allRentItems.length == 0}}"
        style="color:#999;font-size:26rpx;text-align:center;padding:20rpx 0;">
        暂无租赁物
      </view>
      <view class="all-item-row" wx:for="{{order._allRentItems}}" wx:key="id">
        <text class="all-item-col-code">{{item.code || '无码'}}</text>
        <text class="all-item-col-name">{{item.name || '—'}}</text>
        <text class="all-item-col-cat">{{item.class_name || '—'}}</text>
        <text class="all-item-col-rental">{{item._rentalName}}</text>
        <view class="all-item-col-status">
          <view class="chip {{item._statusClass}}" style="font-size:20rpx;padding:2rpx 8rpx;">
            {{item._statusLabel}}
          </view>
        </view>
      </view>
    </block>
  </view>
  <!-- ── Card 4: 退款 ─────────────────────── -->
  <view class="card">
    <view class="section-title" bindtap="onToggleRefund">
      退款
      <view class="section-title-right">
        <van-icon name="{{_refundExpanded ? 'arrow-up' : 'arrow-down'}}" size="18px" color="#999" />
      </view>
    </view>

    <block wx:if="{{_refundExpanded}}">
      <!-- 退款摘要 -->
      <view class="refund-summary-grid">
        <view class="refund-summary-cell">
          <view class="refund-summary-label">总计押金</view>
          <view class="refund-summary-value">{{order.totalGuarantyAmountStr}}</view>
        </view>
        <view class="refund-summary-cell">
          <view class="refund-summary-label">总计租金</view>
          <view class="refund-summary-value">{{order.totalRentSummaryAmountStr}}</view>
        </view>
        <view class="refund-summary-cell">
          <view class="refund-summary-label">总计超时</view>
          <view class="refund-summary-value">{{order.totalRentOverTimeAmountStr}}</view>
        </view>
        <view class="refund-summary-cell">
          <view class="refund-summary-label">总计赔偿</view>
          <view class="refund-summary-value">{{order.totalRentRepairationAmountStr}}</view>
        </view>
      </view>

      <view class="divider"></view>

      <view class="refund-amount-row">
        <text class="refund-amount-label">应退押金</text>
        <text class="refund-amount-value">{{order.totalRentNeedToRefundAmountStr}}</text>
      </view>
      <view class="refund-amount-row">
        <text class="refund-amount-label">已退金额</text>
        <text class="refund-amount-value">{{order.refundAmountStr}}</text>
      </view>
      <view class="refund-amount-row" wx:if="{{order.member.availableDeposit > 0}}">
        <text class="refund-amount-label">可用储值</text>
        <view class="refund-deposit-right">
          <text class="refund-amount-value">{{order.member.availableDepositStr}}</text>
          <view class="refund-deposit-toggle {{order.depositPaidAmount > 0 ? 'refund-deposit-toggle--disabled' : ''}}" bindtap="onTogglePayWithDeposit">
            <text class="refund-deposit-toggle-label">储值付租金</text>
            <view class="refund-deposit-check {{(payWithDeposit || order.depositPaidAmount > 0) ? 'refund-deposit-check--on' : ''}}">
              <text wx:if="{{payWithDeposit || order.depositPaidAmount > 0}}">✓</text>
            </view>
          </view>
        </view>
      </view>
      <view class="refund-amount-row">
        <text class="refund-amount-label">实际应退</text>
        <text class="refund-amount-value refund-need">
          {{order.totalRentUnRefund <= 0 ? '¥0.00' : order.totalRentUnRefundStr}}
        </text>
      </view>

      <!-- 退款按钮 -->
      <view class="refund-btn-row">
        <van-button
          type="danger"
          block
          disabled="{{order.closed == 1 || order.totalRentUnRefund <= 0}}"
          bindtap="onRefund">
          申请退款 {{order.totalRentUnRefund > 0 ? order.totalRentUnRefundStr : ''}}
        </van-button>
      </view>
    </block>
  </view>
</view>
<view wx:else class="page-loading">
  <text>加载中…</text>
</view>

<!-- ── 底部操作栏（订单未关闭时显示） ─── -->
<view class="bottom-bar" wx:if="{{order && order.closed == 0}}">
  <van-button class="bottom-btn bottom-btn--add" bindtap="onAddPackage" size="small">
    + 添加套餐
  </van-button>
  <van-button class="bottom-btn bottom-btn--add" bindtap="onAddItem" size="small">
    + 添加单品
  </van-button>
  <van-button
    class="bottom-btn bottom-btn--confirm {{!allValid || !order.appendingRentals || order.appendingRentals.length == 0 ? 'bottom-btn--disabled' : ''}}"
    disabled="{{!allValid || !order.appendingRentals || order.appendingRentals.length == 0}}"
    bindtap="onConfirmAppend"
    size="small">
    ✓ 确认追加
  </van-button>
</view>

<!-- 更换租赁物弹窗 -->
<view wx:if="{{_chgShow}}" class="chg-overlay" catchtouchmove="noop">
  <view class="chg-header">
    <view class="chg-close-btn" bindtap="onChgCancel">
      <van-icon name="cross" size="20px" color="#333" />
    </view>
    <text class="chg-title">更换租赁物</text>
    <view style="width:60rpx;"></view>
  </view>

  <scroll-view class="chg-body" scroll-y>
    <!-- 现租赁物 -->
    <view class="chg-section">
      <view class="chg-section-label">现租赁物</view>
      <view class="chg-cur-card">
        <view class="chg-cur-head">
          <view class="chg-cur-icon">
            <van-icon name="goods-collect-o" size="20px" color="#006495" />
          </view>
          <view class="chg-cur-main">
            <text class="chg-cur-name">{{_chgItem.name || '—'}}</text>
            <text class="chg-cur-sub">{{_chgItem.noCode ? '无编码' : (_chgItem.code || '—')}}</text>
          </view>
          <view class="chip chip--status-unreturned">待替换</view>
        </view>
        <view class="chg-cur-rows">
          <view class="chg-row">
            <text class="chg-row-label">编码</text>
            <text class="chg-row-val">{{_chgItem.noCode ? '无编码' : (_chgItem.code || '—')}}</text>
          </view>
          <view class="chg-row">
            <text class="chg-row-label">名称</text>
            <text class="chg-row-val">{{_chgItem.name || '—'}}</text>
          </view>
          <view class="chg-row">
            <text class="chg-row-label">分类</text>
            <text class="chg-row-val">{{_chgItem.class_name || '—'}}</text>
          </view>
          <view class="chg-row">
            <text class="chg-row-label">发放人</text>
            <text class="chg-row-val">{{_chgItem.pickStaff ? _chgItem.pickStaff.name : '—'}}</text>
          </view>
          <view class="chg-row">
            <text class="chg-row-label">发放时间</text>
            <text class="chg-row-val">{{_chgItem.pickDateStr}} {{_chgItem.pickTimeStr}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 新租赁物 -->
    <view class="chg-section">
      <view class="chg-section-label">新租赁物</view>
      <view class="chg-hint-text">规则同新增租赁物</view>

      <view class="chg-form-card">
        <!-- 编码 -->
        <view class="chg-form-row">
          <text class="chg-form-label">编码</text>
          <view class="chg-form-right">
            <input class="chg-form-input" disabled="{{_chgNoCode}}"
              value="{{_chgCode}}"
              placeholder="{{_chgNoCode ? '无编码' : '输入或扫描编码'}}"
              bindinput="onChgCodeInput" />
            <view wx:if="{{!_chgNoCode}}" class="chg-scan-btn" bindtap="onChgScan">
              <van-icon name="scan" size="18px" color="#006495" />
            </view>
          </view>
        </view>

        <!-- 无编码 -->
        <view class="chg-form-row chg-form-row--toggle" bindtap="onChgNoCodeToggle">
          <view class="chg-toggle-box">
            <view class="chg-toggle-dot {{_chgNoCode ? 'chg-toggle-dot--on' : ''}}"></view>
            <text class="chg-form-label">无编码</text>
            <text class="chg-toggle-desc">该租赁物无物理编码</text>
          </view>
          <text class="chg-required">*</text>
        </view>

        <!-- 分类 -->
        <view class="chg-form-row">
          <text class="chg-form-label">分类<text class="chg-required">*</text></text>
          <picker class="chg-picker-wrap" mode="selector"
            range="{{_chgCategories}}" range-key="name" value="{{_chgCategoryIdx}}"
            bindchange="onChgCategoryChange">
            <view class="chg-picker-val">
              <text>{{_chgCategoryName || '请选择'}}</text>
              <van-icon name="arrow" size="14px" color="#999" />
            </view>
          </picker>
        </view>

        <!-- 名称 -->
        <view class="chg-form-row">
          <text class="chg-form-label">名称</text>
          <input class="chg-form-input" disabled="{{!_chgNoCode}}"
            value="{{_chgName}}"
            placeholder="{{_chgNoCode ? '请输入名称' : '由编码自动填入'}}"
            bindinput="onChgNameInput" />
        </view>

        <!-- 备注 -->
        <view class="chg-form-row chg-form-row--last">
          <text class="chg-form-label">备注</text>
          <input class="chg-form-input" value="{{_chgMemo}}" placeholder="选填" bindinput="onChgMemoInput" />
        </view>
      </view>
    </view>

    <view class="chg-notice">
      确认后：原租赁物自动归还，新租赁物按当前租赁商品发放，押金与租金保持不变。
    </view>
  </scroll-view>

  <view class="chg-footer">
    <view class="chg-btn chg-btn--cancel" bindtap="onChgCancel">取消</view>
    <view class="chg-btn chg-btn--confirm {{_chgValid ? '' : 'chg-btn--disabled'}}" bindtap="onChgConfirm">
      <van-icon name="success" size="16px" /><text>确认更换</text>
    </view>
  </view>
</view>

<!-- 租金明细按天编辑弹窗 -->
<view wx:if="{{_dayChargeShow}}" class="dc-mask" bindtap="onDayChargeCancel" catchtouchmove="noop">
  <view class="dc-card" catchtap="noop">
    <view class="dc-title">编辑租金明细</view>
    <view class="dc-date">{{_dayChargeDate}}</view>
    <view class="dc-field">
      <text class="dc-label">租金</text>
      <input class="dc-input {{_dayChargeWaived ? 'dc-input--disabled' : ''}}" type="digit" disabled="{{_dayChargeWaived}}" value="{{_dayChargeRent}}" data-field="Rent" bindinput="onDayChargeInput" placeholder="{{_dayChargeRentOrig}}" />
    </view>
    <view class="dc-field">
      <text class="dc-label">超时费</text>
      <input class="dc-input {{_dayChargeWaived ? 'dc-input--disabled' : ''}}" type="digit" disabled="{{_dayChargeWaived}}" value="{{_dayChargeOvertime}}" data-field="Overtime" bindinput="onDayChargeInput" placeholder="{{_dayChargeOvertimeOrig}}" />
    </view>
    <view class="dc-field">
      <text class="dc-label">减免</text>
      <input class="dc-input {{_dayChargeWaived ? 'dc-input--disabled' : ''}}" type="digit" disabled="{{_dayChargeWaived}}" value="{{_dayChargeDiscount}}" data-field="Discount" bindinput="onDayChargeInput" placeholder="{{_dayChargeDiscountOrig}}" />
    </view>
    <view class="dc-field dc-field--waive" bindtap="onDayChargeWaivedToggle">
      <text class="dc-label">免除本日全部费用</text>
      <view class="dc-checkbox {{_dayChargeWaived ? 'dc-checkbox--on' : ''}}">
        <text wx:if="{{_dayChargeWaived}}" class="dc-checkbox-tick">✓</text>
      </view>
    </view>
    <view class="dc-actions">
      <view class="dc-btn dc-btn--cancel" bindtap="onDayChargeCancel">取消</view>
      <view class="dc-btn dc-btn--confirm" bindtap="onDayChargeConfirm">确定</view>
    </view>
  </view>
</view>

<!-- 赔偿金额编辑弹窗（与租金明细弹窗同款） -->
<view wx:if="{{_repairShow}}" class="dc-mask" bindtap="onRepairCancel" catchtouchmove="noop">
  <view class="dc-card" catchtap="noop">
    <view class="dc-title">修改赔偿金额</view>
    <view class="dc-field">
      <text class="dc-label">赔偿金额</text>
      <input class="dc-input" type="digit" value="{{_repairAmount}}" bindinput="onRepairInput" placeholder="{{_repairAmountOrig}}" focus="{{_repairShow}}" />
    </view>
    <view class="dc-actions">
      <view class="dc-btn dc-btn--cancel" bindtap="onRepairCancel">取消</view>
      <view class="dc-btn dc-btn--confirm" bindtap="onRepairConfirm">确定</view>
    </view>
  </view>
</view>
