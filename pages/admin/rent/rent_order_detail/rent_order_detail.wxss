@import '/app.wxss';

/* ── 页面 & 卡片 ─────────────────────── */
.page { background: #F8F8F8; padding: 20rpx 24rpx 160rpx; min-height: 100vh; box-sizing: border-box; }
.page-loading { display: flex; align-items: center; justify-content: center; height: 100vh; color: #999; }

.card { background: #FFF; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }

/* ── 分组标题（蓝色竖条） ─────────────── */
.section-title {
  display: flex; align-items: center;
  font-size: 30rpx; font-weight: 600; color: #333;
  padding: 12rpx 0; margin-bottom: 8rpx;
}
.section-title::before {
  content: ''; display: inline-block;
  width: 6rpx; height: 28rpx;
  background: #2EA6D0; border-radius: 3rpx;
  margin-right: 14rpx; flex-shrink: 0;
}
.section-title-right { margin-left: auto; display: flex; align-items: center; gap: 8rpx; }

/* ── KV 行 ────────────────────────────── */
.kv-row {
  display: flex; justify-content: space-between; align-items: center;
  min-height: 64rpx; font-size: 28rpx; padding: 4rpx 0;
}
.kv-row--dual {
  align-items: center;
  gap: 24rpx;
}
.kv-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}
.kv-cell--right {
  justify-content: flex-start;
}
.kv-cell--code {
  flex: 1.15;
}
.kv-cell--shop {
  flex: 1.1;
}
.kv-label {
  color: #666;
  flex: 0 0 72rpx;
  width: 72rpx;
}
.kv-label--wide {
  flex-basis: 96rpx;
  width: 96rpx;
}
.kv-value { color: #333; text-align: left; flex: 1; min-width: 0; margin-left: 0; word-break: break-all; }
.kv-inline-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  overflow: hidden;
}
.kv-value--inline {
  margin-left: 0;
  min-width: 0;
}
.kv-value--nowrap {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  word-break: normal;
}
.kv-value--link {
  color: #2EA6D0;
}
.kv-value--blue { color: #2EA6D0; font-weight: 600; }
.kv-value--red { color: #E64340; font-weight: 600; }
.kv-value--amount { font-weight: 600; font-size: 32rpx; }

/* ── Chip ─────────────────────────────── */
.chip {
  display: inline-flex; padding: 4rpx 12rpx;
  border-radius: 20rpx; font-size: 22rpx; line-height: 1.4;
  flex-shrink: 0;
}
.chip--member { background: #dbeafe; color: #1d4ed8; }
.chip--guest { background: #f3f4f6; color: #6b7280; }
.chip--package { background: #e0f2fe; color: #0369a1; }
.chip--item { background: #f3f4f6; color: #6b7280; }
.chip--status-unreturned { background: #fef9c3; color: #854d0e; }
.chip--status-issued { background: #dbeafe; color: #1d4ed8; }
.chip--status-returned { background: #dcfce7; color: #15803d; }
.chip--status-noneed { background: #f3f4f6; color: #9ca3af; }

.page--compact .kv-row {
  min-height: 56rpx;
  font-size: 26rpx;
}
.page--compact .kv-row--dual {
  gap: 16rpx;
}
.page--compact .kv-label {
  font-size: 24rpx;
  flex-basis: 64rpx;
  width: 64rpx;
}
.page--compact .kv-label--wide {
  flex-basis: 88rpx;
  width: 88rpx;
}
.page--compact .kv-value {
  font-size: 26rpx;
}
.page--compact .chip {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

/* ── 分隔线 ───────────────────────────── */
.divider { height: 1rpx; background: #F0F0F0; margin: 12rpx 0; }

/* ── 去支付按钮（未付清时显示） ────────────────── */
.go-pay-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #006495;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}
.go-pay-btn:active { opacity: 0.85; }

/* ── 支付摘要 2×3 grid ────────────────── */
.pay-summary-grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  margin-bottom: 16rpx;
}
.pay-summary-cell {
  width: 48%;
  box-sizing: border-box;
  background: #F8F8F8; border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}
.pay-summary-label { font-size: 24rpx; color: #999; margin-bottom: 4rpx; }
.pay-summary-value { font-size: 30rpx; font-weight: 600; color: #333; }
.pay-summary-value--blue { color: #2EA6D0; }
.pay-summary-value--red { color: #E64340; }

.payment-detail-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
}
.payment-detail-toggle__title {
  font-size: 26rpx;
  color: #666;
}

/* ── 支付明细表格 ─────────────────────── */
.pay-table { width: 100%; }
.pay-table-row {
  display: flex; align-items: center;
  font-size: 24rpx; min-height: 56rpx;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 8rpx;
}
.pay-table-row:last-child { border-bottom: none; }
.pay-col-date { flex: 0 0 118rpx; color: #666; font-size: 22rpx; white-space: nowrap; }
.pay-col-time { flex: 0 0 100rpx; color: #666; font-size: 22rpx; white-space: nowrap; }
.pay-col-method { flex: 0 0 94rpx; color: #666; font-size: 22rpx; white-space: nowrap; }
.pay-col-cell { flex: 0 0 124rpx; color: #666; font-size: 22rpx; white-space: nowrap; text-align: center; }
.pay-col-amount { flex: 1; text-align: right; font-weight: 600; }
.pay-col-amount--pay { color: #2EA6D0; }
.pay-col-amount--refund { color: #E64340; }
/* 他人代付：整条标红 */
.pay-table-row--proxy .pay-col-date,
.pay-table-row--proxy .pay-col-time,
.pay-table-row--proxy .pay-col-method,
.pay-table-row--proxy .pay-col-cell,
.pay-table-row--proxy .pay-col-amount { color: #E64340; }

/* ── Tab pill ─────────────────────────── */
.tab-pill {
  display: flex; height: 56rpx; border-radius: 28rpx;
  background: #f3f4f6; flex-shrink: 0;
}
.tab-pill__item {
  flex: 1; text-align: center; line-height: 56rpx;
  font-size: 26rpx; border-radius: 28rpx; color: #6b7280;
}
.tab-pill__item--active { background: #2EA6D0; color: #fff; }
/* 视图切换：整宽分段控件（文字完整展示） */
.rental-tab-pill {
  display: flex; height: 64rpx; border-radius: 12rpx;
  background: #f3f4f6; padding: 4rpx; margin: 4rpx 0 18rpx;
}
.rental-tab-pill__item {
  flex: 1; text-align: center; line-height: 56rpx;
  font-size: 26rpx; border-radius: 10rpx; color: #6b7280;
}
.rental-tab-pill__item--active { background: #fff; color: #006495; font-weight: 600; }
/* 「按租赁物」分组标签 + 底部全部归还栏 */
.byitem-rental-label { font-size: 24rpx; color: #6f7881; padding: 12rpx 4rpx 4rpx; font-weight: 600; }
.return-all-bar { margin-top: 24rpx; }

/* ── 租赁子卡片 ───────────────────────── */
.rental-card {
  background: #f2f5fa;
  border-radius: 14rpx;
  padding: 0;
  margin-bottom: 14rpx;
  overflow: hidden;
}
.rental-card:last-child { margin-bottom: 0; }

.rental-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 58rpx;
  padding: 12rpx 14rpx;
  background: #dce3ee;
}
.rental-head-name {
  flex: 1; font-size: 28rpx; font-weight: 600; color: #0b1c30;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rental-head-meta { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.rental-head-fee { font-size: 24rpx; color: #6f7881; }
.rental-head-fee text { color: #0b1c30; font-weight: 600; }

.rental-showcase {
  background: #f8fbff;
  padding: 12rpx;
}
.rental-showcase-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #5f6872;
  font-size: 24rpx;
  padding: 0 2rpx 8rpx;
}
.rental-showcase-summary-value {
  color: #0b1c30;
  font-weight: 700;
}
.rental-showcase-summary-value--accent {
  color: #0b8fd6;
}
.rental-showcase-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.rental-showcase-time-card {
  flex: 1;
  min-height: 110rpx;
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.rental-showcase-time-card--start {
  background: #c8dfee;
  border: 1rpx solid #8cb9d1;
}
.rental-showcase-time-card--end {
  background: #e7ebf1;
  border: 1rpx solid #d5dce7;
}
.rental-showcase-time-tag {
  color: #0b5e88;
  font-size: 22rpx;
  margin-bottom: 4rpx;
}
.rental-showcase-time-date {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}
.rental-showcase-time-time {
  color: #4f5966;
  font-size: 26rpx;
  line-height: 1.2;
  margin-top: 4rpx;
}
.rental-showcase-time-arrow {
  flex: 0 0 22rpx;
  text-align: center;
  color: #97a2b1;
  font-size: 28rpx;
}
.rental-showcase-fee-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  padding: 8rpx 8rpx 4rpx;
  background: #f4f6f9;
  border-radius: 10rpx 10rpx 0 0;
}
.rental-showcase-fee-cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx 6rpx;
}
.rental-showcase-fee-label {
  display: block;
  color: #6f7881;
  font-size: 24rpx;
  line-height: 1.3;
}
.rental-showcase-fee-value {
  display: block;
  color: #0b1c30;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 2rpx;
}
.rental-showcase-fee-cell--tappable {
  border-radius: 8rpx;
}
.rental-showcase-fee-label--row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.rental-showcase-fee-cell--tappable:active {
  background: #eef3f8;
}
.rental-showcase-fee-value--entertain {
  color: #d97706;
}
.rental-showcase-subtotal {
  height: 68rpx;
  border-top: 1rpx solid #e7edf4;
  border-radius: 0 0 10rpx 10rpx;
  background: #dde4ef;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
}
.rental-showcase-subtotal-label {
  color: #3f4850;
  font-size: 30rpx;
}
.rental-showcase-subtotal-value {
  color: #006fb0;
  font-size: 48rpx;
  font-weight: 700;
}
.rental-showcase-memo-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rental-showcase-memo-box {
  flex: 1;
  min-height: 58rpx;
  border-radius: 18rpx;
  border: 1rpx solid #d7dbe2;
  background: #f6f7f9;
  color: #0b1c30;
  font-size: 26rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.page--compact .rental-showcase-time-date {
  font-size: 28rpx;
}
.page--compact .rental-showcase-time-time {
  font-size: 24rpx;
}
.page--compact .rental-showcase-fee-value {
  font-size: 32rpx;
}
.page--compact .rental-showcase-subtotal-label {
  font-size: 28rpx;
}
.page--compact .rental-showcase-subtotal-value {
  font-size: 42rpx;
}

.rental-subsection-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 0 10rpx;
}
.rental-subsection-head--between {
  justify-content: space-between;
}
.rental-subsection-title {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #3f4850;
  font-weight: 600;
  position: relative;
  padding-left: 12rpx;
}
.rental-subsection-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 4rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #8ba8bd;
}

.rental-body { padding-top: 12rpx; }
.rental-detail-grid {
  display: flex; flex-wrap: wrap; gap: 0;
  font-size: 26rpx;
}
.rental-detail-grid--panel {
  border: 1rpx solid #edf2f6;
  border-radius: 10rpx;
  background: #f9fbfd;
  padding: 6rpx 10rpx;
}
.rental-detail-cell {
  flex: 0 0 50%;
  display: flex;
  min-height: 56rpx;
  align-items: center;
  gap: 8rpx;
}
.rental-detail-label { color: #6f7881; font-size: 24rpx; flex-shrink: 0; }
.rental-detail-value { color: #0b1c30; font-weight: 500; }

.rental-fee-row {
  display: flex; gap: 16rpx; flex-wrap: wrap;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.rental-fee-cell {
  display: flex;
  gap: 6rpx;
  background: #f7f9fc;
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
}
.rental-fee-label { color: #6f7881; }
.rental-fee-value { color: #0b1c30; font-weight: 600; }

.rental-memo-row {
  display: flex; align-items: flex-start; gap: 8rpx;
  font-size: 26rpx; min-height: 52rpx; padding: 4rpx 0;
}
.rental-memo-label { color: #6f7881; flex-shrink: 0; padding-top: 6rpx; }
.rental-memo-tap {
  flex: 1;
  color: #0b1c30;
  word-break: break-all;
  border: 1rpx solid #e5ebf1;
  background: #f9fbfd;
  border-radius: 8rpx;
  min-height: 46rpx;
  line-height: 36rpx;
  padding: 4rpx 10rpx;
}
.rental-memo-placeholder { color: #ccc; }

.toggle-row {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 26rpx;
  color: #3f4850;
  padding: 8rpx 12rpx;
}
.toggle-row--between {
  justify-content: space-between;
  gap: 12rpx;
}
.toggle-row-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ── 详情 / 物明细 ─────────────────────── */
.detail-table { font-size: 24rpx; }
.detail-table-row {
  display: flex; gap: 8rpx; min-height: 48rpx; align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
  padding: 0 12rpx;
}
.detail-table-row:last-child { border-bottom: none; }
.detail-table-row--tappable:active { background: #f2f6f8; }
.detail-table-head .detail-col-date,
.detail-table-head .detail-col-amount,
.detail-table-head .detail-col-overtime,
.detail-table-head .detail-col-discount,
.detail-table-head .detail-col-subtotal { color: #999; font-weight: 400; }
.detail-col-date { flex: 0 0 140rpx; color: #666; }
.detail-col-amount { flex: 0 0 100rpx; text-align: right; font-weight: 600; color: #333; }
.detail-col-overtime { flex: 0 0 100rpx; text-align: right; color: #333; }
.detail-col-discount { flex: 0 0 84rpx; text-align: right; color: #999; }
.detail-col-subtotal { flex: 1; text-align: right; color: #2EA6D0; font-weight: 600; }

/* 租金明细按天编辑弹窗 */
.dc-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
}
.dc-card {
  width: 560rpx; background: #fff; border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx; box-sizing: border-box;
}
.dc-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; text-align: center; }
.dc-date { font-size: 24rpx; color: #999; text-align: center; margin-top: 6rpx; margin-bottom: 16rpx; }
.dc-field {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.dc-label { font-size: 28rpx; color: #333; flex: 0 0 120rpx; }
.dc-input {
  flex: 1; text-align: right; font-size: 30rpx; color: #1a1a1a;
  background: #f6f7f9; border-radius: 10rpx; padding: 10rpx 16rpx;
}
.dc-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.dc-btn {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; font-size: 30rpx;
}
.dc-btn--cancel { background: #f2f3f5; color: #666; }
.dc-btn--confirm { background: #2EA6D0; color: #fff; }
.dc-btn:active { opacity: 0.85; }

.item-table { font-size: 24rpx; }
.item-table-row {
  display: flex; gap: 8rpx; min-height: 48rpx; align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
}
.item-table-row:last-child { border-bottom: none; }
.item-col-code { flex: 0 0 100rpx; color: #666; }
.item-col-name { flex: 1; color: #333; }
.item-col-cat { flex: 0 0 80rpx; color: #666; }
.item-col-status { flex: 0 0 80rpx; text-align: right; }

/* ── 租赁物明细卡片（参考 order_detail_0614.html 模版）─────── */
.item-detail-card {
  background: #ffffff;
  border: 1rpx solid rgba(191, 199, 209, 0.45);
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx;
  overflow: hidden;
}
.item-detail-card--noneed { opacity: 0.6; }
/* 已更换（被换下）：该租赁物已不可用 —— 更深底色 + 更浅文字 */
.item-detail-card--replaced {
  background: #e6eaf0;
  border-color: rgba(160, 170, 182, 0.5);
}
.item-detail-card--replaced .rid-head { background: #dbe1e9; }
.item-detail-card--replaced .rid-head-icon { background: #eef1f5; opacity: 0.65; }
.item-detail-card--replaced .rid-name,
.item-detail-card--replaced .rid-tl-date,
.item-detail-card--replaced .rid-kv-value { color: #9aa3ad; }
.item-detail-card--replaced .rid-sub-label,
.item-detail-card--replaced .rid-sub-value,
.item-detail-card--replaced .rid-sub-dot,
.item-detail-card--replaced .rid-tl-label,
.item-detail-card--replaced .rid-tl-time,
.item-detail-card--replaced .rid-tl-staff,
.item-detail-card--replaced .rid-kv-label,
.item-detail-card--replaced .rid-kv-memo { color: #b0b8c0; }

/* 头部条：图标 + 名称 + 状态 + 编码/分类 */
.rid-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #eff4ff;
  padding: 14rpx 16rpx;
}
.rid-head-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(191, 199, 209, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rid-head-main { flex: 1; min-width: 0; }
.rid-head-title { display: flex; align-items: center; gap: 12rpx; }
.rid-name {
  flex-shrink: 1;
  min-width: 0;
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rid-badge { flex-shrink: 0; font-size: 20rpx; padding: 2rpx 10rpx; }
.rid-head-sub { margin-top: 4rpx; font-size: 23rpx; line-height: 1.3; }
.rid-sub-label { color: #6f7881; }
.rid-sub-value { color: #3f4850; margin-left: 6rpx; }
.rid-sub-dot { color: #bfc7d1; margin: 0 10rpx; }

/* 发放 / 归还 双列时间线 */
.rid-timeline { display: flex; padding: 14rpx 16rpx 6rpx; }
.rid-tl-col { flex: 1; min-width: 0; }
.rid-tl-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 6rpx; }
.rid-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #bfc7d1; }
.rid-dot--on { background: #006495; }
.rid-tl-label { color: #3f4850; font-size: 22rpx; font-weight: 600; }
.rid-tl-date { color: #0b1c30; font-size: 25rpx; }
.rid-tl-time { color: #6f7881; font-size: 22rpx; }
.rid-tl-staff {
  color: #6f7881;
  font-size: 22rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 键值行：赔偿金额 / 备注 */
.rid-kv {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 60rpx;
  padding: 8rpx 16rpx;
  border-top: 1rpx solid rgba(191, 199, 209, 0.3);
}
.rid-kv-label { color: #6f7881; font-size: 25rpx; flex-shrink: 0; }
.rid-kv-value { flex: 1; text-align: right; color: #3f4850; font-size: 26rpx; font-weight: 700; }
.rid-kv-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 0;
}
.rid-kv-memo {
  color: #3f4850;
  font-size: 25rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rid-kv-input {
  flex: 1;
  min-width: 0;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}
.rid-link-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #6f7881;
  font-size: 24rpx;
  flex-shrink: 0;
}
.rid-mini-btn {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(191, 199, 209, 0.7);
  color: #3f4850;
  font-size: 24rpx;
}
.rid-mini-btn--primary { background: #006495; border-color: #006495; color: #ffffff; }
/* 赔偿按钮（移到「赔偿金额」行右侧的紧凑红色按钮） */
.rid-kv-repair-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.5);
  color: #ba1a1a;
  font-size: 24rpx;
  background: #ffffff;
}
.rid-kv-repair-btn:active { opacity: 0.85; }

/* 操作按钮行（图标 + 文字，等宽） */
.rid-actions {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid rgba(191, 199, 209, 0.3);
}
.rid-act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 60rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(191, 199, 209, 0.7);
  background: #ffffff;
  color: #0b1c30;
  font-size: 25rpx;
}
.rid-act--primary { background: #006495; border-color: #006495; color: #ffffff; }
.rid-act--danger { border-color: rgba(186, 26, 26, 0.5); color: #ba1a1a; background: #ffffff; }
.rid-act--disabled { opacity: 0.45; }
.rid-act:active { opacity: 0.85; }

/* 记录展开：发放记录 / 更换记录 */
.rid-record-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  border-top: 1rpx solid rgba(191, 199, 209, 0.3);
}
.rid-record-label { color: #3f4850; font-size: 25rpx; font-weight: 600; }
.rid-record-count { color: #6f7881; font-size: 22rpx; }
.rid-record-spacer { flex: 1; }
.item-log-table {
  padding: 0 16rpx 12rpx;
}
.item-log-row {
  display: flex;
  align-items: center;
  min-height: 44rpx;
  font-size: 22rpx;
  border-bottom: 1rpx solid #efefef;
  color: #666;
}
.item-log-row--head {
  color: #999;
}
.item-log-col-date,
.item-log-col-time,
.item-log-col-status {
  flex: 0 0 22%;
}
.item-log-col-staff {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-log-empty {
  color: #999;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 0;
}

/* ── 全部租赁物（Tab 1）─────────────────── */
.all-items-list { font-size: 26rpx; }
.all-item-row {
  display: flex; gap: 8rpx; min-height: 56rpx; align-items: center;
  border-bottom: 1rpx solid #F0F0F0; padding: 4rpx 0;
}
.all-item-row:last-child { border-bottom: none; }
.all-item-col-code { flex: 0 0 96rpx; color: #666; font-size: 24rpx; }
.all-item-col-name { flex: 1; color: #333; }
.all-item-col-cat { flex: 0 0 80rpx; color: #666; font-size: 24rpx; }
.all-item-col-rental { flex: 0 0 120rpx; color: #999; font-size: 22rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.all-item-col-status { flex: 0 0 80rpx; text-align: right; }

/* ── 追加中的租赁 ─────────────────────── */
.appending-section { margin-top: 16rpx; }
.appending-title { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.appending-card { background: #F8F8F8; border-radius: 8rpx; padding: 12rpx 16rpx; margin-bottom: 8rpx; }
.appending-card-head { display: flex; justify-content: space-between; align-items: center; }
.appending-card-name { font-size: 26rpx; color: #333; flex: 1; }
.appending-del-btn { font-size: 24rpx; color: #E64340; padding: 4rpx 8rpx; }

/* ── 退款摘要 ─────────────────────────── */
.refund-summary-grid {
  display: flex; flex-wrap: nowrap; gap: 8rpx;
  margin-bottom: 16rpx;
}
.refund-summary-cell {
  flex: 1;
  background: #F8F8F8; border-radius: 8rpx;
  padding: 8rpx 8rpx;
  min-width: 0;
}
.refund-summary-label { font-size: 20rpx; color: #999; margin-bottom: 2rpx; }
.refund-summary-value { font-size: 26rpx; font-weight: 600; color: #333; }
.refund-amount-row { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; }
.refund-amount-label { font-size: 26rpx; color: #666; }
.refund-amount-value { font-size: 28rpx; color: #333; font-weight: 600; }
.refund-need { color: #E64340; }
.refund-btn-row { margin-top: 16rpx; }
.refund-deposit-right { display: flex; align-items: center; gap: 24rpx; }
.refund-deposit-toggle { display: flex; align-items: center; gap: 10rpx; }
.refund-deposit-toggle-label { font-size: 24rpx; color: #006495; }
.refund-deposit-toggle--disabled { opacity: 0.45; }
.refund-deposit-check {
  width: 34rpx; height: 34rpx; border-radius: 6rpx;
  border: 2rpx solid #006495; display: flex; align-items: center; justify-content: center;
  color: #006495; font-size: 22rpx; line-height: 1;
}
.refund-deposit-check--on { background: #006495; color: #ffffff; }
/* 微信身份核验二维码弹窗 */
.verify-qr-tip { font-size: 24rpx; color: #666; text-align: center; margin: 12rpx 0 20rpx; line-height: 1.5; }
.verify-qr-img { width: 360rpx; height: 360rpx; display: block; margin: 0 auto; }
.verify-qr-waiting { font-size: 24rpx; color: #006495; text-align: center; margin-top: 16rpx; }

/* ── 底部操作栏 ───────────────────────── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex; gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.bottom-btn { flex: 1; height: 76rpx; border-radius: 8rpx; font-size: 28rpx; }
.bottom-btn--add { background: #006495; color: #fff; border-color: #006495; }
.bottom-btn--confirm { background: #006495; color: #fff; border-color: #006495; }
.bottom-btn--disabled { background: #ccc !important; color: #fff !important; border-color: #ccc !important; }

/* ── 更换租赁物弹窗 ─────────────────────── */
.chg-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: #f8f9fa; z-index: 900;
  display: flex; flex-direction: column;
}
.chg-header {
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between;
  height: 88rpx; padding: 0 24rpx;
  background: #fff; border-bottom: 1rpx solid #f0f0f0;
}
.chg-close-btn { width: 60rpx; display: flex; align-items: center; }
.chg-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; }

.chg-body { flex: 1; overflow-y: auto; }
.chg-section { padding: 20rpx 24rpx 8rpx; }
.chg-section-label {
  font-size: 26rpx; font-weight: 600; color: #3f4850;
  padding-left: 12rpx; border-left: 4rpx solid #2EA6D0;
  margin-bottom: 14rpx;
}
.chg-hint-text { font-size: 22rpx; color: #999; margin-bottom: 14rpx; }

/* 现租赁物卡片 */
.chg-cur-card {
  background: #fff; border-radius: 12rpx;
  border: 1rpx solid rgba(191,199,209,0.5); overflow: hidden;
}
.chg-cur-head {
  display: flex; align-items: center; gap: 14rpx;
  background: #eff4ff; padding: 14rpx 16rpx;
}
.chg-cur-icon {
  width: 52rpx; height: 52rpx; border-radius: 10rpx;
  background: #fff; border: 1rpx solid rgba(191,199,209,0.5);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.chg-cur-main { flex: 1; min-width: 0; }
.chg-cur-name { display: block; font-size: 28rpx; font-weight: 700; color: #0b1c30; }
.chg-cur-sub { display: block; font-size: 22rpx; color: #6f7881; margin-top: 2rpx; }
.chg-cur-rows { padding: 4rpx 16rpx; }
.chg-row {
  display: flex; align-items: center; min-height: 52rpx;
  border-bottom: 1rpx solid rgba(191,199,209,0.25); font-size: 26rpx;
}
.chg-row:last-child { border-bottom: none; }
.chg-row-label { color: #6f7881; flex: 0 0 120rpx; }
.chg-row-val { color: #0b1c30; flex: 1; }

/* 新租赁物表单卡片 */
.chg-form-card {
  background: #fff; border-radius: 12rpx;
  border: 1rpx solid rgba(191,199,209,0.45); overflow: hidden;
}
.chg-form-row {
  display: flex; align-items: center;
  min-height: 88rpx; padding: 0 20rpx;
  border-bottom: 1rpx solid rgba(191,199,209,0.3);
  gap: 16rpx;
}
.chg-form-row--toggle { }
.chg-form-row--last { border-bottom: none; }
.chg-form-label { font-size: 28rpx; color: #3f4850; flex: 0 0 96rpx; }
.chg-form-right { flex: 1; display: flex; align-items: center; gap: 10rpx; }
.chg-form-input { flex: 1; font-size: 28rpx; color: #0b1c30; min-height: 60rpx; }
.chg-scan-btn { padding: 10rpx; flex-shrink: 0; }
.chg-required { color: #e64340; font-size: 24rpx; flex-shrink: 0; }

/* 无编码 toggle */
.chg-toggle-box { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.chg-toggle-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  border: 2rpx solid #bfc7d1; flex-shrink: 0; box-sizing: border-box;
}
.chg-toggle-dot--on { background: #006495; border-color: #006495; }
.chg-toggle-desc { font-size: 24rpx; color: #999; }

/* 分类 picker */
.chg-picker-wrap { flex: 1; }
.chg-picker-val {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 60rpx; font-size: 28rpx; color: #0b1c30;
}

/* 说明文字 */
.chg-notice {
  margin: 8rpx 24rpx 32rpx;
  font-size: 22rpx; color: #999; line-height: 1.7;
  padding: 16rpx 18rpx;
  background: #fff; border-radius: 10rpx;
  border: 1rpx solid rgba(191,199,209,0.3);
}

/* 底部按钮 */
.chg-footer {
  flex-shrink: 0;
  display: flex; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #f0f0f0;
}
.chg-btn {
  flex: 1; height: 88rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  gap: 8rpx; font-size: 30rpx;
}
.chg-btn--cancel { background: #f2f3f5; color: #666; }
.chg-btn--confirm { background: #006495; color: #fff; }
.chg-btn--disabled { opacity: 0.45; }
.chg-btn:active { opacity: 0.85; }

/* 免除态：整行划线 */
.detail-table-row--waived { text-decoration: line-through; color: #b0b0b0; }
.detail-table-row--waived .detail-col-date,
.detail-table-row--waived .detail-col-amount,
.detail-table-row--waived .detail-col-overtime,
.detail-table-row--waived .detail-col-discount,
.detail-table-row--waived .detail-col-subtotal { color: #b0b0b0; }

/* 弹窗：免除复选框行 + 禁用态输入框 */
.dc-checkbox {
  width: 40rpx; height: 40rpx; border: 2rpx solid #c8cdd4; border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center; background: #fff;
}
.dc-checkbox--on { background: #2EA6D0; border-color: #2EA6D0; }
.dc-checkbox-tick { color: #fff; font-size: 28rpx; line-height: 1; }
.dc-input--disabled { color: #b0b0b0; background: #eef0f2; }
