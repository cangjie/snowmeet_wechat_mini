@import '/app.wxss';

/* ── 页面 & 卡片 ─────────────────────── */
.page { background: #F8F8F8; padding: 20rpx 24rpx 160rpx; min-height: 100vh; box-sizing: border-box; }
.page-loading { display: flex; align-items: center; justify-content: center; height: 100vh; color: #999; }

.card { background: #FFF; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }

/* ── 分组标题（蓝色竖条） ─────────────── */
.section-title {
  display: flex; align-items: center;
  font-size: 30rpx; font-weight: 600; color: #333;
  padding: 12rpx 0; margin-bottom: 8rpx;
}
.section-title::before {
  content: ''; display: inline-block;
  width: 6rpx; height: 28rpx;
  background: #2EA6D0; border-radius: 3rpx;
  margin-right: 14rpx; flex-shrink: 0;
}
.section-title-right { margin-left: auto; display: flex; align-items: center; gap: 8rpx; }

/* ── KV 行 ────────────────────────────── */
.kv-row {
  display: flex; justify-content: space-between; align-items: center;
  min-height: 64rpx; font-size: 28rpx; padding: 4rpx 0;
}
.kv-row--dual {
  align-items: center;
  gap: 24rpx;
}
.kv-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}
.kv-cell--right {
  justify-content: flex-start;
}
.kv-cell--code {
  flex: 1.15;
}
.kv-cell--shop {
  flex: 1.1;
}
.kv-label {
  color: #666;
  flex: 0 0 72rpx;
  width: 72rpx;
}
.kv-label--wide {
  flex-basis: 96rpx;
  width: 96rpx;
}
.kv-value { color: #333; text-align: left; flex: 1; min-width: 0; margin-left: 0; word-break: break-all; }
.kv-inline-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  overflow: hidden;
}
.kv-value--inline {
  margin-left: 0;
  min-width: 0;
}
.kv-value--nowrap {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  word-break: normal;
}
.kv-value--link {
  color: #2EA6D0;
}
.kv-value--blue { color: #2EA6D0; font-weight: 600; }
.kv-value--red { color: #E64340; font-weight: 600; }
.kv-value--amount { font-weight: 600; font-size: 32rpx; }

/* ── Chip ─────────────────────────────── */
.chip {
  display: inline-flex; padding: 4rpx 12rpx;
  border-radius: 20rpx; font-size: 22rpx; line-height: 1.4;
  flex-shrink: 0;
}
.chip--member { background: #dbeafe; color: #1d4ed8; }
.chip--guest { background: #f3f4f6; color: #6b7280; }
.chip--package { background: #e0f2fe; color: #0369a1; }
.chip--item { background: #f3f4f6; color: #6b7280; }
.chip--status-unreturned { background: #fef9c3; color: #854d0e; }
.chip--status-issued { background: #dbeafe; color: #1d4ed8; }
.chip--status-returned { background: #dcfce7; color: #15803d; }
.chip--status-noneed { background: #f3f4f6; color: #9ca3af; }

.page--compact .kv-row {
  min-height: 56rpx;
  font-size: 26rpx;
}
.page--compact .kv-row--dual {
  gap: 16rpx;
}
.page--compact .kv-label {
  font-size: 24rpx;
  flex-basis: 64rpx;
  width: 64rpx;
}
.page--compact .kv-label--wide {
  flex-basis: 88rpx;
  width: 88rpx;
}
.page--compact .kv-value {
  font-size: 26rpx;
}
.page--compact .chip {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

/* ── 分隔线 ───────────────────────────── */
.divider { height: 1rpx; background: #F0F0F0; margin: 12rpx 0; }

/* ── 支付摘要 2×3 grid ────────────────── */
.pay-summary-grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  margin-bottom: 16rpx;
}
.pay-summary-cell {
  width: 48%;
  box-sizing: border-box;
  background: #F8F8F8; border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}
.pay-summary-label { font-size: 24rpx; color: #999; margin-bottom: 4rpx; }
.pay-summary-value { font-size: 30rpx; font-weight: 600; color: #333; }
.pay-summary-value--blue { color: #2EA6D0; }
.pay-summary-value--red { color: #E64340; }

.payment-detail-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
}
.payment-detail-toggle__title {
  font-size: 26rpx;
  color: #666;
}

/* ── 支付明细表格 ─────────────────────── */
.pay-table { width: 100%; }
.pay-table-row {
  display: flex; align-items: center;
  font-size: 24rpx; min-height: 56rpx;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 8rpx;
}
.pay-table-row:last-child { border-bottom: none; }
.pay-col-date { flex: 0 0 120rpx; color: #666; font-size: 22rpx; }
.pay-col-method { flex: 1; color: #666; }
.pay-col-type { flex: 0 0 60rpx; }
.pay-col-amount { flex: 0 0 130rpx; text-align: right; font-weight: 600; }
.pay-col-amount--pay { color: #2EA6D0; }
.pay-col-amount--refund { color: #E64340; }

/* ── Tab pill ─────────────────────────── */
.tab-pill {
  display: flex; height: 56rpx; border-radius: 28rpx;
  background: #f3f4f6; flex-shrink: 0;
}
.tab-pill__item {
  flex: 1; text-align: center; line-height: 56rpx;
  font-size: 26rpx; border-radius: 28rpx; color: #6b7280;
}
.tab-pill__item--active { background: #2EA6D0; color: #fff; }

/* ── 租赁子卡片 ───────────────────────── */
.rental-card {
  background: #f2f5fa;
  border-radius: 14rpx;
  padding: 0;
  margin-bottom: 14rpx;
  overflow: hidden;
}
.rental-card:last-child { margin-bottom: 0; }

.rental-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 58rpx;
  padding: 12rpx 14rpx;
  background: #dce3ee;
}
.rental-head-name {
  flex: 1; font-size: 28rpx; font-weight: 600; color: #0b1c30;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rental-head-meta { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.rental-head-fee { font-size: 24rpx; color: #6f7881; }
.rental-head-fee text { color: #0b1c30; font-weight: 600; }

.rental-showcase {
  background: #f8fbff;
  padding: 12rpx;
}
.rental-showcase-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #5f6872;
  font-size: 24rpx;
  padding: 0 2rpx 8rpx;
}
.rental-showcase-summary-value {
  color: #0b1c30;
  font-weight: 700;
}
.rental-showcase-summary-value--accent {
  color: #0b8fd6;
}
.rental-showcase-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.rental-showcase-time-card {
  flex: 1;
  min-height: 110rpx;
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.rental-showcase-time-card--start {
  background: #c8dfee;
  border: 1rpx solid #8cb9d1;
}
.rental-showcase-time-card--end {
  background: #e7ebf1;
  border: 1rpx solid #d5dce7;
}
.rental-showcase-time-tag {
  color: #0b5e88;
  font-size: 22rpx;
  margin-bottom: 4rpx;
}
.rental-showcase-time-date {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}
.rental-showcase-time-time {
  color: #4f5966;
  font-size: 26rpx;
  line-height: 1.2;
  margin-top: 4rpx;
}
.rental-showcase-time-arrow {
  flex: 0 0 22rpx;
  text-align: center;
  color: #97a2b1;
  font-size: 28rpx;
}
.rental-showcase-fee-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  padding: 8rpx 8rpx 4rpx;
  background: #f4f6f9;
  border-radius: 10rpx 10rpx 0 0;
}
.rental-showcase-fee-cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx 6rpx;
}
.rental-showcase-fee-label {
  display: block;
  color: #6f7881;
  font-size: 24rpx;
  line-height: 1.3;
}
.rental-showcase-fee-value {
  display: block;
  color: #0b1c30;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 2rpx;
}
.rental-showcase-subtotal {
  height: 68rpx;
  border-top: 1rpx solid #e7edf4;
  border-radius: 0 0 10rpx 10rpx;
  background: #dde4ef;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
}
.rental-showcase-subtotal-label {
  color: #3f4850;
  font-size: 30rpx;
}
.rental-showcase-subtotal-value {
  color: #006fb0;
  font-size: 48rpx;
  font-weight: 700;
}
.rental-showcase-memo-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rental-showcase-memo-box {
  flex: 1;
  min-height: 58rpx;
  border-radius: 18rpx;
  border: 1rpx solid #d7dbe2;
  background: #f6f7f9;
  color: #0b1c30;
  font-size: 26rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.page--compact .rental-showcase-time-date {
  font-size: 28rpx;
}
.page--compact .rental-showcase-time-time {
  font-size: 24rpx;
}
.page--compact .rental-showcase-fee-value {
  font-size: 32rpx;
}
.page--compact .rental-showcase-subtotal-label {
  font-size: 28rpx;
}
.page--compact .rental-showcase-subtotal-value {
  font-size: 42rpx;
}

.rental-subsection-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 0 10rpx;
}
.rental-subsection-head--between {
  justify-content: space-between;
}
.rental-subsection-title {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #3f4850;
  font-weight: 600;
  position: relative;
  padding-left: 12rpx;
}
.rental-subsection-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 4rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #8ba8bd;
}

.rental-body { padding-top: 12rpx; }
.rental-detail-grid {
  display: flex; flex-wrap: wrap; gap: 0;
  font-size: 26rpx;
}
.rental-detail-grid--panel {
  border: 1rpx solid #edf2f6;
  border-radius: 10rpx;
  background: #f9fbfd;
  padding: 6rpx 10rpx;
}
.rental-detail-cell {
  flex: 0 0 50%;
  display: flex;
  min-height: 56rpx;
  align-items: center;
  gap: 8rpx;
}
.rental-detail-label { color: #6f7881; font-size: 24rpx; flex-shrink: 0; }
.rental-detail-value { color: #0b1c30; font-weight: 500; }

.rental-fee-row {
  display: flex; gap: 16rpx; flex-wrap: wrap;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.rental-fee-cell {
  display: flex;
  gap: 6rpx;
  background: #f7f9fc;
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
}
.rental-fee-label { color: #6f7881; }
.rental-fee-value { color: #0b1c30; font-weight: 600; }

.rental-memo-row {
  display: flex; align-items: flex-start; gap: 8rpx;
  font-size: 26rpx; min-height: 52rpx; padding: 4rpx 0;
}
.rental-memo-label { color: #6f7881; flex-shrink: 0; padding-top: 6rpx; }
.rental-memo-tap {
  flex: 1;
  color: #0b1c30;
  word-break: break-all;
  border: 1rpx solid #e5ebf1;
  background: #f9fbfd;
  border-radius: 8rpx;
  min-height: 46rpx;
  line-height: 36rpx;
  padding: 4rpx 10rpx;
}
.rental-memo-placeholder { color: #ccc; }

.toggle-row {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 26rpx;
  color: #3f4850;
  padding: 8rpx 12rpx;
}
.toggle-row--between {
  justify-content: space-between;
  gap: 12rpx;
}
.toggle-row-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ── 详情 / 物明细 ─────────────────────── */
.detail-table { font-size: 24rpx; }
.detail-table-row {
  display: flex; gap: 8rpx; min-height: 48rpx; align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
  padding: 0 12rpx;
}
.detail-table-row:last-child { border-bottom: none; }
.detail-table-row--tappable:active { background: #f2f6f8; }
.detail-table-head .detail-col-date,
.detail-table-head .detail-col-amount,
.detail-table-head .detail-col-overtime,
.detail-table-head .detail-col-discount,
.detail-table-head .detail-col-subtotal { color: #999; font-weight: 400; }
.detail-col-date { flex: 0 0 140rpx; color: #666; }
.detail-col-amount { flex: 0 0 100rpx; text-align: right; font-weight: 600; color: #333; }
.detail-col-overtime { flex: 0 0 100rpx; text-align: right; color: #333; }
.detail-col-discount { flex: 0 0 84rpx; text-align: right; color: #999; }
.detail-col-subtotal { flex: 1; text-align: right; color: #2EA6D0; font-weight: 600; }

/* 租金明细按天编辑弹窗 */
.dc-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
}
.dc-card {
  width: 560rpx; background: #fff; border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx; box-sizing: border-box;
}
.dc-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; text-align: center; }
.dc-date { font-size: 24rpx; color: #999; text-align: center; margin-top: 6rpx; margin-bottom: 16rpx; }
.dc-field {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.dc-label { font-size: 28rpx; color: #333; flex: 0 0 120rpx; }
.dc-input {
  flex: 1; text-align: right; font-size: 30rpx; color: #1a1a1a;
  background: #f6f7f9; border-radius: 10rpx; padding: 10rpx 16rpx;
}
.dc-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.dc-btn {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; font-size: 30rpx;
}
.dc-btn--cancel { background: #f2f3f5; color: #666; }
.dc-btn--confirm { background: #2EA6D0; color: #fff; }
.dc-btn:active { opacity: 0.85; }

.item-table { font-size: 24rpx; }
.item-table-row {
  display: flex; gap: 8rpx; min-height: 48rpx; align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
}
.item-table-row:last-child { border-bottom: none; }
.item-col-code { flex: 0 0 100rpx; color: #666; }
.item-col-name { flex: 1; color: #333; }
.item-col-cat { flex: 0 0 80rpx; color: #666; }
.item-col-status { flex: 0 0 80rpx; text-align: right; }

.item-detail-card {
  background: #f5f7fb;
  border-radius: 10rpx;
  padding: 12rpx;
  margin: 0 12rpx 12rpx;
}
.item-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding-bottom: 8rpx;
}
.item-detail-name {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-detail-grid {
  display: flex;
  flex-wrap: wrap;
}
.item-detail-cell {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 46rpx;
  padding-right: 8rpx;
}
.item-detail-label {
  color: #999;
  font-size: 22rpx;
  flex-shrink: 0;
}
.item-detail-value {
  color: #333;
  font-size: 24rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-edit-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}
.item-edit-row--memo {
  align-items: flex-start;
}
.item-edit-label {
  color: #666;
  font-size: 24rpx;
  width: 56rpx;
  flex-shrink: 0;
}
.item-edit-value {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 24rpx;
}
.item-edit-value--memo {
  word-break: break-all;
}
.item-edit-input {
  flex: 1;
  min-width: 0;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.item-edit-input--memo {
  min-height: 56rpx;
}
.item-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}
.item-log-toggle {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2EA6D0;
  font-size: 24rpx;
}
.item-log-table {
  margin-top: 6rpx;
  border-top: 1rpx solid #ececec;
}
.item-log-row {
  display: flex;
  align-items: center;
  min-height: 44rpx;
  font-size: 22rpx;
  border-bottom: 1rpx solid #efefef;
  color: #666;
}
.item-log-row--head {
  color: #999;
}
.item-log-col-date,
.item-log-col-time,
.item-log-col-status {
  flex: 0 0 22%;
}
.item-log-col-staff {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-log-empty {
  color: #999;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 0;
}

/* ── 全部租赁物（Tab 1）─────────────────── */
.all-items-list { font-size: 26rpx; }
.all-item-row {
  display: flex; gap: 8rpx; min-height: 56rpx; align-items: center;
  border-bottom: 1rpx solid #F0F0F0; padding: 4rpx 0;
}
.all-item-row:last-child { border-bottom: none; }
.all-item-col-code { flex: 0 0 96rpx; color: #666; font-size: 24rpx; }
.all-item-col-name { flex: 1; color: #333; }
.all-item-col-cat { flex: 0 0 80rpx; color: #666; font-size: 24rpx; }
.all-item-col-rental { flex: 0 0 120rpx; color: #999; font-size: 22rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.all-item-col-status { flex: 0 0 80rpx; text-align: right; }

/* ── 追加中的租赁 ─────────────────────── */
.appending-section { margin-top: 16rpx; }
.appending-title { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.appending-card { background: #F8F8F8; border-radius: 8rpx; padding: 12rpx 16rpx; margin-bottom: 8rpx; }
.appending-card-head { display: flex; justify-content: space-between; align-items: center; }
.appending-card-name { font-size: 26rpx; color: #333; flex: 1; }
.appending-del-btn { font-size: 24rpx; color: #E64340; padding: 4rpx 8rpx; }

/* ── 退款摘要 ─────────────────────────── */
.refund-summary-grid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-bottom: 16rpx;
}
.refund-summary-cell {
  flex: 0 0 calc(50% - 6rpx);
  background: #F8F8F8; border-radius: 8rpx;
  padding: 10rpx 14rpx;
}
.refund-summary-label { font-size: 22rpx; color: #999; margin-bottom: 2rpx; }
.refund-summary-value { font-size: 28rpx; font-weight: 600; color: #333; }
.refund-amount-row { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; }
.refund-amount-label { font-size: 26rpx; color: #666; }
.refund-amount-value { font-size: 28rpx; color: #333; font-weight: 600; }
.refund-need { color: #E64340; }
.refund-btn-row { margin-top: 16rpx; }

/* ── 底部操作栏 ───────────────────────── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex; gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.bottom-btn { flex: 1; height: 76rpx; border-radius: 8rpx; font-size: 28rpx; }
.bottom-btn--add { background: #006495; color: #fff; border-color: #006495; }
.bottom-btn--confirm { background: #006495; color: #fff; border-color: #006495; }
.bottom-btn--disabled { background: #ccc !important; color: #fff !important; border-color: #ccc !important; }
