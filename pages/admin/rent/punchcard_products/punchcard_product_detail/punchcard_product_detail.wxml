<view class="page" wx:if="{{dataLoaded}}">

  <view class="header">
    <view class="htitle">{{pageTitle}}</view>
    <view class="hsub">名称 / 价格 / 图片 / 简介{{cardType == '次卡' ? ' / 次数' : ''}}</view>
  </view>

  <view class="form">

    <view class="section">
      <view class="shead"><text class="st">基本信息</text></view>
      <view class="fgroup">
        <view class="flabel">名称<text class="req">*</text></view>
        <input class="finput" value="{{name}}" placeholder="如：双板季前次卡" bindinput="onNameInput" />
      </view>
      <view class="fgroup">
        <view class="flabel">价格<text class="req">*</text></view>
        <input class="finput" type="digit" value="{{sale_price}}" placeholder="0.00" bindinput="onPriceInput" />
      </view>
      <view class="fgroup" wx:if="{{cardType == '次卡'}}">
        <view class="flabel">次数<text class="req">*</text></view>
        <input class="finput" type="number" value="{{punch_total}}" placeholder="0" bindinput="onPunchTotalInput" />
      </view>
      <!-- 养护次卡才有单项/双项之分：单项=修刃 或 热蜡（二选一），双项=修刃 + 热打蜡。
           它决定开单选中这张卡时自动带出哪些养护服务项 -->
      <view class="fgroup" wx:if="{{bizType == '养护' && cardType == '次卡'}}">
        <view class="flabel">养护项目<text class="req">*</text></view>
        <view class="seg">
          <view class="seg-item {{careProjectCount == 1 ? 'seg-item--on' : ''}}" data-v="1" bindtap="onProjectCountTap">单项</view>
          <view class="seg-item {{careProjectCount == 2 ? 'seg-item--on' : ''}}" data-v="2" bindtap="onProjectCountTap">双项</view>
        </view>
      </view>
      <view class="fhint" wx:if="{{bizType == '养护' && cardType == '次卡'}}">
        单项 = 修刃 或 热蜡（二选一）；双项 = 修刃 + 热打蜡
      </view>
      <!-- 门店只能从 shop_list 选、不能手输：顾客端门店过滤是 product.shop == shop_list.name 的
           精确匹配，手输差一个字（「南山」写成「南山店」）就静默失效，店员完全看不出来 -->
      <view class="fgroup">
        <view class="flabel">限定门店<text class="hint">· 不限门店=全店通用</text></view>
        <picker mode="selector" range="{{shopOptions}}" value="{{shopIndex}}" bindchange="onShopPick">
          <view class="fpicker">
            <text class="fpicker-val">{{shopOptions[shopIndex]}}</text>
            <text class="fpicker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="fgroup fgroup--row">
        <view class="flabel">上架销售</view>
        <switch checked="{{on_shelves}}" bindchange="onToggleOnShelves" color="#006495" />
      </view>
    </view>

    <view class="section">
      <view class="shead"><text class="st">商品图片</text><text class="sd">选填 · 1 张</text></view>
      <multi-uploader image_count="1" uploaded_files="{{imageUrl}}" bindUploaded="onImageUploaded"></multi-uploader>
    </view>

    <view class="section">
      <view class="shead"><text class="st">简介</text><text class="sd">顾客端首页卡片取它的纯文本摘要</text></view>
      <editor id="editor" class="editor" bindstatuschange="onEditorStatusChange" bindready="onEditorReady" bindinput="onEditorInput"></editor>
      <view class="toolbar" catchtouchend="format" data-target="intro">
        <view class="tool-item {{formats.bold ? 'tool-item--on' : ''}}" data-name="bold">加粗</view>
        <view class="tool-item {{formats.italic ? 'tool-item--on' : ''}}" data-name="italic">斜体</view>
        <view class="tool-item {{formats.underline ? 'tool-item--on' : ''}}" data-name="underline">下划线</view>
        <view class="tool-item {{formats.list === 'ordered' ? 'tool-item--on' : ''}}" data-name="list" data-value="ordered">有序列表</view>
        <view class="tool-item {{formats.list === 'bullet' ? 'tool-item--on' : ''}}" data-name="list" data-value="bullet">无序列表</view>
      </view>
    </view>

    <view class="section">
      <view class="shead"><text class="st">使用规则</text><text class="sd">留空则顾客端显示默认规则</text></view>
      <editor id="editorRules" class="editor" bindstatuschange="onRulesStatusChange" bindready="onRulesReady" bindinput="onRulesInput"></editor>
      <view class="toolbar" catchtouchend="format" data-target="rules">
        <view class="tool-item {{rulesFormats.bold ? 'tool-item--on' : ''}}" data-name="bold">加粗</view>
        <view class="tool-item {{rulesFormats.italic ? 'tool-item--on' : ''}}" data-name="italic">斜体</view>
        <view class="tool-item {{rulesFormats.underline ? 'tool-item--on' : ''}}" data-name="underline">下划线</view>
        <view class="tool-item {{rulesFormats.list === 'ordered' ? 'tool-item--on' : ''}}" data-name="list" data-value="ordered">有序列表</view>
        <view class="tool-item {{rulesFormats.list === 'bullet' ? 'tool-item--on' : ''}}" data-name="list" data-value="bullet">无序列表</view>
      </view>
    </view>

    <!-- 删除只在编辑已有商品时出现；新建还没落库，没什么可删 -->
    <view class="section" wx:if="{{!isNew}}">
      <view class="shead"><text class="st">删除商品</text></view>
      <view class="fhint">删除后该商品不再出现在顾客购买页、发卡列表和本管理页。已经发出去的卡不受影响，仍可正常使用。</view>
      <view class="btn-danger {{deleting ? 'disabled' : ''}}" bindtap="onDelete">{{deleting ? '删除中...' : '删除该商品'}}</view>
    </view>

  </view>

  <view class="footer">
    <view class="btn btn-plain" bindtap="onCancel">取消</view>
    <view class="btn btn-primary {{saving ? 'disabled' : ''}}" bindtap="onSave">{{saving ? '保存中...' : '保 存'}}</view>
  </view>

</view>
