page { background: #f6f7f9; }

.page { padding: 20rpx; box-sizing: border-box; }

.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  box-sizing: border-box; margin-bottom: 20rpx;
}

.section-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 12rpx; }

.empty-tip { font-size: 26rpx; color: #999; text-align: center; padding: 40rpx 0; }

.filter-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.filter-row:last-child { margin-bottom: 0; }
.filter-chip {
  font-size: 24rpx; color: #666; background: #f2f3f5;
  border-radius: 30rpx; padding: 8rpx 22rpx;
}
.filter-chip--on { background: #2EA6D0; color: #fff; }

.prod-row {
  display: flex; align-items: center;
  padding: 20rpx 8rpx; border-bottom: 1rpx solid #f3f4f6;
}
.prod-row:last-child { border-bottom: none; }
.prod-thumb {
  width: 96rpx; height: 96rpx; border-radius: 12rpx; margin-right: 20rpx;
  background: #f2f3f5; flex-shrink: 0;
}
.prod-thumb--empty {
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #bbb;
}
.prod-info { flex: 1; }
.prod-name { font-size: 28rpx; color: #1a1a1a; font-weight: 600; }
.prod-tag {
  font-size: 20rpx; color: #2EA6D0; border: 1rpx solid #2EA6D0;
  border-radius: 6rpx; padding: 2rpx 8rpx; margin-right: 8rpx;
}
.prod-tag--off {
  font-size: 20rpx; color: #E64340; border: 1rpx solid #E64340;
  border-radius: 6rpx; padding: 2rpx 8rpx; margin-left: 12rpx; font-weight: normal;
}
.prod-sub { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.add-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.add-btn {
  flex: 1 0 45%; text-align: center; background: #2EA6D0; color: #fff;
  font-size: 26rpx; padding: 18rpx 0; border-radius: 12rpx;
}
.add-btn:active { opacity: 0.85; }
