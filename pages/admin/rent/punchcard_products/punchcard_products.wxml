<view class="page">
  <view class="card">
    <view class="section-title">筛选</view>
    <view class="filter-row">
      <view class="filter-chip {{filterBizType == '' ? 'filter-chip--on' : ''}}" bindtap="onFilterBizType" data-value="">全部业务</view>
      <view class="filter-chip {{filterBizType == item ? 'filter-chip--on' : ''}}" wx:for="{{bizTypes}}" wx:key="*this" bindtap="onFilterBizType" data-value="{{item}}">{{item}}</view>
    </view>
    <view class="filter-row">
      <view class="filter-chip {{filterCardType == '' ? 'filter-chip--on' : ''}}" bindtap="onFilterCardType" data-value="">全部卡类</view>
      <view class="filter-chip {{filterCardType == item ? 'filter-chip--on' : ''}}" wx:for="{{cardTypes}}" wx:key="*this" bindtap="onFilterCardType" data-value="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">商品列表</view>
    <view wx:if="{{filteredProducts.length == 0}}" class="empty-tip">暂无商品</view>
    <view class="prod-row" wx:for="{{filteredProducts}}" wx:key="id" bindtap="onEdit" data-id="{{item.id}}">
      <!-- 固定 96rpx 方框用 aspectFit：整图缩进去不裁剪，店长一眼能核对配的是哪张 -->
      <image wx:if="{{item.imageUrl}}" class="prod-thumb" src="{{item.imageUrl}}" mode="aspectFit"></image>
      <view wx:else class="prod-thumb prod-thumb--empty">无图</view>
      <view class="prod-info">
        <view class="prod-name">{{item.name}}<text wx:if="{{!item.on_shelves}}" class="prod-tag--off">已下架</text></view>
        <view class="prod-sub">
          <text class="prod-tag">{{item.bizType}}{{item.cardType}}</text>
          <text wx:if="{{item.projectText}}" class="prod-tag">{{item.projectText}}</text>
          {{item.countText}} · ¥{{item.sale_price}}{{item.shop ? (' · ' + item.shop) : ''}}
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">新增商品</view>
    <view class="add-grid">
      <view class="add-btn" wx:for="{{addCombos}}" wx:key="label" bindtap="onAdd" data-biztype="{{item.bizType}}" data-cardtype="{{item.cardType}}">{{item.label}}</view>
    </view>
  </view>
</view>
