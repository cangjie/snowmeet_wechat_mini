<view wx:if="{{staff && staff.title_level >= 100}}" class="page-root">

  <!-- 筛选区 -->
  <view class="filter-card">
    <!-- 店铺 -->
    <view class="filter-row">
      <text class="filter-label">店铺</text>
      <view class="filter-value">
        <shop-selector wx:if="{{(cell != null && cell != '') || (keyword != null && keyword != '')}}" defaultShop=""
          bindShopSelected="shopSelected"></shop-selector>
        <shop-selector wx:else bindShopSelected="shopSelected"></shop-selector>
      </view>
    </view>

    <!-- 日期 -->
    <view class="filter-row filter-row--date">
      <text class="filter-label">日期</text>
      <date-range-picker
        startDate="{{startDate}}"
        endDate="{{endDate}}"
        bind:change="onDateRangeChange"
      />
    </view>

    <!-- 测试 -->
    <view class="filter-row">
      <text class="filter-label">测试</text>
      <radio-group id="isTest" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>营业</label>
        <label class="radio-item"><radio value="{{true}}" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>测试</label>
        <label class="radio-item"><radio value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
      </radio-group>
    </view>

    <!-- 招待 -->
    <view class="filter-row">
      <text class="filter-label">招待</text>
      <radio-group id="isEntertain" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>正常</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>招待</label>
        <label class="radio-item"><radio value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
      </radio-group>
    </view>

    <!-- 减免 -->
    <view class="filter-row">
      <text class="filter-label">减免</text>
      <radio-group id="haveDiscount" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>包含</label>
        <label class="radio-item"><radio value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>不含</label>
      </radio-group>
    </view>

    <!-- 次卡 -->
    <view class="filter-row">
      <text class="filter-label">次卡</text>
      <radio-group id="useCard" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>包含</label>
        <label class="radio-item"><radio value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>不含</label>
      </radio-group>
    </view>

    <!-- 状态 -->
    <view class="filter-row">
      <text class="filter-label">状态</text>
      <radio-group id="status" class="radio-group radio-group--wrap" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="null"/>全部</label>
        <label class="radio-item"><radio value="未支付"/>未支付</label>
        <label class="radio-item"><radio value="未开始"/>未开始</label>
        <label class="radio-item"><radio value="租赁中"/>租赁中</label>
        <label class="radio-item"><radio value="部分归还"/>部分归还</label>
        <label class="radio-item"><radio value="全部归还"/>全部归还</label>
        <label class="radio-item"><radio value="部分退押金"/>部分退押金</label>
        <label class="radio-item"><radio value="全额退押金"/>全额退押金</label>
        <label class="radio-item"><radio value="了结关闭"/>了结关闭</label>
        <label class="radio-item"><radio value="临时订单"/>临时订单</label>
      </radio-group>
    </view>

    <!-- 租赁物 -->
    <view class="filter-row">
      <text class="filter-label">租赁物</text>
      <view class="filter-value filter-row-inner">
        <input class="filter-input filter-input--sm" placeholder="点击选择分类" style="text-align:center;"
          bindtap="showBackdrop" value="{{queryOptions[3].value == null ? '' : queryOptions[3].value.name}}" />
        <input class="filter-input" bindinput="setRentItemName" disabled="{{queryOptions[3].value == null}}"
          style="margin-left:12rpx;" placeholder="名称或编码" value="{{queryOptions[4].value}}" />
      </view>
    </view>

    <!-- 手机 -->
    <view class="filter-row">
      <text class="filter-label">手机</text>
      <input class="filter-input" bindinput="setCell" type="number" placeholder="手机号搜索" />
    </view>

    <!-- 备注 -->
    <view class="filter-row">
      <text class="filter-label">备注</text>
      <input class="filter-input" bindinput="setMemo" placeholder="关键词搜索" />
    </view>

    <view class="filter-actions">
      <van-button type="primary" size="normal" bind:click="query" loading="{{querying}}" disabled="{{querying}}">查 询</van-button>
    </view>
  </view>

  <!-- 统计行 + 分页 -->
  <view wx:if="{{total > 0}}" class="summary-section">
    <view class="summary-bar">
      <text>共 {{total}} 单</text>
      <text class="summary-sep">·</text>
      <text>总租金 {{totalRentalAmountStr}}</text>
      <text class="summary-sep">·</text>
      <text>按时间倒序</text>
    </view>
    <view class="page-bar">
      <van-button size="mini" plain type="primary" disabled="{{page <= 1}}" bind:click="onPrevPage">上一页</van-button>
      <text class="page-info">第 {{page}} / {{totalPages}} 页（每页 {{pageSize}} 条）</text>
      <van-button size="mini" plain type="primary" disabled="{{page >= totalPages}}" bind:click="onNextPage">下一页</van-button>
    </view>
  </view>

  <!-- 订单列表 -->
  <block wx:for="{{orders}}" wx:key="id">
    <view class="order-card" id="{{index}}" bindtap="gotoDetail">
      <!-- 卡片头：订单号 + 状态 -->
      <view class="order-header">
        <text class="order-code">{{item.code || ('#' + item.id)}}</text>
        <view class="status-chip status-chip--{{item.statusClass}}">
          {{item.statusLabel}}
        </view>
      </view>

      <!-- 内容区：左侧标签列 + 右侧详情 -->
      <view class="order-body">
        <view class="tag-col">
          <text wx:if="{{item.is_test == 1}}" class="tag tag--test">测</text>
          <text wx:if="{{item.haveEntertain}}" class="tag tag--entertain">招</text>
          <text wx:if="{{item.is_package == 0}}" class="tag tag--single">单</text>
          <text wx:if="{{item.haveOnCredit}}" class="tag tag--credit">挂</text>
          <text wx:if="{{item.haveDiscount}}" class="tag tag--discount">减</text>
          <text wx:if="{{item.useCard}}" class="tag tag--card">卡</text>
          <text class="tag tag--member">{{item.memberShip}}</text>
        </view>
        <view class="order-rows">
          <view class="order-row">
            <text class="row-label">日期</text><text class="row-value">{{item.dateStr}}</text>
            <text class="row-label row-label--mid">时间</text><text class="row-value">{{item.timeStr}}</text>
          </view>
          <view class="order-row">
            <text class="row-label">顾客</text><text class="row-value row-value--wide">{{item.calledName}}</text>
          </view>
          <view class="order-row">
            <text class="row-label">手机</text><text class="row-value row-value--wide">{{item.customerCell}}</text>
          </view>
          <view class="order-row">
            <text class="row-label">支付金额</text><text class="row-value">{{item.paidAmountStr}}</text>
            <text class="row-label row-label--mid">方式</text><text class="row-value">{{item.payMethod || '--'}}</text>
          </view>
          <view class="order-row">
            <text class="row-label">总计租金</text><text class="row-value">{{item.displayedRentalStr || '--'}}</text>
          </view>
          <view class="order-row">
            <text class="row-label">开单人</text><text class="row-value row-value--wide">{{item.staff.name}}</text>
          </view>
          <view wx:if="{{item.memo}}" class="order-row">
            <text class="row-label">备注</text><text class="row-value row-value--wide">{{item.memo}}</text>
          </view>
        </view>
      </view>

    </view>
  </block>

  <!-- 无结果 -->
  <view wx:if="{{!querying && total == 0}}" class="empty-tip">暂无匹配订单</view>

  <van-popup show="{{ showRentCategorySelector }}">
    <top-category-selector bindModalClick="selectCategory"></top-category-selector>
  </van-popup>

</view>
