<view class="qr-page">
  <view class="qr-title">我的雪票订购码</view>
  <view class="qr-note">顾客扫码可直接进入雪票订购页面</view>
  <image wx:if="{{qrUrl}}" src="{{qrUrl}}" class="qr-image" mode="aspectFit" show-menu-by-longpress bindload="onQrLoad" binderror="onQrError" />
  <view wx:if="{{loading}}" class="qr-note">正在生成二维码…</view>
  <view wx:if="{{error}}" class="qr-error">{{error}} <text class="qr-retry" bindtap="getQrCode">重试</text></view>
  <view wx:if="{{qrUrl && !error}}" class="qr-note">长按二维码可保存或转发</view>
  <view wx:if="{{bookingUrl && !error}}" class="qr-retry" bindtap="copyLink">复制二维码内容</view>
</view>
<admin-page-help />
