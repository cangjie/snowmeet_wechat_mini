/* pages/admin/ticket/coupon_admin/coupon_admin.wxss */
page { background: #F5F6FA; }
.page { padding: 24rpx; box-sizing: border-box; }

/* 视图切换 */
.view-switch {
  display: flex; background: #E4E7EF; border-radius: 999rpx;
  padding: 6rpx; margin-bottom: 20rpx;
}
.vs-item {
  flex: 1; text-align: center; padding: 18rpx 0;
  border-radius: 999rpx; font-size: 28rpx; color: #6B7280;
}
.vs-item--active {
  background: #fff; color: #2EA6D0; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(46, 166, 208, 0.14);
}

/* 筛选卡片 */
.card {
  background: #fff; border-radius: 16rpx;
  padding: 8rpx 24rpx; margin-bottom: 20rpx;
}
.filter-row {
  display: flex; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #F0F1F5;
}
.filter-row:last-child { border-bottom: none; }
.filter-row--date { display: block; }
.filter-label {
  width: 90rpx; flex-shrink: 0;
  font-size: 26rpx; color: #6B7280;
}
.picker-value { font-size: 28rpx; color: #333; }

.chip-group { display: flex; flex-wrap: wrap; }
.chip {
  padding: 8rpx 24rpx; margin-right: 16rpx;
  border-radius: 999rpx; background: #F3F4F6;
  font-size: 26rpx; color: #6B7280;
}
.chip--active { background: #2EA6D0; color: #fff; }

/* 顶部信息条 */
.sum-row {
  font-size: 28rpx; color: #333; font-weight: 600;
  padding: 8rpx 4rpx 16rpx;
}
.hint {
  font-size: 24rpx; color: #6B7280; line-height: 1.6;
  padding: 12rpx 20rpx; background: #fff;
  border-radius: 12rpx; margin-bottom: 16rpx;
}
.hint--warn { background: #FFF7E6; color: #A15C00; }
.hint-link { color: #2EA6D0; margin-left: 12rpx; text-decoration: underline; }

/* 列表行 */
.row {
  background: #fff; border-radius: 16rpx;
  padding: 24rpx; margin-bottom: 16rpx;
}
.row--member { display: flex; align-items: center; }
.row-head { display: flex; align-items: center; flex-wrap: wrap; }
.row-title {
  font-size: 30rpx; color: #1F2937; font-weight: 600;
  margin-right: 12rpx;
}
.row-sub { font-size: 24rpx; color: #6B7280; line-height: 1.7; margin-top: 6rpx; }
.row-memo { font-size: 22rpx; color: #9CA3AF; margin-top: 6rpx; }
.row-transfer {
  font-size: 24rpx; color: #2EA6D0; font-weight: 600;
  margin-top: 8rpx;
}

/* 状态徽标：主状态互斥，无效/未激活是叠加的 */
.state {
  font-size: 20rpx; padding: 2rpx 12rpx;
  border-radius: 999rpx; margin-right: 8rpx;
}
.state--used { background: #E8F5E9; color: #2E7D32; }
.state--expired { background: #F3F4F6; color: #9CA3AF; }
.state--shared { background: #FFF7E6; color: #A15C00; }
.state--unused { background: #E7F3F8; color: #2EA6D0; }
.state--invalid { background: #FDECEC; color: #C62828; }
.state--inactive { background: #F3F4F6; color: #6B7280; }

/* 汇总视图 */
.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #E7F3F8; color: #2EA6D0;
  font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx; flex-shrink: 0;
}
.mem-main { flex: 1; min-width: 0; }
.mem-phone { font-size: 24rpx; color: #9CA3AF; }

.empty {
  text-align: center; color: #9CA3AF;
  font-size: 26rpx; padding: 80rpx 0;
}

/* 查询按钮：筛选卡片里的四项都是暂存的，点它才真正发起查询 */
.filter-actions {
  padding: 20rpx 0 8rpx;
}
.query-btn {
  background: #2EA6D0;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 80rpx;
  height: 80rpx;
}
.query-btn::after { border: none; }
.query-btn[disabled] { background: #B7D9E6; color: #fff; }

/* ═══ 券种背景（与顾客端 banner 同一套配色）═══
   底色只用最浅一档、图案透明度 ≤20%，保证正文压在上面仍有足够对比度。
   全部是 repeating-linear-gradient / radial-gradient，不出图，新增券种加一条 class 即可。
   券种由后端 TicketTransferRules.ResolveBanner 统一判定，各页面口径一致。 */
.kind-bg--wax {
  background-color: #EFF4FF;
  background-image: repeating-linear-gradient(45deg, rgba(37,99,235,.13) 0 14rpx, transparent 14rpx 30rpx);
}
.kind-bg--hotwax {
  background-color: #FFF1E7;
  background-image:
    radial-gradient(circle at 96% 150%, transparent 80rpx, rgba(234,88,12,.15) 80rpx 84rpx, transparent 84rpx),
    radial-gradient(circle at 96% 150%, transparent 128rpx, rgba(234,88,12,.13) 128rpx 132rpx, transparent 132rpx),
    radial-gradient(circle at 96% 150%, transparent 176rpx, rgba(234,88,12,.11) 176rpx 180rpx, transparent 180rpx);
}
.kind-bg--edge {
  background-color: #E6F5F3;
  background-image: repeating-linear-gradient(90deg, rgba(15,118,110,.16) 0 4rpx, transparent 4rpx 26rpx);
}
.kind-bg--dual {
  background-color: #EEF0FF;
  background-image:
    repeating-linear-gradient(45deg, rgba(67,56,202,.12) 0 4rpx, transparent 4rpx 24rpx),
    repeating-linear-gradient(-45deg, rgba(67,56,202,.12) 0 4rpx, transparent 4rpx 24rpx);
}
.kind-bg--pass {
  background-color: #E8F5FE;
  background-image: radial-gradient(circle, rgba(2,132,199,.20) 3rpx, transparent 3.2rpx);
  background-size: 28rpx 28rpx;
}
.kind-bg--course {
  background-color: #F1F5F9;
  background-image: repeating-linear-gradient(-45deg, rgba(51,65,85,.10) 0 20rpx, transparent 20rpx 44rpx);
}
.kind-bg--cash {
  background-color: #FEF3C7;
  background-image: repeating-linear-gradient(180deg, rgba(180,83,9,.13) 0 4rpx, transparent 4rpx 32rpx);
}
/* 失效态：任何券种统一降灰。用换底色+文字降色，不用整行 opacity——
   那样会把券码、时间这些小字压到读不清。 */
.kind-bg--muted {
  background-color: #F3F4F6;
  background-image: repeating-linear-gradient(45deg, rgba(107,114,128,.20) 0 14rpx, transparent 14rpx 30rpx);
}

.kind-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 8rpx;
  background: rgba(255,255,255,.75);
}
.kind-tag--wax { color: #1D4FD7; }
.kind-tag--hotwax { color: #C2410C; }
.kind-tag--edge { color: #0F766E; }
.kind-tag--dual { color: #4338CA; }
.kind-tag--pass { color: #0369A1; }
.kind-tag--course { color: #334155; }
.kind-tag--cash { color: #B45309; }
.kind-tag--muted { color: #6B7280; }

.row--kind { display: flex; gap: 16rpx; align-items: stretch; }
.row--kind .row-body { flex: 1; min-width: 0; }
