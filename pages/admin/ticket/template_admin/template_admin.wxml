<!--pages/admin/ticket/template_admin/template_admin.wxml-->
<view class="page">

  <view class="view-switch">
    <view class="vs-item {{view == item.key ? 'vs-item--active' : ''}}"
      wx:for="{{viewOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onViewTap">
      {{item.name}} {{item.key == 'active' ? activeCount : hiddenCount}}
    </view>
  </view>

  <view class="hint" wx:if="{{conflictCount > 0}}">
    有 {{conflictCount}} 个当前模板同时设了「可用天数」和「总过期日」。这两项只能留一个，
    否则实际发券会按总过期日走、天数形同虚设。点进去改一下。
  </view>

  <view class="hint" wx:if="{{missingBizCount > 0}}">
    有 {{missingBizCount}} 个当前模板还没设业务类型。没设的模板，它发出的券在任何开单页都选不到。
  </view>

  <view class="card">
    <view class="row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onTemplateTap">
      <view class="row-main">
        <view class="row-title">
          <text class="name {{item.hide == 1 ? 'name--hidden' : ''}}">{{item.name}}</text>
          <text class="tag tag--type">{{item.type}}</text>
          <text class="tag {{item.bizTypeMissing ? 'tag--missing' : 'tag--biz'}}">{{item.bizTypeText}}</text>
          <text class="tag tag--invalid" wx:if="{{item.valid != 1}}">已停用</text>
        </view>
        <view class="row-meta {{item.hasConflict ? 'row-meta--warn' : ''}}">{{item.validityText}}</view>
        <view class="row-meta">
          商品优惠 {{item.ruleCount}} 条 · 累计发券 {{item.ticketTotal}} 张 · 近一年 {{item.ticketRecent}} 张
        </view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="empty" wx:if="{{!loading && items.length == 0}}">
      {{view == 'hidden' ? '没有失效模板' : '没有当前模板'}}
    </view>
  </view>

  <button class="btn-add" wx:if="{{view == 'active'}}" bindtap="onAddTap">新建模板</button>
</view>
