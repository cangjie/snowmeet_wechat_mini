.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f6f8fa; color: #1d3040; }
.notice { color: #66808f; font-size: 26rpx; line-height: 1.6; padding: 20rpx; }
.card { background: white; border-radius: 18rpx; padding: 28rpx; margin-bottom: 20rpx; }
.cover-preview { background: white; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; }
.cover-label { color: #758997; font-size: 24rpx; margin-bottom: 12rpx; }
.cover-image { display: block; width: 100%; border-radius: 10rpx; }
.title { font-weight: 600; font-size: 32rpx; }.arrow { float:right; color:#9aa; }.status { float:right; color:#1688b1; font-size:24rpx; }
.meta { color:#758997; font-size:24rpx; line-height:1.6; margin-top:10rpx; }.stats { font-size:27rpx; margin-top:14rpx; }.heading,.label { font-size:28rpx; font-weight:600; margin:24rpx 0; }
.actions,.modes { display:flex; gap:16rpx; flex-wrap:wrap; margin-top:22rpx; }
.action-btn { display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box; height:68rpx; line-height:68rpx; margin:0; padding:0 26rpx; border:0; border-radius:999rpx; background:#e8f6fb; color:#2ea6d0; font-size:24rpx; font-weight:600; white-space:nowrap; }
.action-btn::after { border:0; }
.action-btn.primary,.mode.active { background:#2ea6d0; color:white; }
.action-btn.danger { background:#fef2f2; color:#ef4444; }
.action-btn[disabled] { opacity:.55; }
.mode { padding:16rpx 20rpx; border:1rpx solid #b6d4e0; border-radius:12rpx; font-size:26rpx; }.input { background:#f5f7f8; padding:18rpx; border-radius:10rpx; }
.mask { position:fixed; inset:0; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; }.popup { background:white; padding:36rpx; border-radius:20rpx; text-align:center; width:70%; }.popup image { width:420rpx; height:420rpx; max-width:100%; }
