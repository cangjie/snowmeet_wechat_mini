/* ── 页面背景 ─────────────────────────────── */
.page-root {
  min-height: 100vh;
  background: #f8f9ff;
  padding: 16rpx 0 48rpx;
  box-sizing: border-box;
}

/* ── 筛选卡片 ─────────────────────────────── */
.filter-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 16rpx 24rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-row:last-of-type {
  border-bottom: none;
}

.filter-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}

.filter-value {
  flex: 1;
  font-size: 26rpx;
}

/* radio group */
.radio-group {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  flex: 1;
}

.radio-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

/* inputs */
.filter-input {
  flex: 1;
  height: 56rpx;
  background: #f8f9ff;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #333;
  box-sizing: border-box;
}

.filter-actions {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

/* ── 统计 & 分页 ─────────────────────────── */
.summary-section {
  margin: 0 16rpx 12rpx;
}

.summary-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #555;
  padding: 8rpx 0 4rpx;
}

.summary-sep {
  margin: 0 10rpx;
  color: #ccc;
}

/* 翻页栏已抽成 list-pager 组件，样式在 components/list-pager/index.wxss */
.summary-section--bottom {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

/* ── 装备卡片 ─────────────────────────────── */
.care-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

/* 内容区：左侧标签 + 中间详情 + 右侧照片 */
.care-body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* 左侧标签列 */
.tag-col {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 48rpx;
  flex-shrink: 0;
  gap: 6rpx;
  padding-top: 2rpx;
  margin-right: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 0;
  border-radius: 4rpx;
  background: #f3f4f6;
  color: #374151;
  text-align: center;
}

.tag--entertain { background: #fef3c7; color: #92400e; }
.tag--warranty  { background: #cffafe; color: #0e7490; }
.tag--summer    { background: #fef3c7; color: #b45309; }

/* 详情行 */
.care-rows {
  flex: 1;
  min-width: 0;
}

.care-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 6rpx;
  font-size: 24rpx;
}

.row-label {
  width: 100rpx;
  flex-shrink: 0;
  color: #888;
  font-size: 22rpx;
}

.row-value {
  color: #333;
  font-size: 24rpx;
}

.row-value--wide {
  flex: 1;
  width: auto;
}

.row-value--strong {
  color: #b91c1c;
  font-weight: 600;
}

.row-value--link {
  color: #2EA6D0;
}

/* 装备照片：卡片最右侧竖排，与养护订单列表一致 */
.care-photos {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  width: 160rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.care-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f3f4f6;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 60rpx 0;
}
