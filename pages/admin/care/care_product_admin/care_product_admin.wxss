/* pages/admin/care/care_product_admin/care_product_admin.wxss */
page { background: #F5F6FA; }
.page { padding: 24rpx; box-sizing: border-box; }

.card { background: #fff; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 20rpx; }

.shop-chips { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; }

.hint {
  background: #FFF7E6; border: 1rpx solid #FFE0A3; border-radius: 12rpx;
  padding: 16rpx 20rpx; margin-bottom: 20rpx;
  font-size: 24rpx; color: #8A6D3B; line-height: 1.6;
}

.frow {
  display: flex; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #F0F1F5;
}
.frow:last-child { border-bottom: none; }
.flabel { width: 100rpx; flex-shrink: 0; font-size: 26rpx; color: #6B7280; }
.finput { flex: 1; font-size: 28rpx; color: #333; }
.fpicker { flex: 1; font-size: 28rpx; color: #333; }
.fswitch { transform: scale(0.8); margin-left: auto; }

.row {
  display: flex; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx solid #F0F1F5;
}
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-arrow { color: #C4C8D2; font-size: 36rpx; padding-left: 16rpx; }
.row-title { display: flex; align-items: center; flex-wrap: wrap; }
.name { font-size: 30rpx; color: #333; font-weight: 600; margin-right: 12rpx; }
.row-meta { font-size: 24rpx; color: #6B7280; margin-top: 8rpx; }

.tag {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx;
  margin-right: 8rpx; margin-top: 4rpx;
}
.tag--live { background: #E4F4F9; color: #2EA6D0; }
.tag--hidden { background: #F3F4F6; color: #9AA0AC; }
.tag--invalid { background: #FDECEC; color: #D9534F; }
.tag--warn { background: #FFF1E0; color: #C77700; }

.empty { text-align: center; color: #9AA0AC; font-size: 26rpx; padding: 60rpx 0; }

.chip-group { display: flex; flex-wrap: wrap; padding: 8rpx 0 4rpx; }
.chip {
  padding: 8rpx 24rpx; margin-right: 16rpx; margin-bottom: 8rpx;
  border-radius: 999rpx; background: #F3F4F6;
  font-size: 24rpx; color: #6B7280;
}
.chip--active { background: #2EA6D0; color: #fff; }

.sec-hint { font-size: 22rpx; color: #9AA0AC; line-height: 1.6; padding: 12rpx 0 4rpx; }

.btn-add, .btn-save {
  margin-top: 20rpx; background: #2EA6D0; color: #fff;
  font-size: 30rpx; border-radius: 12rpx;
}

.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 100;
  display: flex; align-items: flex-end;
}
.panel {
  width: 100%; background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx 40rpx; box-sizing: border-box;
  max-height: 86vh; overflow-y: auto;
}
.panel-title {
  font-size: 30rpx; color: #333; font-weight: 600;
  text-align: center; padding-bottom: 12rpx;
}
.panel-del { text-align: center; color: #D9534F; font-size: 26rpx; padding: 24rpx 0 8rpx; }
.panel-cancel { text-align: center; color: #6B7280; font-size: 28rpx; padding: 20rpx 0 0; }
