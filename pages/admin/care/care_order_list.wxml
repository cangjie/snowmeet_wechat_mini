<view wx:if="{{staff && staff.title_level >= 100}}" class="page-root">

  <!-- 筛选区 -->
  <view class="filter-card">
    <view wx:if="{{aiQueryApplied && aiQueryConditions}}" class="filter-row">
      <text class="filter-label">AI 条件</text>
      <text class="filter-value">{{aiQueryConditions}}</text>
    </view>
    <!-- 店铺 -->
    <view class="filter-row">
      <text class="filter-label">店铺</text>
      <view class="filter-value">
        <shop-selector wx:if="{{!aiQueryApplied && ((cell != null && cell != '') || (keyword != null && keyword != ''))}}" defaultShop=""
          bindShopSelected="shopSelected"></shop-selector>
        <shop-selector wx:else defaultShop="{{aiQueryApplied ? (shop || '全部店铺') : ''}}"
          bindShopSelected="shopSelected"></shop-selector>
      </view>
    </view>

    <!-- 日期 -->
    <view class="filter-row filter-row--date">
      <text class="filter-label">日期</text>
      <date-range-picker
        startDate="{{startDate}}"
        endDate="{{endDate}}"
        bind:change="onDateRangeChange"
      />
    </view>

    <!-- 测试 -->
    <view class="filter-row">
      <text class="filter-label">测试</text>
      <radio-group id="isTest" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>营业</label>
        <label class="radio-item"><radio value="{{true}}" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>测试</label>
        <label class="radio-item"><radio value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
      </radio-group>
    </view>

    <!-- 招待 -->
    <view class="filter-row">
      <text class="filter-label">招待</text>
      <radio-group id="isEntertain" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>正常</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>招待</label>
        <label class="radio-item"><radio value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
      </radio-group>
    </view>

    <!-- 减免 -->
    <view class="filter-row">
      <text class="filter-label">减免</text>
      <radio-group id="haveDiscount" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>包含</label>
        <label class="radio-item"><radio value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>不含</label>
      </radio-group>
    </view>

    <!-- 非雪季 -->
    <view class="filter-row">
      <text class="filter-label">非雪季</text>
      <radio-group id="summer" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>包含</label>
        <label class="radio-item"><radio value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>不含</label>
      </radio-group>
    </view>

    <!-- 次卡 -->
    <view class="filter-row">
      <text class="filter-label">次卡</text>
      <radio-group id="useCard" class="radio-group" bindchange="setQueryOptions">
        <label class="radio-item"><radio checked="{{true}}" value="null" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>全部</label>
        <label class="radio-item"><radio value="true" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>包含</label>
        <label class="radio-item"><radio value="false" disabled="{{(cell != null && cell != '') || (keyword != null && keyword != '') || querying}}"/>不含</label>
      </radio-group>
    </view>

    <!-- 手机 -->
    <view class="filter-row">
      <text class="filter-label">手机</text>
      <input class="filter-input" bindinput="setCell" type="number" placeholder="手机号搜索" />
    </view>

    <!-- 备注 -->
    <view class="filter-row">
      <text class="filter-label">备注</text>
      <input class="filter-input" bindinput="setMemo" placeholder="关键词搜索" />
    </view>

    <view class="filter-actions">
      <van-button type="primary" size="normal" bind:click="query" loading="{{querying}}" disabled="{{querying}}">查 询</van-button>
    </view>
  </view>

  <!-- 统计行 + 分页 -->
  <view wx:if="{{total > 0}}" class="summary-section">
    <view class="summary-bar">
      <text>本页收款 {{totalEarnStr}}</text>
      <text class="summary-sep">·</text>
      <text>共 {{total}} 单，{{totalPages}} 页</text>
      <text class="summary-sep">·</text>
      <text>共计收款 {{allEarnStr}}</text>
    </view>
    <list-pager page="{{page}}" total-pages="{{totalPages}}" page-size="{{pageSize}}"
                disabled="{{querying}}" bind:change="onPagerChange" />
  </view>

  <!-- 订单列表 -->
  <block wx:for="{{orders}}" wx:key="id">
    <view class="order-card {{item.unpaid ? 'order-card--unpaid' : ''}}" id="{{index}}" bindtap="gotoDetail">
      <!-- 卡片头：订单号 + 状态 -->
      <view class="order-header">
        <text class="order-code">{{item.code || ('#' + item.id)}}</text>
        <view class="status-chip status-chip--{{item.statusClass}}">
          {{item.statusLabel}}
        </view>
      </view>

      <!-- 内容区：左侧标签列 + 右侧详情 -->
      <view class="order-body">
        <view class="tag-col">
          <text wx:if="{{item.is_test == 1}}" class="tag tag--test">测</text>
          <text wx:if="{{item.haveEntertain}}" class="tag tag--entertain">招</text>
          <text wx:if="{{item.is_package == 0}}" class="tag tag--single">单</text>
          <text wx:if="{{item.haveOnCredit}}" class="tag tag--credit">挂</text>
          <text wx:if="{{item.haveDiscount}}" class="tag tag--discount">减</text>
          <text wx:if="{{item.haveWarranty}}" class="tag tag--warranty">质</text>
          <text wx:if="{{item.isSummerTask}}" class="tag tag--summer">非</text>
          <text wx:if="{{item.useCard}}" class="tag tag--card">卡</text>
          <text wx:if="{{item.haveTicket}}" class="tag tag--ticket">券</text>
          <text wx:if="{{item.isNewCareCustomer}}" class="tag tag--new">新</text>
        </view>
        <view class="order-rows">
          <!-- 订单基本信息：两列。左列放长内容（日期、手机+复制、金额），右列放短内容 -->
          <view class="info-grid">
            <view class="info-cell info-cell--full">
              <text class="row-label">开单店铺</text><text class="row-value row-value--wide row-value--nowrap">{{item.shop || '--'}}</text>
            </view>
            <view class="info-cell">
              <text class="row-label">日期</text><text class="row-value row-value--wide row-value--nowrap">{{item.dateStr}} {{item.timeStr}}</text>
            </view>
            <view class="info-cell info-cell--right">
              <text class="row-label">顾客</text><text class="row-value row-value--wide row-value--nowrap">{{item.calledName}}</text>
            </view>
            <view class="info-cell">
              <text class="row-label">手机</text><view class="info-phone"><text class="row-value">{{item.customerCell}}</text><phone-copy phone="{{item.customerCell}}" /></view>
            </view>
            <view class="info-cell info-cell--right">
              <text class="row-label">方式</text><text class="row-value row-value--wide row-value--nowrap">{{item.payMethod || '--'}}</text>
            </view>
            <view class="info-cell">
              <text class="row-label">支付金额</text><text class="row-value row-value--wide row-value--nowrap">{{item.paidAmountStr}}</text>
            </view>
            <view class="info-cell info-cell--right">
              <text class="row-label">退款</text><text class="row-value row-value--wide row-value--nowrap">{{item.refundAmountStr}}</text>
            </view>
            <view class="info-cell">
              <text class="row-label">总计收款</text><text class="row-value row-value--wide row-value--nowrap row-value--strong">{{item.totalEarnAmountStr}}</text>
            </view>
            <view class="info-cell info-cell--right">
              <text class="row-label">开单人</text><text class="row-value row-value--wide row-value--nowrap">{{item.staff.name}}</text>
            </view>
          </view>
          <view wx:if="{{item.memo}}" class="order-row">
            <text class="row-label row-label--info">备注</text><text class="row-value row-value--wide">{{item.memo}}</text>
          </view>

        </view>
      </view>
      <!-- 装备：通栏放在订单信息下面（不在右侧详情列里），每件装备左边的图标列和上面订单标签列对齐——双板 / 单板在这一列放图标；
           整体可折叠，默认收起，点标题展开；展开后每件一块（品牌 / 长度 / 项目 / 进度），窄而高的照片在各自那块的右侧 -->
      <view wx:if="{{item.careRows.length > 0}}" class="care-section">
        <view class="care-section-title" data-idx="{{index}}" catchtap="onToggleCares">
          <text>装备 {{item.careCount}} 件</text>
          <text class="care-toggle">{{item.careExpanded ? '收起' : '展开'}}<text class="care-arrow {{item.careExpanded ? 'care-arrow--open' : ''}}">›</text></text>
        </view>
        <block wx:for="{{item.careRows}}" wx:for-item="cr" wx:for-index="ci" wx:key="id">
          <view wx:if="{{item.careExpanded}}" class="care-line">
            <view class="care-icon-col">
              <image wx:if="{{cr.iconSrc}}" class="care-kind" src="{{cr.iconSrc}}" mode="aspectFit" />
            </view>
            <view class="care-body">
              <view class="care-main">
                <view class="care-title">{{cr.title}}</view>
                <view wx:if="{{cr.services.length > 0}}" class="care-services">
                  <text wx:for="{{cr.services}}" wx:for-item="sv" wx:key="text" class="svc {{sv.cls}}">{{sv.text}}</text>
                </view>
                <!-- 进度：左边一个阶段色块（未开始 / 进行中 / 待发板 / 已完成 / 已取消），后面列出这件装备的全部任务，
                     做完的绿字、正在做的红字、没开始的灰字 -->
                <view class="care-progress">
                  <text class="progress-chip progress-chip--{{cr.statusClass}}">{{cr.statusLabel}}</text>
                  <block wx:for="{{cr.tasks}}" wx:for-item="tk" wx:for-index="ti" wx:key="key">
                    <text wx:if="{{ti > 0}}" class="care-task-sep">›</text>
                    <text class="care-task care-task--{{tk.cls}}">{{tk.name}}<text wx:if="{{tk.flag}}" class="care-task-flag">{{tk.flag}}</text></text>
                  </block>
                </view>
                <!-- 这件装备用的权益，在金额 / 减免上面，每种一行：质保 / 招待标签；次卡（卡名 + 卡号 + 这件用完之后还剩几次）；
                     券（券名 + 券号）；学员卡（「某某教练的学员卡」+ 卡号）。不管订单里哪件装备、用了什么卡 / 券，都各列各的 -->
                <view wx:if="{{cr.hasFlag}}" class="care-card care-flags"><text wx:if="{{cr.isWarranty}}" class="care-card-tag care-card-tag--warranty">质保</text><text wx:if="{{cr.isEntertain}}" class="care-card-tag care-card-tag--entertain">招待</text></view>
                <view wx:if="{{cr.usesCard}}" class="care-card"><text class="care-card-tag">次卡</text><text class="care-card-name">{{cr.cardName}}</text><text wx:if="{{cr.cardNo}}" class="care-card-no">{{cr.cardNo}}</text><text class="care-card-remain">{{cr.cardRemain}}</text></view>
                <view wx:if="{{cr.usesTicket}}" class="care-card care-ticket"><text class="care-card-tag care-card-tag--ticket">券</text><text class="care-card-name">{{cr.ticketName}}</text><text class="care-card-no">{{cr.ticketNo}}</text></view>
                <view wx:if="{{cr.usesCoachCard}}" class="care-card care-coach"><text class="care-card-tag care-card-tag--coach">学员卡</text><text class="care-card-name">{{cr.coachName}}</text><text class="care-card-no">{{cr.coachNo}}</text></view>
                <!-- 金额 / 减免：每件装备都显示，招待 / 质保也显示（后端按所做项目算标准价、减免到 0 元） -->
                <view class="care-amount">
                  <text class="care-amount-item"><text class="care-amount-label">金额</text>{{cr.chargeStr}}</text>
                  <text class="care-amount-item"><text class="care-amount-label">减免</text>{{cr.discountStr}}</text>
                </view>
              </view>
              <!-- 照片：盒子跟着整块装备的高度走（次卡多一行时也一样高），照片铺满盒子 -->
              <view wx:if="{{cr.thumb}}" class="care-thumb-box">
                <image class="care-thumb" mode="aspectFill" src="{{cr.thumb}}"
                       data-idx="{{index}}" data-cid="{{cr.id}}" catchtap="onCarePhotoTap" />
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>

  <!-- 列表底部分页 -->
  <view wx:if="{{total > 0}}" class="summary-section summary-section--bottom">
    <list-pager page="{{page}}" total-pages="{{totalPages}}" page-size="{{pageSize}}"
                disabled="{{querying}}" bind:change="onPagerChange" />
  </view>

  <!-- 无结果 -->
  <view wx:if="{{!querying && total == 0}}" class="empty-tip">暂无匹配订单</view>

</view>

<admin-page-help />
