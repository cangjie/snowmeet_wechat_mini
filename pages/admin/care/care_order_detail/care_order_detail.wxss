/* pages/admin/care/care_order_detail/care_order_detail.wxss
   Alpine Operational Minimalist：卡片 + 蓝竖条分组标题 + chip */
.page-root {
  min-height: 100vh;
  background: #f8f9ff;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a33;
  margin-bottom: 16rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #006495;
}
.section-title--sub {
  margin-top: 24rpx;
  font-size: 28rpx;
}
.section-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.section-title-row .section-title { margin-bottom: 16rpx; }

/* 订单信息双列 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}
.info-cell {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
  box-sizing: border-box;
}
.info-label {
  font-size: 24rpx;
  color: #6f7881;
}
.info-value {
  font-size: 28rpx;
  color: #1f2a33;
  margin-top: 4rpx;
  word-break: break-all;
}
.info-value--link { color: #006495; }

/* 支付信息（与租赁详情页同款：2×2 摘要格 + 可折叠支付明细表） */
.pay-summary-grid {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  margin-bottom: 4rpx;
}
.pay-summary-cell {
  width: 48%;
  box-sizing: border-box;
  background: #F8F8F8; border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}
.pay-summary-label { font-size: 24rpx; color: #999; margin-bottom: 4rpx; }
.pay-summary-value { font-size: 30rpx; font-weight: 600; color: #333; }
.pay-summary-value--blue { color: #2EA6D0; }
.pay-summary-value--red { color: #E64340; }

.divider { height: 1rpx; background: #F0F0F0; margin: 12rpx 0; }

.payment-detail-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
}
.payment-detail-toggle__title {
  font-size: 26rpx;
  color: #666;
}

.pay-table { width: 100%; }
.pay-table-row {
  display: flex; align-items: center;
  font-size: 24rpx; min-height: 56rpx;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 8rpx;
}
.pay-table-row:last-child { border-bottom: none; }
.pay-col-date { flex: 0 0 118rpx; color: #666; font-size: 22rpx; white-space: nowrap; }
.pay-col-time { flex: 0 0 100rpx; color: #666; font-size: 22rpx; white-space: nowrap; }
.pay-col-method { flex: 0 0 94rpx; color: #666; font-size: 22rpx; white-space: nowrap; }
.pay-col-cell { flex: 0 0 124rpx; color: #666; font-size: 22rpx; white-space: nowrap; text-align: center; }
.pay-col-amount { flex: 1; text-align: right; font-weight: 600; }
.pay-col-amount--pay { color: #2EA6D0; }
.pay-col-amount--refund { color: #E64340; }
/* 他人代付整行标红 */
.pay-table-row--proxy .pay-col-date,
.pay-table-row--proxy .pay-col-time,
.pay-table-row--proxy .pay-col-method,
.pay-table-row--proxy .pay-col-cell,
.pay-table-row--proxy .pay-col-amount { color: #E64340; }
.pay-empty { color: #999; font-size: 26rpx; text-align: center; padding: 20rpx 0; }

.order-memo-block {
  margin-top: 12rpx;
  border-top: 1rpx solid #eef1f5;
  padding-top: 14rpx;
}

.order-memo-input {
  width: 100%;
  min-height: 108rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  background: #ffffff;
  border: 1rpx solid #dfe5ec;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
  color: #1f2a33;
}

.order-memo-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 10rpx;
}

/* 备注只读展示态 */
.order-memo-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #1f2a33;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}
.order-memo-text--empty { color: #9aa3ac; }
.edit-link--memo { padding-bottom: 0; }

/* chip */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  flex: none;
}
.chip-primary { background: #e1f0f7; color: #006495; }
.chip-success { background: #dcfce7; color: #15803d; }
.chip-pending { background: #fee2e2; color: #b91c1c; }
.chip-muted { background: #eef1f5; color: #6f7881; }
.chip-outline { background: #f4f7fa; color: #3f4850; }

/* 装备卡 */
.care-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.care-head-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.care-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a33;
}
.care-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}
.care-summary {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 600;
  color: #006495;
}
.care-body { margin-top: 16rpx; border-top: 1rpx solid #eef1f5; padding-top: 16rpx; }
.care-memo { font-size: 26rpx; color: #6f7881; margin-top: 8rpx; }

/* 照片 */
.photo-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.photo-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #eef1f5;
}

/* 任务时间线 */
.task-list { display: flex; flex-direction: column; }
.task-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}
.task-row--current { background: #f7fbfd; border-radius: 8rpx; padding-left: 8rpx; padding-right: 8rpx; }
.task-main { flex: 1; min-width: 0; }
.task-name-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.task-name { font-size: 28rpx; color: #1f2a33; }
.task-meta {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  font-size: 22rpx;
  color: #9aa3ac;
  margin-top: 4rpx;
}
.task-actions { flex: none; }

/* 任务操作面板 */
.task-panel {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0 12rpx;
}
.kv-grid { display: flex; flex-wrap: wrap; }
.kv-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 8rpx;
  box-sizing: border-box;
}
.panel-input {
  background: #ffffff;
  border: 1rpx solid #dfe5ec;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  margin-top: 6rpx;
}
.panel-input--wide { margin-top: 16rpx; }
.safe-memo-textarea { width: 100%; box-sizing: border-box; min-height: 80rpx; }
.panel-btn-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
}
.panel-btn-row--split { margin-top: 24rpx; }

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.2;
}
.btn--sm { padding: 8rpx 22rpx; font-size: 24rpx; }
.btn--primary { background: #006495; color: #ffffff; }
.btn--danger { background: #e64340; color: #ffffff; }
.btn--warning { background: #d97706; color: #ffffff; }
.btn--plain { background: #ffffff; color: #006495; border: 1rpx solid #bfd7e4; }

/* 发板核销 */
.deal-method-row, .veri-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.veri-row .panel-input { flex: 1; margin-top: 0; }
.veri-hint {
  font-size: 22rpx;
  color: #9aa3ac;
  margin-top: 12rpx;
  text-align: center;
}
.veri-hint--left { text-align: left; margin-bottom: 12rpx; }
.veri-seg {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}
.scan-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
}
.scan-qr-img {
  width: 360rpx;
  height: 360rpx;
  background: #ffffff;
  border-radius: 12rpx;
}
.task-panel--proof {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.task-proof-label { font-size: 24rpx; color: #6f7881; }

/* 非雪季订单醒目横幅（琥珀警示系：蓝=操作 绿=成功 红=危险已占用） */
.summer-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  background: #fffbeb;
  border-left: 8rpx solid #f59e0b;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.summer-banner-texts { display: flex; flex-direction: column; min-width: 0; }
.summer-banner-title { font-size: 30rpx; font-weight: 600; color: #92400e; }
.summer-banner-desc { font-size: 24rpx; color: #b45309; margin-top: 4rpx; }
.chip-summer { background: #fef3c7; color: #92400e; font-weight: 600; }

/* 任务行三态：当前高亮 / 未来淡化 / 完成收敛 */
.task-row--current {
  background: #f0f7fb;
  border-left: 8rpx solid #006495;
  border-bottom: none;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0;
}
.task-row--current .task-name { font-weight: 600; }
.task-row--future .task-name { color: #9aa3ac; }
.task-row--future .chip { opacity: 0.7; }
.task-row--done { gap: 10rpx; padding: 10rpx 0; }
.task-done-name { font-size: 26rpx; color: #3f4850; flex: none; }
.task-done-flag { font-size: 22rpx; color: #b91c1c; flex: none; }
.task-done-meta {
  margin-left: auto;
  font-size: 22rpx;
  color: #9aa3ac;
  text-align: right;
  min-width: 0;
}

/* 进行中计时 */
.task-elapsed {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #006495;
}
.task-elapsed-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #006495;
  animation: elapsed-pulse 1.6s ease-in-out infinite;
}
@keyframes elapsed-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

/* 整宽大按钮 + 引导文案 */
.btn--block {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}
.btn--danger-plain { background: #ffffff; color: #e64340; border: 1rpx solid #f3b6b5; }
.btn--half { flex: 1; justify-content: center; }
.task-hint {
  font-size: 22rpx;
  color: #9aa3ac;
  text-align: center;
  margin-top: 8rpx;
}

/* 装备信息编辑 */
.sub-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.edit-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #006495;
  padding: 0 4rpx 16rpx;
}
.edit-panel {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 16rpx;
}
.edit-panel .panel-input { width: 100%; box-sizing: border-box; }
.edit-block { margin-top: 16rpx; }
.edit-block-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.seg-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 6rpx;
}
.panel-picker-value { color: #1f2a33; min-height: 40rpx; }

/* 新增品牌弹层 */
.brand-modal { padding: 32rpx 24rpx 24rpx; }
.brand-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a33;
  text-align: center;
  margin-bottom: 20rpx;
}
.brand-modal-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.brand-modal-body .panel-input { width: 100%; box-sizing: border-box; }
.brand-modal-footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 24rpx;
}

.refund-modal {
  padding: 30rpx 24rpx 24rpx;
}

.refund-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a33;
  text-align: center;
  margin-bottom: 18rpx;
}

.refund-modal-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.refund-modal-actions {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  gap: 18rpx;
}
