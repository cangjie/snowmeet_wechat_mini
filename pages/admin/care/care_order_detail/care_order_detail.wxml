<!--pages/admin/care/care_order_detail/care_order_detail.wxml
  新版养护订单详情（Alpine Operational Minimalist）
  非雪季横幅 / A 订单信息 / B 支付信息（四格摘要 + 可折叠明细） /
  C 每件装备卡（装备信息可编辑 + 服务 + 照片 + 任务时间线 + 发板核销四方式 + 打印）
-->
<view class="page-root">

  <!-- 非雪季订单醒目横幅 -->
  <view wx:if="{{summerBanner.show}}" class="summer-banner">
    <van-icon name="warning-o" size="22px" color="#f59e0b"/>
    <view class="summer-banner-texts">
      <text class="summer-banner-title">非雪季养护订单</text>
      <text class="summer-banner-desc">{{summerBanner.desc}}</text>
    </view>
  </view>

  <!-- A 订单信息 -->
  <view class="card">
    <view class="section-title">订单信息</view>
    <view class="info-grid">
      <view class="info-cell">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.code || order.id}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">店铺</text>
        <text class="info-value">{{order.shop}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">顾客</text>
        <text class="info-value">{{order.contact_name || '散客'}}</text>
      </view>
      <view class="info-cell" bindtap="onCall">
        <text class="info-label">电话</text>
        <text class="info-value info-value--link">{{order.contact_num || '--'}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">业务日期</text>
        <text class="info-value">{{order.bizDateStr}}</text>
      </view>
      <view class="info-cell">
        <text class="info-label">装备数量</text>
        <text class="info-value">{{cares.length}}</text>
      </view>
    </view>
    <!-- 订单备注：只读 / 编辑二态（同装备信息） -->
    <view class="order-memo-block">
      <view class="sub-title-row">
        <text class="info-label">订单备注</text>
        <view wx:if="{{!orderMemoEditing}}" class="edit-link edit-link--memo" catchtap="onOrderMemoEditTap">
          <van-icon name="edit" size="14px" color="#006495"/>
          <text>编辑</text>
        </view>
      </view>
      <text wx:if="{{!orderMemoEditing}}" class="order-memo-text {{order.memo ? '' : 'order-memo-text--empty'}}">{{order.memo || '暂无备注'}}</text>
      <block wx:else>
        <textarea class="order-memo-input" maxlength="200" placeholder="填写订单备注（选填）"
                  value="{{orderMemoDraft}}" bindinput="onOrderMemoInput"/>
        <view class="order-memo-actions">
          <view class="btn btn--plain btn--sm" bindtap="onOrderMemoCancel">取消</view>
          <view class="btn btn--primary btn--sm" bindtap="onSaveOrderMemo">{{savingOrderMemo ? '保存中...' : '保存备注'}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- B 支付信息 -->
  <!-- 与租赁详情页同款：2×2 摘要格 + 可折叠支付明细表（代付标红 + 脱敏手机号） -->
  <view class="card">
    <view class="section-title-row">
      <view class="section-title">支付信息</view>
      <view class="btn btn--danger btn--sm" catchtap="onOpenRefundPopup">退款</view>
    </view>

    <view class="pay-summary-grid">
      <view class="pay-summary-cell">
        <view class="pay-summary-label">支付总金额</view>
        <view class="pay-summary-value pay-summary-value--blue">{{payment.paidStr}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">退款总金额</view>
        <view class="pay-summary-value pay-summary-value--red">{{payment.refundStr}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">支付笔数</view>
        <view class="pay-summary-value">{{payment.payRows.length}}</view>
      </view>
      <view class="pay-summary-cell">
        <view class="pay-summary-label">退款笔数</view>
        <view class="pay-summary-value">{{payment.refundRows.length}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="payment-detail-toggle" bindtap="onTogglePayment">
      <text class="payment-detail-toggle__title">支付明细</text>
      <van-icon name="{{payment.expanded ? 'arrow-up' : 'arrow-down'}}" size="18px" color="#999"/>
    </view>

    <block wx:if="{{payment.expanded}}">
      <view class="pay-table" wx:if="{{payment.payRows.length > 0 || payment.refundRows.length > 0}}">
        <view class="pay-table-row" style="font-size:22rpx;color:#999;">
          <text class="pay-col-date">日期</text>
          <text class="pay-col-time">时间</text>
          <text class="pay-col-method">支付方式</text>
          <text class="pay-col-cell">手机号</text>
          <text class="pay-col-amount">金额</text>
        </view>
        <view class="pay-table-row {{item._isProxy ? 'pay-table-row--proxy' : ''}}" wx:for="{{payment.payRows}}" wx:key="id">
          <text class="pay-col-date">{{item.paid_dateDateStr}}</text>
          <text class="pay-col-time">{{item.paid_dateTimeStr}}</text>
          <text class="pay-col-method">{{item.pay_method}}</text>
          <text class="pay-col-cell">{{item._proxyCellMasked}}</text>
          <text class="pay-col-amount pay-col-amount--pay">{{item.amountStr}}</text>
        </view>
        <view class="pay-table-row" wx:for="{{payment.refundRows}}" wx:key="id">
          <text class="pay-col-date">{{item.paid_dateDateStr || '—'}}</text>
          <text class="pay-col-time">{{item.paid_dateTimeStr || ''}}</text>
          <text class="pay-col-method">{{item.pay_method || '—'}}</text>
          <text class="pay-col-cell"></text>
          <text class="pay-col-amount pay-col-amount--refund">-{{item.amountStr}}</text>
        </view>
      </view>
      <view wx:else class="pay-empty">暂无支付记录</view>
    </block>
  </view>

  <!-- C 装备卡 -->
  <block wx:for="{{cares}}" wx:key="id" wx:for-item="care" wx:for-index="cidx">
    <view class="card" id="care-{{care.id}}">
      <view class="care-head" data-cidx="{{cidx}}" bindtap="onToggleCare">
        <view class="care-head-left">
          <text class="care-title">{{care._title}}</text>
          <view class="chip {{care._status === '已完成' ? 'chip-success' : (care._status === '已取消' ? 'chip-pending' : (care._status === '未开始' ? 'chip-muted' : 'chip-primary'))}}">{{care._status}}</view>
        </view>
        <van-icon name="{{care._expanded ? 'arrow-up' : 'arrow-down'}}" size="16px" color="#6f7881"/>
      </view>

      <!-- 服务 chips + 金额（折叠态也显示） -->
      <view class="care-chips">
        <view wx:for="{{care._chips}}" wx:key="text" wx:for-item="chip" class="chip {{chip.cls}}">{{chip.text}}</view>
        <text class="care-summary">{{care._summaryStr}}</text>
      </view>

      <view wx:if="{{care._expanded}}" class="care-body">
        <!-- 装备信息（只读 / 编辑二态） -->
        <view class="sub-title-row">
          <view class="section-title section-title--sub">装备信息</view>
          <view wx:if="{{!care._editing}}" class="edit-link" data-cidx="{{cidx}}" catchtap="onEditTap">
            <van-icon name="edit" size="14px" color="#006495"/>
            <text>编辑</text>
          </view>
        </view>

        <view class="info-grid">
          <view class="info-cell">
            <text class="info-label">序列号</text>
            <text class="info-value">{{care._serialText || '--'}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">附件</text>
            <text class="info-value">{{care.with_pole ? '雪杖 ' : ''}}{{care.others_associates || ''}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">项目收费</text>
            <text class="info-value">{{care._commonStr}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">附加费</text>
            <text class="info-value">{{care._repairStr}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">减免</text>
            <text class="info-value">{{care._discountStr}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">任务码</text>
            <text class="info-value">{{care.task_flow_code || '--'}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">特殊标记</text>
            <text class="info-value">{{care.entertain ? '招待' : (care.warranty ? '质保' : '无')}}</text>
          </view>
          <view wx:if="{{care.equipment === '单板'}}" class="info-cell">
            <text class="info-label">前脚</text>
            <text class="info-value">{{care.board_front === '左' ? '左脚' : (care.board_front === '右' ? '右脚' : '--')}}</text>
          </view>
        </view>

        <block wx:if="{{!care._editing}}">
          <view wx:if="{{care.memo}}" class="care-memo">备注：{{care.memo}}</view>

          <!-- 照片 -->
          <view wx:if="{{care._photos.length > 0}}" class="photo-row">
            <image wx:for="{{care._photos}}" wx:key="id" wx:for-index="idx"
                   class="photo-thumb" src="{{item.thumb}}" mode="aspectFill"
                   data-cidx="{{cidx}}" data-idx="{{idx}}" bindtap="onPhotoTap"/>
          </view>
        </block>

        <!-- 编辑面板 -->
        <view wx:else class="edit-panel">
          <view class="kv-grid">
            <view class="kv-item">
              <text class="info-label">品牌</text>
              <picker range="{{care.equipment === '双板' ? skiBrandList : boardBrandList}}" range-key="displayedName"
                      value="{{care._brandIndex}}" data-cidx="{{cidx}}" bindchange="onBrandChange">
                <view class="panel-input panel-picker-value">{{care.brand || '请选择品牌'}}</view>
              </picker>
            </view>
            <view class="kv-item">
              <text class="info-label">长度(cm)</text>
              <input class="panel-input" type="digit" value="{{care.scale || ''}}"
                     data-cidx="{{cidx}}" data-field="scale" bindblur="onEditFieldBlur"/>
            </view>
            <view wx:if="{{care.equipment === '双板'}}" class="kv-item">
              <text class="info-label">鞋长(mm)</text>
              <input class="panel-input" type="digit" value="{{care.boot_length || ''}}"
                     data-cidx="{{cidx}}" data-field="boot_length" bindblur="onEditFieldBlur"/>
            </view>
            <view wx:else class="kv-item">
              <text class="info-label">前脚</text>
              <view class="seg-row">
                <view class="btn btn--sm {{care.board_front === '左' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-value="左" catchtap="onBoardFrontTap">左</view>
                <view class="btn btn--sm {{care.board_front === '右' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-value="右" catchtap="onBoardFrontTap">右</view>
              </view>
            </view>
          </view>

          <view class="edit-block">
            <view class="edit-block-head">
              <text class="info-label">序列号</text>
              <view wx:if="{{care.equipment === '双板'}}"
                    class="btn btn--sm {{care._diffSerial ? 'btn--primary' : 'btn--plain'}}"
                    data-cidx="{{cidx}}" catchtap="onSerialDiffTap">分左右</view>
            </view>
            <block wx:if="{{care._diffSerial}}">
              <input class="panel-input" placeholder="左板序列号" value="{{care._leftSerial}}"
                     data-cidx="{{cidx}}" data-field="_leftSerial" bindblur="onEditFieldBlur"/>
              <input class="panel-input" placeholder="右板序列号" value="{{care._rightSerial}}"
                     data-cidx="{{cidx}}" data-field="_rightSerial" bindblur="onEditFieldBlur"/>
            </block>
            <input wx:else class="panel-input" placeholder="序列号" value="{{care.serials || ''}}"
                   data-cidx="{{cidx}}" data-field="serials" bindblur="onEditFieldBlur"/>
          </view>

          <view class="edit-block">
            <view class="edit-block-head">
              <text class="info-label">附件</text>
              <view wx:if="{{care.equipment === '双板'}}"
                    class="btn btn--sm {{care.with_pole ? 'btn--primary' : 'btn--plain'}}"
                    data-cidx="{{cidx}}" catchtap="onWithPoleTap">雪杖</view>
            </view>
            <input class="panel-input" placeholder="其他附件" value="{{care.others_associates || ''}}"
                   data-cidx="{{cidx}}" data-field="others_associates" bindblur="onEditFieldBlur"/>
          </view>

          <view class="edit-block">
            <view class="edit-block-head"><text class="info-label">备注</text></view>
            <input class="panel-input" placeholder="备注" value="{{care.memo || ''}}"
                   data-cidx="{{cidx}}" data-field="memo" bindblur="onEditFieldBlur"/>
          </view>

          <view class="edit-block">
            <view class="edit-block-head"><text class="info-label">装备照片</text></view>
            <van-uploader file-list="{{care._photoFiles}}" max-count="9" deletable
                          data-cidx="{{cidx}}"
                          bind:after-read="onEditPhotoRead" bind:delete="onEditPhotoDelete"/>
          </view>

          <view class="panel-btn-row">
            <view class="btn btn--plain btn--half" data-cidx="{{cidx}}" catchtap="onEditCancel">取消</view>
            <view class="btn btn--primary btn--half" data-cidx="{{cidx}}" catchtap="onEditSave">保存</view>
          </view>
        </view>

        <!-- 任务时间线 -->
        <view class="section-title section-title--sub">养护任务</view>
        <view class="task-list">
          <block wx:for="{{care._tasks}}" wx:key="id" wx:for-item="task" wx:for-index="tidx">

            <!-- 已完成 / 强行中止：单行收敛 -->
            <view wx:if="{{task._done}}" class="task-row task-row--done">
              <van-icon name="{{task.status === '已完成' ? 'checked' : 'clear'}}" size="16px"
                        color="{{task.status === '已完成' ? '#15803d' : '#b91c1c'}}"/>
              <text class="task-done-name">{{task._title}}</text>
              <text wx:if="{{task.status === '强行中止'}}" class="task-done-flag">中止</text>
              <text class="task-done-meta">{{task._durationStr ? task._durationStr + ' · ' : ''}}{{task._staffName ? task._staffName + ' · ' : ''}}{{task._endStr}}</text>
            </view>

            <!-- 未完成任务 -->
            <view wx:else class="task-row {{task._current ? 'task-row--current' : 'task-row--future'}}">
              <view class="task-main">
                <view class="task-name-wrap">
                  <text class="task-name">{{task._title}}</text>
                  <view class="chip {{task.status === '已开始' ? 'chip-primary' : 'chip-muted'}}">{{task.status}}</view>
                </view>
                <view class="task-meta" wx:if="{{task._staffName || task._startStr}}">
                  <text wx:if="{{task._staffName}}">{{task._staffName}}</text>
                  <text wx:if="{{task._startStr}}">{{task._startStr}} 开始</text>
                </view>
                <!-- 进行中：实时已用时 -->
                <view wx:if="{{task._running && task._elapsedStr}}" class="task-elapsed">
                  <view class="task-elapsed-dot"></view>
                  <text>进行中 · 已用时 {{task._elapsedStr}}</text>
                </view>
                <!-- 通用任务整宽大按钮（安全检查/发板/寄存或快递走各自专属面板） -->
                <block wx:if="{{task._current && task.task_name !== '安全检查' && task.task_name !== '发板' && task.task_name !== '寄存或快递'}}">
                  <view wx:if="{{task.status === '未开始'}}" class="btn btn--primary btn--block"
                        data-cidx="{{cidx}}" data-task-id="{{task.id}}" data-task-name="{{task.task_name}}" catchtap="onTaskStart">开始 {{task.task_name}}</view>
                  <view wx:elif="{{task._running && task._isMine}}" class="btn btn--danger btn--block"
                        data-cidx="{{cidx}}" data-task-id="{{task.id}}" catchtap="onTaskEnd">结束 {{task.task_name}}</view>
                  <view wx:elif="{{task._running}}" class="btn btn--danger-plain btn--block"
                        data-cidx="{{cidx}}" data-task-id="{{task.id}}" catchtap="onTaskEnd">强行中止（{{task._staffName || '他人'}} 执行中）</view>
                  <view wx:if="{{task._hint}}" class="task-hint">{{task._hint}}</view>
                </block>
              </view>
            </view>

            <!-- 安全检查录入区 -->
            <view wx:if="{{task.task_name === '安全检查' && task._current && care._safeChecking}}" class="task-panel">
                <view class="kv-grid">
                  <view class="kv-item">
                    <text class="info-label">身高(cm) *</text>
                    <input class="panel-input" type="digit" value="{{care.height || ''}}"
                           data-cidx="{{cidx}}" data-field="height" bindblur="onSafeFieldBlur"/>
                  </view>
                  <view wx:if="{{care.equipment === '双板'}}" class="kv-item">
                    <text class="info-label">体重(kg)</text>
                    <input class="panel-input" type="digit" value="{{care.weight || ''}}"
                           data-cidx="{{cidx}}" data-field="weight" bindblur="onSafeFieldBlur"/>
                  </view>
                  <view wx:else class="kv-item">
                    <text class="info-label">间距</text>
                    <input class="panel-input" type="digit" value="{{care.gap || ''}}"
                           data-cidx="{{cidx}}" data-field="gap" bindblur="onSafeFieldBlur"/>
                  </view>
                  <block wx:if="{{care.equipment === '双板'}}">
                    <view class="kv-item">
                      <text class="info-label">前脱落值 *</text>
                      <input class="panel-input" type="digit" value="{{care.front_din || ''}}"
                             data-cidx="{{cidx}}" data-field="front_din" bindblur="onSafeFieldBlur"/>
                    </view>
                    <view class="kv-item">
                      <text class="info-label">后脱落值 *</text>
                      <input class="panel-input" type="digit" value="{{care.rear_din || ''}}"
                             data-cidx="{{cidx}}" data-field="rear_din" bindblur="onSafeFieldBlur"/>
                    </view>
                  </block>
                  <block wx:else>
                    <view class="kv-item">
                      <text class="info-label">左角度</text>
                      <input class="panel-input" type="digit" value="{{care.left_angle || ''}}"
                             data-cidx="{{cidx}}" data-field="left_angle" bindblur="onSafeFieldBlur"/>
                    </view>
                    <view class="kv-item">
                      <text class="info-label">右角度</text>
                      <input class="panel-input" type="digit" value="{{care.right_angle || ''}}"
                             data-cidx="{{cidx}}" data-field="right_angle" bindblur="onSafeFieldBlur"/>
                    </view>
                  </block>
                </view>
                <view class="edit-block">
                  <view class="edit-block-head"><text class="info-label">安全检查备注</text></view>
                  <textarea class="panel-input panel-input--wide safe-memo-textarea" placeholder="选填，如顾客体态/特殊注意事项等"
                            value="{{care._safeMemoDraft || ''}}" maxlength="200"
                            data-cidx="{{cidx}}" bindblur="onSafeMemoBlur"/>
                </view>
                <view class="btn btn--warning btn--block" data-cidx="{{cidx}}" catchtap="onSafeCheck">确认安全</view>
                <view class="task-hint">确认后您将成为本次养护的安全负责人</view>
              <view wx:if="{{task._hint}}" class="task-hint">{{task._hint}}</view>
            </view>

            <!-- 寄存或快递（非雪季） -->
            <view wx:if="{{task.task_name === '寄存或快递' && task._current}}" class="task-panel">
              <view class="deal-method-row">
                <view class="btn btn--sm {{task.deal_method === '寄存' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-tidx="{{tidx}}" data-method="寄存" catchtap="onDealMethodTap">寄存</view>
                <view class="btn btn--sm {{task.deal_method === '快递' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-tidx="{{tidx}}" data-method="快递" catchtap="onDealMethodTap">快递</view>
                <view class="btn btn--sm {{task.deal_method === '万龙寄存柜' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-tidx="{{tidx}}" data-method="万龙寄存柜" catchtap="onDealMethodTap">万龙寄存柜</view>
              </view>
              <input class="panel-input panel-input--wide"
                     placeholder="{{task.deal_method === '快递' ? '快递单号（必填）' : '备注'}}"
                     value="{{task.store_memo || ''}}"
                     data-cidx="{{cidx}}" data-tidx="{{tidx}}" bindblur="onStoreMemoBlur"/>
              <view class="btn btn--danger btn--block" data-cidx="{{cidx}}" data-tidx="{{tidx}}" catchtap="onStoreConfirm">确认寄存方式</view>
            </view>

            <!-- 发板核销 / 取消养护：同一套四方式核验，按任务状态自动判定用途。
                 只剩发板没完成（终态）→ 正常发板；其余任务只要还有未完成的（含已开始）→ 仅提供取消，非互斥、非用户手动开关 -->
            <view wx:if="{{task.task_name === '发板' && task.status === '未开始' && (task._current || care._canCancel)}}" class="task-panel {{care._cancelMode ? 'task-panel--cancel-active' : ''}}">
              <view wx:if="{{care._cancelMode}}" class="cancel-reason-box">
                <text class="info-label">取消原因 *</text>
                <textarea class="panel-input panel-input--wide safe-memo-textarea" placeholder="必填，如顾客改约/装备不适合养护等"
                          value="{{care._cancelReason || ''}}" maxlength="200"
                          data-cidx="{{cidx}}" bindblur="onCancelReasonBlur"/>
                <view class="veri-hint veri-hint--left">仍有养护任务未完成，本次仅支持取消。请选择下方任一方式核验身份，核验通过后按取消处理，不再赠送养护完成券</view>
              </view>
              <view class="veri-seg">
                <view class="btn btn--sm {{care._veriType === '扫码取板' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-type="扫码取板" catchtap="onVeriTypeTap">扫码取板</view>
                <view class="btn btn--sm {{care._veriType === '验证码' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-type="验证码" catchtap="onVeriTypeTap">验证码</view>
                <view class="btn btn--sm {{care._veriType === '拍照凭证' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-type="拍照凭证" catchtap="onVeriTypeTap">拍照凭证</view>
                <view wx:if="{{isMaster}}" class="btn btn--sm {{care._veriType === '店长确认' ? 'btn--primary' : 'btn--plain'}}"
                      data-cidx="{{cidx}}" data-type="店长确认" catchtap="onVeriTypeTap">店长确认</view>
              </view>
              <view wx:if="{{!care._veriType}}" class="veri-hint">{{care._cancelMode ? '请选择核验方式：由顾客本人操作，或核实操作人身份' : '请选择核销方式：由顾客本人操作，或核实取板人身份'}}</view>

              <!-- 扫码取板 -->
              <block wx:if="{{care._veriType === '扫码取板'}}">
                <view class="scan-qr">
                  <image wx:if="{{scanQr.careId === care.id && scanQr.url}}" class="scan-qr-img"
                         src="{{scanQr.url}}" mode="aspectFit"/>
                  <view wx:if="{{scanQr.careId === care.id && scanQr.status === 'loading'}}" class="veri-hint">二维码生成中…</view>
                  <view wx:if="{{scanQr.careId === care.id && scanQr.status === 'ready'}}" class="veri-hint">{{care._cancelMode ? '请顾客本人用微信扫码，扫码成功自动完成取消' : '请顾客本人用微信扫码，扫码成功自动完成发板'}}</view>
                  <view wx:if="{{scanQr.careId !== care.id || scanQr.status === 'broken'}}" class="panel-btn-row">
                    <view class="btn btn--plain" data-cidx="{{cidx}}" catchtap="onScanRetry">{{scanQr.careId === care.id && scanQr.status === 'broken' ? '重新生成二维码' : '生成二维码'}}</view>
                  </view>
                </view>
              </block>

              <!-- 验证码 -->
              <block wx:if="{{care._veriType === '验证码'}}">
                <view class="veri-row">
                      <input class="panel-input" type="number" placeholder="4 位任务码"
                         value="{{veriCode}}" bindinput="onVeriCodeInput"/>
                  <view class="btn btn--primary btn--sm" data-cidx="{{cidx}}" catchtap="onVeriCodeConfirm">验证</view>
                  <view class="btn btn--plain btn--sm" data-cidx="{{cidx}}" catchtap="onSendVeriCode">重新发送</view>
                </view>
              </block>

              <!-- 拍照凭证 -->
              <block wx:if="{{care._veriType === '拍照凭证'}}">
                <view class="veri-hint veri-hint--left">{{care._cancelMode ? '拍摄操作人凭证照片，上传成功后自动完成取消' : '拍摄取板人凭证照片，上传成功后自动完成发板'}}</view>
                <van-uploader max-count="1" data-cidx="{{cidx}}" bind:after-read="onPickPhotoRead"/>
              </block>

              <!-- 店长确认 -->
              <block wx:if="{{care._veriType === '店长确认'}}">
                <view class="btn btn--danger btn--block" data-cidx="{{cidx}}" catchtap="onMasterFinish">{{care._cancelMode ? '店长确认取消' : '店长确认发板'}}</view>
              </block>
            </view>

            <!-- 发板完成后：核销凭证 -->
            <view wx:if="{{task.task_name === '发板' && task.status === '已完成' && (task.memo || care._pickThumb)}}" class="task-panel task-panel--proof">
              <text wx:if="{{task.memo}}" class="task-proof-label">核销方式：{{task.memo}}</text>
              <image wx:if="{{care._pickThumb}}" class="photo-thumb" src="{{care._pickThumb}}" mode="aspectFill"
                     data-cidx="{{cidx}}" catchtap="onPickProofTap"/>
            </view>
            <view wx:if="{{task.task_name === '发板' && task.status === '已完成' && care.is_cancel}}" class="task-panel task-panel--cancel">
              <text class="task-proof-label">已取消 · 原因：{{care.cancel_reason || '（未填写）'}}</text>
            </view>
          </block>
        </view>

        <!-- 打印 -->
        <view class="panel-btn-row panel-btn-row--split">
          <view class="btn btn--plain" data-cidx="{{cidx}}" catchtap="onPrintLabel">打印标签存根</view>
          <view class="btn btn--plain" data-cidx="{{cidx}}" catchtap="onPrintInvoice">打印顾客小票</view>
        </view>
      </view>
    </view>
  </block>

  <view style="height: 120rpx;"></view>

  <van-popup show="{{ printShow }}" position="bottom" custom-style="height: 80%;" bind:close="onPrinterClose" closeable>
    <print-care wx:if="{{printShow}}" care="{{careToBePrinted}}" order="{{order}}" type="{{printType}}"></print-care>
  </van-popup>

  <!-- 新增品牌 -->
  <van-popup show="{{addBrand.show}}" position="center" round custom-style="width: 560rpx;" bind:close="onAddBrandCancel">
    <view class="brand-modal">
      <view class="brand-modal-title">新增品牌</view>
      <view class="brand-modal-body">
        <input class="panel-input" placeholder="英文名称（必填）" value="{{addBrand.name}}"
               data-field="name" bindinput="onAddBrandInput"/>
        <input class="panel-input" placeholder="中文名称" value="{{addBrand.chineseName}}"
               data-field="chineseName" bindinput="onAddBrandInput"/>
      </view>
      <view class="brand-modal-footer">
        <view class="btn btn--plain btn--half" catchtap="onAddBrandCancel">取消</view>
        <view class="btn btn--primary btn--half" catchtap="onAddBrandConfirm">确认</view>
      </view>
    </view>
  </van-popup>

  <van-popup show="{{refundPopup.show}}" position="center" round custom-style="width: 620rpx;" bind:close="onCloseRefundPopup">
    <view class="refund-modal">
      <view class="refund-modal-title">订单退款</view>
      <view class="refund-modal-body">
        <text class="info-label">退款金额</text>
        <input class="panel-input" type="digit" placeholder="请输入退款金额"
               value="{{refundPopup.amount}}" bindinput="onRefundAmountInput"/>
        <text class="info-label">退款备注</text>
        <textarea class="order-memo-input" maxlength="100" placeholder="请填写退款备注"
                  value="{{refundPopup.memo}}" bindinput="onRefundMemoInput"/>
      </view>
      <view class="refund-modal-actions">
        <view class="btn btn--plain btn--half" catchtap="onCloseRefundPopup">取消</view>
        <view class="btn btn--danger btn--half" catchtap="onConfirmRefund">{{refundPopup.refunding ? '退款中...' : '确认退款'}}</view>
      </view>
    </view>
  </van-popup>
</view>
