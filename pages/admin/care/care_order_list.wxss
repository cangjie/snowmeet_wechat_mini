/* ── 页面背景 ─────────────────────────────── */
.page-root {
  min-height: 100vh;
  background: #f8f9ff;
  padding: 16rpx 0 48rpx;
  box-sizing: border-box;
}

/* ── 筛选卡片 ─────────────────────────────── */
.filter-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 16rpx 24rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-row:last-of-type {
  border-bottom: none;
}

.filter-row--date {
  align-items: flex-start;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.filter-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}

.filter-value {
  flex: 1;
  font-size: 26rpx;
}

.filter-row-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* radio group */
.radio-group {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  flex: 1;
}

.radio-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

/* inputs */
.filter-input {
  flex: 1;
  height: 56rpx;
  background: #f8f9ff;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #333;
  box-sizing: border-box;
}

.filter-actions {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

/* ── 统计 & 分页 ─────────────────────────── */
.summary-section {
  margin: 0 16rpx 12rpx;
}

.summary-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #555;
  padding: 8rpx 0 4rpx;
}

.summary-sep {
  margin: 0 10rpx;
  color: #ccc;
}

/* 翻页栏已抽成 list-pager 组件，样式在 components/list-pager/index.wxss */
.summary-section--bottom {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

/* ── 订单卡片 ─────────────────────────────── */
.order-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

/* 卡头 */
.order-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  font-family: 'Lexend', sans-serif;
}

/* 状态 chip */
.status-chip {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #e8f4fd;
  color: #006495;
}

.status-chip--paid    { background: #dcfce7; color: #15803d; }
.status-chip--temp    { background: #fee2e2; color: #b91c1c; }
.status-chip--partial { background: #fef3c7; color: #b45309; }
.status-chip--unpaid  { background: #f3f4f6; color: #6b7280; }
.status-chip--refund  { background: #ede9fe; color: #6d28d9; }
.status-chip--credit  { background: #e0e7ff; color: #3730a3; }

/* 没付成功的订单（待生成 / 待支付 / 订单关闭）：整张卡片文字置灰 */
.order-card--unpaid .order-code,
.order-card--unpaid .row-label,
.order-card--unpaid .row-value,
.order-card--unpaid .row-value--strong { color: #b0b0b0; }
.order-card--unpaid .tag { background: #f3f4f6; color: #b0b0b0; }

/* 内容区：左侧标签 + 右侧详情 */
.order-body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* 左侧标签列 */
.tag-col {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 48rpx;
  flex-shrink: 0;
  gap: 6rpx;
  padding-top: 2rpx;
  margin-right: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 0;
  border-radius: 4rpx;
  background: #f3f4f6;
  color: #374151;
  text-align: center;
}

.tag--test      { background: #fee2e2; color: #b91c1c; }
.tag--entertain { background: #fef3c7; color: #92400e; }
.tag--credit    { background: #fce7f3; color: #9d174d; }
.tag--discount  { background: #d1fae5; color: #065f46; }
.tag--warranty  { background: #cffafe; color: #0e7490; }
.tag--summer    { background: #fef3c7; color: #b45309; }
.tag--card      { background: #dbeafe; color: #1e40af; }
.tag--ticket    { background: #ffedd5; color: #c2410c; }
.tag--new       { background: #ecfccb; color: #3f6212; }

/* 详情行 */
.order-rows {
  margin-bottom: 12rpx;
  flex: 1;
  min-width: 0;
}

.order-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 6rpx;
  font-size: 24rpx;
}

.row-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #888;
  font-size: 22rpx;
}

.row-label--mid {
  width: 90rpx;
  margin-left: 8rpx;
}

.row-value {
  width: 160rpx;
  color: #333;
  font-size: 24rpx;
}

.row-value--wide {
  flex: 1;
  width: auto;
}

.row-value--strong {
  color: #b91c1c;
  font-weight: 600;
}

/* 支付方式：整行不折行 */
.row-value--nowrap {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 订单基本信息：两列。内容区宽 606rpx，左列 55% 放长内容（日期、手机+复制按钮、金额），
   右列 45% 放短内容；一行放不下的值不折行（省略号），手机号+复制按钮整体不收缩 */
.info-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.info-cell {
  width: 55%;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  margin-bottom: 6rpx;
  font-size: 24rpx;
}

.info-cell--right {
  width: 45%;
  padding-left: 12rpx;
}

/* 开单门店：占满一整行，放在订单信息最上面 */
.info-cell--full {
  width: 100%;
}

.info-cell .row-label { width: 88rpx; }
.info-cell--right .row-label { width: 70rpx; }
.info-cell .row-value--wide { min-width: 0; }
.row-label--info { width: 88rpx; }
/* 整单备注：内容长了往下折行，不省略 */
.order-memo { align-items: flex-start; line-height: 34rpx; }
.order-memo .row-value { word-break: break-all; }

.info-phone {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

/* 装备：通栏放在订单信息下面；每件一块，左边是和订单标签列对齐的图标列（双板 / 单板的图标），
   窄而高的照片（雪板是竖图）在各自那块的右侧 */
.care-section {
  border-top: 1rpx solid #f0f0f0;
}

.care-section-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #888;
  /* 上下留白加大，作为折叠开关好点；左边让出标签列的位置（标签列宽 + 右间距），文字和上面的订单信息左对齐 */
  padding: 12rpx 0;
  padding-left: 64rpx;
}

.care-toggle {
  color: #006495;
}

/* 展开 / 收起右侧的小箭头：收起时朝下，展开时朝上 */
.care-arrow {
  display: inline-block;
  margin-left: 8rpx;
  font-size: 28rpx;
  transform: rotate(90deg);
}

.care-arrow--open {
  transform: rotate(-90deg);
}

/* 每件装备整块（图标列 + 内容 + 照片）一个底色色块，按进度分四种：
   未开始（只做了安全检查或一项没做）灰蓝 / 进行中（除安全检查、发板外的任务有做了、有没做的）琥珀 /
   待发板（只差发板）紫 / 已完成（发板做完）绿；已取消红。
   左右各多出 10rpx 再用同样的内边距收回来，里面的内容还是和上面订单信息左对齐 */
.care-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 8rpx -10rpx 0;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: #eef1f6;
}

.care-line--idle   { background: #eef1f6; }
.care-line--run    { background: #fdf0c8; }
.care-line--ready  { background: #ebe6fd; }
.care-line--done   { background: #daf4e3; }
.care-line--cancel { background: #fde4e4; }

/* 图标列：和订单标签列（.tag-col）一样宽、一样的右间距，图标和上面的订单图标上下对齐成一列 */
.care-icon-col {
  width: 48rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  padding-top: 9rpx;
}

.care-kind {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

/* 每件装备的内容（块与块之间靠 .care-line 的色块和间距分开，不再画虚线） */
.care-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 10rpx 0;
}

.care-main {
  flex: 1;
  min-width: 0;
}

.care-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
}

.care-services {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 4rpx 0 2rpx;
}

.svc {
  font-size: 20rpx;
  line-height: 30rpx;
  padding: 0 10rpx;
  margin: 0 6rpx 4rpx 0;
  border-radius: 6rpx;
  background: #dbeafe;
  color: #1e40af;
}

.svc--urgent { background: #fee2e2; color: #b91c1c; }
.svc--summer { background: #fef3c7; color: #b45309; }

.care-progress {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

/* 任务进度：全部任务按先后排开，做完绿字、正在做（轮到的这一道）红字、还没轮到的灰字 */
.care-task {
  font-size: 22rpx;
  line-height: 36rpx;
}

.care-task--done { color: #16a34a; }
.care-task--run  { color: #dc2626; font-weight: 600; }
.care-task--idle { color: #9ca3af; }

/* 强行中止的任务算做完（绿），名字后面标一个小「中止」 */
.care-task-flag {
  margin-left: 4rpx;
  font-size: 18rpx;
  font-weight: normal;
  opacity: 0.8;
}

.care-task-sep {
  margin: 0 8rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  color: #d1d5db;
}

/* 每件装备的金额 / 减免 */
.care-amount {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #374151;
}

.care-amount-item {
  margin-right: 28rpx;
}

.care-amount-label {
  margin-right: 8rpx;
  color: #888;
}

/* 单项备注：金额 / 减免下面一行，标签灰、内容深色，内容长了往下折行 */
.care-memo {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #374151;
}

.care-memo-label {
  flex-shrink: 0;
  margin-right: 8rpx;
  color: #888;
}

.care-memo-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 装备用的权益：质保 / 招待、次卡（卡名 + 卡号 + 剩余次数）、券（券名 + 券号）、学员卡（名 + 卡号），每种一行，在金额 / 减免上面 */
.care-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #374151;
}

/* 权益标签：颜色和订单左侧标签列一致（卡 蓝 / 券 橙 / 质 青 / 招 琥珀），次卡用基础的蓝色 */
.care-card-tag {
  flex: none;
  margin-right: 10rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #dbeafe;
  color: #1e40af;
  font-size: 20rpx;
  line-height: 32rpx;
}

.care-card-tag--ticket    { background: #ffedd5; color: #c2410c; }
.care-card-tag--coach     { background: #dcfce7; color: #166534; }
.care-card-tag--warranty  { background: #cffafe; color: #0e7490; }
.care-card-tag--entertain { background: #fef3c7; color: #92400e; }

/* 占位行：看不见，但占的高度和真实的权益行一样 */
.care-card--ghost { visibility: hidden; }

.care-card-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡号、剩余次数都不收缩：卡名再长也只省略卡名 */
.care-card-no {
  flex: none;
  margin-left: 12rpx;
  color: #6b7280;
}

.care-card-remain {
  flex: none;
  margin-left: 12rpx;
  color: #1e40af;
}

.progress-chip {
  font-size: 20rpx;
  line-height: 30rpx;
  padding: 0 14rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #6b7280;
}

/* 阶段文字标签：白底药丸坐在装备色块上（色块本身已经表示阶段），文字颜色跟阶段走 */
.progress-chip--run    { color: #b45309; }
.progress-chip--ready  { color: #6d28d9; }
.progress-chip--done   { color: #15803d; }
.progress-chip--cancel { color: #b91c1c; }


/* 照片盒子：在 .care-body 里 stretch，高度跟整块装备内容走（至少 132rpx）；照片绝对定位铺满盒子 */
.care-thumb-box {
  position: relative;
  flex: none;
  align-self: stretch;
  width: 72rpx;
  min-height: 132rpx;
  margin-left: 12rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.care-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 没付成功的订单：装备块同样置灰 */
.order-card--unpaid .care-title,
.order-card--unpaid .care-task,
.order-card--unpaid .care-task-sep,
.order-card--unpaid .care-section-title,
.order-card--unpaid .care-toggle { color: #b0b0b0; }
.order-card--unpaid .care-kind { opacity: 0.4; filter: grayscale(1); }
.order-card--unpaid .care-amount,
.order-card--unpaid .care-amount-label,
.order-card--unpaid .care-memo,
.order-card--unpaid .care-memo-label,
.order-card--unpaid .care-card,
.order-card--unpaid .care-card-remain,
.order-card--unpaid .care-card-no,
.order-card--unpaid .care-card-tag { color: #b0b0b0; }
.order-card--unpaid .care-card-tag { background: #f3f4f6; }
.order-card--unpaid .svc { background: #f3f4f6; color: #b0b0b0; }
.order-card--unpaid .progress-chip { background: #fff; color: #b0b0b0; }
/* 没付成功的订单：装备色块不分阶段，统一浅灰 */
.order-card--unpaid .care-line,
.order-card--unpaid .care-line--idle,
.order-card--unpaid .care-line--run,
.order-card--unpaid .care-line--ready,
.order-card--unpaid .care-line--done,
.order-card--unpaid .care-line--cancel { background: #f7f7f7; }

/* 空状态 */
.empty-tip {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 60rpx 0;
}
