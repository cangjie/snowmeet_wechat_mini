/* 复用现有养护列表样式 */
.page-root {
  min-height: 100vh;
  background: #f8f9ff;
  padding: 16rpx 0 48rpx;
  box-sizing: border-box;
}
.filter-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 16rpx 24rpx;
}
.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.filter-row--date {
  align-items: flex-start;
  padding: 10rpx 0;
}
.filter-row:last-of-type { border-bottom: none; }
.filter-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}
.filter-value { flex: 1; font-size: 26rpx; }
.radio-group {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  flex: 1;
}
.radio-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}
.filter-input {
  flex: 1;
  height: 56rpx;
  background: #f8f9ff;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #333;
  box-sizing: border-box;
}
.filter-actions {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}
.summary-section { margin: 0 16rpx 12rpx; }
.summary-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #555;
  padding: 8rpx 0 4rpx;
}
.summary-sep { margin: 0 10rpx; color: #ccc; }

.task-stats {
  margin: 4rpx 0 10rpx;
}

.task-stats-label {
  font-size: 22rpx;
  color: #7a7a7a;
}

.task-stats-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 6rpx;
}

.task-stat-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #eef2ff;
}

.task-stat-name {
  font-size: 22rpx;
  color: #334155;
}

.task-stat-count {
  font-size: 22rpx;
  color: #b91c1c;
  font-weight: 600;
  margin-left: 6rpx;
}

.summary-section--bottom { margin-top: 16rpx; margin-bottom: 24rpx; }
.care-card {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}
.care-body { display: flex; flex-direction: row; align-items: flex-start; }
.care-rows { flex: 1; min-width: 0; }
.care-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 6rpx;
  font-size: 24rpx;
}
.row-label {
  width: 100rpx;
  flex-shrink: 0;
  color: #888;
  font-size: 22rpx;
}
.row-value { color: #333; font-size: 24rpx; }
.row-value--wide { flex: 1; width: auto; }
.row-value--strong { color: #b91c1c; font-weight: 600; }

.care-photos {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  width: 160rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.care-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f3f4f6;
}

.empty-tip {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 60rpx 0;
}
