<view class="page" wx:if="{{loading}}">
  <view class="loading-state">加载中…</view>
</view>

<block wx:else>
  <view class="page" wx:if="{{product}}">

    <!-- 配了商品图就用图，没配图退回"数字热区"（用真实次数当视觉主体） -->
    <view wx:if="{{product.imageUrl}}" class="hero hero--image">
      <image class="hero-img" src="{{product.imageUrl}}" mode="aspectFill" />
      <text class="hero-name hero-name--onimage">{{product.name}}</text>
    </view>
    <view wx:else class="hero">
      <block wx:if="{{product.isSeason}}">
        <text class="hero-count hero-count--season">季卡</text>
      </block>
      <block wx:else>
        <text class="hero-count">{{product.punch_total}}</text>
        <text class="hero-unit">次</text>
      </block>
      <text class="hero-name">{{product.name}}</text>
    </view>

    <view class="price-row">
      <text class="price-main">{{product.priceStr}}</text>
      <text wx:if="{{product.unitPriceStr}}" class="price-unit">约{{product.unitPriceStr}}/次</text>
    </view>

    <!-- 商品简介：后台商品维护页编的富文本原文，有就整段渲染；没编简介时退回一句自动生成的说明 -->
    <view class="info-card">
      <view class="info-card-title">商品简介</view>
      <rich-text wx:if="{{product.content}}" class="info-card-rich" nodes="{{product.content}}" />
      <view wx:else class="info-card-text">「{{product.name}}」{{product.countLabel}}，支付成功后自动存入「我的-次卡」</view>
    </view>

    <!-- 使用规则：后台商品维护页编了就整段渲染它；没编则回退下面这套默认规则（存量商品不至于空白） -->
    <view class="info-card">
      <view class="info-card-title">使用规则</view>
      <rich-text wx:if="{{product.usageRules}}" class="info-card-rich" nodes="{{product.usageRules}}" />
      <block wx:else>
        <view class="rule-row">
          <van-icon name="completed" size="17px" color="#006495" />
          <view class="rule-text">
            <view class="rule-text-main">{{product.usageMain}}</view>
            <view class="rule-text-sub">{{product.usageSub}}</view>
          </view>
        </view>
        <view class="rule-row">
          <van-icon name="clock-o" size="17px" color="#006495" />
          <view class="rule-text">
            <view class="rule-text-main">无使用期限</view>
            <view class="rule-text-sub">购买后长期有效，不设失效日期</view>
          </view>
        </view>
        <view class="rule-row">
          <van-icon name="manager-o" size="17px" color="#006495" />
          <view class="rule-text">
            <view class="rule-text-main">本人专属</view>
            <view class="rule-text-sub">仅限购买会员本人核销使用，不可转让</view>
          </view>
        </view>
      </block>
    </view>

    <view class="info-card">
      <view class="info-card-title">适用门店</view>
      <view class="shop-chip">
        <van-icon name="location-o" size="14px" color="#3f4850" />
        <text>{{product.shopLabel}}</text>
      </view>
    </view>

    <view class="footer">
      <view class="stepper">
        <view class="stepper-btn stepper-btn--minus {{qty<=1 ? 'stepper-btn--disabled' : ''}}" bindtap="onQtyMinus">
          <van-icon name="minus" size="15px" color="{{qty<=1 ? '#bfc7d1' : '#006495'}}" />
        </view>
        <text class="stepper-value">{{qty}}</text>
        <view class="stepper-btn stepper-btn--plus {{qty>=9 ? 'stepper-btn--disabled' : ''}}" bindtap="onQtyPlus">
          <van-icon name="plus" size="15px" color="#ffffff" />
        </view>
      </view>
      <view class="footer-total">
        <text class="footer-total-label">合计</text>
        <text class="footer-total-value">{{totalStr}}</text>
      </view>
      <button class="buy-btn {{buying ? 'buy-btn--disabled' : ''}}" bindtap="onBuyNow">
        {{buying ? '下单中…' : '立即购买'}}
      </button>
    </view>

  </view>
</block>
