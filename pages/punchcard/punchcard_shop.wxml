<view class="page">

  <!-- 真实信息条：只陈述系统实际会做的事，不写促销/优惠数字 -->
  <view class="info-strip">
    <van-icon name="shopping-cart-o" size="17px" color="#ffffff" />
    <text class="info-strip-text">在线购买 · 支付成功后次卡自动到账</text>
  </view>

  <view wx:if="{{loading}}" class="loading-state">加载中…</view>
  <block wx:else>
    <view class="feed-list">
      <view class="feed-card" wx:for="{{items}}" wx:key="_key" data-index="{{index}}" bindtap="onCardTap">
        <view class="feed-banner feed-banner--{{item.theme}}">
          <text class="feed-banner-tag">{{item.bizType}}次卡</text>
          <view class="feed-banner-count-row">
            <block wx:if="{{item.isSeason}}">
              <text class="feed-banner-count feed-banner-count--season">季卡</text>
            </block>
            <block wx:else>
              <text class="feed-banner-count">{{item.punch_total}}</text>
              <text class="feed-banner-unit">次</text>
            </block>
          </view>
        </view>
        <view class="feed-body">
          <view class="feed-name">{{item.name}}</view>
          <view class="feed-desc">{{item.desc}}</view>
          <view class="feed-bottom-row">
            <view class="feed-price-group">
              <text class="feed-price">{{item.priceStr}}</text>
              <text wx:if="{{item.unitPriceStr}}" class="feed-unit-price">约{{item.unitPriceStr}}/次</text>
            </view>
            <view class="feed-buy-btn" catchtap="onBuyTap" data-index="{{index}}">购买</view>
          </view>
        </view>
      </view>
    </view>
  </block>

</view>
