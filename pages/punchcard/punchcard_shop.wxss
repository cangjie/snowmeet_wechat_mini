/* Alpine Operational Minimalist token 本地拷贝——不能 @import "/pages/payment/settle/tokens.wxss"，
   那个文件在 app.json 的 subPackages（root: pages/payment）里，主包页面无法跨分包引用其资源，
   同 recept_package.wxss/recept_new.wxss 的既有做法：各自内联一份同款变量 */
page {
  --surface: #f8f9ff;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #eff4ff;
  --surface-container-high: #dce9ff;
  --on-surface: #0b1c30;
  --on-surface-variant: #3f4850;
  --outline: #6f7881;
  --outline-variant: #bfc7d1;
  --primary: #006495;
  --on-primary: #ffffff;
  --tertiary: #006591;
  --tertiary-container: #21abef;
}

.page {
  min-height: 100vh;
  /* 底部菜单是 fixed 的，留出它的高度 + 安全区，否则最后一张卡片会被盖住 */
  padding: 16px 14px calc(110px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading-state {
  text-align: center;
  color: var(--on-surface-variant);
  font-size: 13px;
  padding: 60px 0;
}

/* 信息流：仿公众号群发的横幅卡片列表 */
.feed-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.feed-card {
  background: var(--surface-container-lowest);
  border: 1px solid var(--outline-variant);
  border-radius: 14px;
  overflow: hidden;
}

.feed-card:active {
  opacity: 0.94;
}

/* 横幅：配了商品图就铺图（.feed-banner--image），没配图退回渐变色块 + 大字次数当"封面图" */
.feed-banner {
  position: relative;
  height: 96px;
  padding: 14px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.feed-banner--rent { background: linear-gradient(135deg, #006495, #21abef); }
.feed-banner--rent-deep { background: linear-gradient(135deg, #1e3a8a, #3b82f6); }
.feed-banner--care { background: linear-gradient(135deg, #047857, #10b981); }
.feed-banner--care-season { background: linear-gradient(135deg, #b45309, #f59e0b); }

/* 图片横幅：整图完整展示（mode=widthFix），角标绝对定位压在图上。
   ⚠️ 必须覆盖 .feed-banner 的固定 96px 高度改成 auto，否则 widthFix 撑出来的高度会被截断，
   等于又变回裁剪（配 aspectFill 时那个固定高度才有意义）。 */
.feed-banner--image {
  padding: 0;
  overflow: hidden;
  height: auto;
  min-height: 96px;   /* 仅作图片加载前的占位，避免容器 0 高度闪一下 */
  display: block;
  background: #eef2f7;
}

.feed-banner-img {
  width: 100%;
  display: block;     /* widthFix 下高度由图片比例决定，不要写 height */
}

.feed-banner-tag {
  align-self: flex-start;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
}

/* 压在照片上的角标：照片明暗不可控，用半透明黑底保证白字始终可读 */
.feed-banner-tag--onimage {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(0, 0, 0, 0.45);
}

.feed-banner-count-row {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.feed-banner-count {
  font-family: 'Lexend', sans-serif;
  font-size: 34px;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.feed-banner-count--season {
  font-size: 26px;
}

.feed-banner-unit {
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

.feed-body {
  padding: 12px 14px 14px;
}

.feed-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--on-surface);
  margin-bottom: 4px;
}

.feed-desc {
  font-size: 12px;
  color: var(--on-surface-variant);
  line-height: 1.5;
  margin-bottom: 12px;
  /* 简介来自后台富文本摘要、长度不可控，固定夹 2 行，免得不同商品的卡片高度参差不齐 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.feed-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.feed-price-group {
  display: flex;
  align-items: baseline;
  gap: 6px;
  min-width: 0;
}

.feed-price {
  font-family: 'Lexend', sans-serif;
  font-size: 19px;
  font-weight: 800;
  color: var(--primary);
}

.feed-unit-price {
  font-size: 11px;
  color: var(--on-surface-variant);
  white-space: nowrap;
}

.feed-buy-btn {
  flex-shrink: 0;
  padding: 8px 24px;
  border-radius: 999px;
  background: var(--primary);
  color: #ffffff;
  font-size: 13.5px;
  font-weight: 700;
}

.feed-buy-btn:active {
  opacity: 0.85;
}
