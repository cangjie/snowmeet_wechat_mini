/* Alpine Operational Minimalist token 本地拷贝——不能 @import "/pages/payment/settle/tokens.wxss"，
   那个文件在 app.json 的 subPackages（root: pages/payment）里，主包页面无法跨分包引用其资源，
   同 recept_package.wxss/recept_new.wxss 的既有做法：各自内联一份同款变量 */
page {
  --surface: #f8f9ff;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #eff4ff;
  --surface-container-high: #dce9ff;
  --on-surface: #0b1c30;
  --on-surface-variant: #3f4850;
  --outline: #6f7881;
  --outline-variant: #bfc7d1;
  --primary: #006495;
  --on-primary: #ffffff;
  --tertiary: #006591;
  --tertiary-container: #21abef;
}

.page {
  min-height: 100vh;
  padding: 16px 14px 100px;
  box-sizing: border-box;
}

.loading-state {
  text-align: center;
  color: var(--on-surface-variant);
  font-size: 13px;
  padding: 80px 0;
}

/* 数字热区（无商品图，用真实次数当视觉主体） */
.hero {
  border-radius: 16px;
  padding: 26px 20px;
  margin-bottom: 14px;
  background: linear-gradient(135deg, var(--primary), var(--tertiary-container));
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4px 10px;
}

.hero-count {
  font-family: 'Lexend', sans-serif;
  font-size: 40px;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.hero-unit {
  font-size: 16px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.hero-name {
  width: 100%;
  font-size: 14.5px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 4px;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 4px 4px 16px;
}

.price-main {
  font-family: 'Lexend', sans-serif;
  font-size: 26px;
  font-weight: 800;
  color: var(--primary);
}

.price-unit {
  font-size: 12px;
  color: var(--on-surface-variant);
}

.info-card {
  background: var(--surface-container-lowest);
  border: 1px solid var(--outline-variant);
  border-radius: 14px;
  padding: 14px 15px;
  margin-bottom: 12px;
}

.info-card-title {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--on-surface);
  margin-bottom: 8px;
}

.info-card-text {
  font-size: 13px;
  color: var(--on-surface-variant);
  line-height: 1.6;
}

.rule-row {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding: 8px 0;
  border-top: 1px solid var(--outline-variant);
}

.rule-row:first-of-type {
  border-top: none;
  padding-top: 2px;
}

.rule-text-main {
  font-size: 13px;
  font-weight: 600;
  color: var(--on-surface);
}

.rule-text-sub {
  font-size: 11.5px;
  color: var(--on-surface-variant);
  margin-top: 1px;
}

.shop-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--surface-container-low);
  color: var(--on-surface-variant);
  font-size: 12.5px;
  font-weight: 600;
}

/* 底部步进器 + 立即购买（结构照抄 recept_package.wxss 的 .modal-footer/.stepper） */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface-container-lowest);
  border-top: 1px solid var(--outline-variant);
  padding: 10px 14px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 60;
}

.stepper {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: 999px;
  padding: 4px 6px;
  flex-shrink: 0;
}

.stepper-btn {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn--minus {
  background: #ffffff;
  border: 1px solid var(--outline-variant);
}

.stepper-btn--plus {
  background: var(--primary);
}

.stepper-btn--disabled {
  opacity: 0.6;
}

.stepper-value {
  font-size: 14px;
  font-weight: 700;
  color: var(--on-surface);
  min-width: 18px;
  text-align: center;
}

.footer-total {
  flex: 1;
  min-width: 0;
}

.footer-total-label {
  display: block;
  font-size: 10.5px;
  color: var(--on-surface-variant);
}

.footer-total-value {
  font-family: 'Lexend', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: var(--primary);
}

.buy-btn {
  flex-shrink: 0;
  height: 44px;
  padding: 0 22px;
  border-radius: 999px;
  background: var(--primary);
  color: #ffffff;
  font-size: 14.5px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.buy-btn::after {
  border: none;
}

.buy-btn--disabled {
  background: var(--surface-container-high);
  color: var(--on-surface-variant);
}
