<!-- pages/ski_pass/skipass_detail_new.wxml -->
<view class="page-container">

<!-- 顶部导航栏：必须用 safe-nav-bar，自己画的顶栏会和手机状态栏重叠、返回键点不动。 -->
<safe-nav-bar title="{{resort}}雪票" placeholder="{{false}}" background="#F8F9FF" color="#1A73E8" border="{{false}}" />

<!-- 主内容区：整页 scroll-view，上边距 = 导航栏总高度（状态栏 + 导航栏） -->
<scroll-view class="main-content" style="padding-top: {{navTotalHeight}}px;" scroll-y="true" enhanced="true" show-scrollbar="false">

  <!-- Hero 横幅图 -->
  <view class="hero-section">
    <image class="hero-image" src="{{productImage}}" mode="aspectFill" />
    <view class="hero-overlay" />
    <view class="hero-content">
      <text class="hero-title">{{hasPrice ? groupTitle : (loading ? '加载中…' : resort + '雪票')}}</text>
      <text class="hero-subtitle" wx:if="{{productName}}">{{productName}}</text>
    </view>
  </view>

  <view class="form-section">

    <!-- 这一组暂时没有价格（价格还没发布，或链接里的分组已下架） -->
    <view class="bento-card empty-card" wx:if="{{!loading && !hasPrice}}">
      <text class="empty-title">暂无价格</text>
      <text class="empty-sub">这类雪票目前没有可订的日期，请返回重新选择</text>
    </view>

    <block wx:if="{{hasPrice}}">

      <!-- 装备：组内只有一种装备时不显示 -->
      <view class="bento-card" wx:if="{{gearOptions.length > 1}}">
        <text class="card-label">装备 (GEAR)</text>
        <view class="gear-row">
          <view
            wx:for="{{gearOptions}}"
            wx:key="id"
            class="gear-chip {{item.id == productId && !item.disabled ? 'gear-chip--active' : ''}} {{item.disabled ? 'gear-chip--disabled' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectGear"
          >
            <text class="gear-name">{{item.label}}</text>
            <text class="gear-price">¥{{item.minPriceStr}}起</text>
          </view>
        </view>
      </view>

      <!-- 日期与价格：只有写了价格的日期能点 -->
      <view class="bento-card">
        <text class="card-label">日期与价格 (DATE &amp; PRICE)</text>
        <view class="week-row">
          <text class="week-cell" wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="month-block" wx:for="{{months}}" wx:key="key">
          <text class="month-title">{{item.title}}</text>
          <view class="day-grid">
            <view
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="idx"
              class="day-cell {{cell.empty ? 'day-cell--empty' : (cell.enabled ? (cell.selected ? 'day-cell--selected' : 'day-cell--enabled') : 'day-cell--disabled')}}"
              data-date="{{cell.date}}"
              bindtap="onSelectDay"
            >
              <text class="day-num" wx:if="{{!cell.empty}}">{{cell.day}}</text>
              <text class="day-price" wx:if="{{cell.enabled}}">{{cell.priceStr}}</text>
            </view>
          </view>
        </view>
        <view class="selected-line">
          <text class="selected-date">{{selectedDateText}}</text>
          <text class="selected-price">¥{{priceStr}}</text>
        </view>
      </view>

      <!-- 游客信息：只有店员订票时才填 -->
      <view class="info-card" wx:if="{{isStaff}}">
        <view class="info-card-header">
          <view class="header-accent" />
          <text class="info-card-title">游客信息 (Guest Details)</text>
        </view>
        <view class="field-group">
          <view class="field-item">
            <text class="field-label">姓名 (FULL NAME)</text>
            <input
              class="field-input"
              value="{{name}}"
              placeholder="请输入姓名"
              placeholder-class="field-placeholder"
              bindinput="onNameInput"
            />
            <view class="field-underline" />
          </view>
          <view class="field-item">
            <text class="field-label">取票手机号 (PHONE NUMBER)</text>
            <view class="phone-row">
              <input
                class="field-input phone-input"
                value="{{cell}}"
                placeholder="请输入手机号"
                placeholder-class="field-placeholder"
                type="number"
                bindinput="onPhoneInput"
              />
              <view>
                <button open-type="getPhoneNumber" bindgetphonenumber="getCell" style="width: 190rpx;font-size: 9pt;height:50rpx" size="mini" class="input">自动获取</button>
              </view>
            </view>
            <view class="field-underline" />
          </view>
        </view>
      </view>

    </block>

    <!-- 底部占位，防止被底栏遮挡 -->
    <view class="bottom-placeholder" />

  </view>
</scroll-view>

<!-- 加入购物车前的确认弹层：顾客在这里核对，也可以直接改日期、接收订票短信的手机号 -->
<view class="sheet-mask" wx:if="{{showConfirm}}" bindtap="onCloseConfirm"></view>
<view class="sheet" wx:if="{{showConfirm}}" catchtap="">
  <view class="sheet-handle"></view>
  <text class="sheet-title">请和顾客确认订票信息</text>
  <text class="sheet-product">{{productName}}</text>

  <view class="sheet-field">
    <text class="sheet-label">游玩日期</text>
    <picker class="sheet-picker" range="{{confirmDateRange}}" value="{{confirmDateIndex}}" bindchange="onConfirmDateChange">
      <view class="sheet-picker-value">
        <text class="sheet-value">{{confirmDateText}}</text>
        <text class="sheet-edit">修改</text>
      </view>
    </picker>
  </view>

  <view class="sheet-field">
    <text class="sheet-label">接收订票短信的手机号</text>
    <view class="sheet-picker-value">
      <input class="sheet-input" type="number" maxlength="11" value="{{confirmCell}}" placeholder="请输入手机号" bindinput="onConfirmCellInput" />
    </view>
  </view>

  <view class="sheet-field">
    <text class="sheet-label">姓名</text>
    <view class="sheet-picker-value">
      <input class="sheet-input" value="{{confirmName}}" placeholder="请输入姓名" bindinput="onConfirmNameInput" />
    </view>
  </view>

  <view class="sheet-amount">
    <text class="sheet-amount-label">本张应付</text>
    <text class="sheet-amount-value">{{confirmPriceStr}}</text>
  </view>

  <view class="sheet-actions">
    <view class="sheet-btn sheet-btn--ghost" bindtap="onCloseConfirm">再改改</view>
    <view class="sheet-btn sheet-btn--primary" bindtap="onConfirmAdd">确认加入购物车</view>
  </view>
</view>

<!-- 底部栏：店员是「购物车 + 加入购物车」；顾客只显示价格和订票说明 -->
<view class="pay-bar" wx:if="{{hasPrice}}">
  <view class="price-section">
    <text class="price-label">{{isStaff ? '本张 (THIS TICKET)' : '价格 (PRICE)'}}</text>
    <view class="price-row">
      <text class="price-value">{{summaryStr}}</text>
    </view>
  </view>
  <view wx:if="{{isStaff}}" class="bar-actions">
    <view class="cart-entry" bindtap="onOpenCart">
      <text class="cart-entry-text">购物车</text>
      <text class="cart-entry-count" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
    <view class="pay-btn {{!canAdd ? 'pay-btn--disabled' : ''}}" bindtap="onAddToCart">
      <text class="pay-btn-text">加入购物车</text>
    </view>
  </view>
  <view wx:else class="staff-only">
    <text class="staff-only-text">仅限店员订票，请联系店员预订</text>
  </view>
</view>

</view>
