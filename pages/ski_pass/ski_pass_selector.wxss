@import '/common.wxss';

page{
    --primary: #1A73E8;
    --primary-container: #D1E4FF;
    --surface: #F8F9FF;
    --on-surface: #1A1C1E;
    --on-surface-variant: #44474E;
    --outline: #74777F;
    background-color: var(--surface);
    height: 100%;
}

.weui-tabs-bar__wrp {
    border-bottom: 1px solid #eee;
    margin-top: 10px;
}

.weui-tabs-swiper {
    width: 100%;
    height: 100px;
}

.tab-content {
    height: 100px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    padding: 40rpx;
    font-size: 9pt;
}

.weui-tabs-bar__title {
    margin: 0px 10px;
}

.tab-bar-title__selected {
    font-size: 20px;
    font-weight: bold;
}

.page-wrap {
    padding: 0 24rpx;
}

.page-head {
    display: flex;
    flex-direction: column;
    padding: 36rpx 8rpx 24rpx;
}

.page-title {
    font-size: 44rpx;
    font-weight: 800;
    color: var(--on-surface);
}

.page-sub {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--outline);
}

.notice {
    background: rgba(26, 115, 232, 0.06);
    border: 1rpx solid rgba(26, 115, 232, 0.14);
    border-radius: 20rpx;
    padding: 20rpx 24rpx;
    margin-bottom: 20rpx;
}

.notice-text {
    font-size: 24rpx;
    color: var(--on-surface-variant);
}

.group-list {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.group-card {
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border-radius: 28rpx;
    padding: 32rpx 28rpx;
    box-shadow: 0 8rpx 28rpx rgba(26, 115, 232, 0.06), 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.group-card:active {
    background: #F3F6FD;
}

.group-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.group-title {
    font-size: 34rpx;
    font-weight: 800;
    color: var(--on-surface);
}

.group-sub {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--outline);
}

.group-price {
    display: flex;
    align-items: baseline;
    margin-left: 16rpx;
}

.price-yen {
    font-size: 26rpx;
    font-weight: 700;
    color: var(--primary);
}

.price-num {
    font-size: 48rpx;
    font-weight: 800;
    color: var(--primary);
    letter-spacing: -1rpx;
}

.price-from {
    margin-left: 4rpx;
    font-size: 24rpx;
    color: var(--outline);
}

.group-arrow {
    margin-left: 12rpx;
    font-size: 40rpx;
    color: #C4C6D0;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 0;
}

.empty-title {
    font-size: 32rpx;
    font-weight: 700;
    color: var(--on-surface);
}

.empty-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: var(--outline);
}
