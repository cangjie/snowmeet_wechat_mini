/* pages/ski_pass/skipass_cart.wxss */
page {
  --primary: #1A73E8;
  --surface: #F8F9FF;
  --card: #FFFFFF;
  --on-surface: #1A1C1E;
  --outline: #74777F;
  --outline-variant: #C4C6D0;
  --error: #BA1A1A;
  background-color: var(--surface);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--on-surface);
}

.cart-page { min-height: 100vh; }

.cart-scroll { height: 100vh; padding: 24rpx 32rpx 0; box-sizing: border-box; }

.cart-line {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 115, 232, 0.06);
}

.line-top { display: flex; justify-content: space-between; align-items: flex-start; }
.line-title { flex: 1; font-size: 30rpx; font-weight: 700; line-height: 1.4; padding-right: 24rpx; }
.line-remove { font-size: 24rpx; color: var(--outline); padding: 4rpx 0; }

.line-meta { margin-top: 12rpx; display: flex; gap: 32rpx; font-size: 26rpx; color: var(--outline); }

.line-bottom { margin-top: 20rpx; display: flex; justify-content: space-between; align-items: center; }
.line-price { display: flex; align-items: baseline; gap: 12rpx; }
.price-unit { font-size: 26rpx; color: var(--outline); }
.price-times { font-size: 26rpx; color: var(--outline); }
.price-line-total { font-size: 34rpx; font-weight: 800; color: var(--primary); margin-left: 8rpx; }

.stepper { display: flex; align-items: center; gap: 4rpx; }
.step-btn {
  width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; font-size: 36rpx;
  border-radius: 14rpx; background: #EDEFF3; color: var(--on-surface);
}
.step-count { min-width: 64rpx; text-align: center; font-size: 30rpx; font-weight: 700; }

.cart-tip { margin: 8rpx 8rpx 0; font-size: 22rpx; color: var(--outline); line-height: 1.6; }
.cart-bottom-space { height: 220rpx; }

.empty-state { padding: 160rpx 0; display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.empty-text { font-size: 28rpx; color: var(--outline); }
.empty-btn { padding: 20rpx 56rpx; border-radius: 40rpx; background: var(--primary); color: #fff; font-size: 28rpx; font-weight: 700; }

.cart-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--outline-variant);
}
.bar-total { flex: 1; display: flex; flex-direction: column; }
.bar-label { font-size: 22rpx; color: var(--outline); }
.bar-value { font-size: 40rpx; font-weight: 800; }
.bar-continue {
  padding: 22rpx 28rpx; border-radius: 20rpx; background: #EDEFF3; font-size: 28rpx; font-weight: 700;
}
.bar-pay {
  padding: 22rpx 40rpx; border-radius: 20rpx; background: var(--primary); color: #fff; font-size: 30rpx; font-weight: 800;
}
.bar-pay--disabled { opacity: 0.45; }
