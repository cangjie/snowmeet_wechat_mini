/* pages/ski_pass/skipass_detail_new.wxss */

/* =====================
   CSS 变量 / 设计 Token
   ===================== */
page {
  --primary: #1A73E8;
  --primary-light: #4285F4;
  --primary-container: #D1E4FF;
  --on-primary: #FFFFFF;
  --surface: #F8F9FF;
  --surface-container-lowest: #FFFFFF;
  --surface-container-low: #F3F3F7;
  --surface-container: #EDEFF3;
  --surface-container-high: #E7E8EC;
  --surface-container-highest: #DFE3EB;
  --on-surface: #1A1C1E;
  --on-surface-variant: #44474E;
  --outline: #74777F;
  --outline-variant: #C4C6D0;
  --error: #BA1A1A;

  background-color: var(--surface);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--on-surface);
}

/* =====================
   页面容器
   ===================== */
.page-container {
  min-height: 100vh;
  background-color: var(--surface);
  position: relative;
}

/* 顶部导航栏改用 components/safe_nav_bar（让出手机状态栏，返回键与胶囊同一行） */

.main-content {
  /* padding-top 由页面按导航栏实际高度内联设置（状态栏 + 导航栏） */
  height: 100vh;
  box-sizing: border-box;
}

/* =====================
   Hero 横幅
   ===================== */
.hero-section {
  position: relative;
  margin: 20rpx 24rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  height: 260rpx;
  box-shadow:
    0 16rpx 40rpx rgba(26, 115, 232, 0.15),
    0 4rpx 16rpx rgba(0, 0, 0, 0.10);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(26, 28, 30, 0.85) 0%,
    rgba(26, 28, 30, 0.2) 55%,
    transparent 100%
  );
}

.hero-content {
  position: absolute;
  bottom: 28rpx;
  left: 32rpx;
  right: 32rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.25;
}

.hero-subtitle {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 6rpx;
}

/* =====================
   表单区域
   ===================== */
.form-section {
  padding: 24rpx 24rpx 0;
}

.bento-card {
  background: var(--surface-container-lowest);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 8rpx 28rpx rgba(26, 115, 232, 0.06),
    0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.card-label {
  display: block;
  font-size: 18rpx;
  font-weight: 800;
  color: var(--outline);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  margin-bottom: 14rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--outline);
  text-align: center;
}

/* =====================
   装备选择
   ===================== */
.gear-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gear-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 180rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: var(--surface-container-low);
  border: 2rpx solid transparent;
}

.gear-chip--active {
  background: rgba(26, 115, 232, 0.08);
  border-color: var(--primary);
}

.gear-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.gear-chip--active .gear-name {
  color: var(--primary);
}

.gear-price {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--outline);
}

/* =====================
   价格月历：7 列等宽，格子里上写日期、下写价格；没价格的灰掉
   ===================== */
.week-row {
  display: flex;
  margin-top: 4rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--surface-container-high);
}

.week-cell {
  width: 14.2857%;
  text-align: center;
  font-size: 22rpx;
  color: var(--outline);
}

.month-block {
  margin-top: 24rpx;
}

.month-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--on-surface);
  margin-bottom: 12rpx;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.2857%;
  height: 104rpx;
  box-sizing: border-box;
  padding: 4rpx 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.day-num {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.day-price {
  font-size: 20rpx;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.day-cell--enabled .day-num {
  color: var(--on-surface);
}

.day-cell--enabled .day-price {
  color: var(--primary);
  font-weight: 600;
}

.day-cell--enabled:active {
  background: var(--primary-container);
}

.day-cell--selected {
  background: var(--primary);
}

.day-cell--selected .day-num,
.day-cell--selected .day-price {
  color: #FFFFFF;
}

.day-cell--disabled .day-num {
  color: var(--outline-variant);
  font-weight: 400;
}

.selected-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--surface-container-high);
}

.selected-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--on-surface-variant);
}

.selected-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary);
}

/* =====================
   游客信息卡片（仅店员）
   ===================== */
.info-card {
  background: var(--surface-container-lowest);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 8rpx 28rpx rgba(26, 115, 232, 0.06),
    0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.info-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.header-accent {
  width: 5rpx;
  height: 36rpx;
  background: var(--primary);
  border-radius: 9999rpx;
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.field-item {
  position: relative;
}

.field-label {
  display: block;
  font-size: 18rpx;
  font-weight: 800;
  color: var(--outline);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 10rpx;
}

.field-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--on-surface);
  padding: 0;
  border: none;
  background: transparent;
  box-sizing: border-box;
  line-height: 1.4;
}

.field-placeholder {
  color: var(--outline-variant);
  font-weight: 400;
}

.field-underline {
  height: 2rpx;
  background: var(--outline-variant);
  border-radius: 2rpx;
  margin-top: 8rpx;
  opacity: 0.4;
}

.phone-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.phone-input {
  flex: 1;
}

/* =====================
   底部占位
   ===================== */
.bottom-placeholder {
  height: 180rpx;
}

/* =====================
   底部栏（玻璃效果）
   ===================== */
.pay-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(248, 249, 255, 0.88);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 -2rpx 0 rgba(196, 198, 208, 0.3);
}

.price-section {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.price-label {
  font-size: 16rpx;
  font-weight: 800;
  color: var(--outline);
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-value {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--on-surface);
  letter-spacing: -2rpx;
  line-height: 1;
}

.pay-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  box-shadow:
    0 12rpx 30rpx rgba(26, 115, 232, 0.28),
    0 4rpx 10rpx rgba(26, 115, 232, 0.18);
}

.pay-btn:active {
  transform: scale(0.97);
}

.pay-btn--disabled {
  background: var(--surface-container-highest);
  box-shadow: none;
  opacity: 0.5;
  pointer-events: none;
}

.pay-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.pay-btn-arrow {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 400;
}

/* 顾客：不能订票，只提示 */
.staff-only {
  flex: 1;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(26, 115, 232, 0.06);
  border: 1rpx solid rgba(26, 115, 232, 0.14);
  text-align: center;
}

.staff-only-text {
  font-size: 24rpx;
  color: var(--on-surface-variant);
  line-height: 1.5;
}
